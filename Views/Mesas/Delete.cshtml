@model RestauranteSaborCasero.Models.Mesa

@{
    ViewData["Title"] = "Eliminar Mesa";
}

<style>
    /* =========================================================
           VARIABLES DE TEMA (Basado en el Dashboard)
           ========================================================= */
    :root {
        --sc-primary: #8d3024;
        --sc-primary-dark: #7d2b21;
        --sc-primary-soft: #f9f2f0;
        --sc-dark: #3c2c27;
        --sc-gray: #756b65;
        --sc-border: #eee8e3;
        --sc-bg-panel: #ffffff;
        --sc-shadow: 0 8px 24px rgba(49, 31, 25, .07);
        --sc-danger-bg: #fdf3f2;
        --sc-danger-border: #f5c2c2;
        --sc-danger-text: #c92a2a;
    }

    .sc-page-container {
        width: 100%;
        max-width: 600px;
        padding-top: 12px;
        color: var(--sc-dark);
    }

    /* =========================================================
           ENCABEZADO
           ========================================================= */
    .sc-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 25px;
    }

    .sc-header-icon {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--sc-danger-bg);
        border-radius: 12px;
        color: var(--sc-danger-text);
    }

        .sc-header-icon svg {
            width: 24px;
            height: 24px;
            stroke: currentColor;
        }

    .sc-eyebrow {
        margin: 0 0 4px;
        color: var(--sc-danger-text);
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 1.2px;
        text-transform: uppercase;
    }

    .sc-title {
        margin: 0;
        color: var(--sc-dark);
        font-size: 2rem;
        font-weight: 900;
        letter-spacing: -0.5px;
        line-height: 1.1;
    }

    .sc-description {
        margin: 6px 0 0;
        color: var(--sc-gray);
        font-size: 0.85rem;
        font-weight: 600;
    }

    /* =========================================================
           TARJETA (PANEL)
           ========================================================= */
    .sc-panel {
        background: var(--sc-bg-panel);
        border: 1px solid var(--sc-border);
        border-radius: 16px;
        box-shadow: var(--sc-shadow);
        overflow: hidden;
        margin-bottom: 25px;
    }

    .sc-panel-header {
        padding: 20px 24px;
        background: #faf8f6;
        border-bottom: 1px solid var(--sc-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .sc-panel-title {
        margin: 0;
        color: var(--sc-dark);
        font-size: 1.1rem;
        font-weight: 900;
    }

    .sc-panel-subtitle {
        margin: 4px 0 0;
        color: var(--sc-gray);
        font-size: 0.75rem;
        font-weight: 600;
    }

    .sc-panel-body {
        padding: 24px;
    }

    /* =========================================================
           ALERTA DE PELIGRO
           ========================================================= */
    .sc-alert-danger {
        display: flex;
        gap: 14px;
        background-color: var(--sc-danger-bg);
        border: 1px solid var(--sc-danger-border);
        color: var(--sc-danger-text);
        border-radius: 12px;
        padding: 18px;
        margin-bottom: 24px;
    }

    .sc-alert-icon {
        flex-shrink: 0;
        width: 24px;
        height: 24px;
    }

    .sc-alert-content h4 {
        margin: 0 0 4px;
        font-size: 0.95rem;
        font-weight: 800;
    }

    .sc-alert-content p {
        margin: 0;
        font-size: 0.85rem;
        font-weight: 600;
        line-height: 1.5;
        opacity: 0.9;
    }

    /* =========================================================
           LISTA DE DATOS
           ========================================================= */
    .sc-data-list {
        display: flex;
        flex-direction: column;
        margin: 0 0 24px 0;
        padding: 0;
        list-style: none;
        border: 1px solid var(--sc-border);
        border-radius: 12px;
        overflow: hidden;
    }

    .sc-data-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 20px;
        border-bottom: 1px solid var(--sc-border);
        background: #ffffff;
    }

        .sc-data-item:last-child {
            border-bottom: none;
        }

    .sc-data-label {
        color: var(--sc-gray);
        font-size: 0.85rem;
        font-weight: 700;
    }

    .sc-data-value {
        color: var(--sc-dark);
        font-size: 0.95rem;
        font-weight: 800;
        text-align: right;
    }

    .sc-highlight {
        font-size: 1.05rem;
        color: var(--sc-primary);
        font-weight: 900;
    }

    /* =========================================================
           BADGE ESTADO
           ========================================================= */
    .sc-badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 800;
        background-color: #f3f0ed;
        color: #5f534d;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* =========================================================
           BOTONES Y ACCIONES
           ========================================================= */
    .sc-actions {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
        padding-top: 20px;
        border-top: 1px solid var(--sc-border);
    }

    .sc-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 44px;
        padding: 0 22px;
        border-radius: 10px;
        font-size: 0.85rem;
        font-weight: 800;
        text-decoration: none;
        transition: all 0.2s ease;
        border: 1px solid transparent;
        cursor: pointer;
    }

        .sc-btn svg {
            width: 18px;
            height: 18px;
            stroke: currentColor;
        }

    .sc-btn-danger {
        background-color: #dc3545;
        color: #ffffff;
    }

        .sc-btn-danger:hover {
            background-color: #c82333;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(220, 53, 69, 0.25);
        }

    .sc-btn-secondary {
        background-color: #f3f0ed;
        color: #665d57;
        border-color: #e5ddd6;
    }

        .sc-btn-secondary:hover {
            background-color: #e9e3de;
            color: var(--sc-dark);
            transform: translateY(-2px);
        }
</style>

<div class="sc-page-container">

    <!-- ENCABEZADO -->
    <div class="sc-header">
        <div class="sc-header-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
        </div>
        <div>
            <p class="sc-eyebrow">Precaución</p>
            <h1 class="sc-title">Eliminar mesa</h1>
            <p class="sc-description">Por favor, revisa la información antes de continuar.</p>
        </div>
    </div>

    <!-- TARJETA -->
    <div class="sc-panel">

        <div class="sc-panel-header">
            <div>
                <h2 class="sc-panel-title">Mesa #@Model.NumeroMesa</h2>
                <p class="sc-panel-subtitle">Registro a eliminar</p>
            </div>
            <div class="sc-badge" style="background: var(--sc-danger-bg); color: var(--sc-danger-text);">
                Confirmación requerida
            </div>
        </div>

        <div class="sc-panel-body">

            <!-- ADVERTENCIA -->
            <div class="sc-alert-danger">
                <div class="sc-alert-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                </div>
                <div class="sc-alert-content">
                    <h4>Acción irreversible</h4>
                    <p>¿Está seguro de que desea eliminar permanentemente esta mesa del sistema? Toda la información asociada se perderá y esta acción no se puede deshacer.</p>
                </div>
            </div>

            <!-- INFORMACIÓN -->
            <ul class="sc-data-list">

                <li class="sc-data-item">
                    <span class="sc-data-label">ID de mesa</span>
                    <span class="sc-data-value">@Model.IdMesa</span>
                </li>

                <li class="sc-data-item">
                    <span class="sc-data-label">Número de mesa</span>
                    <span class="sc-data-value sc-highlight">@Model.NumeroMesa</span>
                </li>

                <li class="sc-data-item">
                    <span class="sc-data-label">Estado actual</span>
                    <span class="sc-badge">
                        <span style="display: inline-block; width: 6px; height: 6px; background: currentColor; border-radius: 50%; margin-right: 6px;"></span>
                        @Model.Estado
                    </span>
                </li>

            </ul>

            <!-- ACCIONES / FORMULARIO -->
            <form asp-action="Delete" method="post">

                <input type="hidden" asp-for="IdMesa" />

                <div class="sc-actions">

                    <button type="submit" class="sc-btn sc-btn-danger">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="3 6 5 6 21 6" />
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                            <line x1="10" y1="11" x2="10" y2="17" />
                            <line x1="14" y1="11" x2="14" y2="17" />
                        </svg>
                        Confirmar eliminación
                    </button>

                    <a asp-action="Index" class="sc-btn sc-btn-secondary">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="19" y1="12" x2="5" y2="12" />
                            <polyline points="12 19 5 12 12 5" />
                        </svg>
                        Cancelar
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>