@model RestauranteSaborCasero.Models.Mesa

@{
    ViewData["Title"] = "Eliminar Mesa";
}

<h1>Eliminar Mesa</h1>

<h3>
    ¿Está seguro de que desea eliminar esta mesa?
</h3>

<div>

    <h4>Mesa #@Model.NumeroMesa</h4>

    <dl>

        <dt>
            ID de mesa
        </dt>

        <dd>
            @Model.IdMesa
        </dd>

        <dt>
            Número de mesa
        </dt>

        <dd>
            @Model.NumeroMesa
        </dd>

        <dt>
            Estado
        </dt>

        <dd>
            @Model.Estado
        </dd>

    </dl>

</div>

<form asp-action="Delete" method="post">

    <input type="hidden"
           asp-for="IdMesa" />

    <button type="submit">
        Confirmar eliminación
    </button>

    <a asp-action="Index">
        Cancelar
    </a>

</form>
