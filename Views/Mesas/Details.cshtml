@model RestauranteSaborCasero.Models.Mesa

@{
    ViewData["Title"] = "Detalles de la Mesa";
}

<h1>Detalles de la Mesa</h1>

<div>

    <h4>Mesa #@Model.NumeroMesa</h4>

    <dl>

        <dt>
            ID de mesa
        </dt>

        <dd>
            @Model.IdMesa
        </dd>

        <dt>
            Número de mesa
        </dt>

        <dd>
            @Model.NumeroMesa
        </dd>

        <dt>
            Estado
        </dt>

        <dd>
            @Model.Estado
        </dd>

    </dl>

</div>

<div>

    <a asp-action="Edit"
       asp-route-id="@Model.IdMesa">
        Editar
    </a>

    <a asp-action="Delete"
       asp-route-id="@Model.IdMesa">
        Eliminar
    </a>

    <a asp-action="Index">
        Volver
    </a>

</div>