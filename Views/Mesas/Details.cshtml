
@model RestauranteSaborCasero.Models.Mesa

@{
    ViewData["Title"] = "Detalles de la Mesa";
}

<style>
    .mesa-detalles-container {
        padding: 30px;
    }

    .mesa-detalles-header {
        margin-bottom: 25px;
    }

    .mesa-detalles-titulo {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
        color: #2c2c2c;
    }

    .mesa-detalles-subtitulo {
        margin: 6px 0 0;
        color: #777;
        font-size: 15px;
    }

    .mesa-detalles-card {
        width: 600px;
        background-color: white;
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        padding: 30px;
        margin-bottom: 20px;
    }

    .mesa-identificacion {
        font-size: 22px;
        font-weight: 700;
        color: #343a40;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid #eeeeee;
    }

    .informacion-mesa {
        border: 1px solid #eeeeee;
        border-radius: 8px;
        overflow: hidden;
    }

    .dato {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px;
        border-bottom: 1px solid #eeeeee;
    }

        .dato:last-child {
            border-bottom: none;
        }

    .dato-titulo {
        color: #777;
        font-size: 14px;
        font-weight: 600;
    }

    .dato-valor {
        color: #333;
        font-size: 15px;
        font-weight: 600;
    }

    .numero-mesa {
        font-size: 18px;
        font-weight: 700;
    }

    .estado {
        display: inline-block;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        background-color: #d1e7dd;
        color: #0f5132;
    }

    .acciones {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .btn {
        display: inline-block;
        text-decoration: none;
        padding: 11px 20px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
    }

    .btn-editar {
        background-color: #ffc107;
        color: #212529;
    }

        .btn-editar:hover {
            background-color: #ffca2c;
            color: #212529;
        }

    .btn-eliminar {
        background-color: #dc3545;
        color: white;
    }

        .btn-eliminar:hover {
            background-color: #bb2d3b;
            color: white;
        }

    .btn-volver {
        background-color: #6c757d;
        color: white;
    }

        .btn-volver:hover {
            background-color: #5c636a;
            color: white;
        }
</style>


<div class="mesa-detalles-container">

    <!-- ENCABEZADO -->
    <div class="mesa-detalles-header">

        <h1 class="mesa-detalles-titulo">
            Detalles de la mesa
        </h1>

        <p class="mesa-detalles-subtitulo">
            Información de la mesa registrada
        </p>

    </div>


    <!-- INFORMACIÓN DE LA MESA -->
    <div class="mesa-detalles-card">

        <div class="mesa-identificacion">
            Mesa #@Model.NumeroMesa
        </div>


        <div class="informacion-mesa">

            <!-- ID -->
            <div class="dato">

                <span class="dato-titulo">
                    ID de mesa
                </span>

                <span class="dato-valor">
                    @Model.IdMesa
                </span>

            </div>


            <!-- NÚMERO -->
            <div class="dato">

                <span class="dato-titulo">
                    Número de mesa
                </span>

                <span class="dato-valor numero-mesa">
                    @Model.NumeroMesa
                </span>

            </div>


            <!-- ESTADO -->
            <div class="dato">

                <span class="dato-titulo">
                    Estado
                </span>

                <span class="estado">
                    @Model.Estado
                </span>

            </div>

        </div>

    </div>


    <!-- ACCIONES -->
    <div class="acciones">

        <a asp-action="Edit"
           asp-route-id="@Model.IdMesa"
           class="btn btn-editar">
            Editar mesa
        </a>

        <a asp-action="Delete"
           asp-route-id="@Model.IdMesa"
           class="btn btn-eliminar">
            Eliminar
        </a>

        <a asp-action="Index"
           class="btn btn-volver">
            Volver a mesas
        </a>

    </div>

</div>

