@model RestauranteSaborCasero.Models.Mesa

@{
    ViewData["Title"] = "Registrar Mesa";
}

<style>
    .mesa-create-page {
        width: 100%;
        padding-top: 12px;
        color: #f1e9e3;
    }

    /* =========================
       ENCABEZADO
       ========================= */

    .mesa-create-header {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 24px;
    }

    .mesa-create-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #321b18;
        border: 1px solid #623027;
        border-radius: 12px;
        color: #c99b58;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
        flex-shrink: 0;
    }

    .mesa-create-icon svg {
        width: 27px;
        height: 27px;
        stroke: currentColor;
    }

    .mesa-create-eyebrow {
        margin: 0 0 4px;
        color: #c99b58;
        font-size: 0.7rem;
        font-weight: 900;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .mesa-create-title {
        margin: 0;
        color: #f6eee8;
        font-size: 2rem;
        font-weight: 900;
        letter-spacing: -0.8px;
        line-height: 1.1;
    }

    .mesa-create-subtitle {
        margin: 7px 0 0;
        color: #9f9087;
        font-size: 0.82rem;
        font-weight: 500;
    }

    /* =========================
       CARD
       ========================= */

    .mesa-create-card {
        width: 650px;
        box-sizing: border-box;
        background: #211917;
        border: 1px solid #392824;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 14px 35px rgba(0, 0, 0, 0.28);
    }

    .mesa-card-header {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 19px 22px;
        background: #271c1a;
        border-bottom: 1px solid #3b2925;
    }

    .mesa-card-header-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #321b18;
        border: 1px solid #593027;
        border-radius: 9px;
        color: #c99b58;
        flex-shrink: 0;
    }

    .mesa-card-header-icon svg {
        width: 19px;
        height: 19px;
        stroke: currentColor;
    }

    .mesa-card-header-title {
        margin: 0;
        color: #eee4dd;
        font-size: 0.95rem;
        font-weight: 900;
    }

    .mesa-card-header-subtitle {
        margin: 4px 0 0;
        color: #867770;
        font-size: 0.69rem;
    }

    .mesa-form {
        padding: 25px;
    }

    /* =========================
       INFORMACIÓN
       ========================= */

    .form-info {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 22px;
        padding: 13px 15px;
        background: #2a1c1a;
        border: 1px solid #49302b;
        border-left: 3px solid #842f25;
        border-radius: 8px;
    }

    .form-info-icon {
        width: 18px;
        height: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #c99b58;
        flex-shrink: 0;
    }

    .form-info-icon svg {
        width: 17px;
        height: 17px;
        stroke: currentColor;
    }

    .form-info-text {
        margin: 0;
        color: #9d8d84;
        font-size: 0.67rem;
        font-weight: 500;
        line-height: 1.55;
    }

    .form-info-text strong {
        color: #c7b5aa;
        font-weight: 900;
    }

    /* =========================
       VALIDACIÓN GENERAL
       ========================= */

    .validation-summary {
        background: #3b211f;
        border: 1px solid #68302b;
        border-left: 3px solid #a33c32;
        color: #df8178;
        border-radius: 8px;
        padding: 12px 15px;
        margin-bottom: 20px;
        font-size: 0.7rem;
        font-weight: 700;
    }

    .validation-summary:empty {
        display: none;
    }

    /* =========================
       CAMPOS
       ========================= */

    .campo {
        margin-bottom: 21px;
    }

    .campo label {
        display: block;
        margin-bottom: 8px;
        color: #e7ddd6;
        font-size: 0.75rem;
        font-weight: 900;
        letter-spacing: 0.15px;
    }

    .campo input,
    .campo select {
        width: 100%;
        height: 44px;
        box-sizing: border-box;
        padding: 0 13px;
        background: #181311;
        border: 1px solid #49332d;
        border-radius: 8px;
        color: #eee5df;
        font-family: inherit;
        font-size: 0.78rem;
        font-weight: 600;
        outline: none;
        transition: border-color 0.2s ease,
                    background 0.2s ease,
                    box-shadow 0.2s ease;
    }

    .campo input::placeholder {
        color: #665952;
    }

    .campo input:hover,
    .campo select:hover {
        border-color: #65443a;
        background: #1d1614;
    }

    .campo input:focus,
    .campo select:focus {
        border-color: #9b392d;
        background: #1d1614;
        box-shadow: 0 0 0 3px rgba(132, 47, 37, 0.15);
    }

    .campo select {
        cursor: pointer;
        appearance: auto;
    }

    .campo select option {
        background: #211917;
        color: #eee5df;
    }

    /* =========================
       AYUDA
       ========================= */

    .ayuda {
        display: block;
        margin-top: 7px;
        color: #756861;
        font-size: 0.65rem;
        font-weight: 500;
        line-height: 1.5;
    }

    /* =========================
       VALIDACIÓN
       ========================= */

    .validation {
        display: block;
        margin-top: 6px;
        color: #d97970;
        font-size: 0.66rem;
        font-weight: 800;
    }

    /* =========================
       SEPARADOR
       ========================= */

    .campo-separador {
        height: 1px;
        margin: 4px 0 22px;
        background: #332521;
    }

    /* =========================
       BOTONES
       ========================= */

    .acciones {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-top: 25px;
        padding-top: 21px;
        border-top: 1px solid #392824;
    }

    .btn-guardar,
    .btn-volver {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 42px;
        padding: 0 17px;
        border-radius: 8px;
        font-size: 0.72rem;
        font-weight: 900;
        text-decoration: none;
        cursor: pointer;
        transition: background 0.2s ease,
                    border-color 0.2s ease,
                    color 0.2s ease,
                    transform 0.2s ease,
                    box-shadow 0.2s ease;
    }

    .btn-guardar {
        border: 1px solid #9c3b30;
        background: #842f25;
        color: #ffffff;
        box-shadow: 0 7px 17px rgba(90, 27, 20, 0.25);
    }

    .btn-guardar:hover {
        background: #9b392d;
        border-color: #b24739;
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 9px 20px rgba(105, 30, 22, 0.34);
    }

    .btn-volver {
        border: 1px solid #49362f;
        background: #28211f;
        color: #c1b3ab;
    }

    .btn-volver:hover {
        background: #352723;
        border-color: #68483d;
        color: #eee4dd;
        transform: translateY(-1px);
    }

    .btn-guardar svg,
    .btn-volver svg {
        width: 16px;
        height: 16px;
        stroke: currentColor;
    }
</style>


<div class="mesa-create-page">

    <!-- =========================
         ENCABEZADO
         ========================= -->

    <div class="mesa-create-header">

        <div class="mesa-create-icon">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="M7 9h10" />
                <path d="M7 13h4" />
                <path d="M16 13h1" />
            </svg>

        </div>

        <div>

            <p class="mesa-create-eyebrow">
                Gestión del restaurante
            </p>

            <h1 class="mesa-create-title">
                Registrar mesa
            </h1>

            <p class="mesa-create-subtitle">
                Agrega una nueva mesa al restaurante.
            </p>

        </div>

    </div>


    <!-- =========================
         CARD
         ========================= -->

    <div class="mesa-create-card">

        <div class="mesa-card-header">

            <div class="mesa-card-header-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="M7 9h10" />
                    <path d="M7 13h4" />
                    <path d="M16 13h1" />
                </svg>

            </div>

            <div>

                <h2 class="mesa-card-header-title">
                    Información de la mesa
                </h2>

                <p class="mesa-card-header-subtitle">
                    Define el número y estado inicial de la mesa.
                </p>

            </div>

        </div>


        <div class="mesa-form">

            <div class="form-info">

                <div class="form-info-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 10v6" />
                        <path d="M12 7h.01" />
                    </svg>

                </div>

                <p class="form-info-text">
                    El número de mesa debe ser <strong>único</strong> dentro del restaurante.
                    Una mesa nueva normalmente se registra como disponible.
                </p>

            </div>


            <form asp-action="Create"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>


                <!-- =========================
                     NÚMERO DE MESA
                     ========================= -->

                <div class="campo">

                    <label asp-for="NumeroMesa">
                        Número de mesa
                    </label>

                    <input asp-for="NumeroMesa"
                           type="number"
                           min="1"
                           max="999"
                           placeholder="Ejemplo: 1" />

                    <span class="ayuda">
                        Escribe el número que tendrá la mesa.
                    </span>

                    <span asp-validation-for="NumeroMesa"
                          class="validation">
                    </span>

                </div>


                <div class="campo-separador"></div>


                <!-- =========================
                     ESTADO
                     ========================= -->

                <div class="campo">

                    <label asp-for="Estado">
                        Estado de la mesa
                    </label>

                    <select asp-for="Estado"
                            asp-items="Html.GetEnumSelectList<RestauranteSaborCasero.Models.EstadoMesa>()">
                    </select>

                    <span class="ayuda">
                        Normalmente una mesa nueva comienza como disponible.
                    </span>

                    <span asp-validation-for="Estado"
                          class="validation">
                    </span>

                </div>


                <!-- =========================
                     BOTONES
                     ========================= -->

                <div class="acciones">

                    <button type="submit"
                            class="btn-guardar">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
                            <path d="M17 21v-8H7v8" />
                            <path d="M7 3v5h8" />
                        </svg>

                        Guardar mesa

                    </button>


                    <a asp-action="Index"
                       class="btn-volver">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M19 12H5" />
                            <path d="m12 19-7-7 7-7" />
                        </svg>

                        Volver a mesas

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
