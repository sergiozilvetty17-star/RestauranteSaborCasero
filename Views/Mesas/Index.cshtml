@model IEnumerable<RestauranteSaborCasero.Models.Mesa>

@{
    ViewData["Title"] = "Mesas";
}

<h1>Mesas</h1>

<p>
    <a asp-action="Create">Registrar nueva mesa</a>
</p>

<table>
    <thead>
        <tr>
            <th>
                Número de mesa
            </th>

            <th>
                Estado
            </th>

            <th>
                Acciones
            </th>
        </tr>
    </thead>

    <tbody>
        @foreach (var mesa in Model)
        {
            <tr>
                <td>
                    @mesa.NumeroMesa
                </td>

                <td>
                    @mesa.Estado
                </td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@mesa.IdMesa">
                        Detalles
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@mesa.IdMesa">
                        Editar
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@mesa.IdMesa">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>