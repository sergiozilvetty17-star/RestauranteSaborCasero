@model IEnumerable<RestauranteSaborCasero.Models.Mesa>

@{
    ViewData["Title"] = "Mesas";

    var mesas = Model?.ToList()
        ?? new List<RestauranteSaborCasero.Models.Mesa>();

    var totalMesas = mesas.Count;

    var mesasDisponibles = mesas.Count(m =>
        m.Estado.ToString().ToLower().Contains("dispon"));

    var mesasOcupadas = mesas.Count(m =>
        m.Estado.ToString().ToLower().Contains("ocup"));

    var otrosEstados = totalMesas - mesasDisponibles - mesasOcupadas;
}

<style>
    .mesas-page {
        width: 100%;
        padding-top: 12px;
        color: #f1e9e3;
    }

    /* =========================
       ENCABEZADO
       ========================= */

    .mesas-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 23px;
    }

    .mesas-header-left {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .mesas-header-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #321b18;
        border: 1px solid #623027;
        border-radius: 12px;
        color: #c99b58;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
        flex-shrink: 0;
    }

    .mesas-header-icon svg {
        width: 27px;
        height: 27px;
        stroke: currentColor;
    }

    .mesas-eyebrow {
        margin: 0 0 4px;
        color: #c99b58;
        font-size: 0.7rem;
        font-weight: 900;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .mesas-titulo {
        margin: 0;
        color: #f6eee8;
        font-size: 2rem;
        font-weight: 900;
        letter-spacing: -0.8px;
        line-height: 1.1;
    }

    .mesas-subtitulo {
        margin: 7px 0 0;
        color: #9f9087;
        font-size: 0.82rem;
        font-weight: 500;
    }

    /* =========================
       BOTÓN NUEVA MESA
       ========================= */

    .btn-nueva-mesa {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 43px;
        padding: 0 17px;
        background: #842f25;
        border: 1px solid #9c3b30;
        border-radius: 9px;
        color: #ffffff;
        text-decoration: none;
        font-size: 0.77rem;
        font-weight: 900;
        box-shadow: 0 7px 17px rgba(90, 27, 20, 0.25);
        transition: background 0.2s ease,
                    border-color 0.2s ease,
                    transform 0.2s ease,
                    box-shadow 0.2s ease;
    }

    .btn-nueva-mesa:hover {
        background: #9b392d;
        border-color: #b24739;
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 9px 20px rgba(105, 30, 22, 0.34);
    }

    .btn-nueva-mesa svg {
        width: 17px;
        height: 17px;
        stroke: currentColor;
    }

    /* =========================
       RESUMEN
       ========================= */

    .mesas-resumen {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        margin-bottom: 18px;
    }

    .mesa-stat {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 16px 18px;
        background: #211917;
        border: 1px solid #392824;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.20);
    }

    .mesa-stat-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        flex-shrink: 0;
    }

    .mesa-stat-icon svg {
        width: 20px;
        height: 20px;
        stroke: currentColor;
    }

    .mesa-stat-icon.total {
        background: #321b18;
        border: 1px solid #593027;
        color: #c99b58;
    }

    .mesa-stat-icon.disponible {
        background: #183126;
        border: 1px solid #28543f;
        color: #69b58d;
    }

    .mesa-stat-icon.ocupada {
        background: #3b211f;
        border: 1px solid #68302b;
        color: #d67970;
    }

    .mesa-stat-label {
        margin: 0 0 3px;
        color: #81736c;
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .mesa-stat-value {
        margin: 0;
        color: #f0e7e1;
        font-size: 1.25rem;
        font-weight: 900;
    }

    /* =========================
       CARD TABLA
       ========================= */

    .mesas-card {
        width: 100%;
        background: #211917;
        border: 1px solid #392824;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 14px 35px rgba(0, 0, 0, 0.28);
    }

    .mesas-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 17px 21px;
        background: #271c1a;
        border-bottom: 1px solid #3b2925;
    }

    .mesas-card-title {
        margin: 0;
        color: #eee4dd;
        font-size: 0.94rem;
        font-weight: 900;
    }

    .mesas-card-subtitle {
        margin: 4px 0 0;
        color: #867770;
        font-size: 0.7rem;
    }

    .mesas-count {
        padding: 6px 10px;
        background: #321b18;
        border: 1px solid #593027;
        border-radius: 7px;
        color: #c99b58;
        font-size: 0.66rem;
        font-weight: 900;
    }

    /* =========================
       TABLA
       ========================= */

    .tabla-mesas {
        width: 100%;
        border-collapse: collapse;
        background: #211917;
    }

    .tabla-mesas thead {
        background: #2b1e1b;
        color: #bfaea4;
    }

    .tabla-mesas th {
        padding: 14px 19px;
        text-align: left;
        font-size: 0.67rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.55px;
        border-bottom: 1px solid #44302a;
        white-space: nowrap;
    }

    .tabla-mesas td {
        padding: 15px 19px;
        border-bottom: 1px solid #332521;
        color: #b8aaa2;
        font-size: 0.76rem;
        font-weight: 500;
        vertical-align: middle;
    }

    .tabla-mesas tbody tr {
        background: #211917;
        transition: background 0.18s ease;
    }

    .tabla-mesas tbody tr:hover {
        background: #2a1c1a;
    }

    .tabla-mesas tbody tr:last-child td {
        border-bottom: none;
    }

    /* =========================
       NÚMERO DE MESA
       ========================= */

    .mesa-identidad {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .mesa-icon {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #2d201d;
        border: 1px solid #47312b;
        border-radius: 8px;
        color: #c99b58;
        flex-shrink: 0;
    }

    .mesa-icon svg {
        width: 18px;
        height: 18px;
        stroke: currentColor;
    }

    .numero-mesa {
        display: block;
        color: #eee5df;
        font-size: 0.82rem;
        font-weight: 900;
    }

    .mesa-id {
        display: block;
        margin-top: 2px;
        color: #71635d;
        font-size: 0.61rem;
        font-weight: 600;
    }

    /* =========================
       ESTADOS
       ========================= */

    .estado {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 7px;
        font-size: 0.64rem;
        font-weight: 900;
    }

    .estado::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }

    .estado-disponible {
        background: #183126;
        border: 1px solid #28543f;
        color: #70bc94;
    }

    .estado-disponible::before {
        background: #62ae87;
        box-shadow: 0 0 7px rgba(98, 174, 135, 0.45);
    }

    .estado-ocupada {
        background: #421f1d;
        border: 1px solid #71302b;
        color: #df8178;
    }

    .estado-ocupada::before {
        background: #d97970;
        box-shadow: 0 0 7px rgba(217, 121, 112, 0.40);
    }

    .estado-default {
        background: #2c2523;
        border: 1px solid #493b36;
        color: #b5a69e;
    }

    .estado-default::before {
        background: #8f817a;
    }

    /* =========================
       ACCIONES
       ========================= */

    .acciones {
        display: flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }

    .btn-accion {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 58px;
        height: 32px;
        padding: 0 9px;
        border-radius: 7px;
        font-size: 0.64rem;
        font-weight: 900;
        text-decoration: none;
        transition: background 0.18s ease,
                    border-color 0.18s ease,
                    color 0.18s ease,
                    transform 0.18s ease;
    }

    .btn-accion:hover {
        transform: translateY(-1px);
    }

    .btn-detalles {
        background: #28211f;
        border: 1px solid #49362f;
        color: #c1b3ab;
    }

    .btn-detalles:hover {
        background: #352723;
        border-color: #68483d;
        color: #eee4dd;
    }

    .btn-editar {
        background: #382d1d;
        border: 1px solid #66502b;
        color: #d3ac62;
    }

    .btn-editar:hover {
        background: #4a3821;
        border-color: #87652f;
        color: #e5c37c;
    }

    .btn-eliminar {
        background: #3c201f;
        border: 1px solid #672d2a;
        color: #d77a72;
    }

    .btn-eliminar:hover {
        background: #542522;
        border-color: #8a3933;
        color: #f09a91;
    }

    /* =========================
       TABLA VACÍA
       ========================= */

    .tabla-vacia {
        text-align: center;
        padding: 60px 45px !important;
        color: #756861 !important;
        font-size: 0.78rem !important;
        line-height: 1.7;
    }

    .tabla-vacia strong {
        color: #c39a5a;
    }

    .tabla-vacia-icon {
        width: 48px;
        height: 48px;
        margin: 0 auto 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #2c201d;
        border: 1px solid #49312b;
        border-radius: 11px;
        color: #947568;
    }

    .tabla-vacia-icon svg {
        width: 22px;
        height: 22px;
        stroke: currentColor;
    }
</style>


<div class="mesas-page">

    <!-- =========================
         ENCABEZADO
         ========================= -->

    <div class="mesas-header">

        <div class="mesas-header-left">

            <div class="mesas-header-icon">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="M7 9h10" />
                    <path d="M7 13h4" />
                    <path d="M16 13h1" />
                </svg>
            </div>

            <div>

                <p class="mesas-eyebrow">
                    Gestión del restaurante
                </p>

                <h1 class="mesas-titulo">
                    Mesas
                </h1>

                <p class="mesas-subtitulo">
                    Consulta y administra las mesas disponibles en el restaurante.
                </p>

            </div>

        </div>


        <a asp-action="Create"
           class="btn-nueva-mesa">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">
                <path d="M12 5v14" />
                <path d="M5 12h14" />
            </svg>

            Registrar nueva mesa

        </a>

    </div>


    <!-- =========================
         RESUMEN
         ========================= -->

    <div class="mesas-resumen">

        <!-- TOTAL -->

        <div class="mesa-stat">

            <div class="mesa-stat-icon total">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="M7 9h10" />
                    <path d="M7 13h4" />
                    <path d="M16 13h1" />
                </svg>

            </div>

            <div>

                <p class="mesa-stat-label">
                    Total de mesas
                </p>

                <p class="mesa-stat-value">
                    @totalMesas
                </p>

            </div>

        </div>


        <!-- DISPONIBLES -->

        <div class="mesa-stat">

            <div class="mesa-stat-icon disponible">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" />
                    <path d="m8 12 2.5 2.5L16 9" />
                </svg>

            </div>

            <div>

                <p class="mesa-stat-label">
                    Disponibles
                </p>

                <p class="mesa-stat-value">
                    @mesasDisponibles
                </p>

            </div>

        </div>


        <!-- OCUPADAS -->

        <div class="mesa-stat">

            <div class="mesa-stat-icon ocupada">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M8 8l8 8" />
                    <path d="M16 8l-8 8" />
                </svg>

            </div>

            <div>

                <p class="mesa-stat-label">
                    Ocupadas
                </p>

                <p class="mesa-stat-value">
                    @mesasOcupadas
                </p>

            </div>

        </div>

    </div>


    <!-- =========================
         TABLA
         ========================= -->

    <div class="mesas-card">

        <div class="mesas-card-header">

            <div>

                <h2 class="mesas-card-title">
                    Control de mesas
                </h2>

                <p class="mesas-card-subtitle">
                    Consulta el estado actual y administra cada mesa.
                </p>

            </div>

            <span class="mesas-count">
                @totalMesas REGISTRADAS
            </span>

        </div>


        <table class="tabla-mesas">

            <thead>

                <tr>

                    <th>
                        Mesa
                    </th>

                    <th>
                        Estado
                    </th>

                    <th>
                        Acciones
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (mesas.Any())
                {
                    foreach (var mesa in mesas)
                    {
                        var estado = mesa.Estado.ToString().ToLower();

                        <tr>

                            <!-- =========================
                                 NÚMERO
                                 ========================= -->

                            <td>

                                <div class="mesa-identidad">

                                    <span class="mesa-icon">

                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8"
                                             stroke-linecap="round"
                                             stroke-linejoin="round">
                                            <rect x="3" y="5" width="18" height="14" rx="2" />
                                            <path d="M7 9h10" />
                                            <path d="M7 13h4" />
                                            <path d="M16 13h1" />
                                        </svg>

                                    </span>

                                    <span>

                                        <span class="numero-mesa">
                                            Mesa @mesa.NumeroMesa
                                        </span>

                                        <span class="mesa-id">
                                            ID #@mesa.IdMesa
                                        </span>

                                    </span>

                                </div>

                            </td>


                            <!-- =========================
                                 ESTADO
                                 ========================= -->

                            <td>

                                @if (estado.Contains("dispon"))
                                {
                                    <span class="estado estado-disponible">
                                        @mesa.Estado
                                    </span>
                                }
                                else if (estado.Contains("ocup"))
                                {
                                    <span class="estado estado-ocupada">
                                        @mesa.Estado
                                    </span>
                                }
                                else
                                {
                                    <span class="estado estado-default">
                                        @mesa.Estado
                                    </span>
                                }

                            </td>


                            <!-- =========================
                                 ACCIONES
                                 ========================= -->

                            <td>

                                <div class="acciones">

                                    <a asp-action="Details"
                                       asp-route-id="@mesa.IdMesa"
                                       class="btn-accion btn-detalles">
                                        Ver
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@mesa.IdMesa"
                                       class="btn-accion btn-editar">
                                        Editar
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@mesa.IdMesa"
                                       class="btn-accion btn-eliminar">
                                        Eliminar
                                    </a>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="3"
                            class="tabla-vacia">

                            <div class="tabla-vacia-icon">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <rect x="3" y="5" width="18" height="14" rx="2" />
                                    <path d="M7 9h10" />
                                    <path d="M7 13h4" />
                                    <path d="M16 13h1" />
                                </svg>

                            </div>

                            No hay mesas registradas.

                            <br />

                            Utiliza
                            <strong>“Registrar nueva mesa”</strong>
                            para agregar la primera.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

