@model RestauranteSaborCasero.Models.Usuario
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Nuevo usuario";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1 class="fw-bold">Nuevo usuario</h1>
        <p class="text-muted mb-0">
            Registra un usuario para el sistema del restaurante.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <!-- Envía los datos al método Create del UsuariosController. -->
            <form asp-action="Create" method="post">

                <!-- Muestra errores generales de validación. -->
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label"></label>

                    <!-- asp-for conecta este campo con Usuario.Nombre. -->
                    <input asp-for="Nombre"
                           class="form-control"
                           placeholder="Ejemplo: María Pérez" />

                    <span asp-validation-for="Nombre"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Correo" class="form-label"></label>

                    <input asp-for="Correo"
                           class="form-control"
                           placeholder="correo@ejemplo.com" />

                    <span asp-validation-for="Correo"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Contraseña</label>

                    <!-- type="password" evita que el texto sea visible mientras se escribe. -->
                    <input asp-for="ContrasenaHash"
                           type="password"
                           class="form-control"
                           placeholder="Ingrese una contraseña"
                           autocomplete="new-password" />

                    <span asp-validation-for="ContrasenaHash"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Rol" class="form-label"></label>

                    <!-- Crea las opciones Mesero, Cocinero y Administrador desde el enum RolUsuario. -->
                    <select asp-for="Rol"
                            asp-items="Html.GetEnumSelectList<RolUsuario>()"
                            class="form-select">
                        <option value="">-- Seleccione un rol --</option>
                    </select>

                    <span asp-validation-for="Rol"
                          class="text-danger"></span>
                </div>

                <div class="form-check mb-4">
                    <!-- Guarda true si está marcado y false si se desmarca. -->
                    <input asp-for="Activo" class="form-check-input" />

                    <label asp-for="Activo" class="form-check-label">
                        Usuario activo
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Guardar usuario
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}