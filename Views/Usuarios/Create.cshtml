
@model RestauranteSaborCasero.Models.Usuario

@{
    ViewData["Title"] = "Nuevo usuario";
}

<style>
    .usuario-container {
        padding: 30px;
    }

    .usuario-header {
        margin-bottom: 25px;
    }

    .usuario-titulo {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
        color: #2c2c2c;
    }

    .usuario-subtitulo {
        margin: 6px 0 0;
        color: #777;
        font-size: 15px;
    }

    .usuario-card {
        width: 600px;
        background-color: white;
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        padding: 30px;
    }

    .campo {
        margin-bottom: 20px;
    }

        .campo label {
            display: block;
            margin-bottom: 7px;
            color: #333;
            font-size: 14px;
            font-weight: 600;
        }

        .campo input,
        .campo select {
            width: 100%;
            box-sizing: border-box;
            padding: 12px;
            border: 1px solid #ced4da;
            border-radius: 7px;
            background-color: white;
            color: #333;
            font-size: 15px;
        }

            .campo input:focus,
            .campo select:focus {
                outline: none;
                border-color: #198754;
                box-shadow: 0 0 0 2px rgba(25, 135, 84, 0.12);
            }

    .ayuda {
        display: block;
        margin-top: 6px;
        color: #888;
        font-size: 12px;
    }

    .validacion {
        display: block;
        margin-top: 5px;
        color: #dc3545;
        font-size: 13px;
    }

    .resumen-validacion {
        background-color: #f8d7da;
        border: 1px solid #f1aeb5;
        color: #842029;
        border-radius: 7px;
        padding: 12px 15px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .activo {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 25px;
        padding: 12px 15px;
        background-color: #f8f9fa;
        border: 1px solid #eeeeee;
        border-radius: 7px;
    }

        .activo input {
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

        .activo label {
            color: #333;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
        }

    .acciones {
        display: flex;
        gap: 10px;
        align-items: center;
        padding-top: 20px;
        border-top: 1px solid #eeeeee;
    }

    .btn-guardar {
        border: none;
        background-color: #198754;
        color: white;
        padding: 12px 22px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-guardar:hover {
            background-color: #157347;
        }

    .btn-cancelar {
        background-color: #6c757d;
        color: white;
        text-decoration: none;
        padding: 12px 22px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
    }

        .btn-cancelar:hover {
            background-color: #5c636a;
            color: white;
        }
</style>


<div class="usuario-container">

    <!-- ENCABEZADO -->
    <div class="usuario-header">

        <h1 class="usuario-titulo">
            Nuevo usuario
        </h1>

        <p class="usuario-subtitulo">
            Registra una persona que podrá utilizar el sistema.
        </p>

    </div>


    <!-- FORMULARIO -->
    <div class="usuario-card">

        <form asp-action="Create"
              method="post">

            <!-- VALIDACIONES -->
            <div asp-validation-summary="ModelOnly"
                 class="resumen-validacion">
            </div>


            <!-- NOMBRE -->
            <div class="campo">

                <label asp-for="Nombre">
                    Nombre completo
                </label>

                <input asp-for="Nombre"
                       type="text"
                       placeholder="Ejemplo: María Pérez" />

                <span asp-validation-for="Nombre"
                      class="validacion">
                </span>

            </div>


            <!-- CORREO -->
            <div class="campo">

                <label asp-for="Correo">
                    Correo electrónico
                </label>

                <input asp-for="Correo"
                       type="email"
                       placeholder="correo@ejemplo.com"
                       autocomplete="email" />

                <span class="ayuda">
                    Este correo se utilizará para iniciar sesión.
                </span>

                <span asp-validation-for="Correo"
                      class="validacion">
                </span>

            </div>


            <!-- CONTRASEÑA -->
            <div class="campo">

                <label asp-for="ContrasenaHash">
                    Contraseña
                </label>

                <input asp-for="ContrasenaHash"
                       type="password"
                       placeholder="Ingrese una contraseña"
                       autocomplete="new-password" />

                <span class="ayuda">
                    Escribe una contraseña segura para el usuario.
                </span>

                <span asp-validation-for="ContrasenaHash"
                      class="validacion">
                </span>

            </div>


            <!-- ROL -->
            <div class="campo">

                <label asp-for="Rol">
                    Rol del usuario
                </label>

                <select asp-for="Rol"
                        asp-items="Html.GetEnumSelectList<RolUsuario>()">

                    <option value="">
                        Seleccione un rol
                    </option>

                </select>

                <span class="ayuda">
                    El rol determina qué funciones podrá utilizar.
                </span>

                <span asp-validation-for="Rol"
                      class="validacion">
                </span>

            </div>


            <!-- ESTADO -->
            <div class="activo">

                <input asp-for="Activo"
                       type="checkbox"
                       id="Activo" />

                <label for="Activo">
                    Usuario activo
                </label>

            </div>


            <!-- BOTONES -->
            <div class="acciones">

                <button type="submit"
                        class="btn-guardar">
                    Guardar usuario
                </button>

                <a asp-action="Index"
                   class="btn-cancelar">
                    Cancelar
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

