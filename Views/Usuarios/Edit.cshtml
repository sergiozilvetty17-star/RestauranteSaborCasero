@model RestauranteSaborCasero.Models.Usuario
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Editar usuario";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1 class="fw-bold">Editar usuario</h1>
        <p class="text-muted mb-0">
            Actualiza los datos del usuario seleccionado.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <!-- Envía los datos al método POST Edit del UsuariosController. -->
            <form asp-action="Edit" method="post">

                <!-- Mantiene el identificador del usuario que se está editando. -->
                <input type="hidden" asp-for="IdUsuario" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label"></label>

                    <input asp-for="Nombre" class="form-control" />

                    <span asp-validation-for="Nombre"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Correo" class="form-label"></label>

                    <input asp-for="Correo"
                           class="form-control"
                           type="email" />

                    <span asp-validation-for="Correo"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Contraseña</label>

                    <!-- Permite reemplazar la contraseña actual. -->
                    <input asp-for="ContrasenaHash"
                           type="password"
                           class="form-control"
                           placeholder="Ingrese la contraseña"
                           autocomplete="new-password" />

                    <span asp-validation-for="ContrasenaHash"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Rol" class="form-label"></label>

                    <!-- Selecciona automáticamente el rol actual del usuario. -->
                    <select asp-for="Rol"
                            asp-items="Html.GetEnumSelectList<RolUsuario>()"
                            class="form-select">
                    </select>

                    <span asp-validation-for="Rol"
                          class="text-danger"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="Activo" class="form-check-input" />

                    <label asp-for="Activo" class="form-check-label">
                        Usuario activo
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning">
                        Guardar cambios
                    </button>

                    <a asp-action="Details"
                       asp-route-id="@Model.IdUsuario"
                       class="btn btn-outline-info">
                        Ver detalles
                    </a>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}