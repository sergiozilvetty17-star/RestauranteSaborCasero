@model IEnumerable<RestauranteSaborCasero.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="container mt-4">

    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Usuarios</h1>
            <p class="text-muted mb-0">
                Administración de usuarios del restaurante
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus"></i>
            Nuevo usuario
        </a>
    </div>

    <!-- Tabla de usuarios -->
    <div class="card shadow-sm">
        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-people fs-1 text-muted"></i>

                    <h4 class="mt-3">No hay usuarios registrados</h4>

                    <p class="text-muted">
                        Actualmente no existen usuarios en el sistema.
                    </p>

                    <a asp-action="Create" class="btn btn-primary">
                        Registrar primer usuario
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Correo</th>
                                <th>Rol</th>
                                <th>Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var usuario in Model)
                            {
                                <tr>

                                    <td>
                                        @usuario.IdUsuario
                                    </td>

                                    <td>
                                        <strong>@usuario.Nombre</strong>
                                    </td>

                                    <td>
                                        @usuario.Correo
                                    </td>

                                    <td>
                                        @switch (usuario.Rol)
                                        {
                                            case RolUsuario.Administrador:
                                                <span class="badge bg-danger">
                                                    Administrador
                                                </span>
                                                break;

                                            case RolUsuario.Cocinero:
                                                <span class="badge bg-warning text-dark">
                                                    Cocinero
                                                </span>
                                                break;

                                            case RolUsuario.Mesero:
                                                <span class="badge bg-primary">
                                                    Mesero
                                                </span>
                                                break;
                                        }
                                    </td>

                                    <td>
                                        @if (usuario.Activo)
                                        {
                                            <span class="badge bg-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <a asp-action="Details"
                                               asp-route-id="@usuario.IdUsuario"
                                               class="btn btn-outline-info btn-sm"
                                               title="Ver detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@usuario.IdUsuario"
                                               class="btn btn-outline-warning btn-sm"
                                               title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@usuario.IdUsuario"
                                               class="btn btn-outline-danger btn-sm"
                                               title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>