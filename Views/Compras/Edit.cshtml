@model RestauranteSaborCasero.Models.Compra

<h1>Editar Compra</h1>

<form asp-action="Edit">
    <input type="hidden" asp-for="IdCompra" />

    <div>
        <label asp-for="IdUsuario">Usuario que compra:</label>
        <select asp-for="IdUsuario" asp-items="ViewBag.IdUsuario"></select>
    </div>

    <div>
        <label asp-for="Fecha">Fecha de Compra:</label>
        <input asp-for="Fecha" type="date" />
    </div>

    <div>
        <label asp-for="Proveedor">Proveedor:</label>
        <input asp-for="Proveedor" type="text" />
    </div>

    <div>
        <input type="submit" value="Actualizar Compra" />
    </div>
</form>

<div>
    <a asp-action="Index">Volver a la lista</a>
</div>