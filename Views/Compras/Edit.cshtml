@model RestauranteSaborCasero.Models.Compra

@{
    ViewData["Title"] = "Editar Compra";
}

<style>
    /* =========================================================
           VARIABLES DE TEMA (Basado en el Dashboard)
           ========================================================= */
    :root {
        --sc-primary: #8d3024;
        --sc-primary-dark: #7d2b21;
        --sc-primary-soft: #f9f2f0;
        --sc-dark: #3c2c27;
        --sc-gray: #756b65;
        --sc-border: #eee8e3;
        --sc-bg-panel: #ffffff;
        --sc-shadow: 0 8px 24px rgba(49, 31, 25, .07);
        --sc-danger-bg: #fdf3f2;
        --sc-danger-text: #c92a2a;
    }

    .sc-page-container {
        width: 100%;
        max-width: 800px;
        padding-top: 12px;
        color: var(--sc-dark);
    }

    /* =========================================================
           ENCABEZADO
           ========================================================= */
    .sc-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 25px;
    }

    .sc-header-icon {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--sc-primary-soft);
        border-radius: 12px;
        color: var(--sc-primary);
    }

        .sc-header-icon svg {
            width: 24px;
            height: 24px;
            stroke: currentColor;
        }

    .sc-eyebrow {
        margin: 0 0 4px;
        color: var(--sc-primary);
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 1.2px;
        text-transform: uppercase;
    }

    .sc-title {
        margin: 0;
        color: var(--sc-dark);
        font-size: 2rem;
        font-weight: 900;
        letter-spacing: -0.5px;
        line-height: 1.1;
    }

    .sc-description {
        margin: 6px 0 0;
        color: var(--sc-gray);
        font-size: 0.85rem;
        font-weight: 600;
    }

    /* =========================================================
           TARJETA (PANEL)
           ========================================================= */
    .sc-panel {
        background: var(--sc-bg-panel);
        border: 1px solid var(--sc-border);
        border-radius: 16px;
        box-shadow: var(--sc-shadow);
        overflow: hidden;
        margin-bottom: 25px;
    }

    .sc-panel-header {
        padding: 20px 24px;
        background: #faf8f6;
        border-bottom: 1px solid var(--sc-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .sc-panel-title {
        margin: 0;
        color: var(--sc-dark);
        font-size: 1.1rem;
        font-weight: 900;
    }

    .sc-panel-subtitle {
        margin: 4px 0 0;
        color: var(--sc-gray);
        font-size: 0.75rem;
        font-weight: 600;
    }

    .sc-panel-body {
        padding: 24px;
    }

    /* =========================================================
           FORMULARIO Y CAMPOS
           ========================================================= */
    .sc-form-group {
        margin-bottom: 22px;
    }

    .sc-form-label {
        display: block;
        margin-bottom: 8px;
        color: var(--sc-dark);
        font-size: 0.85rem;
        font-weight: 800;
    }

    .sc-input-wrapper {
        position: relative;
    }

    .sc-input-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        width: 18px;
        height: 18px;
        color: #a3968f;
        pointer-events: none;
    }

        .sc-input-icon svg {
            width: 100%;
            height: 100%;
            stroke: currentColor;
        }

    .sc-input,
    .sc-select {
        width: 100%;
        height: 48px;
        padding: 0 16px 0 42px;
        background: #ffffff;
        border: 1px solid #dcd2cc;
        border-radius: 10px;
        color: var(--sc-dark);
        font-size: 0.9rem;
        font-weight: 600;
        outline: none;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }

    .sc-select {
        cursor: pointer;
        appearance: auto;
        padding-right: 36px;
    }

        .sc-input:hover,
        .sc-select:hover {
            border-color: #c4b5ac;
        }

        .sc-input:focus,
        .sc-select:focus {
            border-color: var(--sc-primary);
            box-shadow: 0 0 0 3px rgba(141, 48, 36, 0.1);
            background: #ffffff;
        }

    .sc-help-text {
        display: block;
        margin-top: 6px;
        color: #8c8078;
        font-size: 0.75rem;
        font-weight: 600;
    }

    /* =========================================================
           VALIDACIÓN
           ========================================================= */
    .sc-validation {
        display: block;
        margin-top: 6px;
        color: var(--sc-danger-text);
        font-size: 0.75rem;
        font-weight: 700;
    }

    .sc-validation-summary {
        background-color: var(--sc-danger-bg);
        border: 1px solid #f5c2c2;
        color: var(--sc-danger-text);
        border-radius: 10px;
        padding: 14px 18px;
        margin-bottom: 24px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    /* =========================================================
           FILAS DINÁMICAS (INGREDIENTES)
           ========================================================= */
    .sc-ingredients-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 30px;
        margin-bottom: 20px;
        padding-top: 24px;
        border-top: 1px solid var(--sc-border);
    }

    .sc-ingredients-title {
        font-size: 1.1rem;
        font-weight: 900;
        color: var(--sc-dark);
        margin: 0;
    }

    .sc-ingredient-row {
        display: flex;
        gap: 16px;
        align-items: flex-end;
        padding: 16px;
        background: #faf8f6;
        border: 1px solid var(--sc-border);
        border-radius: 12px;
        margin-bottom: 16px;
    }

    .sc-ingredient-field {
        flex: 1;
    }

        .sc-ingredient-field label {
            display: block;
            font-size: 0.75rem;
            font-weight: 800;
            color: var(--sc-gray);
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .sc-empty-state {
        text-align: center;
        padding: 30px 20px;
        background: #faf8f6;
        border: 1px dashed #dcd2cc;
        border-radius: 12px;
        color: #8c8078;
        font-weight: 600;
        font-size: 0.9rem;
    }

    /* =========================================================
           BOTONES Y ACCIONES
           ========================================================= */
    .sc-actions {
        display: flex;
        gap: 12px;
        align-items: center;
        padding-top: 24px;
        border-top: 1px solid var(--sc-border);
        margin-top: 10px;
    }

    .sc-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 44px;
        padding: 0 22px;
        border-radius: 10px;
        font-size: 0.85rem;
        font-weight: 800;
        text-decoration: none;
        transition: all 0.2s ease;
        border: 1px solid transparent;
        cursor: pointer;
    }

        .sc-btn svg {
            width: 18px;
            height: 18px;
            stroke: currentColor;
        }

    .sc-btn-primary {
        background-color: var(--sc-primary);
        color: #ffffff;
    }

        .sc-btn-primary:hover {
            background-color: var(--sc-primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(141, 48, 36, 0.2);
        }

    .sc-btn-secondary {
        background-color: #f3f0ed;
        color: #665d57;
        border-color: #e5ddd6;
    }

        .sc-btn-secondary:hover {
            background-color: #e9e3de;
            color: var(--sc-dark);
            transform: translateY(-2px);
        }

    .sc-btn-danger {
        background-color: #dc3545;
        color: #ffffff;
        padding: 0 16px;
    }

        .sc-btn-danger:hover {
            background-color: #c82333;
        }

    .sc-btn-info {
        background-color: #e6f0fa;
        color: #0b5ed7;
        border-color: #cce0f5;
        height: 38px;
        padding: 0 16px;
    }

        .sc-btn-info:hover {
            background-color: #cce0f5;
            color: #084298;
        }
</style>

<div class="sc-page-container">

    <!-- ENCABEZADO -->
    <div class="sc-header">
        <div class="sc-header-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                <line x1="3" y1="6" x2="21" y2="6" />
                <path d="M16 10a4 4 0 0 1-8 0" />
            </svg>
        </div>
        <div>
            <p class="sc-eyebrow">Gestión de Compras</p>
            <h1 class="sc-title">Editar compra</h1>
            <p class="sc-description">Modifica la información de la compra y sus ingredientes.</p>
        </div>
    </div>

    <!-- FORMULARIO -->
    <div class="sc-panel">

        <div class="sc-panel-header">
            <div>
                <h2 class="sc-panel-title">Compra #@Model.IdCompra</h2>
                <p class="sc-panel-subtitle">Registro de abastecimiento</p>
            </div>
            <div style="background: var(--sc-primary-soft); color: var(--sc-primary); font-size: 0.7rem; padding: 6px 10px; border-radius: 8px; font-weight: 800; text-transform: uppercase;">
                Modo Edición
            </div>
        </div>

        <div class="sc-panel-body">

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="IdCompra" />

                <!-- VALIDACIONES -->
                <div asp-validation-summary="ModelOnly" class="sc-validation-summary"></div>

                <!-- USUARIO -->
                <div class="sc-form-group">
                    <label asp-for="IdUsuario" class="sc-form-label">
                        Usuario responsable
                    </label>
                    <div class="sc-input-wrapper">
                        <span class="sc-input-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                <circle cx="12" cy="7" r="4" />
                            </svg>
                        </span>
                        <select asp-for="IdUsuario" class="sc-select" asp-items="ViewBag.IdUsuario">
                            <option value="">Seleccione un usuario...</option>
                        </select>
                    </div>
                    <span class="sc-help-text">Usuario encargado de registrar esta compra en el sistema.</span>
                    <span asp-validation-for="IdUsuario" class="sc-validation"></span>
                </div>

                <!-- FECHA -->
                <div class="sc-form-group">
                    <label asp-for="Fecha" class="sc-form-label">
                        Fecha de compra
                    </label>
                    <div class="sc-input-wrapper">
                        <span class="sc-input-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                                <line x1="16" y1="2" x2="16" y2="6" />
                                <line x1="8" y1="2" x2="8" y2="6" />
                                <line x1="3" y1="10" x2="21" y2="10" />
                            </svg>
                        </span>
                        <!-- Nota: El input date tiene un icon propio en navegadores, le damos padding izquierdo para el ícono SVG personalizado -->
                        <input asp-for="Fecha" type="date" class="sc-input" />
                    </div>
                    <span asp-validation-for="Fecha" class="sc-validation"></span>
                </div>

                <!-- PROVEEDOR -->
                <div class="sc-form-group">
                    <label asp-for="Proveedor" class="sc-form-label">
                        Proveedor
                    </label>
                    <div class="sc-input-wrapper">
                        <span class="sc-input-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="1" y="3" width="15" height="13" />
                                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8" />
                                <circle cx="5.5" cy="18.5" r="2.5" />
                                <circle cx="18.5" cy="18.5" r="2.5" />
                            </svg>
                        </span>
                        <input asp-for="Proveedor" type="text" class="sc-input" placeholder="Ejemplo: Distribuidora ABC" />
                    </div>
                    <span class="sc-help-text">Nombre de la empresa o persona proveedora.</span>
                    <span asp-validation-for="Proveedor" class="sc-validation"></span>
                </div>

                <!-- SECCIÓN DE INGREDIENTES -->
                <div class="sc-ingredients-header">
                    <h2 class="sc-ingredients-title">Ingredientes de la compra</h2>
                    <button type="button" class="sc-btn sc-btn-info" onclick="agregarIngrediente()">
                        + Agregar ingrediente
                    </button>
                </div>

                <div id="ingredientes-container">
                    @if (Model?.Detalles != null && Model.Detalles.Count > 0)
                    {
                        var indice = 0;
                        foreach (var detalle in Model.Detalles)
                        {
                            <div class="sc-ingredient-row">
                                <div class="sc-ingredient-field">
                                    <label>Ingrediente</label>
                                    <select class="sc-select" style="padding-left: 16px;" name="Detalles[@indice].IdIngrediente" required>
                                        <option value="">Seleccione...</option>
                                        @foreach (var ing in (IEnumerable<RestauranteSaborCasero.Models.Ingrediente>)ViewData["Ingredientes"])
                                        {
                                            if (ing.IdIngrediente == detalle.IdIngrediente)
                                            {
                                                <option value="@ing.IdIngrediente" selected>@ing.Nombre (@ing.UnidadMedida)</option>
                                            }
                                            else
                                            {
                                                <option value="@ing.IdIngrediente">@ing.Nombre (@ing.UnidadMedida)</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="sc-ingredient-field">
                                    <label>Cantidad</label>
                                    <input type="number" class="sc-input" style="padding-left: 16px;" name="Detalles[@indice].Cantidad" value="@detalle.Cantidad" step="0.01" min="0.01" required />
                                </div>
                                <button type="button" class="sc-btn sc-btn-danger" onclick="eliminarIngrediente(this)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="18" y1="6" x2="6" y2="18"></line>
                                        <line x1="6" y1="6" x2="18" y2="18"></line>
                                    </svg>
                                </button>
                            </div>
                            indice++;
                        }
                    }
                    else
                    {
                        <div class="sc-empty-state" id="mensaje-sin-ingredientes">
                            No has agregado ningún ingrediente aún.<br />
                            Presiona <strong>+ Agregar ingrediente</strong> para comenzar.
                        </div>
                    }
                </div>

                <!-- ACCIONES -->
                <div class="sc-actions">
                    <button type="submit" class="sc-btn sc-btn-primary">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
                            <polyline points="17 21 17 13 7 13 7 21" />
                            <polyline points="7 3 7 8 15 8" />
                        </svg>
                        Guardar cambios
                    </button>

                    <a asp-action="Index" class="sc-btn sc-btn-secondary">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="19" y1="12" x2="5" y2="12" />
                            <polyline points="12 19 5 12 12 5" />
                        </svg>
                        Volver a compras
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let indiceIngrediente = @(Model?.Detalles?.Count ?? 0);

        function agregarIngrediente() {
            const container = document.getElementById("ingredientes-container");
            const mensaje = document.getElementById("mensaje-sin-ingredientes");
            if (mensaje) mensaje.remove();

            const fila = document.createElement("div");
            fila.className = "sc-ingredient-row";
            fila.innerHTML = `
                        <div class="sc-ingredient-field">
                            <label>Ingrediente</label>
                            <select class="sc-select" style="padding-left: 16px;" name="Detalles[${indiceIngrediente}].IdIngrediente" required>
                                <option value="">Seleccione...</option>
                                @foreach (var ing in (IEnumerable<RestauranteSaborCasero.Models.Ingrediente>)ViewData["Ingredientes"])
                                {
                                            <option value="@ing.IdIngrediente">@ing.Nombre (@ing.UnidadMedida)</option>
                                }
                            </select>
                        </div>
                        <div class="sc-ingredient-field">
                            <label>Cantidad</label>
                            <input type="number" class="sc-input" style="padding-left: 16px;" name="Detalles[${indiceIngrediente}].Cantidad" value="1" step="0.01" min="0.01" required />
                        </div>
                        <button type="button" class="sc-btn sc-btn-danger" onclick="eliminarIngrediente(this)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 18px; height: 18px;">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    `;
            container.appendChild(fila);
            indiceIngrediente++;
        }

        function eliminarIngrediente(boton) {
            const fila = boton.closest(".sc-ingredient-row");
            if (fila) fila.remove();

            const filas = document.querySelectorAll(".sc-ingredient-row");
            if (filas.length === 0) {
                const container = document.getElementById("ingredientes-container");
                container.innerHTML = `
                            <div class="sc-empty-state" id="mensaje-sin-ingredientes">
                                No has agregado ningún ingrediente aún.<br />
                                Presiona <strong>+ Agregar ingrediente</strong> para comenzar.
                            </div>`;
            }
        }
    </script>
}