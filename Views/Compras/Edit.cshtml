@model RestauranteSaborCasero.Models.Compra

@{
    ViewData["Title"] = "Editar Compra";
}

<style>
    .editar-compra-container {
        padding: 30px;
    }

    .editar-compra-header {
        margin-bottom: 25px;
    }

    .editar-compra-titulo {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
        color: #2c2c2c;
    }

    .editar-compra-subtitulo {
        margin: 6px 0 0;
        color: #777;
        font-size: 15px;
    }

    .editar-compra-card {
        width: 600px;
        background-color: white;
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        padding: 30px;
    }

    .compra-identificacion {
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 25px;
        color: #343a40;
    }

        .compra-identificacion strong {
            font-size: 18px;
        }

    .campo {
        margin-bottom: 20px;
    }

        .campo label {
            display: block;
            margin-bottom: 7px;
            font-size: 14px;
            font-weight: 600;
            color: #333;
        }

        .campo input,
        .campo select {
            width: 100%;
            box-sizing: border-box;
            padding: 12px;
            border: 1px solid #ced4da;
            border-radius: 7px;
            background-color: white;
            color: #333;
            font-size: 15px;
        }

            .campo input:focus,
            .campo select:focus {
                outline: none;
                border-color: #198754;
                box-shadow: 0 0 0 2px rgba(25, 135, 84, 0.12);
            }

    .ayuda {
        display: block;
        margin-top: 6px;
        color: #888;
        font-size: 12px;
    }

    .validation {
        display: block;
        margin-top: 5px;
        color: #dc3545;
        font-size: 13px;
    }

    .validation-summary {
        background-color: #f8d7da;
        border: 1px solid #f1aeb5;
        color: #842029;
        border-radius: 7px;
        padding: 12px 15px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .acciones {
        display: flex;
        gap: 10px;
        align-items: center;
        padding-top: 20px;
        border-top: 1px solid #eeeeee;
        margin-top: 25px;
    }

    .btn-guardar {
        border: none;
        background-color: #198754;
        color: white;
        padding: 12px 22px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-guardar:hover {
            background-color: #157347;
        }

    .btn-volver {
        background-color: #6c757d;
        color: white;
        text-decoration: none;
        padding: 12px 22px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
    }

        .btn-volver:hover {
            background-color: #5c636a;
            color: white;
        }

    .ingredientes-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
        margin-top: 30px;
        border-top: 1px solid #eeeeee;
        padding-top: 20px;
    }

    .btn-agregar-ingrediente {
        background-color: #0d6efd;
        color: white;
        border: none;
        padding: 8px 15px;
        border-radius: 7px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-agregar-ingrediente:hover {
            background-color: #0b5ed7;
        }

    .ingredientes-container {
        margin-bottom: 25px;
    }

    .ingrediente-row {
        display: flex;
        gap: 15px;
        align-items: flex-end;
        margin-bottom: 15px;
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        border: 1px solid #e9ecef;
    }

    .ingrediente-campo {
        flex: 1;
    }

        .ingrediente-campo label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 5px;
            color: #555;
        }

        .ingrediente-campo select, .ingrediente-campo input {
            width: 100%;
            padding: 10px;
            border: 1px solid #ced4da;
            border-radius: 5px;
        }

    .btn-eliminar-ingrediente {
        background-color: #dc3545;
        color: white;
        border: none;
        padding: 10px 15px;
        border-radius: 5px;
        font-weight: bold;
        cursor: pointer;
        height: fit-content;
    }

    .sin-ingredientes {
        text-align: center;
        color: #777;
        padding: 20px;
        background: #f8f9fa;
        border-radius: 8px;
        border: 1px dashed #ced4da;
    }
</style>


<div class="editar-compra-container">

    <!-- ENCABEZADO -->
    <div class="editar-compra-header">

        <h1 class="editar-compra-titulo">
            Editar compra
        </h1>

        <p class="editar-compra-subtitulo">
            Modifica la información de la compra seleccionada
        </p>

    </div>


    <!-- FORMULARIO -->
    <div class="editar-compra-card">

        <div class="compra-identificacion">

            Compra:
            <strong>
                #@Model.IdCompra
            </strong>

        </div>


        <form asp-action="Edit"
              method="post">

            <input type="hidden"
                   asp-for="IdCompra" />


            <!-- VALIDACIONES -->
            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>


            <!-- USUARIO -->
            <div class="campo">

                <label asp-for="IdUsuario">
                    Usuario que registra la compra
                </label>

                <select asp-for="IdUsuario"
                        asp-items="ViewBag.IdUsuario">

                    <option value="">
                        Seleccione un usuario
                    </option>

                </select>

                <span class="ayuda">
                    Selecciona el usuario encargado de registrar esta compra.
                </span>

                <span asp-validation-for="IdUsuario"
                      class="validation">
                </span>

            </div>


            <!-- FECHA -->
            <div class="campo">

                <label asp-for="Fecha">
                    Fecha de compra
                </label>

                <input asp-for="Fecha"
                       type="date" />

                <span asp-validation-for="Fecha"
                      class="validation">
                </span>

            </div>


            <!-- PROVEEDOR -->
            <div class="campo">

                <label asp-for="Proveedor">
                    Proveedor
                </label>

                <input asp-for="Proveedor"
                       type="text"
                       placeholder="Ejemplo: Distribuidora ABC" />

                <span class="ayuda">
                    Nombre del proveedor de la compra.
                </span>

                <span asp-validation-for="Proveedor"
                      class="validation">
                </span>

            </div>
            <div class="ingredientes-header">
                <h2 class="seccion-titulo" style="border: none; padding: 0; margin: 0;">Ingredientes de la compra</h2>
                <button type="button" class="btn-agregar-ingrediente" onclick="agregarIngrediente()">+ Agregar ingrediente</button>
            </div>

            <div id="ingredientes-container" class="ingredientes-container">
                @if (Model?.Detalles != null && Model.Detalles.Count > 0)
                {
                    var indice = 0;
                    foreach (var detalle in Model.Detalles)
                    {
                        <div class="ingrediente-row">
                            <div class="ingrediente-campo">
                                <label>Ingrediente</label>
                                <select name="Detalles[@indice].IdIngrediente" required>
                                    <option value="">Seleccione...</option>
                                    @foreach (var ing in (IEnumerable<RestauranteSaborCasero.Models.Ingrediente>)ViewData["Ingredientes"])
                                    {
                                        if (ing.IdIngrediente == detalle.IdIngrediente)
                                        {
                                            <option value="@ing.IdIngrediente" selected>@ing.Nombre (@ing.UnidadMedida)</option>
                                        }
                                        else
                                        {
                                            <option value="@ing.IdIngrediente">@ing.Nombre (@ing.UnidadMedida)</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="ingrediente-campo">
                                <label>Cantidad</label>
                                <input type="number" name="Detalles[@indice].Cantidad" value="@detalle.Cantidad" step="0.01" min="0.01" required />
                            </div>
                            <button type="button" class="btn-eliminar-ingrediente" onclick="eliminarIngrediente(this)">X</button>
                        </div>
                        indice++;
                    }
                }
                else
                {
                    <div class="sin-ingredientes" id="mensaje-sin-ingredientes">
                        No has agregado ningún ingrediente.<br />
                        Presiona <strong>+ Agregar ingrediente</strong> para comenzar.
                    </div>
                }
            </div>

            <!-- ACCIONES -->
            <div class="acciones">

                <button type="submit"
                        class="btn-guardar">
                    Guardar cambios
                </button>

                <a asp-action="Index"
                   class="btn-volver">
                    Volver a compras
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let indiceIngrediente = @(Model?.Detalles?.Count ?? 0);

        function agregarIngrediente() {
            const container = document.getElementById("ingredientes-container");
            const mensaje = document.getElementById("mensaje-sin-ingredientes");
            if (mensaje) mensaje.remove();

            const fila = document.createElement("div");
            fila.className = "ingrediente-row";
            fila.innerHTML = `
                        <div class="ingrediente-campo">
                            <label>Ingrediente</label>
                            <select name="Detalles[${indiceIngrediente}].IdIngrediente" required>
                                <option value="">Seleccione...</option>
                                @foreach (var ing in (IEnumerable<RestauranteSaborCasero.Models.Ingrediente>)ViewData["Ingredientes"])
                                {
                                        <option value="@ing.IdIngrediente">@ing.Nombre (@ing.UnidadMedida)</option>
                                }
                            </select>
                        </div>
                        <div class="ingrediente-campo">
                            <label>Cantidad</label>
                            <input type="number" name="Detalles[${indiceIngrediente}].Cantidad" value="1" step="0.01" min="0.01" required />
                        </div>
                        <button type="button" class="btn-eliminar-ingrediente" onclick="eliminarIngrediente(this)">X</button>
                    `;
            container.appendChild(fila);
            indiceIngrediente++;
        }

        function eliminarIngrediente(boton) {
            const fila = boton.closest(".ingrediente-row");
            if (fila) fila.remove();

            const filas = document.querySelectorAll(".ingrediente-row");
            if (filas.length === 0) {
                const container = document.getElementById("ingredientes-container");
                container.innerHTML = `
                            <div class="sin-ingredientes" id="mensaje-sin-ingredientes">
                                No has agregado ningún ingrediente.<br />
                                Presiona <strong>+ Agregar ingrediente</strong> para comenzar.
                            </div>`;
            }
        }
    </script>
}
