@model RestauranteSaborCasero.Models.Compra

@{
    ViewData["Title"] = "Detalles de la Compra";
}

<style>
    /* =========================================================
           VARIABLES DE TEMA (Basado en el Dashboard)
           ========================================================= */
    :root {
        --sc-primary: #8d3024;
        --sc-primary-dark: #7d2b21;
        --sc-primary-soft: #f9f2f0;
        --sc-dark: #3c2c27;
        --sc-gray: #756b65;
        --sc-border: #eee8e3;
        --sc-bg-panel: #ffffff;
        --sc-shadow: 0 8px 24px rgba(49, 31, 25, .07);
    }

    .sc-page-container {
        width: 100%;
        max-width: 850px;
        padding-top: 12px;
        color: var(--sc-dark);
    }

    /* =========================================================
           ENCABEZADO
           ========================================================= */
    .sc-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 25px;
    }

    .sc-header-icon {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--sc-primary-soft);
        border-radius: 12px;
        color: var(--sc-primary);
    }

        .sc-header-icon svg {
            width: 24px;
            height: 24px;
            stroke: currentColor;
        }

    .sc-eyebrow {
        margin: 0 0 4px;
        color: var(--sc-primary);
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 1.2px;
        text-transform: uppercase;
    }

    .sc-title {
        margin: 0;
        color: var(--sc-dark);
        font-size: 2rem;
        font-weight: 900;
        letter-spacing: -0.5px;
        line-height: 1.1;
    }

    .sc-description {
        margin: 6px 0 0;
        color: var(--sc-gray);
        font-size: 0.85rem;
        font-weight: 600;
    }

    /* =========================================================
           TARJETA (PANEL)
           ========================================================= */
    .sc-panel {
        background: var(--sc-bg-panel);
        border: 1px solid var(--sc-border);
        border-radius: 16px;
        box-shadow: var(--sc-shadow);
        overflow: hidden;
        margin-bottom: 30px;
    }

    .sc-panel-header {
        padding: 20px 24px;
        background: #faf8f6;
        border-bottom: 1px solid var(--sc-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .sc-panel-title {
        margin: 0;
        color: var(--sc-dark);
        font-size: 1.1rem;
        font-weight: 900;
    }

    .sc-panel-subtitle {
        margin: 4px 0 0;
        color: var(--sc-gray);
        font-size: 0.75rem;
        font-weight: 600;
    }

    .sc-panel-body {
        padding: 0;
    }

    /* =========================================================
           LISTA DE DATOS
           ========================================================= */
    .sc-data-list {
        display: flex;
        flex-direction: column;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .sc-data-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 24px;
        border-bottom: 1px solid var(--sc-border);
    }

        .sc-data-item:last-child {
            border-bottom: none;
        }

    .sc-data-label {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--sc-gray);
        font-size: 0.85rem;
        font-weight: 700;
    }

        .sc-data-label svg {
            width: 16px;
            height: 16px;
            color: #a3968f;
        }

    .sc-data-value {
        color: var(--sc-dark);
        font-size: 0.95rem;
        font-weight: 800;
        text-align: right;
    }

    .sc-highlight {
        font-size: 1.05rem;
        color: var(--sc-primary);
        font-weight: 900;
    }

    /* =========================================================
           TABLA ESTILIZADA
           ========================================================= */
    .sc-table {
        width: 100%;
        border-collapse: collapse;
    }

        .sc-table th {
            padding: 16px 24px;
            background: #fbf9f8;
            border-bottom: 2px solid var(--sc-border);
            color: var(--sc-gray);
            font-size: 0.75rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            text-align: left;
        }

        .sc-table td {
            padding: 16px 24px;
            border-bottom: 1px solid var(--sc-border);
            color: var(--sc-dark);
            font-size: 0.9rem;
            font-weight: 600;
        }

        .sc-table tr:last-child td {
            border-bottom: none;
        }

        .sc-table tbody tr:hover {
            background-color: var(--sc-primary-soft);
        }

    .sc-empty-state {
        text-align: center;
        padding: 40px 20px;
        color: #8c8078;
        font-size: 0.9rem;
        font-weight: 600;
    }

    /* =========================================================
           BADGE ESTADO
           ========================================================= */
    .sc-badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* =========================================================
           BOTONES Y ACCIONES
           ========================================================= */
    .sc-actions {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
        margin-top: 10px;
    }

    .sc-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 44px;
        padding: 0 22px;
        border-radius: 10px;
        font-size: 0.85rem;
        font-weight: 800;
        text-decoration: none;
        transition: all 0.2s ease;
        border: 1px solid transparent;
        cursor: pointer;
    }

        .sc-btn svg {
            width: 18px;
            height: 18px;
            stroke: currentColor;
        }

    .sc-btn-warning {
        background-color: #f2d7a0;
        color: #5f430f;
        border-color: #e8c785;
    }

        .sc-btn-warning:hover {
            background-color: #e8c785;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(242, 215, 160, 0.4);
        }

    .sc-btn-secondary {
        background-color: #f3f0ed;
        color: #665d57;
        border-color: #e5ddd6;
    }

        .sc-btn-secondary:hover {
            background-color: #e9e3de;
            color: var(--sc-dark);
            transform: translateY(-2px);
        }

    .sc-btn-disabled {
        background-color: #f3f0ed;
        color: #b0a69f;
        border-color: #e5ddd6;
        cursor: not-allowed;
    }
</style>

<div class="sc-page-container">

    <!-- ENCABEZADO -->
    <div class="sc-header">
        <div class="sc-header-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                <polyline points="14 2 14 8 20 8" />
                <line x1="16" y1="13" x2="8" y2="13" />
                <line x1="16" y1="17" x2="8" y2="17" />
                <polyline points="10 9 9 9 8 9" />
            </svg>
        </div>
        <div>
            <p class="sc-eyebrow">Gestión de Compras</p>
            <h1 class="sc-title">Detalles de la compra</h1>
            <p class="sc-description">Información general y lista de ingredientes registrados.</p>
        </div>
    </div>

    <!-- INFORMACIÓN GENERAL -->
    <div class="sc-panel">

        <div class="sc-panel-header">
            <div>
                <h2 class="sc-panel-title">Compra #@Model.IdCompra</h2>
                <p class="sc-panel-subtitle">Datos administrativos</p>
            </div>

            <div class="sc-badge">
                @switch (Model.Estado)
                {
                    case RestauranteSaborCasero.Models.EstadoCompra.Pendiente:
                        <span style="background-color: #fcf1d4; color: #8a6a1c; padding: 6px 12px; border-radius: 8px;">
                            <span style="display: inline-block; width: 6px; height: 6px; background: currentColor; border-radius: 50%; margin-right: 6px;"></span>
                            Pendiente
                        </span>
                        break;
                    case RestauranteSaborCasero.Models.EstadoCompra.Realizada:
                        <span style="background-color: #e3f2eb; color: #1e7048; padding: 6px 12px; border-radius: 8px;">
                            <span style="display: inline-block; width: 6px; height: 6px; background: currentColor; border-radius: 50%; margin-right: 6px;"></span>
                            Realizada
                        </span>
                        break;
                    case RestauranteSaborCasero.Models.EstadoCompra.Cancelada:
                        <span style="background-color: #fdf3f2; color: #c92a2a; padding: 6px 12px; border-radius: 8px;">
                            <span style="display: inline-block; width: 6px; height: 6px; background: currentColor; border-radius: 50%; margin-right: 6px;"></span>
                            Cancelada
                        </span>
                        break;
                }
            </div>
        </div>

        <div class="sc-panel-body">
            <ul class="sc-data-list">

                <!-- FECHA -->
                <li class="sc-data-item">
                    <span class="sc-data-label">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                            <line x1="16" y1="2" x2="16" y2="6" />
                            <line x1="8" y1="2" x2="8" y2="6" />
                            <line x1="3" y1="10" x2="21" y2="10" />
                        </svg>
                        Fecha de compra
                    </span>
                    <span class="sc-data-value">@Model.Fecha.ToString("dd/MM/yyyy")</span>
                </li>

                <!-- PROVEEDOR -->
                <li class="sc-data-item">
                    <span class="sc-data-label">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="1" y="3" width="15" height="13" />
                            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8" />
                            <circle cx="5.5" cy="18.5" r="2.5" />
                            <circle cx="18.5" cy="18.5" r="2.5" />
                        </svg>
                        Proveedor
                    </span>
                    <span class="sc-data-value sc-highlight">@Model.Proveedor</span>
                </li>

                <!-- USUARIO -->
                <li class="sc-data-item">
                    <span class="sc-data-label">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                        Usuario de registro
                    </span>
                    <span class="sc-data-value">
                        @if (Model.Usuario != null)
                        {
                            @Model.Usuario.Nombre
                        }
                        else
                        {
                            <span style="color: #a3968f;">No registrado</span>
                        }
                    </span>
                </li>

            </ul>
        </div>
    </div>

    <!-- INGREDIENTES -->
    <div class="sc-panel">
        <div class="sc-panel-header">
            <div>
                <h2 class="sc-panel-title">Ingredientes comprados</h2>
                <p class="sc-panel-subtitle">Lista de abastecimiento de esta operación</p>
            </div>
            <div class="sc-header-icon" style="width: 36px; height: 36px; background: #ffffff; border: 1px solid var(--sc-border);">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width: 18px; height: 18px; color: var(--sc-gray);">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                    <line x1="3" y1="6" x2="21" y2="6" />
                    <path d="M16 10a4 4 0 0 1-8 0" />
                </svg>
            </div>
        </div>

        <div class="sc-panel-body">
            <table class="sc-table">
                <thead>
                    <tr>
                        <th>Ingrediente</th>
                        <th>Cantidad Ingresada</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Detalles != null && Model.Detalles.Any())
                    {
                        foreach (var detalle in Model.Detalles)
                        {
                            <tr>
                                <td>
                                    @if (detalle.Ingrediente != null)
                                    {
                                        <strong>@detalle.Ingrediente.Nombre</strong>
                                    }
                                    else
                                    {
                                        <span style="color: #a3968f;">Ingrediente no disponible</span>
                                    }
                                </td>
                                <td>
                                    <span style="color: #1e7048; font-weight: 800; background: #e3f2eb; padding: 4px 8px; border-radius: 6px;">
                                        + @detalle.Cantidad
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2">
                                <div class="sc-empty-state">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" style="width: 48px; height: 48px; margin-bottom: 12px; color: #dcd2cc;">
                                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                                        <line x1="9" y1="3" x2="9" y2="21" />
                                    </svg>
                                    <br />
                                    No hay ingredientes vinculados a este registro.
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ACCIONES -->
    <div class="sc-actions">

        @if (Model.Estado == RestauranteSaborCasero.Models.EstadoCompra.Pendiente)
        {
            <!-- Botón activo y funcional si está Pendiente -->
            <a asp-action="Edit"
               asp-route-id="@Model.IdCompra"
               class="sc-btn sc-btn-warning">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 20h9" />
                    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
                </svg>
                Editar compra
            </a>
        }
        else
        {
            <!-- Botón deshabilitado si ya está Realizada o Cancelada -->
            <span class="sc-btn sc-btn-disabled">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                Edición bloqueada
            </span>
        }

        <a asp-action="Index"
           class="sc-btn sc-btn-secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12" />
                <polyline points="12 19 5 12 12 5" />
            </svg>
            Volver a compras
        </a>

    </div>

</div>