@model IEnumerable<RestauranteSaborCasero.Models.Compra>

@{
    ViewData["Title"] = "Compras";

    var compras = Model?.ToList()
        ?? new List<RestauranteSaborCasero.Models.Compra>();

    var totalCompras = compras.Count;

    var comprasPendientes = compras.Count(c =>
        c.Estado == RestauranteSaborCasero.Models.EstadoCompra.Pendiente);

    var comprasRealizadas = compras.Count(c =>
        c.Estado == RestauranteSaborCasero.Models.EstadoCompra.Realizada);

    var comprasCanceladas = compras.Count(c =>
        c.Estado == RestauranteSaborCasero.Models.EstadoCompra.Cancelada);
}

<style>
    .compras-page {
        width: 100%;
        padding-top: 12px;
        color: #f1e9e3;
    }

    /* =========================
       ENCABEZADO
       ========================= */

    .compras-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 23px;
    }

    .compras-header-left {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .compras-header-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #321b18;
        border: 1px solid #623027;
        border-radius: 12px;
        color: #c99b58;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
        flex-shrink: 0;
    }

    .compras-header-icon svg {
        width: 27px;
        height: 27px;
        stroke: currentColor;
    }

    .compras-eyebrow {
        margin: 0 0 4px;
        color: #c99b58;
        font-size: 0.7rem;
        font-weight: 900;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .compras-titulo {
        margin: 0;
        color: #f6eee8;
        font-size: 2rem;
        font-weight: 900;
        letter-spacing: -0.8px;
        line-height: 1.1;
    }

    .compras-subtitulo {
        margin: 7px 0 0;
        color: #9f9087;
        font-size: 0.82rem;
        font-weight: 500;
    }

    /* =========================
       BOTÓN NUEVA COMPRA
       ========================= */

    .btn-nueva-compra {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 43px;
        padding: 0 17px;
        background: #842f25;
        border: 1px solid #9c3b30;
        border-radius: 9px;
        color: #ffffff;
        text-decoration: none;
        font-size: 0.77rem;
        font-weight: 900;
        box-shadow: 0 7px 17px rgba(90, 27, 20, 0.25);
        transition: background 0.2s ease,
                    border-color 0.2s ease,
                    transform 0.2s ease,
                    box-shadow 0.2s ease;
    }

    .btn-nueva-compra:hover {
        background: #9b392d;
        border-color: #b24739;
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 9px 20px rgba(105, 30, 22, 0.34);
    }

    .btn-nueva-compra svg {
        width: 17px;
        height: 17px;
        stroke: currentColor;
    }

    /* =========================
       RESUMEN
       ========================= */

    .compras-resumen {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 18px;
    }

    .compra-stat {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 16px 18px;
        background: #211917;
        border: 1px solid #392824;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.20);
    }

    .compra-stat-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        flex-shrink: 0;
    }

    .compra-stat-icon svg {
        width: 20px;
        height: 20px;
        stroke: currentColor;
    }

    .compra-stat-icon.total {
        background: #321b18;
        border: 1px solid #593027;
        color: #c99b58;
    }

    .compra-stat-icon.pendiente {
        background: #382d1d;
        border: 1px solid #66502b;
        color: #d3ac62;
    }

    .compra-stat-icon.realizada {
        background: #183126;
        border: 1px solid #28543f;
        color: #69b58d;
    }

    .compra-stat-icon.cancelada {
        background: #3b211f;
        border: 1px solid #68302b;
        color: #d67970;
    }

    .compra-stat-label {
        margin: 0 0 3px;
        color: #81736c;
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .compra-stat-value {
        margin: 0;
        color: #f0e7e1;
        font-size: 1.25rem;
        font-weight: 900;
    }

    /* =========================
       CARD
       ========================= */

    .compras-card {
        width: 100%;
        background: #211917;
        border: 1px solid #392824;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 14px 35px rgba(0, 0, 0, 0.28);
    }

    .compras-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 17px 21px;
        background: #271c1a;
        border-bottom: 1px solid #3b2925;
    }

    .compras-card-title {
        margin: 0;
        color: #eee4dd;
        font-size: 0.94rem;
        font-weight: 900;
    }

    .compras-card-subtitle {
        margin: 4px 0 0;
        color: #867770;
        font-size: 0.7rem;
    }

    .compras-count {
        padding: 6px 10px;
        background: #321b18;
        border: 1px solid #593027;
        border-radius: 7px;
        color: #c99b58;
        font-size: 0.66rem;
        font-weight: 900;
    }

    /* =========================
       TABLA
       ========================= */

    .tabla-compras {
        width: 100%;
        border-collapse: collapse;
        background: #211917;
    }

    .tabla-compras thead {
        background: #2b1e1b;
        color: #bfaea4;
    }

    .tabla-compras th {
        padding: 14px 17px;
        text-align: left;
        font-size: 0.67rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.55px;
        border-bottom: 1px solid #44302a;
        white-space: nowrap;
    }

    .tabla-compras td {
        padding: 15px 17px;
        border-bottom: 1px solid #332521;
        color: #b8aaa2;
        font-size: 0.76rem;
        font-weight: 500;
        vertical-align: middle;
    }

    .tabla-compras tbody tr {
        background: #211917;
        transition: background 0.18s ease;
    }

    .tabla-compras tbody tr:hover {
        background: #2a1c1a;
    }

    .tabla-compras tbody tr:last-child td {
        border-bottom: none;
    }

    /* =========================
       FECHA
       ========================= */

    .fecha-wrapper {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .fecha-icon {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #2d201d;
        border: 1px solid #47312b;
        border-radius: 8px;
        color: #c99b58;
        flex-shrink: 0;
    }

    .fecha-icon svg {
        width: 17px;
        height: 17px;
        stroke: currentColor;
    }

    .fecha {
        display: block;
        color: #eee5df;
        font-size: 0.79rem;
        font-weight: 900;
    }

    /* =========================
       PROVEEDOR
       ========================= */

    .proveedor {
        color: #d2b06b;
        font-size: 0.78rem;
        font-weight: 900;
    }

    /* =========================
       USUARIO
       ========================= */

    .usuario-wrapper {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .usuario-icon {
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #2b211f;
        border: 1px solid #45322c;
        border-radius: 7px;
        color: #a89489;
    }

    .usuario-icon svg {
        width: 15px;
        height: 15px;
        stroke: currentColor;
    }

    .usuario {
        color: #b9aaa2;
        font-weight: 700;
    }

    .sin-dato {
        color: #6f625c;
        font-style: italic;
        font-size: 0.7rem;
    }

    /* =========================
       ESTADOS
       ========================= */

    .estado-compra {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 7px;
        font-size: 0.64rem;
        font-weight: 900;
    }

    .estado-compra::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }

    .estado-pendiente {
        background: #382d1d;
        border: 1px solid #66502b;
        color: #d3ac62;
    }

    .estado-pendiente::before {
        background: #d3ac62;
        box-shadow: 0 0 7px rgba(211, 172, 98, 0.40);
    }

    .estado-realizada {
        background: #183126;
        border: 1px solid #28543f;
        color: #70bc94;
    }

    .estado-realizada::before {
        background: #62ae87;
        box-shadow: 0 0 7px rgba(98, 174, 135, 0.45);
    }

    .estado-cancelada {
        background: #421f1d;
        border: 1px solid #71302b;
        color: #df8178;
    }

    .estado-cancelada::before {
        background: #d97970;
        box-shadow: 0 0 7px rgba(217, 121, 112, 0.40);
    }

    /* =========================
       ACCIONES
       ========================= */

    .acciones {
        display: flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }

    .btn-accion {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 55px;
        height: 32px;
        padding: 0 9px;
        border-radius: 7px;
        font-size: 0.62rem;
        font-weight: 900;
        text-decoration: none;
        transition: background 0.18s ease,
                    border-color 0.18s ease,
                    color 0.18s ease,
                    transform 0.18s ease;
    }

    .btn-accion:hover {
        transform: translateY(-1px);
    }

    .btn-detalles {
        background: #28211f;
        border: 1px solid #49362f;
        color: #c1b3ab;
    }

    .btn-detalles:hover {
        background: #352723;
        border-color: #68483d;
        color: #eee4dd;
    }

    .btn-editar {
        background: #382d1d;
        border: 1px solid #66502b;
        color: #d3ac62;
    }

    .btn-editar:hover {
        background: #4a3821;
        border-color: #87652f;
        color: #e5c37c;
    }

    .btn-recibida {
        background: #183126;
        border: 1px solid #28543f;
        color: #70bc94;
        cursor: pointer;
    }

    .btn-recibida:hover {
        background: #214433;
        border-color: #3b7056;
        color: #8ad0aa;
    }

    .btn-cancelar {
        background: #3c201f;
        border: 1px solid #672d2a;
        color: #d77a72;
        cursor: pointer;
    }

    .btn-cancelar:hover {
        background: #542522;
        border-color: #8a3933;
        color: #f09a91;
    }

    .btn-editar-disabled {
        background: #292523;
        border: 1px solid #3f3632;
        color: #6f6661;
        cursor: not-allowed;
        opacity: 0.75;
    }

    /* =========================
       TABLA VACÍA
       ========================= */

    .tabla-vacia {
        text-align: center;
        padding: 60px 45px !important;
        color: #756861 !important;
        font-size: 0.78rem !important;
        line-height: 1.7;
    }

    .tabla-vacia strong {
        color: #c39a5a;
    }

    .tabla-vacia-icon {
        width: 48px;
        height: 48px;
        margin: 0 auto 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #2c201d;
        border: 1px solid #49312b;
        border-radius: 11px;
        color: #947568;
    }

    .tabla-vacia-icon svg {
        width: 22px;
        height: 22px;
        stroke: currentColor;
    }
</style>


<div class="compras-page">

    <!-- =========================
         ENCABEZADO
         ========================= -->

    <div class="compras-header">

        <div class="compras-header-left">

            <div class="compras-header-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M3 7h18" />
                    <path d="M5 7v12h14V7" />
                    <path d="M8 7V4h8v3" />
                    <path d="M8 11h8" />
                    <path d="M8 15h5" />
                </svg>

            </div>

            <div>

                <p class="compras-eyebrow">
                    Gestión de abastecimiento
                </p>

                <h1 class="compras-titulo">
                    Compras
                </h1>

                <p class="compras-subtitulo">
                    Registro y control de compras de ingredientes.
                </p>

            </div>

        </div>


        <a asp-action="Create"
           class="btn-nueva-compra">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">
                <path d="M12 5v14" />
                <path d="M5 12h14" />
            </svg>

            Nueva compra

        </a>

    </div>


    <!-- =========================
         RESUMEN
         ========================= -->

    <div class="compras-resumen">

        <!-- TOTAL -->

        <div class="compra-stat">

            <div class="compra-stat-icon total">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M3 7h18" />
                    <path d="M5 7v12h14V7" />
                    <path d="M8 7V4h8v3" />
                    <path d="M8 11h8" />
                </svg>

            </div>

            <div>

                <p class="compra-stat-label">
                    Total compras
                </p>

                <p class="compra-stat-value">
                    @totalCompras
                </p>

            </div>

        </div>


        <!-- PENDIENTES -->

        <div class="compra-stat">

            <div class="compra-stat-icon pendiente">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 2" />
                </svg>

            </div>

            <div>

                <p class="compra-stat-label">
                    Pendientes
                </p>

                <p class="compra-stat-value">
                    @comprasPendientes
                </p>

            </div>

        </div>


        <!-- REALIZADAS -->

        <div class="compra-stat">

            <div class="compra-stat-icon realizada">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" />
                    <path d="m8 12 2.5 2.5L16 9" />
                </svg>

            </div>

            <div>

                <p class="compra-stat-label">
                    Realizadas
                </p>

                <p class="compra-stat-value">
                    @comprasRealizadas
                </p>

            </div>

        </div>


        <!-- CANCELADAS -->

        <div class="compra-stat">

            <div class="compra-stat-icon cancelada">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M8 8l8 8" />
                    <path d="M16 8l-8 8" />
                </svg>

            </div>

            <div>

                <p class="compra-stat-label">
                    Canceladas
                </p>

                <p class="compra-stat-value">
                    @comprasCanceladas
                </p>

            </div>

        </div>

    </div>


    <!-- =========================
         TABLA
         ========================= -->

    <div class="compras-card">

        <div class="compras-card-header">

            <div>

                <h2 class="compras-card-title">
                    Registro de compras
                </h2>

                <p class="compras-card-subtitle">
                    Consulta proveedores, usuarios y estado de cada compra.
                </p>

            </div>

            <span class="compras-count">
                @totalCompras REGISTRADAS
            </span>

        </div>


        <table class="tabla-compras">

            <thead>

                <tr>

                    <th>
                        Fecha
                    </th>

                    <th>
                        Proveedor
                    </th>

                    <th>
                        Usuario
                    </th>

                    <th>
                        Estado
                    </th>

                    <th>
                        Acciones
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (compras.Any())
                {
                    foreach (var item in compras)
                    {
                        <tr>

                            <!-- =========================
                                 FECHA
                                 ========================= -->

                            <td>

                                <div class="fecha-wrapper">

                                    <span class="fecha-icon">

                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8"
                                             stroke-linecap="round"
                                             stroke-linejoin="round">
                                            <rect x="3" y="5" width="18" height="16" rx="2" />
                                            <path d="M16 3v4" />
                                            <path d="M8 3v4" />
                                            <path d="M3 10h18" />
                                        </svg>

                                    </span>

                                    <span class="fecha">
                                        @item.Fecha.ToString("dd/MM/yyyy")
                                    </span>

                                </div>

                            </td>


                            <!-- =========================
                                 PROVEEDOR
                                 ========================= -->

                            <td>

                                <span class="proveedor">
                                    @item.Proveedor
                                </span>

                            </td>


                            <!-- =========================
                                 USUARIO
                                 ========================= -->

                            <td>

                                @if (item.Usuario != null)
                                {
                                    <div class="usuario-wrapper">

                                        <span class="usuario-icon">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="1.8"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">
                                                <circle cx="12" cy="8" r="4" />
                                                <path d="M4 21c1.5-4 4-6 8-6s6.5 2 8 6" />
                                            </svg>

                                        </span>

                                        <span class="usuario">
                                            @item.Usuario.Nombre
                                        </span>

                                    </div>
                                }
                                else
                                {
                                    <span class="sin-dato">
                                        Sin usuario
                                    </span>
                                }

                            </td>


                            <!-- =========================
                                 ESTADO
                                 ========================= -->

                            <td>

                                @switch (item.Estado)
                                {
                                    case RestauranteSaborCasero.Models.EstadoCompra.Pendiente:

                                        <span class="estado-compra estado-pendiente">
                                            Pendiente
                                        </span>

                                        break;

                                    case RestauranteSaborCasero.Models.EstadoCompra.Realizada:

                                        <span class="estado-compra estado-realizada">
                                            Realizada
                                        </span>

                                        break;

                                    case RestauranteSaborCasero.Models.EstadoCompra.Cancelada:

                                        <span class="estado-compra estado-cancelada">
                                            Cancelada
                                        </span>

                                        break;
                                }

                            </td>


                            <!-- =========================
                                 ACCIONES
                                 ========================= -->

                            <td>

                                <div class="acciones">

                                    <a asp-action="Details"
                                       asp-route-id="@item.IdCompra"
                                       class="btn-accion btn-detalles">
                                        Ver
                                    </a>


                                    @if (item.Estado == RestauranteSaborCasero.Models.EstadoCompra.Pendiente)
                                    {
                                        <!-- EDITAR -->

                                        <a asp-action="Edit"
                                           asp-route-id="@item.IdCompra"
                                           class="btn-accion btn-editar">
                                            Editar
                                        </a>


                                        <!-- RECIBIDA -->

                                        <form asp-action="CambiarEstado"
                                              method="post"
                                              style="display:inline;">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.IdCompra" />

                                            <input type="hidden"
                                                   name="nuevoEstado"
                                                   value="Realizada" />

                                            <button type="submit"
                                                    class="btn-accion btn-recibida">
                                                ✓ Recibida
                                            </button>

                                        </form>


                                        <!-- CANCELAR -->

                                        <form asp-action="CambiarEstado"
                                              method="post"
                                              style="display:inline;">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.IdCompra" />

                                            <input type="hidden"
                                                   name="nuevoEstado"
                                                   value="Cancelada" />

                                            <button type="submit"
                                                    class="btn-accion btn-cancelar">
                                                ✕ Cancelar
                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <!-- EDITAR DESHABILITADO -->

                                        <span class="btn-accion btn-editar-disabled">
                                            Editar
                                        </span>
                                    }

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="5"
                            class="tabla-vacia">

                            <div class="tabla-vacia-icon">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="M3 7h18" />
                                    <path d="M5 7v12h14V7" />
                                    <path d="M8 7V4h8v3" />
                                </svg>

                            </div>

                            No hay compras registradas.

                            <br />

                            Utiliza
                            <strong>“Nueva compra”</strong>
                            para registrar la primera.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
