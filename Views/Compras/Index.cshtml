@model IEnumerable<RestauranteSaborCasero.Models.Compra>

<h1>Lista de Compras</h1>

<p>
    <a asp-action="Create">Crear Nueva Compra</a>
</p>

<table>
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Proveedor</th>
            <th>Usuario (Comprador)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Fecha.ToShortDateString()</td>
                    <td>@item.Proveedor</td>
                    <td>@item.Usuario?.Nombre</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.IdCompra">Editar</a> |
                        <a asp-action="Details" asp-route-id="@item.IdCompra">Detalles</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>