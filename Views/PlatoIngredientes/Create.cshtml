```cshtml
@model RestauranteSaborCasero.Models.PlatoIngrediente

@{
    ViewData["Title"] = "Asignar ingrediente";
}

<style>
    .asignar-container {
        padding: 30px;
    }

    .asignar-header {
        margin-bottom: 25px;
    }

    .asignar-titulo {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
        color: #2c2c2c;
    }

    .asignar-subtitulo {
        margin: 6px 0 0;
        color: #777;
        font-size: 15px;
    }

    .asignar-card {
        width: 600px;
        background-color: white;
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        padding: 30px;
    }

    .campo {
        margin-bottom: 20px;
    }

        .campo label {
            display: block;
            margin-bottom: 7px;
            font-size: 14px;
            font-weight: 600;
            color: #333;
        }

        .campo select,
        .campo input {
            width: 100%;
            box-sizing: border-box;
            padding: 12px;
            border: 1px solid #ced4da;
            border-radius: 7px;
            background-color: white;
            color: #333;
            font-size: 15px;
        }

            .campo select:focus,
            .campo input:focus {
                outline: none;
                border-color: #198754;
                box-shadow: 0 0 0 2px rgba(25, 135, 84, 0.12);
            }

    .ayuda {
        display: block;
        margin-top: 6px;
        color: #888;
        font-size: 12px;
    }

    .validacion {
        display: block;
        margin-top: 5px;
        color: #dc3545;
        font-size: 13px;
    }

    .resumen-validacion {
        background-color: #f8d7da;
        border: 1px solid #f1aeb5;
        color: #842029;
        border-radius: 7px;
        padding: 12px 15px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .info {
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 7px;
        padding: 12px 15px;
        margin-bottom: 25px;
        color: #666;
        font-size: 13px;
    }

    .acciones {
        display: flex;
        gap: 10px;
        align-items: center;
        padding-top: 20px;
        border-top: 1px solid #eeeeee;
        margin-top: 25px;
    }

    .btn-guardar {
        border: none;
        background-color: #198754;
        color: white;
        padding: 12px 22px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-guardar:hover {
            background-color: #157347;
        }

    .btn-cancelar {
        background-color: #6c757d;
        color: white;
        text-decoration: none;
        padding: 12px 22px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
    }

        .btn-cancelar:hover {
            background-color: #5c636a;
            color: white;
        }
</style>


<div class="asignar-container">

    <!-- ENCABEZADO -->
    <div class="asignar-header">

        <h1 class="asignar-titulo">
            Asignar ingrediente
        </h1>

        <p class="asignar-subtitulo">
            Indica qué ingrediente necesita un plato y cuánto necesita.
        </p>

    </div>


    <!-- FORMULARIO -->
    <div class="asignar-card">

        <div class="info">
            Selecciona un plato, un ingrediente y escribe la cantidad necesaria.
        </div>


        <form asp-action="Create"
              method="post">

            <!-- VALIDACIONES -->
            <div asp-validation-summary="ModelOnly"
                 class="resumen-validacion">
            </div>


            <!-- PLATO -->
            <div class="campo">

                <label asp-for="IdPlato">
                    ¿A qué plato?
                </label>

                <select asp-for="IdPlato"
                        asp-items="ViewBag.IdPlato">

                    <option value="">
                        Seleccione un plato
                    </option>

                </select>

                <span asp-validation-for="IdPlato"
                      class="validacion">
                </span>

            </div>


            <!-- INGREDIENTE -->
            <div class="campo">

                <label asp-for="IdIngrediente">
                    ¿Qué ingrediente?
                </label>

                <select asp-for="IdIngrediente"
                        asp-items="ViewBag.IdIngrediente">

                    <option value="">
                        Seleccione un ingrediente
                    </option>

                </select>

                <span asp-validation-for="IdIngrediente"
                      class="validacion">
                </span>

            </div>


            <!-- CANTIDAD -->
            <div class="campo">

                <label asp-for="CantidadNecesaria">
                    ¿Cuánto necesita?
                </label>

                <input asp-for="CantidadNecesaria"
                       type="number"
                       step="0.01"
                       min="0.01"
                       placeholder="Ejemplo: 0.50" />

                <span class="ayuda">
                    Escribe la cantidad necesaria para preparar una unidad del plato.
                </span>

                <span asp-validation-for="CantidadNecesaria"
                      class="validacion">
                </span>

            </div>


            <!-- BOTONES -->
            <div class="acciones">

                <button type="submit"
                        class="btn-guardar">
                    Guardar asignación
                </button>

                <a asp-action="Index"
                   class="btn-cancelar">
                    Cancelar
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
```
