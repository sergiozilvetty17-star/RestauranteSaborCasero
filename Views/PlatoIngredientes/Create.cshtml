@model RestauranteSaborCasero.Models.PlatoIngrediente
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Asignar ingrediente";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1 class="fw-bold">Asignar ingrediente a un plato</h1>
        <p class="text-muted mb-0">
            Define qué ingrediente necesita un plato y en qué cantidad.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <!-- Envía los datos al método POST Create del controlador. -->
            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="IdPlato" class="form-label">
                        Plato
                    </label>

                    <!-- La lista de platos se carga desde CargarListas del controlador. -->
                    <select asp-for="IdPlato"
                            class="form-select"
                            asp-items="ViewBag.IdPlato">
                        <option value="">-- Seleccione un plato --</option>
                    </select>

                    <span asp-validation-for="IdPlato"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IdIngrediente" class="form-label">
                        Ingrediente
                    </label>

                    <!-- La lista de ingredientes también llega desde el controlador. -->
                    <select asp-for="IdIngrediente"
                            class="form-select"
                            asp-items="ViewBag.IdIngrediente">
                        <option value="">-- Seleccione un ingrediente --</option>
                    </select>

                    <span asp-validation-for="IdIngrediente"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="CantidadNecesaria" class="form-label">
                        Cantidad necesaria
                    </label>

                    <input asp-for="CantidadNecesaria"
                           type="number"
                           step="0.01"
                           min="0.01"
                           class="form-control"
                           placeholder="Ejemplo: 0.50" />

                    <div class="form-text">
                        Ingresa la cantidad según la unidad del ingrediente.
                    </div>

                    <span asp-validation-for="CantidadNecesaria"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Guardar asignación
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}