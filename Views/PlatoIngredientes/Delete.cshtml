```cshtml
@model RestauranteSaborCasero.Models.PlatoIngrediente

@{
    ViewData["Title"] = "Eliminar ingrediente";
}

<style>
    .eliminar-container {
        padding: 30px;
    }

    .eliminar-header {
        margin-bottom: 25px;
    }

    .eliminar-titulo {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
        color: #dc3545;
    }

    .eliminar-subtitulo {
        margin: 6px 0 0;
        color: #777;
        font-size: 15px;
    }

    .eliminar-card {
        width: 600px;
        background-color: white;
        border: 1px solid #f1aeb5;
        border-radius: 10px;
        padding: 30px;
    }

    .advertencia {
        background-color: #fff3cd;
        border: 1px solid #ffecb5;
        color: #664d03;
        border-radius: 7px;
        padding: 14px 16px;
        margin-bottom: 25px;
        font-size: 14px;
        line-height: 1.5;
    }

        .advertencia strong {
            display: block;
            margin-bottom: 3px;
        }

    .informacion {
        border: 1px solid #eeeeee;
        border-radius: 8px;
        overflow: hidden;
    }

    .dato {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px;
        border-bottom: 1px solid #eeeeee;
    }

        .dato:last-child {
            border-bottom: none;
        }

    .dato-titulo {
        color: #777;
        font-size: 14px;
        font-weight: 600;
    }

    .dato-valor {
        color: #333;
        font-size: 15px;
        font-weight: 600;
        text-align: right;
    }

    .plato {
        color: #198754;
        font-size: 16px;
    }

    .ingrediente {
        color: #343a40;
    }

    .cantidad {
        color: #0d6efd;
    }

    .acciones {
        display: flex;
        gap: 10px;
        align-items: center;
        padding-top: 20px;
        margin-top: 25px;
        border-top: 1px solid #eeeeee;
    }

    .btn-eliminar {
        border: none;
        background-color: #dc3545;
        color: white;
        padding: 12px 20px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-eliminar:hover {
            background-color: #bb2d3b;
        }

    .btn-cancelar {
        background-color: #6c757d;
        color: white;
        text-decoration: none;
        padding: 12px 20px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
    }

        .btn-cancelar:hover {
            background-color: #5c636a;
            color: white;
        }
</style>


<div class="eliminar-container">

    <!-- ENCABEZADO -->
    <div class="eliminar-header">

        <h1 class="eliminar-titulo">
            Eliminar ingrediente
        </h1>

        <p class="eliminar-subtitulo">
            Confirma que deseas quitar este ingrediente del plato.
        </p>

    </div>


    <!-- TARJETA -->
    <div class="eliminar-card">

        <!-- ADVERTENCIA -->
        <div class="advertencia">

            <strong>
                Atención
            </strong>

            Este ingrediente dejará de formar parte de la receta de este plato.

        </div>


        <!-- INFORMACIÓN -->
        <div class="informacion">

            <!-- PLATO -->
            <div class="dato">

                <span class="dato-titulo">
                    Plato
                </span>

                <span class="dato-valor plato">
                    @Model.Plato.Nombre
                </span>

            </div>


            <!-- INGREDIENTE -->
            <div class="dato">

                <span class="dato-titulo">
                    Ingrediente
                </span>

                <span class="dato-valor ingrediente">
                    @Model.Ingrediente.Nombre
                </span>

            </div>


            <!-- CANTIDAD -->
            <div class="dato">

                <span class="dato-titulo">
                    Cantidad necesaria
                </span>

                <span class="dato-valor cantidad">
                    @Model.CantidadNecesaria
                    @Model.Ingrediente.UnidadMedida
                </span>

            </div>

        </div>


        <!-- CONFIRMACIÓN -->
        <form asp-action="Delete"
              asp-route-idPlato="@Model.IdPlato"
              asp-route-idIngrediente="@Model.IdIngrediente"
              method="post">

            <input type="hidden"
                   name="idPlato"
                   value="@Model.IdPlato" />

            <input type="hidden"
                   name="idIngrediente"
                   value="@Model.IdIngrediente" />


            <div class="acciones">

                <button type="submit"
                        class="btn-eliminar">
                    Sí, eliminar ingrediente
                </button>

                <a asp-action="Index"
                   class="btn-cancelar">
                    Cancelar
                </a>

            </div>

        </form>

    </div>

</div>
```
