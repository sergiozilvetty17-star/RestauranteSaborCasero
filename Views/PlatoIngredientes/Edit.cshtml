```cshtml
@model RestauranteSaborCasero.Models.PlatoIngrediente

@{
    ViewData["Title"] = "Editar ingrediente";
}

<style>
    .editar-container {
        padding: 30px;
    }

    .editar-header {
        margin-bottom: 25px;
    }

    .editar-titulo {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
        color: #2c2c2c;
    }

    .editar-subtitulo {
        margin: 6px 0 0;
        color: #777;
        font-size: 15px;
    }

    .editar-card {
        width: 600px;
        background-color: white;
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        padding: 30px;
    }

    .informacion {
        border: 1px solid #eeeeee;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 25px;
    }

    .dato {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px;
        border-bottom: 1px solid #eeeeee;
    }

        .dato:last-child {
            border-bottom: none;
        }

    .dato-titulo {
        color: #777;
        font-size: 14px;
        font-weight: 600;
    }

    .dato-valor {
        color: #343a40;
        font-size: 15px;
        font-weight: 600;
        text-align: right;
    }

    .plato {
        color: #198754;
    }

    .ingrediente {
        color: #0d6efd;
    }

    .campo {
        margin-bottom: 20px;
    }

        .campo label {
            display: block;
            margin-bottom: 7px;
            font-size: 14px;
            font-weight: 600;
            color: #333;
        }

        .campo input {
            width: 100%;
            box-sizing: border-box;
            padding: 12px;
            border: 1px solid #ced4da;
            border-radius: 7px;
            font-size: 16px;
            color: #333;
        }

            .campo input:focus {
                outline: none;
                border-color: #198754;
                box-shadow: 0 0 0 2px rgba(25, 135, 84, 0.12);
            }

    .ayuda {
        display: block;
        margin-top: 7px;
        color: #888;
        font-size: 12px;
    }

    .validacion {
        display: block;
        margin-top: 5px;
        color: #dc3545;
        font-size: 13px;
    }

    .resumen-validacion {
        background-color: #f8d7da;
        border: 1px solid #f1aeb5;
        color: #842029;
        border-radius: 7px;
        padding: 12px 15px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .acciones {
        display: flex;
        gap: 10px;
        align-items: center;
        padding-top: 20px;
        margin-top: 25px;
        border-top: 1px solid #eeeeee;
    }

    .btn-guardar {
        border: none;
        background-color: #198754;
        color: white;
        padding: 12px 22px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-guardar:hover {
            background-color: #157347;
        }

    .btn-cancelar {
        background-color: #6c757d;
        color: white;
        text-decoration: none;
        padding: 12px 22px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
    }

        .btn-cancelar:hover {
            background-color: #5c636a;
            color: white;
        }
</style>


<div class="editar-container">

    <!-- ENCABEZADO -->
    <div class="editar-header">

        <h1 class="editar-titulo">
            Editar ingrediente del plato
        </h1>

        <p class="editar-subtitulo">
            Cambia solamente la cantidad necesaria.
        </p>

    </div>


    <!-- FORMULARIO -->
    <div class="editar-card">

        <form asp-action="Edit"
              asp-route-idPlato="@Model.IdPlato"
              asp-route-idIngrediente="@Model.IdIngrediente"
              method="post">

            <!-- CLAVE COMPUESTA -->
            <input type="hidden"
                   asp-for="IdPlato" />

            <input type="hidden"
                   asp-for="IdIngrediente" />


            <!-- VALIDACIONES -->
            <div asp-validation-summary="ModelOnly"
                 class="resumen-validacion">
            </div>


            <!-- INFORMACIÓN FIJA -->
            <div class="informacion">

                <div class="dato">

                    <span class="dato-titulo">
                        Plato
                    </span>

                    <span class="dato-valor plato">
                        @Model.Plato.Nombre
                    </span>

                </div>


                <div class="dato">

                    <span class="dato-titulo">
                        Ingrediente
                    </span>

                    <span class="dato-valor ingrediente">
                        @Model.Ingrediente.Nombre
                    </span>

                </div>

            </div>


            <!-- CANTIDAD -->
            <div class="campo">

                <label asp-for="CantidadNecesaria">
                    Cantidad necesaria
                </label>

                <input asp-for="CantidadNecesaria"
                       type="number"
                       step="0.01"
                       min="0.01"
                       placeholder="Ejemplo: 0.50" />

                <span class="ayuda">
                    Unidad:
                    @Model.Ingrediente.UnidadMedida
                </span>

                <span asp-validation-for="CantidadNecesaria"
                      class="validacion">
                </span>

            </div>


            <!-- BOTONES -->
            <div class="acciones">

                <button type="submit"
                        class="btn-guardar">
                    Guardar cambios
                </button>

                <a asp-action="Index"
                   class="btn-cancelar">
                    Cancelar
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
```
