@model RestauranteSaborCasero.Models.PlatoIngrediente

@{
    ViewData["Title"] = "Editar cantidad de ingrediente";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1 class="fw-bold">Editar ingrediente del plato</h1>
        <p class="text-muted mb-0">
            Modifica la cantidad necesaria para preparar este plato.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <!-- Envía la actualización al método POST Edit. -->
            <form asp-action="Edit"
                  asp-route-idPlato="@Model.IdPlato"
                  asp-route-idIngrediente="@Model.IdIngrediente"
                  method="post">

                <!-- Conservan los dos valores que forman la clave compuesta. -->
                <input type="hidden" asp-for="IdPlato" />
                <input type="hidden" asp-for="IdIngrediente" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label class="form-label">Plato</label>

                    <!-- No se cambia el plato durante la edición de esta relación. -->
                    <select asp-for="IdPlato"
                            class="form-select"
                            asp-items="ViewBag.IdPlato"
                            disabled>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Ingrediente</label>

                    <!-- No se cambia el ingrediente durante la edición. -->
                    <select asp-for="IdIngrediente"
                            class="form-select"
                            asp-items="ViewBag.IdIngrediente"
                            disabled>
                    </select>
                </div>

                <div class="mb-4">
                    <label asp-for="CantidadNecesaria" class="form-label">
                        Cantidad necesaria
                    </label>

                    <input asp-for="CantidadNecesaria"
                           type="number"
                           step="0.01"
                           min="0.01"
                           class="form-control" />

                    <div class="form-text">
                        La unidad corresponde a la definida para el ingrediente.
                    </div>

                    <span asp-validation-for="CantidadNecesaria"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning">
                        Guardar cambios
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}