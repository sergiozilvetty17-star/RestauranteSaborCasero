@{
    ViewData["Title"] = "Inicio";
}

<style>
    /* =========================================================
           INICIO - SABOR CASERO
           ========================================================= */

    .home-page {
        width: 100%;
    }

    /* =========================================================
           HERO
           ========================================================= */

    .home-hero {
        position: relative;
        min-height: 300px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 45px 50px;
        background: linear-gradient( 135deg, #8b3a2b 0%, #743024 55%, #68291f 100% );
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 40px rgba(104, 41, 31, 0.20);
    }

        .home-hero::before {
            content: "";
            position: absolute;
            width: 380px;
            height: 380px;
            right: -100px;
            top: -160px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.06);
        }

        .home-hero::after {
            content: "";
            position: absolute;
            width: 250px;
            height: 250px;
            right: 180px;
            bottom: -180px;
            border-radius: 50%;
            background: rgba(214, 155, 69, 0.12);
        }

    .home-hero-content {
        position: relative;
        z-index: 2;
        max-width: 720px;
    }

    .home-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
        color: #f4d8ae;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .home-eyebrow-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #d69b45;
        box-shadow: 0 0 0 4px rgba(214, 155, 69, 0.15);
    }

    .home-title {
        margin: 0;
        color: #ffffff;
        font-size: 3rem;
        font-weight: 800;
        letter-spacing: -1.5px;
        line-height: 1.05;
    }

    .home-description {
        margin: 18px 0 0;
        max-width: 600px;
        color: rgba(255, 255, 255, 0.78);
        font-size: 1.05rem;
        line-height: 1.7;
    }

    /* =========================================================
           HERO ICON
           ========================================================= */

    .home-hero-icon {
        position: relative;
        z-index: 2;
        width: 150px;
        height: 150px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 35px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.09);
        border: 1px solid rgba(255, 255, 255, 0.13);
        box-shadow: inset 0 0 30px rgba(255, 255, 255, 0.03);
    }

        .home-hero-icon svg {
            width: 72px;
            height: 72px;
            color: #ffffff;
            stroke: currentColor;
        }

    /* =========================================================
           SECTION HEADER
           ========================================================= */

    .home-section {
        margin-top: 38px;
    }

    .home-section-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin-bottom: 18px;
    }

    .home-section-title {
        margin: 0;
        color: var(--sc-dark);
        font-size: 1.35rem;
        font-weight: 800;
        letter-spacing: -0.3px;
    }

    .home-section-subtitle {
        margin: 5px 0 0;
        color: var(--sc-gray);
        font-size: 0.86rem;
    }

    /* =========================================================
           MODULE CARDS
           ========================================================= */

    .home-modules {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .home-module {
        position: relative;
        display: flex;
        flex-direction: column;
        min-height: 245px;
        padding: 25px;
        background: var(--sc-white);
        border: 1px solid var(--sc-border);
        border-radius: 16px;
        box-shadow: var(--sc-shadow);
        text-decoration: none;
        overflow: hidden;
        transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
    }

        .home-module:hover {
            color: inherit;
            text-decoration: none;
            transform: translateY(-4px);
            border-color: #ddcfc4;
            box-shadow: 0 16px 35px rgba(70, 45, 30, 0.12);
        }

        .home-module::after {
            content: "";
            position: absolute;
            right: -35px;
            bottom: -55px;
            width: 150px;
            height: 150px;
            border-radius: 50%;
            background: var(--sc-primary-soft);
            opacity: 0;
            transition: opacity 0.22s ease;
        }

        .home-module:hover::after {
            opacity: 1;
        }

    /* =========================================================
           MODULE ICON
           ========================================================= */

    .home-module-icon {
        position: relative;
        z-index: 2;
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        border-radius: 13px;
        background: var(--sc-primary-soft);
        color: var(--sc-primary);
        transition: background 0.22s ease, color 0.22s ease, transform 0.22s ease;
    }

    .home-module:hover .home-module-icon {
        background: var(--sc-primary);
        color: #ffffff;
        transform: scale(1.04);
    }

    .home-module-icon svg {
        width: 25px;
        height: 25px;
        stroke: currentColor;
    }

    /* =========================================================
           MODULE CONTENT
           ========================================================= */

    .home-module-title {
        position: relative;
        z-index: 2;
        margin: 0 0 8px;
        color: var(--sc-dark);
        font-size: 1.08rem;
        font-weight: 800;
    }

    .home-module-description {
        position: relative;
        z-index: 2;
        margin: 0;
        color: var(--sc-gray);
        font-size: 0.87rem;
        line-height: 1.6;
    }

    /* =========================================================
           MODULE LINK
           ========================================================= */

    .home-module-action {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 7px;
        margin-top: auto;
        padding-top: 22px;
        color: var(--sc-primary);
        font-size: 0.82rem;
        font-weight: 800;
    }

        .home-module-action svg {
            width: 16px;
            height: 16px;
            transition: transform 0.2s ease;
        }

    .home-module:hover .home-module-action svg {
        transform: translateX(4px);
    }

    /* =========================================================
           INFORMATION STRIP
           ========================================================= */

    .home-info {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 20px;
        margin-top: 20px;
    }

    .home-info-card {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 18px 20px;
        background: #ffffff;
        border: 1px solid var(--sc-border);
        border-radius: 13px;
    }

    .home-info-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 10px;
        background: var(--sc-secondary-soft);
        color: var(--sc-secondary-dark);
    }

        .home-info-icon svg {
            width: 21px;
            height: 21px;
            stroke: currentColor;
        }

    .home-info-title {
        margin: 0 0 3px;
        color: var(--sc-dark);
        font-size: 0.84rem;
        font-weight: 800;
    }

    .home-info-text {
        margin: 0;
        color: var(--sc-gray);
        font-size: 0.76rem;
    }
</style>


<div class="home-page">

    <!-- =====================================================
         HERO
         ===================================================== -->

    <section class="home-hero">

        <div class="home-hero-content">

            <div class="home-eyebrow">

                <span class="home-eyebrow-dot"></span>

                Sistema de gestión

            </div>

            <h1 class="home-title">
                Bienvenido a<br />
                Sabor Casero
            </h1>

            <p class="home-description">
                Administra de manera sencilla y organizada los platos,
                mesas e ingredientes de tu restaurante desde un solo lugar.
            </p>

        </div>


        <div class="home-hero-icon">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.5"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <path d="M6 3v7" />
                <path d="M4 3v7a2 2 0 0 0 4 0V3" />
                <path d="M6 12v9" />

                <path d="M14 3v18" />
                <path d="M14 3c3 1 4 3.2 4 6v1h-4" />

            </svg>

        </div>

    </section>


    <!-- =====================================================
         MÓDULOS
         ===================================================== -->

    <section class="home-section">

        <div class="home-section-header">

            <div>

                <h2 class="home-section-title">
                    Accesos rápidos
                </h2>

                <p class="home-section-subtitle">
                    Accede rápidamente a las principales áreas del restaurante.
                </p>

            </div>

        </div>


        <div class="home-modules">


            <!-- PLATOS -->

            <a asp-controller="Platos"
               asp-action="Index"
               class="home-module">

                <div class="home-module-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <circle cx="12" cy="12" r="8" />
                        <path d="M4 12h16" />
                        <path d="M12 4c2.5 2 3.5 4.5 3.5 8s-1 6-3.5 8" />
                        <path d="M12 4c-2.5 2-3.5 4.5-3.5 8s1 6 3.5 8" />

                    </svg>

                </div>

                <h3 class="home-module-title">
                    Platos
                </h3>

                <p class="home-module-description">
                    Administra el menú, precios, disponibilidad
                    y tiempos estimados de preparación.
                </p>

                <span class="home-module-action">

                    Administrar platos

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M5 12h14" />
                        <path d="m13 6 6 6-6 6" />

                    </svg>

                </span>

            </a>


            <!-- MESAS -->

            <a asp-controller="Mesas"
               asp-action="Index"
               class="home-module">

                <div class="home-module-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <rect x="4" y="7" width="16" height="8" rx="2" />
                        <path d="M7 15v5" />
                        <path d="M17 15v5" />
                        <path d="M3 7h18" />

                    </svg>

                </div>

                <h3 class="home-module-title">
                    Mesas
                </h3>

                <p class="home-module-description">
                    Consulta y administra las mesas del restaurante
                    y su disponibilidad.
                </p>

                <span class="home-module-action">

                    Administrar mesas

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M5 12h14" />
                        <path d="m13 6 6 6-6 6" />

                    </svg>

                </span>

            </a>


            <!-- INGREDIENTES -->

            <a asp-controller="Ingredientes"
               asp-action="Index"
               class="home-module">

                <div class="home-module-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M12 3c-3 3-6 6.5-6 10a6 6 0 0 0 12 0c0-3.5-3-7-6-10Z" />
                        <path d="M9 15c.5 1.3 1.5 2 3 2" />

                    </svg>

                </div>

                <h3 class="home-module-title">
                    Ingredientes
                </h3>

                <p class="home-module-description">
                    Controla las existencias, cantidades disponibles
                    y niveles mínimos del inventario.
                </p>

                <span class="home-module-action">

                    Administrar ingredientes

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M5 12h14" />
                        <path d="m13 6 6 6-6 6" />

                    </svg>

                </span>

            </a>

        </div>


        <!-- =====================================================
             INFORMACIÓN
             ===================================================== -->

        <div class="home-info">

            <div class="home-info-card">

                <div class="home-info-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M4 19V5" />
                        <path d="M4 19h16" />
                        <path d="M7 16v-5" />
                        <path d="M11 16V8" />
                        <path d="M15 16v-9" />
                        <path d="M19 16V4" />

                    </svg>

                </div>

                <div>

                    <p class="home-info-title">
                        Gestión organizada
                    </p>

                    <p class="home-info-text">
                        Toda la información centralizada.
                    </p>

                </div>

            </div>


            <div class="home-info-card">

                <div class="home-info-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M12 3v18" />
                        <path d="M17 7c0-2-2-4-5-4s-5 2-5 4 2 3 5 4 5 2 5 4-2 4-5 4-5-2-5-4" />

                    </svg>

                </div>

                <div>

                    <p class="home-info-title">
                        Control del restaurante
                    </p>

                    <p class="home-info-text">
                        Información clara y accesible.
                    </p>

                </div>

            </div>


            <div class="home-info-card">

                <div class="home-info-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M12 3a9 9 0 1 0 9 9" />
                        <path d="M12 7v5l3 2" />
                        <path d="M16 3h5v5" />

                    </svg>

                </div>

                <div>

                    <p class="home-info-title">
                        Trabajo eficiente
                    </p>

                    <p class="home-info-text">
                        Menos tiempo buscando información.
                    </p>

                </div>

            </div>

        </div>

    </section>

</div>
```
