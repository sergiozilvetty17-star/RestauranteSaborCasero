@{

    ViewData["Title"] = "Inicio";

}

<style>

    /* =========================================================
       INICIO - SABOR CASERO
       DARK RED / ELEGANTE
       ========================================================= */

    .home-page {
        width: 100%;
    }


    /* =========================================================
       HERO
       ========================================================= */

    .home-hero {

        position: relative;

        min-height: 300px;

        display: flex;

        align-items: center;

        justify-content: space-between;

        padding: 45px 50px;

        background:
            radial-gradient(
                circle at 85% 20%,
                rgba(157, 45, 58, 0.22),
                transparent 32%
            ),
            linear-gradient(
                135deg,
                #35171d 0%,
                #521923 48%,
                #681f2a 100%
            );

        border:
            1px solid
            rgba(185, 93, 104, 0.20);

        border-radius: 20px;

        overflow: hidden;

        box-shadow:
            0 18px 45px
            rgba(0, 0, 0, 0.38);
    }

    .home-hero::before {

        content: "";

        position: absolute;

        width: 430px;
        height: 430px;

        right: -130px;
        top: -190px;

        border-radius: 50%;

        background:
            rgba(255, 255, 255, 0.035);

        border:
            1px solid
            rgba(255,255,255,0.025);
    }

    .home-hero::after {

        content: "";

        position: absolute;

        width: 280px;
        height: 280px;

        right: 190px;
        bottom: -205px;

        border-radius: 50%;

        background:
            rgba(184, 137, 69, 0.09);
    }


    .home-hero-content {

        position: relative;

        z-index: 2;

        max-width: 720px;
    }


    /* =========================================================
       EYEBROW
       ========================================================= */

    .home-eyebrow {

        display: inline-flex;

        align-items: center;

        gap: 9px;

        margin-bottom: 14px;

        color:
            #d8ae68;

        font-size:
            0.75rem;

        font-weight:
            800;

        letter-spacing:
            1.6px;

        text-transform:
            uppercase;
    }

    .home-eyebrow-dot {

        width: 7px;
        height: 7px;

        border-radius: 50%;

        background:
            #c7964f;

        box-shadow:
            0 0 0 4px
            rgba(199, 150, 79, 0.13);
    }


    /* =========================================================
       TITULO
       ========================================================= */

    .home-title {

        margin: 0;

        color:
            #ffffff;

        font-size:
            3rem;

        font-weight:
            800;

        letter-spacing:
            -1.6px;

        line-height:
            1.05;

        text-shadow:
            0 4px 20px
            rgba(0,0,0,0.20);
    }


    .home-description {

        margin:
            18px 0 0;

        max-width:
            600px;

        color:
            rgba(255,255,255,0.72);

        font-size:
            1.05rem;

        line-height:
            1.7;
    }


    /* =========================================================
       HERO ICON
       ========================================================= */

    .home-hero-icon {

        position: relative;

        z-index: 2;

        width: 150px;
        height: 150px;

        display: flex;

        align-items: center;

        justify-content: center;

        margin-right: 35px;

        border-radius: 50%;

        background:
            rgba(255,255,255,0.055);

        border:
            1px solid
            rgba(255,255,255,0.12);

        box-shadow:
            inset 0 0 40px
            rgba(255,255,255,0.025),

            0 15px 35px
            rgba(0,0,0,0.20);
    }

    .home-hero-icon::before {

        content: "";

        position: absolute;

        inset: 11px;

        border-radius: 50%;

        border:
            1px solid
            rgba(184,137,69,0.18);
    }

    .home-hero-icon svg {

        position: relative;

        width: 72px;
        height: 72px;

        color:
            #f1e6dd;

        stroke:
            currentColor;

        filter:
            drop-shadow(
                0 4px 10px
                rgba(0,0,0,0.25)
            );
    }


    /* =========================================================
       SECTION HEADER
       ========================================================= */

    .home-section {

        margin-top:
            38px;
    }

    .home-section-header {

        display:
            flex;

        align-items:
            flex-end;

        justify-content:
            space-between;

        margin-bottom:
            18px;
    }

    .home-section-title {

        margin:
            0;

        color:
            #eee7e1;

        font-size:
            1.35rem;

        font-weight:
            800;

        letter-spacing:
            -0.3px;
    }

    .home-section-subtitle {

        margin:
            5px 0 0;

        color:
            #918881;

        font-size:
            0.86rem;
    }


    /* =========================================================
       MODULE CARDS
       ========================================================= */

    .home-modules {

        display:
            grid;

        grid-template-columns:
            repeat(3, 1fr);

        gap:
            20px;
    }

    .home-module {

        position:
            relative;

        display:
            flex;

        flex-direction:
            column;

        min-height:
            245px;

        padding:
            25px;

        background:
            linear-gradient(
                145deg,
                #282321,
                #201d1b
            );

        border:
            1px solid
            #3b3430;

        border-radius:
            16px;

        box-shadow:
            0 9px 28px
            rgba(0,0,0,0.27);

        text-decoration:
            none;

        overflow:
            hidden;

        transition:
            transform 0.22s ease,
            box-shadow 0.22s ease,
            border-color 0.22s ease,
            background 0.22s ease;
    }

    .home-module:hover {

        color:
            inherit;

        text-decoration:
            none;

        transform:
            translateY(-5px);

        border-color:
            #5b4541;

        background:
            linear-gradient(
                145deg,
                #2d2725,
                #241f1d
            );

        box-shadow:
            0 18px 40px
            rgba(0,0,0,0.38);
    }

    .home-module::before {

        content: "";

        position:
            absolute;

        left:
            0;

        top:
            0;

        width:
            100%;

        height:
            3px;

        background:
            linear-gradient(
                90deg,
                #641b26,
                #9b3442,
                #641b26
            );

        opacity:
            0.65;
    }

    .home-module::after {

        content:
            "";

        position:
            absolute;

        right:
            -45px;

        bottom:
            -65px;

        width:
            170px;

        height:
            170px;

        border-radius:
            50%;

        background:
            rgba(122,31,43,0.12);

        opacity:
            0;

        transition:
            opacity 0.22s ease;
    }

    .home-module:hover::after {

        opacity:
            1;
    }


    /* =========================================================
       MODULE ICON
       ========================================================= */

    .home-module-icon {

        position:
            relative;

        z-index:
            2;

        width:
            52px;

        height:
            52px;

        display:
            flex;

        align-items:
            center;

        justify-content:
            center;

        margin-bottom:
            20px;

        border-radius:
            13px;

        background:
            #351b20;

        border:
            1px solid
            rgba(155,45,58,0.20);

        color:
            #c96b76;

        transition:
            background 0.22s ease,
            color 0.22s ease,
            transform 0.22s ease,
            box-shadow 0.22s ease;
    }

    .home-module:hover .home-module-icon {

        background:
            linear-gradient(
                135deg,
                #8a2836,
                #641b26
            );

        color:
            #ffffff;

        transform:
            scale(1.05);

        box-shadow:
            0 8px 20px
            rgba(122,31,43,0.30);
    }

    .home-module-icon svg {

        width:
            25px;

        height:
            25px;

        stroke:
            currentColor;
    }


    /* =========================================================
       MODULE CONTENT
       ========================================================= */

    .home-module-title {

        position:
            relative;

        z-index:
            2;

        margin:
            0 0 8px;

        color:
            #eee7e1;

        font-size:
            1.08rem;

        font-weight:
            800;
    }

    .home-module-description {

        position:
            relative;

        z-index:
            2;

        margin:
            0;

        color:
            #918881;

        font-size:
            0.87rem;

        line-height:
            1.6;
    }


    /* =========================================================
       MODULE LINK
       ========================================================= */

    .home-module-action {

        position:
            relative;

        z-index:
            2;

        display:
            flex;

        align-items:
            center;

        gap:
            7px;

        margin-top:
            auto;

        padding-top:
            22px;

        color:
            #c56b76;

        font-size:
            0.82rem;

        font-weight:
            800;

        transition:
            color 0.2s ease;
    }

    .home-module:hover .home-module-action {

        color:
            #df8992;
    }

    .home-module-action svg {

        width:
            16px;

        height:
            16px;

        transition:
            transform 0.2s ease;
    }

    .home-module:hover .home-module-action svg {

        transform:
            translateX(4px);
    }


    /* =========================================================
       INFORMATION STRIP
       ========================================================= */

    .home-info {

        display:
            grid;

        grid-template-columns:
            1fr 1fr 1fr;

        gap:
            20px;

        margin-top:
            20px;
    }

    .home-info-card {

        display:
            flex;

        align-items:
            center;

        gap:
            15px;

        padding:
            18px 20px;

        background:
            linear-gradient(
                145deg,
                #25211f,
                #1f1c1a
            );

        border:
            1px solid
            #39332f;

        border-radius:
            13px;

        box-shadow:
            0 6px 20px
            rgba(0,0,0,0.18);

        transition:
            border-color 0.2s ease,
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .home-info-card:hover {

        border-color:
            #4d403a;

        transform:
            translateY(-2px);

        box-shadow:
            0 10px 25px
            rgba(0,0,0,0.25);
    }


    /* =========================================================
       INFORMATION ICON
       ========================================================= */

    .home-info-icon {

        width:
            42px;

        height:
            42px;

        display:
            flex;

        align-items:
            center;

        justify-content:
            center;

        flex-shrink:
            0;

        border-radius:
            10px;

        background:
            #30271e;

        border:
            1px solid
            rgba(184,137,69,0.16);

        color:
            #c99b58;
    }

    .home-info-icon svg {

        width:
            21px;

        height:
            21px;

        stroke:
            currentColor;
    }


    /* =========================================================
       INFORMATION TEXT
       ========================================================= */

    .home-info-title {

        margin:
            0 0 3px;

        color:
            #ddd5cf;

        font-size:
            0.84rem;

        font-weight:
            800;
    }

    .home-info-text {

        margin:
            0;

        color:
            #827a74;

        font-size:
            0.76rem;
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 1100px) {

        .home-hero {

            padding:
                40px;
        }

        .home-hero-icon {

            margin-right:
                10px;
        }

        .home-modules {

            grid-template-columns:
                repeat(2, 1fr);
        }

        .home-info {

            grid-template-columns:
                repeat(2, 1fr);
        }
    }


    @@media (max-width: 768px) {

        .home-hero {

            min-height:
                330px;

            padding:
                35px 30px;
        }

        .home-hero-icon {

            display:
                none;
        }

        .home-title {

            font-size:
                2.5rem;
        }

        .home-description {

            font-size:
                0.96rem;
        }

        .home-modules {

            grid-template-columns:
                1fr;
        }

        .home-info {

            grid-template-columns:
                1fr;
        }
    }


    @@media (max-width: 576px) {

        .home-hero {

            min-height:
                320px;

            padding:
                30px 25px;

            border-radius:
                16px;
        }

        .home-title {

            font-size:
                2.15rem;

            letter-spacing:
                -1px;
        }

        .home-description {

            margin-top:
                15px;

            font-size:
                0.9rem;

            line-height:
                1.6;
        }

        .home-section {

            margin-top:
                30px;
        }

        .home-section-title {

            font-size:
                1.2rem;
        }

        .home-module {

            min-height:
                225px;

            padding:
                22px;
        }

        .home-info-card {

            padding:
                16px;
        }
    }

</style>


<div class="home-page">

    <!-- =====================================================
         HERO
         ===================================================== -->

    <section class="home-hero">

        <div class="home-hero-content">

            <div class="home-eyebrow">

                <span class="home-eyebrow-dot"></span>

                Sistema de gestión

            </div>

            <h1 class="home-title">

                Bienvenido a<br />

                Sabor Casero

            </h1>

            <p class="home-description">

                Administra de manera sencilla y organizada los platos,
                mesas e ingredientes de tu restaurante desde un solo lugar.

            </p>

        </div>


        <div class="home-hero-icon">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.5"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <path d="M6 3v7" />

                <path d="M4 3v7a2 2 0 0 0 4 0V3" />

                <path d="M6 12v9" />

                <path d="M14 3v18" />

                <path d="M14 3c3 1 4 3.2 4 6v1h-4" />

            </svg>

        </div>

    </section>


    <!-- =====================================================
         MÓDULOS
         ===================================================== -->

    <section class="home-section">

        <div class="home-section-header">

            <div>

                <h2 class="home-section-title">

                    Accesos rápidos

                </h2>

                <p class="home-section-subtitle">

                    Accede rápidamente a las principales áreas del restaurante.

                </p>

            </div>

        </div>


        <div class="home-modules">


            <!-- PLATOS -->

            <a asp-controller="Platos"
               asp-action="Index"
               class="home-module">

                <div class="home-module-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <circle cx="12" cy="12" r="8" />

                        <path d="M4 12h16" />

                        <path d="M12 4c2.5 2 3.5 4.5 3.5 8s-1 6-3.5 8" />

                        <path d="M12 4c-2.5 2-3.5 4.5-3.5 8s1 6 3.5 8" />

                    </svg>

                </div>

                <h3 class="home-module-title">

                    Platos

                </h3>

                <p class="home-module-description">

                    Administra el menú, precios, disponibilidad
                    y tiempos estimados de preparación.

                </p>

                <span class="home-module-action">

                    Administrar platos

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M5 12h14" />

                        <path d="m13 6 6 6-6 6" />

                    </svg>

                </span>

            </a>


            <!-- MESAS -->

            <a asp-controller="Mesas"
               asp-action="Index"
               class="home-module">

                <div class="home-module-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <rect x="4"
                              y="7"
                              width="16"
                              height="8"
                              rx="2" />

                        <path d="M7 15v5" />

                        <path d="M17 15v5" />

                        <path d="M3 7h18" />

                    </svg>

                </div>

                <h3 class="home-module-title">

                    Mesas

                </h3>

                <p class="home-module-description">

                    Consulta y administra las mesas del restaurante
                    y su disponibilidad.

                </p>

                <span class="home-module-action">

                    Administrar mesas

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M5 12h14" />

                        <path d="m13 6 6 6-6 6" />

                    </svg>

                </span>

            </a>


            <!-- INGREDIENTES -->

            <a asp-controller="Ingredientes"
               asp-action="Index"
               class="home-module">

                <div class="home-module-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M12 3c-3 3-6 6.5-6 10a6 6 0 0 0 12 0c0-3.5-3-7-6-10Z" />

                        <path d="M9 15c.5 1.3 1.5 2 3 2" />

                    </svg>

                </div>

                <h3 class="home-module-title">

                    Ingredientes

                </h3>

                <p class="home-module-description">

                    Controla las existencias, cantidades disponibles
                    y niveles mínimos del inventario.

                </p>

                <span class="home-module-action">

                    Administrar ingredientes

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M5 12h14" />

                        <path d="m13 6 6 6-6 6" />

                    </svg>

                </span>

            </a>

        </div>


        <!-- =====================================================
             INFORMACIÓN
             ===================================================== -->

        <div class="home-info">


            <div class="home-info-card">

                <div class="home-info-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M4 19V5" />

                        <path d="M4 19h16" />

                        <path d="M7 16v-5" />

                        <path d="M11 16V8" />

                        <path d="M15 16v-9" />

                        <path d="M19 16V4" />

                    </svg>

                </div>

                <div>

                    <p class="home-info-title">

                        Gestión organizada

                    </p>

                    <p class="home-info-text">

                        Toda la información centralizada.

                    </p>

                </div>

            </div>


            <div class="home-info-card">

                <div class="home-info-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M12 3v18" />

                        <path d="M17 7c0-2-2-4-5-4s-5 2-5 4 2 3 5 4 5 2 5 4-2 4-5 4-5-2-5-4" />

                    </svg>

                </div>

                <div>

                    <p class="home-info-title">

                        Control del restaurante

                    </p>

                    <p class="home-info-text">

                        Información clara y accesible.

                    </p>

                </div>

            </div>


            <div class="home-info-card">

                <div class="home-info-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M12 3a9 9 0 1 0 9 9" />

                        <path d="M12 7v5l3 2" />

                        <path d="M16 3h5v5" />

                    </svg>

                </div>

                <div>

                    <p class="home-info-title">

                        Trabajo eficiente

                    </p>

                    <p class="home-info-text">

                        Menos tiempo buscando información.

                    </p>

                </div>

            </div>

        </div>

    </section>

</div>