@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center py-5">
    <h1 class="display-4">Sabor Casero</h1>

    <p class="lead mt-3">
        Sistema de gestión para restaurante
    </p>

    <div class="row justify-content-center mt-5 g-4">

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <h3>🍽 Platos</h3>
                    <p>Administra los platos del restaurante.</p>
                    <a asp-controller="Platos"
                       asp-action="Index"
                       class="btn btn-primary">
                        Ver Platos
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <h3>🪑 Mesas</h3>
                    <p>Administra las mesas del restaurante.</p>
                    <a asp-controller="Mesas"
                       asp-action="Index"
                       class="btn btn-primary">
                        Ver Mesas
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <h3>🥕 Ingredientes</h3>
                    <p>Administra los ingredientes disponibles.</p>
                    <a asp-controller="Ingredientes"
                       asp-action="Index"
                       class="btn btn-primary">
                        Ver Ingredientes
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>