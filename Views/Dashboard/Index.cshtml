@{
    ViewData["Title"] = "Panel de Administrador";
}

<div class="container mt-4">

    <h2 class="mb-4">Resumen del Restaurante</h2>

    <div class="row">

        <div class="col-md-3">
            <div class="card text-white bg-primary mb-3">
                <div class="card-body">
                    <h5 class="card-title">Pedidos Pendientes</h5>
                    <h2 class="card-text">@ViewBag.PedidosPendientes</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-success mb-3">
                <div class="card-body">
                    <h5 class="card-title">Mesas Disponibles</h5>
                    <h2 class="card-text">@ViewBag.MesasDisponibles</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-danger mb-3">
                <div class="card-body">
                    <h5 class="card-title">Alertas Inventario</h5>
                    <h2 class="card-text">@ViewBag.AlertasInventario</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-info mb-3">
                <div class="card-body">
                    <h5 class="card-title">Empleados Activos</h5>
                    <h2 class="card-text">@ViewBag.EmpleadosActivos</h2>
                </div>
            </div>
        </div>

    </div>

    <div class="row">

        <div class="col-md-3">
            <div class="card mb-3">
                <div class="card-body">
                    <h5>Total Usuarios</h5>
                    <h3>@ViewBag.TotalUsuarios</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card mb-3">
                <div class="card-body">
                    <h5>Total Mesas</h5>
                    <h3>@ViewBag.TotalMesas</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card mb-3">
                <div class="card-body">
                    <h5>Total Platos</h5>
                    <h3>@ViewBag.TotalPlatos</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card mb-3">
                <div class="card-body">
                    <h5>Total Ingredientes</h5>
                    <h3>@ViewBag.TotalIngredientes</h3>
                </div>
            </div>
        </div>

    </div>

    <div class="row">

        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-body">
                    <h5>Total Pedidos</h5>
                    <h3>@ViewBag.TotalPedidos</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-body">
                    <h5>Pedidos en Preparación</h5>
                    <h3>@ViewBag.PedidosEnPreparacion</h3>
                </div>
            </div>
        </div>

    </div>

</div>