<script>

    function mostrarFechasPersonalizadas() {

        const periodo =
            document.getElementById("periodo");

        const customDates =
            document.getElementById("customDates");

        if (periodo.value === "personalizado") {

            customDates.classList.add("visible");

        } else {

            customDates.classList.remove("visible");

        }
    }

    document.addEventListener("DOMContentLoaded", function () {

        mostrarFechasPersonalizadas();

    });

</script>
