@model RestauranteSaborCasero.Models.Inventario

@{
    ViewData["Title"] = "Registrar movimiento";
}

<style>
    .inventario-container {
        padding: 30px;
    }

    .inventario-header {
        margin-bottom: 25px;
    }

    .inventario-titulo {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
        color: #2c2c2c;
    }

    .inventario-subtitulo {
        margin: 6px 0 0;
        color: #777;
        font-size: 15px;
    }

    .movimiento-card {
        width: 600px;
        background-color: white;
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        padding: 30px;
    }

    .tipo-ayuda {
        display: flex;
        gap: 10px;
        margin-bottom: 25px;
    }

    .tipo-entrada,
    .tipo-salida {
        flex: 1;
        padding: 12px;
        border-radius: 7px;
        text-align: center;
        font-size: 13px;
        font-weight: 600;
    }

    .tipo-entrada {
        background-color: #d1e7dd;
        color: #0f5132;
    }

    .tipo-salida {
        background-color: #f8d7da;
        color: #842029;
    }

    .campo {
        margin-bottom: 20px;
    }

        .campo label {
            display: block;
            margin-bottom: 7px;
            font-size: 14px;
            font-weight: 600;
            color: #333;
        }

        .campo select,
        .campo input {
            width: 100%;
            box-sizing: border-box;
            padding: 12px;
            border: 1px solid #ced4da;
            border-radius: 7px;
            background-color: white;
            color: #333;
            font-size: 15px;
        }

            .campo select:focus,
            .campo input:focus {
                outline: none;
                border-color: #198754;
                box-shadow: 0 0 0 2px rgba(25, 135, 84, 0.12);
            }

    .ayuda {
        display: block;
        margin-top: 6px;
        color: #888;
        font-size: 12px;
    }

    .validation {
        display: block;
        margin-top: 5px;
        color: #dc3545;
        font-size: 13px;
    }

    .validation-summary {
        background-color: #f8d7da;
        border: 1px solid #f1aeb5;
        color: #842029;
        border-radius: 7px;
        padding: 12px 15px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .acciones {
        display: flex;
        gap: 10px;
        align-items: center;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #eeeeee;
    }

    .btn-guardar {
        border: none;
        background-color: #198754;
        color: white;
        padding: 12px 22px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-guardar:hover {
            background-color: #157347;
        }

    .btn-volver {
        background-color: #6c757d;
        color: white;
        text-decoration: none;
        padding: 12px 22px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
    }

        .btn-volver:hover {
            background-color: #5c636a;
            color: white;
        }
</style>


<div class="inventario-container">

    <!-- ENCABEZADO -->
    <div class="inventario-header">

        <h1 class="inventario-titulo">
            Registrar movimiento
        </h1>

        <p class="inventario-subtitulo">
            Agrega o descuenta una cantidad del inventario
        </p>

    </div>


    <!-- FORMULARIO -->
    <div class="movimiento-card">

        <div class="tipo-ayuda">

            <div class="tipo-entrada">
                ENTRADA<br />
                <small>Agrega stock</small>
            </div>

            <div class="tipo-salida">
                SALIDA<br />
                <small>Reduce stock</small>
            </div>

        </div>


        <form asp-action="Create"
              method="post">

            <!-- VALIDACIONES -->
            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>


            <!-- INGREDIENTE -->
            <div class="campo">

                <label asp-for="IdIngrediente">
                    ¿Qué ingrediente?
                </label>

                <select asp-for="IdIngrediente"
                        asp-items="ViewBag.IdIngrediente">

                    <option value="">
                        Seleccione un ingrediente
                    </option>

                </select>

                <span class="ayuda">
                    Selecciona el ingrediente que tendrá el movimiento.
                </span>

                <span asp-validation-for="IdIngrediente"
                      class="validation">
                </span>

            </div>


            <!-- TIPO -->
            <div class="campo">

                <label asp-for="TipoMovimiento">
                    ¿Qué quieres hacer?
                </label>

                <select asp-for="TipoMovimiento"
                        asp-items="Html.GetEnumSelectList<RestauranteSaborCasero.Models.TipoMovimientoInventario>()">
                </select>

                <span class="ayuda">
                    Entrada aumenta el inventario. Salida lo disminuye.
                </span>

                <span asp-validation-for="TipoMovimiento"
                      class="validation">
                </span>

            </div>


            <!-- CANTIDAD -->
            <div class="campo">

                <label asp-for="Cantidad">
                    ¿Cuánto?
                </label>

                <input asp-for="Cantidad"
                       type="number"
                       step="0.01"
                       min="0.01"
                       placeholder="Ejemplo: 5" />

                <span class="ayuda">
                    Introduce solamente la cantidad del movimiento.
                </span>

                <span asp-validation-for="Cantidad"
                      class="validation">
                </span>

            </div>


            <!-- MOTIVO -->
            <div class="campo">

                <label asp-for="Motivo">
                    Motivo
                </label>

                <input asp-for="Motivo"
                       type="text"
                       maxlength="255"
                       placeholder="Ejemplo: Compra de ingredientes" />

                <span class="ayuda">
                    Explica brevemente por qué se realizó el movimiento.
                </span>

                <span asp-validation-for="Motivo"
                      class="validation">
                </span>

            </div>


            <!-- ACCIONES -->
            <div class="acciones">

                <button type="submit"
                        class="btn-guardar">
                    Registrar movimiento
                </button>

                <a asp-action="Index"
                   class="btn-volver">
                    Volver
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

