@model RestauranteSaborCasero.Models.Inventario

@{
    ViewData["Title"] = "Detalles del movimiento";
}

<style>
    /* =========================================================
           VARIABLES DE TEMA (Dashboard - Sabor Casero)
           ========================================================= */
    :root {
        --sc-primary: #8d3024;
        --sc-primary-dark: #7d2b21;
        --sc-primary-soft: #f9f2f0;
        --sc-dark: #3c2c27;
        --sc-gray: #756b65;
        --sc-border: #eee8e3;
        --sc-bg-panel: #ffffff;
        --sc-shadow: 0 8px 24px rgba(49, 31, 25, .07);
        --sc-success: #198754;
        --sc-success-bg: #e3f2eb;
        --sc-danger: #dc3545;
        --sc-danger-bg: #fdf3f2;
    }

    .sc-page-container {
        width: 100%;
        max-width: 750px;
        padding-top: 12px;
        color: var(--sc-dark);
    }

    /* =========================================================
           ENCABEZADO
           ========================================================= */
    .sc-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 25px;
    }

    .sc-header-icon {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--sc-primary-soft);
        border-radius: 12px;
        color: var(--sc-primary);
    }

        .sc-header-icon svg {
            width: 24px;
            height: 24px;
            stroke: currentColor;
        }

    .sc-eyebrow {
        margin: 0 0 4px;
        color: var(--sc-primary);
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 1.2px;
        text-transform: uppercase;
    }

    .sc-title {
        margin: 0;
        color: var(--sc-dark);
        font-size: 2rem;
        font-weight: 900;
        letter-spacing: -0.5px;
        line-height: 1.1;
    }

    .sc-description {
        margin: 6px 0 0;
        color: var(--sc-gray);
        font-size: 0.85rem;
        font-weight: 600;
    }

    /* =========================================================
           TARJETA (PANEL)
           ========================================================= */
    .sc-panel {
        background: var(--sc-bg-panel);
        border: 1px solid var(--sc-border);
        border-radius: 16px;
        box-shadow: var(--sc-shadow);
        overflow: hidden;
        margin-bottom: 25px;
    }

    .sc-panel-header {
        padding: 20px 24px;
        background: #faf8f6;
        border-bottom: 1px solid var(--sc-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .sc-panel-title {
        margin: 0;
        color: var(--sc-dark);
        font-size: 1.15rem;
        font-weight: 900;
    }

    .sc-panel-subtitle {
        margin: 4px 0 0;
        color: var(--sc-gray);
        font-size: 0.75rem;
        font-weight: 600;
    }

    .sc-panel-body {
        padding: 0;
    }

    /* =========================================================
           HERO DEL INGREDIENTE AFECTADO
           ========================================================= */
    .sc-ingredient-banner {
        padding: 20px 24px;
        background: linear-gradient(135deg, #2b1d19, #4a221b);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .sc-ingredient-banner-info small {
        display: block;
        color: #e9c77f;
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 4px;
    }

    .sc-ingredient-banner-info strong {
        font-size: 1.35rem;
        font-weight: 900;
        color: #ffffff;
    }

    /* =========================================================
           LISTA DE DATOS
           ========================================================= */
    .sc-data-list {
        display: flex;
        flex-direction: column;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .sc-data-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 24px;
        border-bottom: 1px solid var(--sc-border);
    }

        .sc-data-item:last-child {
            border-bottom: none;
        }

    .sc-data-label {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--sc-gray);
        font-size: 0.85rem;
        font-weight: 700;
    }

        .sc-data-label svg {
            width: 17px;
            height: 17px;
            color: #a3968f;
        }

    .sc-data-value {
        color: var(--sc-dark);
        font-size: 0.95rem;
        font-weight: 800;
        text-align: right;
    }

    .sc-motivo {
        max-width: 380px;
        line-height: 1.4;
        font-weight: 600;
        color: #4a3b35;
    }

    .sc-sin-dato {
        color: #a3968f;
        font-style: italic;
        font-weight: 500;
    }

    /* =========================================================
           BADGES & ESTILOS DE MOVIMIENTO
           ========================================================= */
    .sc-badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .sc-badge-entrada {
        background-color: var(--sc-success-bg);
        color: var(--sc-success);
    }

    .sc-badge-salida {
        background-color: var(--sc-danger-bg);
        color: var(--sc-danger);
    }

    .sc-stock-badge {
        display: inline-flex;
        align-items: center;
        padding: 5px 12px;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 900;
    }

    .sc-stock-available {
        background: var(--sc-success-bg);
        color: var(--sc-success);
    }

    .sc-stock-minimum {
        background: var(--sc-danger-bg);
        color: var(--sc-danger);
    }

    /* =========================================================
           BOTONES Y ACCIONES
           ========================================================= */
    .sc-actions {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
    }

    .sc-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 44px;
        padding: 0 22px;
        border-radius: 10px;
        font-size: 0.85rem;
        font-weight: 800;
        text-decoration: none;
        transition: all 0.2s ease;
        border: 1px solid transparent;
        cursor: pointer;
    }

        .sc-btn svg {
            width: 18px;
            height: 18px;
            stroke: currentColor;
        }

    .sc-btn-secondary {
        background-color: #f3f0ed;
        color: #665d57;
        border-color: #e5ddd6;
    }

        .sc-btn-secondary:hover {
            background-color: #e9e3de;
            color: var(--sc-dark);
            transform: translateY(-2px);
        }
</style>

<div class="sc-page-container">

    <!-- ENCABEZADO -->
    <div class="sc-header">
        <div class="sc-header-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3v18" />
                <path d="M4 9h16" />
                <rect x="3" y="14" width="4" height="7" />
                <rect x="10" y="9" width="4" height="12" />
                <rect x="17" y="5" width="4" height="16" />
            </svg>
        </div>
        <div>
            <p class="sc-eyebrow">Auditoría de Almacén</p>
            <h1 class="sc-title">Detalles del movimiento</h1>
            <p class="sc-description">Información detallada del movimiento registrado en el inventario.</p>
        </div>
    </div>

    <!-- TARJETA PRINCIPAL DEL MOVIMIENTO -->
    <div class="sc-panel">

        <div class="sc-panel-header">
            <div>
                <h2 class="sc-panel-title">Movimiento #@Model.IdInventario</h2>
                <p class="sc-panel-subtitle">Registro de trazabilidad</p>
            </div>
            <div>
                @if (Model.TipoMovimiento.ToString().ToLower().Contains("entrada"))
                {
                    <span class="sc-badge sc-badge-entrada">
                        <span style="display: inline-block; width: 6px; height: 6px; background: currentColor; border-radius: 50%; margin-right: 6px;"></span>
                        @Model.TipoMovimiento
                    </span>
                }
                else
                {
                    <span class="sc-badge sc-badge-salida">
                        <span style="display: inline-block; width: 6px; height: 6px; background: currentColor; border-radius: 50%; margin-right: 6px;"></span>
                        @Model.TipoMovimiento
                    </span>
                }
            </div>
        </div>

        <!-- BANNER DEL INGREDIENTE -->
        <div class="sc-ingredient-banner">
            <div class="sc-ingredient-banner-info">
                <small>Ingrediente afectado</small>
                <strong>@Model.Ingrediente.Nombre</strong>
            </div>
            <div style="opacity: 0.3;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width: 38px; height: 38px;">
                    <path d="M6 8l6-3 6 3v8l-6 3-6-3V8" />
                    <path d="M12 11v7" />
                    <path d="M6 11l6 3 6-3" />
                </svg>
            </div>
        </div>

        <div class="sc-panel-body">
            <ul class="sc-data-list">

                <!-- TIPO -->
                <li class="sc-data-item">
                    <span class="sc-data-label">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="17 1 21 5 17 9" />
                            <path d="M3 11V9a4 4 0 0 1 4-4h14" />
                            <polyline points="7 23 3 19 7 15" />
                            <path d="M21 13v2a4 4 0 0 1-4 4H3" />
                        </svg>
                        Tipo de operación
                    </span>
                    <span class="sc-data-value">
                        @if (Model.TipoMovimiento.ToString().ToLower().Contains("entrada"))
                        {
                            <span style="color: var(--sc-success);">Entrada al almacén</span>
                        }
                        else
                        {
                            <span style="color: var(--sc-danger);">Salida de almacén</span>
                        }
                    </span>
                </li>

                <!-- CANTIDAD -->
                <li class="sc-data-item">
                    <span class="sc-data-label">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19" />
                            <line x1="5" y1="12" x2="19" y2="12" />
                        </svg>
                        Cantidad procesada
                    </span>
                    <span class="sc-data-value" style="font-size: 1.15rem; color: var(--sc-primary); font-weight: 900;">
                        @Model.Cantidad @Model.Ingrediente.UnidadMedida
                    </span>
                </li>

                <!-- UNIDAD -->
                <li class="sc-data-item">
                    <span class="sc-data-label">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="4" y1="21" x2="4" y2="14" />
                            <line x1="4" y1="10" x2="4" y2="3" />
                            <line x1="12" y1="21" x2="12" y2="12" />
                            <line x1="12" y1="8" x2="12" y2="3" />
                            <line x1="20" y1="21" x2="20" y2="16" />
                            <line x1="20" y1="12" x2="20" y2="3" />
                            <line x1="1" y1="14" x2="7" y2="14" />
                            <line x1="9" y1="8" x2="15" y2="8" />
                            <line x1="17" y1="16" x2="23" y2="16" />
                        </svg>
                        Unidad de medida
                    </span>
                    <span class="sc-data-value">
                        @Model.Ingrediente.UnidadMedida
                    </span>
                </li>

                <!-- FECHA -->
                <li class="sc-data-item">
                    <span class="sc-data-label">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                            <line x1="16" y1="2" x2="16" y2="6" />
                            <line x1="8" y1="2" x2="8" y2="6" />
                            <line x1="3" y1="10" x2="21" y2="10" />
                        </svg>
                        Fecha y hora
                    </span>
                    <span class="sc-data-value">
                        @Model.Fecha.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </li>

                <!-- MOTIVO -->
                <li class="sc-data-item">
                    <span class="sc-data-label">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <polyline points="14 2 14 8 20 8" />
                            <line x1="16" y1="13" x2="8" y2="13" />
                            <line x1="16" y1="17" x2="8" y2="17" />
                        </svg>
                        Motivo
                    </span>
                    <span class="sc-data-value sc-motivo">
                        @if (string.IsNullOrEmpty(Model.Motivo))
                        {
                            <span class="sc-sin-dato">Sin motivo registrado</span>
                        }
                        else
                        {
                            @Model.Motivo
                        }
                    </span>
                </li>

            </ul>
        </div>

    </div>

    <!-- TARJETA: ESTADO ACTUAL DEL INGREDIENTE -->
    <div class="sc-panel">

        <div class="sc-panel-header">
            <div>
                <h2 class="sc-panel-title">Estado actual del insumo</h2>
                <p class="sc-panel-subtitle">Niveles de stock vigentes tras este movimiento</p>
            </div>
            <div class="sc-header-icon" style="width: 40px; height: 40px; background: #ffffff; border: 1px solid var(--sc-border);">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width: 20px; height: 20px; color: var(--sc-gray);">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                </svg>
            </div>
        </div>

        <div class="sc-panel-body">
            <ul class="sc-data-list">

                <!-- STOCK ACTUAL -->
                <li class="sc-data-item">
                    <span class="sc-data-label">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 6L9 17l-5-5" />
                        </svg>
                        Stock disponible actual
                    </span>
                    <span class="sc-stock-badge sc-stock-available">
                        @Model.Ingrediente.CantidadDisponible @Model.Ingrediente.UnidadMedida
                    </span>
                </li>

                <!-- MÍNIMO -->
                <li class="sc-data-item">
                    <span class="sc-data-label">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2L2 18h20L12 2M12 10v4M12 16h0.01" />
                        </svg>
                        Stock mínimo permitido
                    </span>
                    <span class="sc-stock-badge sc-stock-minimum">
                        @Model.Ingrediente.CantidadMinima @Model.Ingrediente.UnidadMedida
                    </span>
                </li>

                <!-- ESTADO -->
                <li class="sc-data-item">
                    <span class="sc-data-label">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <polyline points="12 6 12 12 16 14" />
                        </svg>
                        Condición del insumo
                    </span>
                    <span class="sc-badge" style="background-color: #f3f0ed; color: #5f534d;">
                        <span style="display: inline-block; width: 6px; height: 6px; background: currentColor; border-radius: 50%; margin-right: 6px;"></span>
                        @Model.Ingrediente.Estado
                    </span>
                </li>

            </ul>
        </div>

    </div>

    <!-- ACCIONES -->
    <div class="sc-actions">
        <a asp-action="Index" class="sc-btn sc-btn-secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12" />
                <polyline points="12 19 5 12 12 5" />
            </svg>
            Volver al inventario
        </a>
    </div>

</div>