
@model RestauranteSaborCasero.Models.Inventario

@{
    ViewData["Title"] = "Detalles del movimiento";
}

<style>
    .movimiento-detalles-container {
        padding: 30px;
    }

    .movimiento-header {
        margin-bottom: 25px;
    }

    .movimiento-titulo {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
        color: #2c2c2c;
    }

    .movimiento-subtitulo {
        margin: 6px 0 0;
        color: #777;
        font-size: 15px;
    }

    .movimiento-card {
        width: 650px;
        background-color: white;
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        padding: 30px;
        margin-bottom: 25px;
    }

    .movimiento-identificacion {
        font-size: 22px;
        font-weight: 700;
        color: #343a40;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid #eeeeee;
    }

    .ingrediente-principal {
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
    }

        .ingrediente-principal small {
            display: block;
            color: #777;
            font-size: 12px;
            margin-bottom: 4px;
        }

        .ingrediente-principal strong {
            color: #343a40;
            font-size: 19px;
        }

    .informacion {
        border: 1px solid #eeeeee;
        border-radius: 8px;
        overflow: hidden;
    }

    .dato {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 15px;
        border-bottom: 1px solid #eeeeee;
    }

        .dato:last-child {
            border-bottom: none;
        }

    .dato-titulo {
        color: #777;
        font-size: 14px;
        font-weight: 600;
    }

    .dato-valor {
        color: #333;
        font-size: 14px;
        font-weight: 600;
        text-align: right;
    }

    .entrada {
        display: inline-block;
        background-color: #d1e7dd;
        color: #0f5132;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .salida {
        display: inline-block;
        background-color: #f8d7da;
        color: #842029;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .cantidad {
        font-size: 18px;
        font-weight: 700;
        color: #198754;
    }

    .stock {
        font-size: 17px;
        font-weight: 700;
        color: #343a40;
    }

    .minimo {
        font-weight: 700;
        color: #dc3545;
    }

    .motivo {
        color: #555;
        max-width: 350px;
    }

    .sin-dato {
        color: #999;
        font-style: italic;
        font-weight: 400;
    }

    .estado {
        display: inline-block;
        background-color: #d1e7dd;
        color: #0f5132;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .acciones {
        display: flex;
        gap: 10px;
    }

    .btn-volver {
        display: inline-block;
        background-color: #6c757d;
        color: white;
        text-decoration: none;
        padding: 11px 20px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
    }

        .btn-volver:hover {
            background-color: #5c636a;
            color: white;
        }
</style>


<div class="movimiento-detalles-container">

    <!-- ENCABEZADO -->
    <div class="movimiento-header">

        <h1 class="movimiento-titulo">
            Detalles del movimiento
        </h1>

        <p class="movimiento-subtitulo">
            Información del movimiento realizado en el inventario
        </p>

    </div>


    <!-- TARJETA -->
    <div class="movimiento-card">

        <div class="movimiento-identificacion">
            Movimiento #@Model.IdInventario
        </div>


        <!-- INGREDIENTE -->
        <div class="ingrediente-principal">

            <small>
                Ingrediente afectado
            </small>

            <strong>
                @Model.Ingrediente.Nombre
            </strong>

        </div>


        <!-- INFORMACIÓN -->
        <div class="informacion">

            <!-- TIPO -->
            <div class="dato">

                <span class="dato-titulo">
                    Tipo de movimiento
                </span>

                <span class="dato-valor">

                    @if (Model.TipoMovimiento.ToString().ToLower().Contains("entrada"))
                    {
                        <span class="entrada">
                            @Model.TipoMovimiento
                        </span>
                    }
                    else
                    {
                        <span class="salida">
                            @Model.TipoMovimiento
                        </span>
                    }

                </span>

            </div>


            <!-- CANTIDAD -->
            <div class="dato">

                <span class="dato-titulo">
                    Cantidad del movimiento
                </span>

                <span class="dato-valor cantidad">
                    @Model.Cantidad
                    @Model.Ingrediente.UnidadMedida
                </span>

            </div>


            <!-- UNIDAD -->
            <div class="dato">

                <span class="dato-titulo">
                    Unidad de medida
                </span>

                <span class="dato-valor">
                    @Model.Ingrediente.UnidadMedida
                </span>

            </div>


            <!-- FECHA -->
            <div class="dato">

                <span class="dato-titulo">
                    Fecha y hora
                </span>

                <span class="dato-valor">
                    @Model.Fecha.ToString("dd/MM/yyyy HH:mm")
                </span>

            </div>


            <!-- MOTIVO -->
            <div class="dato">

                <span class="dato-titulo">
                    Motivo
                </span>

                <span class="dato-valor motivo">

                    @if (string.IsNullOrEmpty(Model.Motivo))
                    {
                        <span class="sin-dato">
                            Sin motivo registrado
                        </span>
                    }
                    else
                    {
                        @Model.Motivo
                    }

                </span>

            </div>

        </div>

    </div>


    <!-- ESTADO ACTUAL -->
    <div class="movimiento-card">

        <div class="movimiento-identificacion">
            Estado actual del ingrediente
        </div>


        <div class="informacion">

            <!-- STOCK ACTUAL -->
            <div class="dato">

                <span class="dato-titulo">
                    Cantidad disponible
                </span>

                <span class="dato-valor stock">
                    @Model.Ingrediente.CantidadDisponible
                    @Model.Ingrediente.UnidadMedida
                </span>

            </div>


            <!-- MÍNIMO -->
            <div class="dato">

                <span class="dato-titulo">
                    Cantidad mínima
                </span>

                <span class="dato-valor minimo">
                    @Model.Ingrediente.CantidadMinima
                    @Model.Ingrediente.UnidadMedida
                </span>

            </div>


            <!-- ESTADO -->
            <div class="dato">

                <span class="dato-titulo">
                    Estado
                </span>

                <span class="estado">
                    @Model.Ingrediente.Estado
                </span>

            </div>

        </div>

    </div>


    <!-- ACCIONES -->
    <div class="acciones">

        <a asp-action="Index"
           class="btn-volver">
            Volver al inventario
        </a>

    </div>

</div>

