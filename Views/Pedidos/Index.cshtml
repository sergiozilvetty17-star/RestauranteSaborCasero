@model IEnumerable<RestauranteSaborCasero.Models.Pedido>

@{
    ViewData["Title"] = "Pedidos";
}

<style>
    .pedidos-container {
        padding: 30px;
    }

    .pedidos-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .pedidos-titulo {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
        color: #2c2c2c;
    }

    .pedidos-subtitulo {
        margin: 6px 0 0;
        color: #777;
        font-size: 15px;
    }

    .btn-nuevo {
        background-color: #198754;
        color: white;
        text-decoration: none;
        padding: 14px 22px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 16px;
    }

        .btn-nuevo:hover {
            background-color: #157347;
            color: white;
        }

    /* ==========================================
           TARJETAS DE PEDIDOS
           ========================================== */

    .pedidos-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
        gap: 20px;
    }

    .pedido-card {
        background: white;
        border: 1px solid #e1e1e1;
        border-radius: 12px;
        padding: 22px;
    }

        .pedido-card:hover {
            border-color: #c8c8c8;
        }

    /* ==========================================
           CABECERA DEL PEDIDO
           ========================================== */

    .pedido-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

    .pedido-numero {
        font-size: 24px;
        font-weight: 800;
        color: #343a40;
    }

    /* ==========================================
           INFORMACIÓN
           ========================================== */

    .pedido-info {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .info-item {
        background-color: #f1f3f5;
        padding: 9px 13px;
        border-radius: 7px;
        font-size: 14px;
        color: #444;
        font-weight: 600;
    }

    /* ==========================================
           ESTADOS
           ========================================== */

    .estado {
        display: inline-block;
        padding: 9px 14px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 700;
    }

    .estado-pendiente {
        background-color: #fff3cd;
        color: #856404;
    }

    .estado-proceso {
        background-color: #cfe2ff;
        color: #084298;
    }

    .estado-listo {
        background-color: #cff4fc;
        color: #055160;
    }

    .estado-entregado {
        background-color: #d1e7dd;
        color: #0f5132;
    }

    .estado-cancelado {
        background-color: #f8d7da;
        color: #842029;
    }

    /* ==========================================
           PLATOS
           ========================================== */

    .platos-titulo {
        font-size: 16px;
        font-weight: 700;
        color: #343a40;
        margin-bottom: 10px;
    }

    .plato {
        padding: 12px 0;
        border-bottom: 1px solid #eeeeee;
    }

        .plato:last-child {
            border-bottom: none;
        }

    .plato-nombre {
        font-size: 16px;
        font-weight: 700;
        color: #333;
    }

    .plato-cantidad {
        color: #198754;
        font-weight: 800;
        margin-right: 6px;
    }

    /* ==========================================
           INDICACIONES
           ========================================== */

    .indicacion {
        margin-top: 6px;
        padding: 8px 10px;
        background-color: #fff8e1;
        border-left: 4px solid #ffc107;
        border-radius: 4px;
        font-size: 14px;
        color: #5f5100;
    }

        .indicacion strong {
            color: #443b00;
        }

    /* ==========================================
           ACCIONES GRANDES
           ========================================== */

    .acciones {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 22px;
    }

    .btn-estado-grande,
    .btn-cancelar-grande {
        min-height: 65px;
        border: none;
        border-radius: 10px;
        font-size: 17px;
        font-weight: 800;
        cursor: pointer;
        padding: 12px;
    }

    .btn-estado-grande {
        background-color: #198754;
        color: white;
    }

        .btn-estado-grande:hover {
            background-color: #157347;
        }

    .btn-cancelar-grande {
        background-color: #dc3545;
        color: white;
    }

        .btn-cancelar-grande:hover {
            background-color: #bb2d3b;
        }

    /* ==========================================
           PEDIDO FINALIZADO
           ========================================== */

    .pedido-finalizado {
        margin-top: 20px;
        padding: 14px;
        text-align: center;
        border-radius: 8px;
        background-color: #f1f3f5;
        color: #666;
        font-weight: 600;
    }

    /* ==========================================
           SIN PEDIDOS
           ========================================== */

    .tabla-vacia {
        background-color: white;
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        text-align: center;
        padding: 50px;
        color: #777;
        font-size: 17px;
    }

    /* ==========================================
           RESPONSIVE
           ========================================== */

    @@media (max-width: 700px) {

        .pedidos-container {
            padding: 15px;
        }

        .pedidos-header {
            flex-direction: column;
            align-items: stretch;
            gap: 15px;
        }

        .btn-nuevo {
            text-align: center;
        }

        .pedidos-grid {
            grid-template-columns: 1fr;
        }

        .acciones {
            grid-template-columns: 1fr;
        }

        .btn-estado-grande,
        .btn-cancelar-grande {
            min-height: 70px;
        }
    }
</style>

<div class="pedidos-container">

    <!-- ==========================================
     ENCABEZADO
     ========================================== -->

    <div class="pedidos-header">

        <div>

            <h1 class="pedidos-titulo">
                Pedidos
            </h1>

            <p class="pedidos-subtitulo">
                Gestiona los pedidos del restaurante
            </p>

        </div>

        <a asp-action="Create" class="btn-nuevo">
            + Nuevo pedido
        </a>

    </div>


    <!-- ==========================================
     PEDIDOS
     ========================================== -->
    @if (Model != null && Model.Any())
    {
        <div class="pedidos-grid">

            @foreach (var pedido in Model)
            {
                <div class="pedido-card">

                    <!-- CABECERA -->

                    <div class="pedido-header">

                        <span class="pedido-numero">
                            Pedido #@pedido.IdPedido
                        </span>


                        @switch (pedido.Estado)
                        {
                            case EstadoPedido.Pendiente:

                                <span class="estado estado-pendiente">
                                    Pendiente
                                </span>

                                break;

                            case EstadoPedido.EnPreparacion:

                                <span class="estado estado-proceso">
                                    En preparación
                                </span>

                                break;

                            case EstadoPedido.Listo:

                                <span class="estado estado-listo">
                                    Listo
                                </span>

                                break;

                            case EstadoPedido.Entregado:

                                <span class="estado estado-entregado">
                                    Entregado
                                </span>

                                break;

                            case EstadoPedido.Cancelado:

                                <span class="estado estado-cancelado">
                                    Cancelado
                                </span>

                                break;
                        }

                    </div>


                    <!-- INFORMACIÓN -->

                    <div class="pedido-info">

                        @if (pedido.Mesa != null)
                        {
                            <div class="info-item">
                                Mesa @pedido.Mesa.NumeroMesa
                            </div>
                        }
                        else
                        {
                            <div class="info-item">
                                Para llevar
                            </div>
                        }


                        <div class="info-item">
                            Mesero: @(pedido.Usuario?.Nombre ?? "Sin asignar")
                        </div>

                    </div>


                    <!-- PLATOS -->

                    <div class="platos-titulo">
                        Platos
                    </div>

                    @if (pedido.Detalles != null && pedido.Detalles.Any())
                    {
                        foreach (var detalle in pedido.Detalles)
                        {
                            <div class="plato">

                                <div class="plato-nombre">

                                    <span class="plato-cantidad">
                                        @detalle.Cantidad x
                                    </span>

                                    @(detalle.Plato?.Nombre ?? "Plato no disponible")

                                </div>


                                @if (!string.IsNullOrWhiteSpace(detalle.IndicacionesExtra))
                                {
                                    <div class="indicacion">

                                        <strong>
                                            Indicaciones:
                                        </strong>

                                        @detalle.IndicacionesExtra

                                    </div>
                                }

                            </div>
                        }
                    }
                    else
                    {
                        <div class="plato">
                            No hay platos registrados.
                        </div>
                    }


                    <!-- ==================================
                     ACCIONES
                     ================================== -->
                    @if (pedido.Estado == EstadoPedido.Pendiente)
                    {
                        <div class="acciones">

                            <form asp-action="CambiarEstado"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@pedido.IdPedido" />

                                <input type="hidden"
                                       name="nuevoEstado"
                                       value="EnPreparacion" />

                                <button type="submit"
                                        class="btn-estado-grande">

                                    ▶ Iniciar preparación

                                </button>

                            </form>


                            <form asp-action="CambiarEstado"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@pedido.IdPedido" />

                                <input type="hidden"
                                       name="nuevoEstado"
                                       value="Cancelado" />

                                <button type="submit"
                                        class="btn-cancelar-grande">

                                    ✕ Cancelar pedido

                                </button>

                            </form>

                        </div>
                    }


                    @if (pedido.Estado == EstadoPedido.EnPreparacion)
                    {
                        <div class="acciones">

                            <form asp-action="CambiarEstado"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@pedido.IdPedido" />

                                <input type="hidden"
                                       name="nuevoEstado"
                                       value="Listo" />

                                <button type="submit"
                                        class="btn-estado-grande">

                                    ✓ Marcar como listo

                                </button>

                            </form>


                            <form asp-action="CambiarEstado"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@pedido.IdPedido" />

                                <input type="hidden"
                                       name="nuevoEstado"
                                       value="Cancelado" />

                                <button type="submit"
                                        class="btn-cancelar-grande">

                                    ✕ Cancelar pedido

                                </button>

                            </form>

                        </div>
                    }


                    @if (pedido.Estado == EstadoPedido.Listo)
                    {
                        <div class="acciones">

                            <form asp-action="CambiarEstado"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@pedido.IdPedido" />

                                <input type="hidden"
                                       name="nuevoEstado"
                                       value="Entregado" />

                                <button type="submit"
                                        class="btn-estado-grande">

                                    ✓ Entregar pedido

                                </button>

                            </form>


                            <form asp-action="CambiarEstado"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@pedido.IdPedido" />

                                <input type="hidden"
                                       name="nuevoEstado"
                                       value="Cancelado" />

                                <button type="submit"
                                        class="btn-cancelar-grande">

                                    ✕ Cancelar pedido

                                </button>

                            </form>

                        </div>
                    }


                    @if (pedido.Estado == EstadoPedido.Entregado)
                    {
                        <div class="pedido-finalizado">
                            ✓ Pedido entregado
                        </div>
                    }


                    @if (pedido.Estado == EstadoPedido.Cancelado)
                    {
                        <div class="pedido-finalizado">
                            ✕ Pedido cancelado
                        </div>
                    }

                </div>
            }

        </div>
    }
    else
    {
        <div class="tabla-vacia">
            No hay pedidos registrados.
        </div>
    }

</div>
<!-- ========================================================= -->
<!-- SIGNALR - ACTUALIZACIÓN DE PEDIDOS EN TIEMPO REAL -->
<!-- ========================================================= -->

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

<script>

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/pedidosHub")
        .withAutomaticReconnect()
        .build();


    // =========================================================
    // CUANDO CUALQUIER USUARIO MODIFICA UN PEDIDO
    // =========================================================

    connection.on("PedidosActualizados", function () {

        console.log("🔄 Se detectó una actualización de pedidos.");

        window.location.reload();

    });


    // =========================================================
    // RECONEXIÓN
    // =========================================================

    connection.onreconnecting(function () {

        console.log(
            "⚠️ SignalR intentando reconectar..."
        );

    });


    connection.onreconnected(function () {

        console.log(
            "✅ SignalR reconectado correctamente."
        );

    });


    connection.onclose(function () {

        console.log(
            "❌ SignalR desconectado."
        );

    });


    // =========================================================
    // INICIAR CONEXIÓN
    // =========================================================

    async function iniciarSignalR() {

        try {

            await connection.start();

            console.log(
                "✅ SignalR conectado correctamente."
            );

        }
        catch (error) {

            console.error(
                "❌ Error al conectar SignalR:",
                error
            );

            // Intentar nuevamente después de 5 segundos

            setTimeout(
                iniciarSignalR,
                5000
            );

        }

    }


    iniciarSignalR();

</script>