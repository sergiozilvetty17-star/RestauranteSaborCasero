@model IEnumerable<RestauranteSaborCasero.Models.Pedido>

@{
    ViewData["Title"] = "Pedidos";
}

<style>
    /* =========================================================
       PEDIDOS - SABOR CASERO
       ========================================================= */

    .pedidos-container {
        padding: 30px;
    }

    /* =========================================================
       ENCABEZADO
       ========================================================= */

    .pedidos-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .pedidos-titulo {
        margin: 0;
        font-size: 30px;
        font-weight: 800;
        color: #3a211c;
        letter-spacing: -0.5px;
    }

    .pedidos-subtitulo {
        margin: 6px 0 0;
        color: #766a66;
        font-size: 15px;
    }

    .btn-nuevo {
        background-color: #7a2e24;
        color: white;
        text-decoration: none;
        padding: 14px 22px;
        border-radius: 9px;
        font-weight: 700;
        font-size: 16px;
        border: 1px solid #68251d;
        box-shadow: 0 5px 14px rgba(104, 37, 29, 0.18);
        transition: all 0.2s ease;
    }

    .btn-nuevo:hover {
        background-color: #5f241c;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 8px 18px rgba(104, 37, 29, 0.24);
    }

    /* =========================================================
       TARJETAS DE PEDIDOS
       ========================================================= */

    .pedidos-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
        gap: 20px;
    }

    .pedido-card {
        position: relative;
        border-radius: 14px;
        padding: 22px;
        overflow: hidden;

        border: 1px solid;
        box-shadow: 0 7px 20px rgba(50, 35, 30, 0.08);

        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease,
            border-color 0.2s ease;
    }

    .pedido-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 13px 30px rgba(50, 35, 30, 0.13);
    }

    /* =========================================================
       FONDOS SEGÚN ESTADO DEL PEDIDO
       ========================================================= */

    /* PENDIENTE - Amarillo cálido */
.pedido-card.estado-pedido-pendiente {
    background: #f8e7a8;
    border-color: #d6b84c;
}

/* EN PREPARACIÓN - Azul más marcado */
.pedido-card.estado-pedido-preparacion {
    background: #c9dcf5;
    border-color: #7fa6d5;
}

/* LISTO - Cian más marcado */
.pedido-card.estado-pedido-listo {
    background: #bfe5eb;
    border-color: #6fb8c5;
}

/* ENTREGADO - Verde más marcado */
.pedido-card.estado-pedido-entregado {
    background: #c5e2ce;
    border-color: #79b58b;
}

/* CANCELADO - Rojo rosado */
.pedido-card.estado-pedido-cancelado {
    background: #edc4c8;
    border-color: #c77b84;
}

    /* =========================================================
       CABECERA DEL PEDIDO
       ========================================================= */

    .pedido-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 18px;
    }

    .pedido-numero {
        font-size: 24px;
        font-weight: 800;
        color: #3a211c;
    }

    /* =========================================================
       INFORMACIÓN
       ========================================================= */

    .pedido-info {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .info-item {
        background-color: rgba(255, 255, 255, 0.65);
        border: 1px solid rgba(100, 80, 70, 0.12);
        padding: 9px 13px;
        border-radius: 7px;
        font-size: 14px;
        color: #4d403b;
        font-weight: 600;
    }

    /* =========================================================
       ESTADOS
       ========================================================= */

    .estado {
        display: inline-block;
        padding: 9px 14px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 700;
        white-space: nowrap;
    }

    .estado-pendiente {
        background-color: #fff3cd;
        color: #856404;
    }

    .estado-proceso {
        background-color: #cfe2ff;
        color: #084298;
    }

    .estado-listo {
        background-color: #cff4fc;
        color: #055160;
    }

    .estado-entregado {
        background-color: #d1e7dd;
        color: #0f5132;
    }

    .estado-cancelado {
        background-color: #f8d7da;
        color: #842029;
    }

    /* =========================================================
       PLATOS
       ========================================================= */

    .platos-titulo {
        font-size: 16px;
        font-weight: 800;
        color: #3a211c;
        margin-bottom: 10px;
    }

    .plato {
        padding: 12px 0;
        border-bottom: 1px solid rgba(90, 70, 60, 0.14);
    }

    .plato:last-child {
        border-bottom: none;
    }

    .plato-nombre {
        font-size: 16px;
        font-weight: 700;
        color: #3f3430;
    }

    .plato-cantidad {
        color: #7a2e24;
        font-weight: 800;
        margin-right: 6px;
    }

    /* =========================================================
       INDICACIONES
       ========================================================= */

    .indicacion {
        margin-top: 6px;
        padding: 8px 10px;
        background-color: rgba(255, 248, 225, 0.90);
        border-left: 4px solid #d69b45;
        border-radius: 4px;
        font-size: 14px;
        color: #5f5100;
    }

    .indicacion strong {
        color: #443b00;
    }

    /* =========================================================
       ACCIONES GRANDES
       ========================================================= */

    .acciones {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 22px;
    }

    .btn-estado-grande,
    .btn-cancelar-grande {
        min-height: 65px;
        border: none;
        border-radius: 10px;
        font-size: 17px;
        font-weight: 800;
        cursor: pointer;
        padding: 12px;
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .btn-estado-grande {
        background-color: #7a2e24;
        color: white;
        box-shadow: 0 5px 12px rgba(122, 46, 36, 0.18);
    }

    .btn-estado-grande:hover {
        background-color: #60231c;
        transform: translateY(-2px);
        box-shadow: 0 8px 17px rgba(122, 46, 36, 0.25);
    }

    .btn-cancelar-grande {
        background-color: #9e3038;
        color: white;
        box-shadow: 0 5px 12px rgba(158, 48, 56, 0.15);
    }

    .btn-cancelar-grande:hover {
        background-color: #81262e;
        transform: translateY(-2px);
        box-shadow: 0 8px 17px rgba(158, 48, 56, 0.23);
    }

    /* =========================================================
       PEDIDO FINALIZADO
       ========================================================= */

    .pedido-finalizado {
        margin-top: 20px;
        padding: 14px;
        text-align: center;
        border-radius: 8px;
        background-color: rgba(255, 255, 255, 0.55);
        border: 1px solid rgba(80, 70, 60, 0.12);
        color: #665d59;
        font-weight: 700;
    }

    /* =========================================================
       SIN PEDIDOS
       ========================================================= */

    .tabla-vacia {
        background-color: #f8f3ef;
        border: 1px solid #dfd3ca;
        border-radius: 12px;
        text-align: center;
        padding: 50px;
        color: #776b65;
        font-size: 17px;
        box-shadow: 0 6px 18px rgba(50, 35, 30, 0.06);
    }

    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 700px) {

        .pedidos-container {
            padding: 15px;
        }

        .pedidos-header {
            flex-direction: column;
            align-items: stretch;
            gap: 15px;
        }

        .btn-nuevo {
            text-align: center;
        }

        .pedidos-grid {
            grid-template-columns: 1fr;
        }

        .pedido-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .acciones {
            grid-template-columns: 1fr;
        }

        .btn-estado-grande,
        .btn-cancelar-grande {
            min-height: 70px;
        }
    }
</style>

<div class="pedidos-container">

    <!-- ==========================================
         ENCABEZADO
         ========================================== -->

    <div class="pedidos-header">

        <div>

            <h1 class="pedidos-titulo">
                Pedidos
            </h1>

            <p class="pedidos-subtitulo">
                Gestiona los pedidos del restaurante
            </p>

        </div>

        <a asp-action="Create" class="btn-nuevo">
            + Nuevo pedido
        </a>

    </div>


    <!-- ==========================================
         PEDIDOS
         ========================================== -->

    @if (Model != null && Model.Any())
    {
        <div class="pedidos-grid">

            @foreach (var pedido in Model)
            {
                <!-- ==========================================
                     TARJETA DEL PEDIDO
                     EL COLOR DEPENDE DEL ESTADO
                     ========================================== -->

                <div class="pedido-card
                    @(pedido.Estado == EstadoPedido.Pendiente ? "estado-pedido-pendiente" :
                      pedido.Estado == EstadoPedido.EnPreparacion ? "estado-pedido-preparacion" :
                      pedido.Estado == EstadoPedido.Listo ? "estado-pedido-listo" :
                      pedido.Estado == EstadoPedido.Entregado ? "estado-pedido-entregado" :
                      pedido.Estado == EstadoPedido.Cancelado ? "estado-pedido-cancelado" : "")">

                    <!-- CABECERA -->

                    <div class="pedido-header">

                        <span class="pedido-numero">
                            Pedido #@pedido.IdPedido
                        </span>

                        @switch (pedido.Estado)
                        {
                            case EstadoPedido.Pendiente:

                                <span class="estado estado-pendiente">
                                    Pendiente
                                </span>

                                break;

                            case EstadoPedido.EnPreparacion:

                                <span class="estado estado-proceso">
                                    En preparación
                                </span>

                                break;

                            case EstadoPedido.Listo:

                                <span class="estado estado-listo">
                                    Listo
                                </span>

                                break;

                            case EstadoPedido.Entregado:

                                <span class="estado estado-entregado">
                                    Entregado
                                </span>

                                break;

                            case EstadoPedido.Cancelado:

                                <span class="estado estado-cancelado">
                                    Cancelado
                                </span>

                                break;
                        }

                    </div>


                    <!-- INFORMACIÓN -->

                    <div class="pedido-info">

                        @if (pedido.Mesa != null)
                        {
                            <div class="info-item">
                                Mesa @pedido.Mesa.NumeroMesa
                            </div>
                        }
                        else
                        {
                            <div class="info-item">
                                Para llevar
                            </div>
                        }

                        <div class="info-item">
                            Mesero: @(pedido.Usuario?.Nombre ?? "Sin asignar")
                        </div>

                    </div>


                    <!-- PLATOS -->

                    <div class="platos-titulo">
                        Platos
                    </div>

                    @if (pedido.Detalles != null && pedido.Detalles.Any())
                    {
                        foreach (var detalle in pedido.Detalles)
                        {
                            <div class="plato">

                                <div class="plato-nombre">

                                    <span class="plato-cantidad">
                                        @detalle.Cantidad x
                                    </span>

                                    @(detalle.Plato?.Nombre ?? "Plato no disponible")

                                </div>


                                @if (!string.IsNullOrWhiteSpace(detalle.IndicacionesExtra))
                                {
                                    <div class="indicacion">

                                        <strong>
                                            Indicaciones:
                                        </strong>

                                        @detalle.IndicacionesExtra

                                    </div>
                                }

                            </div>
                        }
                    }
                    else
                    {
                        <div class="plato">
                            No hay platos registrados.
                        </div>
                    }


                    <!-- ==========================================
                         ACCIONES - PEDIDO PENDIENTE
                         ========================================== -->

                    @if (pedido.Estado == EstadoPedido.Pendiente)
                    {
                        <div class="acciones">

                            <form asp-action="CambiarEstado"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@pedido.IdPedido" />

                                <input type="hidden"
                                       name="nuevoEstado"
                                       value="EnPreparacion" />

                                <button type="submit"
                                        class="btn-estado-grande">

                                    ▶ Iniciar preparación

                                </button>

                            </form>


                            <form asp-action="CambiarEstado"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@pedido.IdPedido" />

                                <input type="hidden"
                                       name="nuevoEstado"
                                       value="Cancelado" />

                                <button type="submit"
                                        class="btn-cancelar-grande">

                                    ✕ Cancelar pedido

                                </button>

                            </form>

                        </div>
                    }


                    <!-- ==========================================
                         ACCIONES - EN PREPARACIÓN
                         ========================================== -->

                    @if (pedido.Estado == EstadoPedido.EnPreparacion)
                    {
                        <div class="acciones">

                            <form asp-action="CambiarEstado"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@pedido.IdPedido" />

                                <input type="hidden"
                                       name="nuevoEstado"
                                       value="Listo" />

                                <button type="submit"
                                        class="btn-estado-grande">

                                    ✓ Marcar como listo

                                </button>

                            </form>


                            <form asp-action="CambiarEstado"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@pedido.IdPedido" />

                                <input type="hidden"
                                       name="nuevoEstado"
                                       value="Cancelado" />

                                <button type="submit"
                                        class="btn-cancelar-grande">

                                    ✕ Cancelar pedido

                                </button>

                            </form>

                        </div>
                    }


                    <!-- ==========================================
                         ACCIONES - LISTO
                         ========================================== -->

                    @if (pedido.Estado == EstadoPedido.Listo)
                    {
                        <div class="acciones">

                            <form asp-action="CambiarEstado"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@pedido.IdPedido" />

                                <input type="hidden"
                                       name="nuevoEstado"
                                       value="Entregado" />

                                <button type="submit"
                                        class="btn-estado-grande">

                                    ✓ Entregar pedido

                                </button>

                            </form>


                            <form asp-action="CambiarEstado"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@pedido.IdPedido" />

                                <input type="hidden"
                                       name="nuevoEstado"
                                       value="Cancelado" />

                                <button type="submit"
                                        class="btn-cancelar-grande">

                                    ✕ Cancelar pedido

                                </button>

                            </form>

                        </div>
                    }


                    <!-- ==========================================
                         PEDIDO ENTREGADO
                         ========================================== -->

                    @if (pedido.Estado == EstadoPedido.Entregado)
                    {
                        <div class="pedido-finalizado">
                            ✓ Pedido entregado
                        </div>
                    }


                    <!-- ==========================================
                         PEDIDO CANCELADO
                         ========================================== -->

                    @if (pedido.Estado == EstadoPedido.Cancelado)
                    {
                        <div class="pedido-finalizado">
                            ✕ Pedido cancelado
                        </div>
                    }

                </div>
            }

        </div>
    }
    else
    {
        <div class="tabla-vacia">
            No hay pedidos registrados.
        </div>
    }

</div>


<!-- =========================================================
     SIGNALR - ACTUALIZACIÓN DE PEDIDOS EN TIEMPO REAL
     ========================================================= -->

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

<script>

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/pedidosHub")
        .withAutomaticReconnect()
        .build();


    // =========================================================
    // CUANDO CUALQUIER USUARIO MODIFICA UN PEDIDO
    // =========================================================

    connection.on("PedidosActualizados", function () {

        console.log("🔄 Se detectó una actualización de pedidos.");

        window.location.reload();

    });


    // =========================================================
    // RECONEXIÓN
    // =========================================================

    connection.onreconnecting(function () {

        console.log(
            "⚠️ SignalR intentando reconectar..."
        );

    });


    connection.onreconnected(function () {

        console.log(
            "✅ SignalR reconectado correctamente."
        );

    });


    connection.onclose(function () {

        console.log(
            "❌ SignalR desconectado."
        );

    });


    // =========================================================
    // INICIAR CONEXIÓN
    // =========================================================

    async function iniciarSignalR() {

        try {

            await connection.start();

            console.log(
                "✅ SignalR conectado correctamente."
            );

        }
        catch (error) {

            console.error(
                "❌ Error al conectar SignalR:",
                error
            );

            // Intentar nuevamente después de 5 segundos

            setTimeout(
                iniciarSignalR,
                5000
            );

        }

    }


    iniciarSignalR();

</script>