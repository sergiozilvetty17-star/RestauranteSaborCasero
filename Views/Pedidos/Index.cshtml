@model IEnumerable<RestauranteSaborCasero.Models.Pedido>

@{
    ViewData["Title"] = "Pedidos";
}

<style>
    .pedidos-container {
        padding: 30px;
    }

    .pedidos-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .pedidos-titulo {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
        color: #2c2c2c;
    }

    .pedidos-subtitulo {
        margin: 6px 0 0;
        color: #777;
        font-size: 15px;
    }

    .btn-nuevo {
        background-color: #198754;
        color: white;
        text-decoration: none;
        padding: 12px 20px;
        border-radius: 8px;
        font-weight: 600;
        display: inline-block;
    }

        .btn-nuevo:hover {
            background-color: #157347;
            color: white;
        }

    .tabla-contenedor {
        background: white;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid #e5e5e5;
    }

    .tabla-pedidos {
        width: 100%;
        border-collapse: collapse;
    }

        .tabla-pedidos thead {
            background-color: #343a40;
            color: white;
        }

        .tabla-pedidos th {
            padding: 15px;
            text-align: left;
            font-size: 14px;
            font-weight: 600;
        }

        .tabla-pedidos td {
            padding: 14px 15px;
            border-bottom: 1px solid #eeeeee;
            color: #444;
            vertical-align: middle;
        }

        .tabla-pedidos tbody tr:hover {
            background-color: #f8f9fa;
        }

    .pedido-id {
        font-weight: 700;
        color: #343a40;
    }

    .sin-mesa {
        color: #999;
        font-style: italic;
    }

    .estado {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .estado-pendiente {
        background-color: #fff3cd;
        color: #856404;
    }

    .estado-proceso {
        background-color: #cfe2ff;
        color: #084298;
    }

    .estado-finalizado {
        background-color: #d1e7dd;
        color: #0f5132;
    }

    .estado-cancelado {
        background-color: #f8d7da;
        color: #842029;
    }

    .acciones {
        display: flex;
        gap: 8px;
        white-space: nowrap;
    }

    .btn-accion {
        padding: 7px 12px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
    }

    .btn-detalles {
        background-color: #0d6efd;
        color: white;
    }

        .btn-detalles:hover {
            background-color: #0b5ed7;
            color: white;
        }

    .btn-editar {
        background-color: #ffc107;
        color: #212529;
    }

        .btn-editar:hover {
            background-color: #ffca2c;
            color: #212529;
        }

    .tabla-vacia {
        text-align: center;
        padding: 45px;
        color: #777;
        font-size: 16px;
    }
</style>

<div class="pedidos-container">

    <div class="pedidos-header">

        <div>
            <h1 class="pedidos-titulo">Pedidos</h1>

            <p class="pedidos-subtitulo">
                Consulta y administra los pedidos del restaurante
            </p>
        </div>

        <a asp-action="Create" class="btn-nuevo">
            + Nuevo pedido
        </a>

    </div>

    <div class="tabla-contenedor">

        <table class="tabla-pedidos">

            <thead>
                <tr>
                    <th>Pedido</th>
                    <th>Mesero</th>
                    <th>Mesa</th>
                    <th>Tipo</th>
                    <th>Fecha</th>
                    <th>Hora inicio</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    @foreach (var pedido in Model)
                    {
                        var estado = pedido.Estado.ToString().ToLower();

                        <tr>

                            <td>
                                <span class="pedido-id">
                                    #@pedido.IdPedido
                                </span>
                            </td>

                            <td>
                                @(pedido.Usuario != null
                                    ? pedido.Usuario.Nombre
                                    : "Sin mesero")
                            </td>

                            <td>
                                @if (pedido.Mesa != null)
                                {
                                    <strong>
                                        Mesa @pedido.Mesa.NumeroMesa
                                    </strong>
                                }
                                else
                                {
                                    <span class="sin-mesa">
                                        Sin mesa
                                    </span>
                                }
                            </td>

                            <td>
                                @pedido.TipoPedido
                            </td>

                            <td>
                                @pedido.Fecha.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @pedido.HoraInicio
                            </td>

                            <td>

                                @if (estado.Contains("pendiente"))
                                {
                                    <span class="estado estado-pendiente">
                                        @pedido.Estado
                                    </span>
                                }
                                else if (estado.Contains("proceso") ||
                                         estado.Contains("prepar"))
                                {
                                    <span class="estado estado-proceso">
                                        @pedido.Estado
                                    </span>
                                }
                                else if (estado.Contains("final") ||
                                         estado.Contains("complet"))
                                {
                                    <span class="estado estado-finalizado">
                                        @pedido.Estado
                                    </span>
                                }
                                else if (estado.Contains("cancel"))
                                {
                                    <span class="estado estado-cancelado">
                                        @pedido.Estado
                                    </span>
                                }
                                else
                                {
                                    <span class="estado estado-proceso">
                                        @pedido.Estado
                                    </span>
                                }

                            </td>

                            <td>

                                <div class="acciones">

                                    <a asp-action="Details"
                                       asp-route-id="@pedido.IdPedido"
                                       class="btn-accion btn-detalles">
                                        Ver detalles
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@pedido.IdPedido"
                                       class="btn-accion btn-editar">
                                        Editar
                                    </a>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="tabla-vacia">
                            No hay pedidos registrados.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
```
