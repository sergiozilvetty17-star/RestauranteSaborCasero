@model RestauranteSaborCasero.Models.Pedido

@{
    ViewData["Title"] = "Crear Pedido";
}

<style>
    .crear-pedido-container {
        padding: 30px;
    }

    .crear-pedido-header {
        margin-bottom: 25px;
    }

    .crear-pedido-titulo {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
        color: #2c2c2c;
    }

    .crear-pedido-subtitulo {
        margin: 6px 0 0;
        color: #777;
        font-size: 15px;
    }

    .crear-pedido-card {
        width: 850px;
        max-width: 100%;
        background-color: white;
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        padding: 30px;
    }

    .seccion {
        margin-bottom: 25px;
    }

    .seccion-titulo {
        font-size: 17px;
        font-weight: 700;
        color: #343a40;
        margin: 0 0 15px;
        padding-bottom: 10px;
        border-bottom: 1px solid #eeeeee;
    }

    .campo {
        margin-bottom: 18px;
    }

        .campo label {
            display: block;
            margin-bottom: 7px;
            font-weight: 600;
            color: #333;
        }

        .campo select,
        .campo input,
        .campo textarea {
            width: 100%;
            box-sizing: border-box;
            padding: 11px 12px;
            border: 1px solid #ced4da;
            border-radius: 7px;
            background-color: white;
            color: #333;
            font-size: 15px;
        }

            .campo select:focus,
            .campo input:focus,
            .campo textarea:focus {
                outline: none;
                border-color: #198754;
                box-shadow: 0 0 0 2px rgba(25, 135, 84, 0.12);
            }

    .campo-ayuda {
        display: block;
        margin-top: 5px;
        color: #888;
        font-size: 12px;
    }

    .campo-validation {
        display: block;
        margin-top: 5px;
        color: #dc3545;
        font-size: 13px;
    }

    .validation-summary {
        background-color: #f8d7da;
        border: 1px solid #f1aeb5;
        color: #842029;
        border-radius: 7px;
        padding: 12px 15px;
        margin-bottom: 20px;
    }

    /* ==========================================
           MESERO ACTUAL
           ========================================== */

    .mesero-actual {
        background-color: #f1f8f4;
        border: 1px solid #cfe8d8;
        border-radius: 8px;
        padding: 14px 16px;
        margin-bottom: 20px;
    }

    .mesero-actual-label {
        display: block;
        color: #6c757d;
        font-size: 12px;
        margin-bottom: 3px;
    }

    .mesero-actual-nombre {
        color: #198754;
        font-size: 17px;
        font-weight: 700;
    }

    /* ==========================================
           PLATOS
           ========================================== */

    .platos-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .btn-agregar-plato {
        border: none;
        background-color: #198754;
        color: white;
        padding: 9px 15px;
        border-radius: 7px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-agregar-plato:hover {
            background-color: #157347;
        }

    .platos-container {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .plato-row {
        display: grid;
        grid-template-columns: 1fr 100px 1fr 40px;
        gap: 10px;
        align-items: end;
        padding: 15px;
        background-color: #f8f9fa;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
    }

    .plato-campo label {
        display: block;
        margin-bottom: 6px;
        font-size: 13px;
        font-weight: 600;
        color: #444;
    }

    .plato-campo select,
    .plato-campo input {
        width: 100%;
        padding: 9px 10px;
        border: 1px solid #ced4da;
        border-radius: 6px;
        background-color: white;
        font-size: 14px;
        box-sizing: border-box;
    }

    .btn-eliminar-plato {
        width: 38px;
        height: 38px;
        border: none;
        border-radius: 6px;
        background-color: #dc3545;
        color: white;
        font-size: 18px;
        cursor: pointer;
    }

        .btn-eliminar-plato:hover {
            background-color: #bb2d3b;
        }

    .sin-platos {
        text-align: center;
        padding: 25px;
        border: 1px dashed #ced4da;
        border-radius: 8px;
        color: #777;
        font-size: 14px;
    }

    .acciones-form {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #eeeeee;
    }

    .btn-guardar {
        border: none;
        background-color: #198754;
        color: white;
        padding: 12px 22px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-guardar:hover {
            background-color: #157347;
        }

    .btn-volver {
        background-color: #6c757d;
        color: white;
        text-decoration: none;
        padding: 12px 22px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
    }

        .btn-volver:hover {
            background-color: #5c636a;
            color: white;
        }

        .crear-pedido-card {
            padding: 20px;
        }

        .plato-row {
            grid-template-columns: 1fr;
        }

        .btn-eliminar-plato {
            width: 100%;
        }

        .platos-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }
    }
</style>


<div class="crear-pedido-container">

    <!-- ==========================================
         ENCABEZADO
         ========================================== -->

    <div class="crear-pedido-header">

        <h1 class="crear-pedido-titulo">
            Crear nuevo pedido
        </h1>

        <p class="crear-pedido-subtitulo">
            Registra un nuevo pedido de manera rápida y sencilla
        </p>

    </div>


    <!-- ==========================================
         FORMULARIO
         ========================================== -->

    <div class="crear-pedido-card">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()


            <!-- ==========================================
                 ERRORES
                 ========================================== -->

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>


            <!-- ==========================================
                 INFORMACIÓN DEL PEDIDO
                 ========================================== -->

            <div class="seccion">

                <h2 class="seccion-titulo">
                    Información del pedido
                </h2>


                <!-- ==========================================
                     MESERO AUTOMÁTICO
                     ========================================== -->

                <div class="mesero-actual">

                    <span class="mesero-actual-label">
                        Mesero responsable
                    </span>

                    <span class="mesero-actual-nombre">
                        @(ViewData["NombreMesero"] ?? "Usuario actual")
                    </span>

                    <div class="campo-ayuda">
                        El mesero se asigna automáticamente según la cuenta que inició sesión.
                    </div>

                </div>


                <!-- ==========================================
                     TIPO DE PEDIDO
                     ========================================== -->

                <div class="campo">

                    <label asp-for="TipoPedido">
                        Tipo de pedido
                    </label>

                    <select asp-for="TipoPedido"
                            asp-items="Html.GetEnumSelectList<RestauranteSaborCasero.Models.TipoPedido>()">
                    </select>

                    <span class="campo-ayuda">
                        Selecciona si el pedido es para una mesa o para llevar.
                    </span>

                    <span asp-validation-for="TipoPedido"
                          class="campo-validation">
                    </span>

                </div>


                <!-- ==========================================
                     MESA
                     ========================================== -->

                <div class="campo">

                    <label asp-for="IdMesa">
                        Mesa
                    </label>

                    <select asp-for="IdMesa"
                            asp-items="ViewBag.IdMesa">

                        <option value="">
                            Sin mesa
                        </option>

                    </select>

                    <span class="campo-ayuda">
                        Si es un pedido para llevar, puedes dejarlo sin mesa.
                    </span>

                    <span asp-validation-for="IdMesa"
                          class="campo-validation">
                    </span>

                </div>

            </div>


            <!-- ==========================================
                 PLATOS
                 ========================================== -->

            <div class="seccion">

                <div class="platos-header">

                    <h2 class="seccion-titulo"
                        style="margin-bottom: 0; flex: 1;">
                        Platos del pedido
                    </h2>

                    <button type="button"
                            class="btn-agregar-plato"
                            onclick="agregarPlato()">
                        + Agregar plato
                    </button>

                </div>


                <div id="platos-container"
                     class="platos-container">

                    @if (Model?.Detalles != null &&
                         Model.Detalles.Count > 0)
                    {
                        var indice = 0;

                        foreach (var detalle in Model.Detalles)
                        {
                            <div class="plato-row">

                                <div class="plato-campo">

                                    <label>
                                        Plato
                                    </label>

                                    <select name="Detalles[@indice].IdPlato"
                                            required>

                                        <option value="">
                                            Seleccione un plato
                                        </option>

                                        @foreach (var plato in (IEnumerable<RestauranteSaborCasero.Models.Plato>)ViewBag.Platos)
                                        {
                                            if (plato.IdPlato == detalle.IdPlato)
                                            {
                                                <option value="@plato.IdPlato"
                                                        selected>
                                                    @plato.Nombre
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="@plato.IdPlato">
                                                    @plato.Nombre
                                                </option>
                                            }
                                        }

                                    </select>

                                </div>


                                <div class="plato-campo">

                                    <label>
                                        Cantidad
                                    </label>

                                    <input type="number"
                                           name="Detalles[@indice].Cantidad"
                                           value="@detalle.Cantidad"
                                           min="1"
                                           max="1000"
                                           required />

                                </div>


                                <div class="plato-campo">

                                    <label>
                                        Indicaciones
                                    </label>

                                    <input type="text"
                                           name="Detalles[@indice].IndicacionesExtra"
                                           value="@detalle.IndicacionesExtra"
                                           maxlength="255"
                                           placeholder="Ej: Sin cebolla" />

                                </div>


                                <button type="button"
                                        class="btn-eliminar-plato"
                                        onclick="eliminarPlato(this)">
                                    ×
                                </button>

                            </div>

                            indice++;
                        }
                    }
                    else
                    {
                        <div class="sin-platos"
                             id="mensaje-sin-platos">
                            No has agregado ningún plato.
                            <br />
                            Presiona <strong>+ Agregar plato</strong> para comenzar.
                        </div>
                    }

                </div>

            </div>


            <!-- ==========================================
                 FECHA Y HORA
                 ========================================== -->

            <div class="seccion">

                <h2 class="seccion-titulo">
                    Fecha y hora
                </h2>

                <div class="campo">

                    <label>
                        Fecha
                    </label>

                    <input type="text"
                           value="@DateTime.Now.ToString("dd/MM/yyyy")"
                           readonly />

                    <span class="campo-ayuda">
                        La fecha se registra automáticamente.
                    </span>

                </div>


                <div class="campo">

                    <label>
                        Hora de inicio
                    </label>

                    <input type="text"
                           value="@DateTime.Now.ToString("HH:mm")"
                           readonly />

                    <span class="campo-ayuda">
                        La hora se registra automáticamente al guardar el pedido.
                    </span>

                </div>

            </div>


            <!-- ==========================================
                 BOTONES
                 ========================================== -->

            <div class="acciones-form">

                <button type="submit"
                        class="btn-guardar">
                    Guardar pedido
                </button>

                <a asp-action="Index"
                   class="btn-volver">
                    Volver a pedidos
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        // ==========================================
        // CONTADOR DE PLATOS
        // ==========================================

        let indicePlato = @(Model?.Detalles?.Count ?? 0);


        // ==========================================
        // AGREGAR PLATO
        // ==========================================

        function agregarPlato() {

            const container =
                document.getElementById("platos-container");

            const mensaje =
                document.getElementById("mensaje-sin-platos");

            if (mensaje) {
                mensaje.remove();
            }


            const fila =
                document.createElement("div");

            fila.className = "plato-row";


            fila.innerHTML = `
                        <div class="plato-campo">

                            <label>
                                Plato
                            </label>

                            <select name="Detalles[${indicePlato}].IdPlato"
                                    required>

                                <option value="">
                                    Seleccione un plato
                                </option>

                                      @foreach (var plato in ViewBag.Platos as IEnumerable<RestauranteSaborCasero.Models.Plato>
                   ?? Enumerable.Empty<RestauranteSaborCasero.Models.Plato>())
        {
                <option value="@plato.IdPlato">
                        @plato.Nombre
                </option>
        }


                            </select>

                        </div>


                        <div class="plato-campo">

                            <label>
                                Cantidad
                            </label>

                            <input type="number"
                                   name="Detalles[${indicePlato}].Cantidad"
                                   value="1"
                                   min="1"
                                   max="1000"
                                   required />

                        </div>


                        <div class="plato-campo">

                            <label>
                                Indicaciones
                            </label>

                            <input type="text"
                                   name="Detalles[${indicePlato}].IndicacionesExtra"
                                   maxlength="255"
                                   placeholder="Ej: Sin cebolla" />

                        </div>


                        <button type="button"
                                class="btn-eliminar-plato"
                                onclick="eliminarPlato(this)">
                            ×
                        </button>
                    `;


            container.appendChild(fila);

            indicePlato++;
        }


        // ==========================================
        // ELIMINAR PLATO
        // ==========================================

        function eliminarPlato(boton) {

            const fila =
                boton.closest(".plato-row");

            if (fila) {
                fila.remove();
            }


            const filas =
                document.querySelectorAll(".plato-row");


            // Si ya no quedan platos,
            // mostramos el mensaje.

            if (filas.length === 0) {

                const container =
                    document.getElementById("platos-container");

                const mensaje =
                    document.createElement("div");

                mensaje.id = "mensaje-sin-platos";

                mensaje.className = "sin-platos";

                mensaje.innerHTML =
                    'No has agregado ningún plato.<br />' +
                    'Presiona <strong>+ Agregar plato</strong> para comenzar.';

                container.appendChild(mensaje);
            }
        }


        // ==========================================
        // MOSTRAR / OCULTAR MESA
        // ==========================================

        const tipoPedido =
            document.querySelector('[name="TipoPedido"]');

        const mesa =
            document.querySelector('[name="IdMesa"]');


        function actualizarMesa() {

            if (!tipoPedido || !mesa) {
                return;
            }

            if (tipoPedido.value === "0") {

                mesa.disabled = false;

            } else {

                mesa.value = "";
                mesa.disabled = true;
            }
        }


        if (tipoPedido) {

            tipoPedido.addEventListener(
                "change",
                actualizarMesa
            );

            actualizarMesa();
        }

    </script>
}