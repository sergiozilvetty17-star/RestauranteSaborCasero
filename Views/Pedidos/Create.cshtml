
@model RestauranteSaborCasero.Models.Pedido

@{
    ViewData["Title"] = "Crear Pedido";
}

<style>
    .crear-pedido-container {
        padding: 30px;
    }

    .crear-pedido-header {
        margin-bottom: 25px;
    }

    .crear-pedido-titulo {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
        color: #2c2c2c;
    }

    .crear-pedido-subtitulo {
        margin: 6px 0 0;
        color: #777;
        font-size: 15px;
    }

    .crear-pedido-card {
        width: 700px;
        max-width: 100%;
        background-color: white;
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        padding: 30px;
    }

    .seccion {
        margin-bottom: 25px;
    }

    .seccion-titulo {
        font-size: 17px;
        font-weight: 700;
        color: #343a40;
        margin: 0 0 15px;
        padding-bottom: 10px;
        border-bottom: 1px solid #eeeeee;
    }

    .campo {
        margin-bottom: 18px;
    }

        .campo:last-child {
            margin-bottom: 0;
        }

        .campo label {
            display: block;
            margin-bottom: 7px;
            font-weight: 600;
            color: #333;
        }

        .campo select,
        .campo input {
            width: 100%;
            box-sizing: border-box;
            padding: 11px 12px;
            border: 1px solid #ced4da;
            border-radius: 7px;
            background-color: white;
            color: #333;
            font-size: 15px;
        }

            .campo input[readonly] {
                background-color: #f8f9fa;
                color: #555;
                cursor: not-allowed;
            }

            .campo select:focus,
            .campo input:focus {
                outline: none;
                border-color: #198754;
                box-shadow: 0 0 0 2px rgba(25, 135, 84, 0.12);
            }

    .campo-ayuda {
        display: block;
        margin-top: 5px;
        color: #888;
        font-size: 12px;
    }

    .campo-validation {
        display: block;
        margin-top: 5px;
        color: #dc3545;
        font-size: 13px;
    }

    .validation-summary {
        background-color: #f8d7da;
        border: 1px solid #f1aeb5;
        color: #842029;
        border-radius: 7px;
        padding: 12px 15px;
        margin-bottom: 20px;
    }

    .acciones-form {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #eeeeee;
    }

    .btn-guardar {
        border: none;
        background-color: #198754;
        color: white;
        padding: 12px 22px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-guardar:hover {
            background-color: #157347;
        }

    .btn-volver {
        background-color: #6c757d;
        color: white;
        text-decoration: none;
        padding: 12px 22px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
    }

        .btn-volver:hover {
            background-color: #5c636a;
            color: white;
        }
</style>


<div class="crear-pedido-container">

    <!-- ========================================== -->
    <!-- ENCABEZADO -->
    <!-- ========================================== -->

    <div class="crear-pedido-header">

        <h1 class="crear-pedido-titulo">
            Crear nuevo pedido
        </h1>

        <p class="crear-pedido-subtitulo">
            Registra un nuevo pedido de manera rápida y sencilla
        </p>

    </div>


    <!-- ========================================== -->
    <!-- FORMULARIO -->
    <!-- ========================================== -->

    <div class="crear-pedido-card">

        <form asp-action="Create" method="post">

            <!-- VALIDACIONES -->

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>


            <!-- ========================================== -->
            <!-- INFORMACIÓN DEL PEDIDO -->
            <!-- ========================================== -->

            <div class="seccion">

                <h2 class="seccion-titulo">
                    Información del pedido
                </h2>


                <!-- ========================================== -->
                <!-- MESERO AUTOMÁTICO -->
                <!-- ========================================== -->

                <div class="campo">

                    <label>
                        Mesero responsable
                    </label>

                    <input type="text"
                           value="@ViewData["NombreMesero"]"
                           readonly />

                    <span class="campo-ayuda">
                        El mesero se asigna automáticamente según la cuenta que inició sesión.
                    </span>

                </div>


                <!-- ========================================== -->
                <!-- TIPO DE PEDIDO -->
                <!-- ========================================== -->

                <div class="campo">

                    <label asp-for="TipoPedido">
                        Tipo de pedido
                    </label>

                    <select asp-for="TipoPedido"
                            asp-items="Html.GetEnumSelectList<RestauranteSaborCasero.Models.TipoPedido>()">
                    </select>

                    <span class="campo-ayuda">
                        Selecciona si el pedido es para el restaurante o para llevar.
                    </span>

                    <span asp-validation-for="TipoPedido"
                          class="campo-validation">
                    </span>

                </div>


                <!-- ========================================== -->
                <!-- MESA -->
                <!-- ========================================== -->

                <div class="campo">

                    <label asp-for="IdMesa">
                        Mesa
                    </label>

                    <select asp-for="IdMesa"
                            asp-items="ViewBag.IdMesa">

                        <option value="">
                            Sin mesa
                        </option>

                    </select>

                    <span class="campo-ayuda">
                        Si es un pedido para llevar, puedes dejarlo sin mesa.
                    </span>

                    <span asp-validation-for="IdMesa"
                          class="campo-validation">
                    </span>

                </div>


                <!-- ========================================== -->
                <!-- ESTADO -->
                <!-- ========================================== -->

                <div class="campo">

                    <label>
                        Estado inicial
                    </label>

                    <input type="text"
                           value="Pendiente"
                           readonly />

                    <span class="campo-ayuda">
                        Todo pedido nuevo comienza automáticamente como Pendiente.
                    </span>

                </div>

            </div>


            <!-- ========================================== -->
            <!-- FECHA Y HORA -->
            <!-- ========================================== -->

            <div class="seccion">

                <h2 class="seccion-titulo">
                    Fecha y hora
                </h2>


                <!-- ========================================== -->
                <!-- FECHA -->
                <!-- ========================================== -->

                <div class="campo">

                    <label>
                        Fecha
                    </label>

                    <input type="text"
                           value="@DateTime.Now.ToString("dd/MM/yyyy")"
                           readonly />

                    <span class="campo-ayuda">
                        La fecha se registra automáticamente al crear el pedido.
                    </span>

                </div>


                <!-- ========================================== -->
                <!-- HORA -->
                <!-- ========================================== -->

                <div class="campo">

                    <label>
                        Hora de inicio
                    </label>

                    <input type="text"
                           value="@DateTime.Now.ToString("HH:mm")"
                           readonly />

                    <span class="campo-ayuda">
                        La hora de inicio se registra automáticamente al guardar el pedido.
                    </span>

                </div>

            </div>


            <!-- ========================================== -->
            <!-- BOTONES -->
            <!-- ========================================== -->

            <div class="acciones-form">

                <button type="submit"
                        class="btn-guardar">

                    Guardar pedido

                </button>


                <a asp-action="Index"
                   class="btn-volver">

                    Volver a pedidos

                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}

