@model RestauranteSaborCasero.Models.Pedido

@{
    ViewData["Title"] = "Crear Pedido";
}

<style>
    /* =========================================================
       CREAR PEDIDO - SABOR CASERO
       ========================================================= */

    .crear-pedido-container {
        padding: 30px;
        max-width: 1100px;
        margin: 0 auto;
    }

    /* =========================================================
       ENCABEZADO
       ========================================================= */

    .crear-pedido-header {
        margin-bottom: 25px;
    }

    .crear-pedido-titulo {
        margin: 0;
        font-size: 32px;
        font-weight: 850;
        color: #3a211c;
        letter-spacing: -0.7px;
    }

    .crear-pedido-subtitulo {
        margin: 7px 0 0;
        color: #746963;
        font-size: 15px;
        font-weight: 500;
    }

    /* =========================================================
       TARJETA PRINCIPAL
       ========================================================= */

    .crear-pedido-card {
        width: 100%;
        max-width: 900px;
        background: #211a18;
        border: 1px solid #382824;
        border-radius: 18px;
        padding: 32px;
        box-shadow: 0 15px 35px rgba(45, 27, 22, 0.16);
    }

    /* =========================================================
       SECCIONES
       ========================================================= */

    .seccion {
        margin-bottom: 30px;
    }

    .seccion-titulo {
        display: flex;
        align-items: center;
        gap: 10px;

        font-size: 18px;
        font-weight: 850;
        color: #f6eee8;

        margin: 0 0 18px;
        padding-bottom: 13px;

        border-bottom: 1px solid #49342e;
    }

    .seccion-titulo::before {
        content: "";
        width: 5px;
        height: 21px;
        border-radius: 4px;
        background: #8b3a2b;
        flex-shrink: 0;
    }

    /* =========================================================
       CAMPOS
       ========================================================= */

    .campo {
        margin-bottom: 21px;
    }

    .campo label {
        display: block;
        margin-bottom: 8px;

        font-weight: 800;
        color: #f3e8e1;
        font-size: 14px;
    }

    .campo select,
    .campo input,
    .campo textarea {
        width: 100%;
        box-sizing: border-box;

        min-height: 46px;
        padding: 11px 13px;

        border: 1px solid #59423a;
        border-radius: 9px;

        background-color: #2b211e;
        color: #f8f1ec;

        font-size: 15px;
        font-weight: 600;

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease,
            background-color 0.2s ease;
    }

    .campo select {
        cursor: pointer;
    }

    .campo select:focus,
    .campo input:focus,
    .campo textarea:focus {
        outline: none;

        background-color: #302420;
        border-color: #9b4435;

        box-shadow: 0 0 0 3px rgba(139, 58, 43, 0.18);
    }

    .campo select option {
        background-color: #2b211e;
        color: #f8f1ec;
    }

    .campo input[readonly] {
        background-color: #28201d;
        color: #d8c9c1;
        cursor: default;
    }

    .campo input:disabled,
    .campo select:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .campo-ayuda {
        display: block;
        margin-top: 7px;

        color: #a99890;
        font-size: 12px;
        font-weight: 500;
        line-height: 1.5;
    }

    .campo-validation {
        display: block;
        margin-top: 6px;

        color: #ff9fa7;
        font-size: 13px;
        font-weight: 700;
    }

    /* =========================================================
       VALIDACIONES
       ========================================================= */

    .validation-summary {
        background-color: #3b2023;
        border: 1px solid #7e4148;
        color: #ffb8be;

        border-radius: 9px;
        padding: 13px 16px;
        margin-bottom: 23px;

        font-size: 14px;
        font-weight: 700;
    }

    /* =========================================================
       MESERO ACTUAL
       ========================================================= */

    .mesero-actual {
        position: relative;

        background: #2b211e;
        border: 1px solid #5b4037;
        border-left: 5px solid #8b3a2b;

        border-radius: 10px;
        padding: 15px 17px;
        margin-bottom: 23px;
    }

    .mesero-actual-label {
        display: block;

        color: #a99890;
        font-size: 12px;
        font-weight: 700;

        text-transform: uppercase;
        letter-spacing: 0.5px;

        margin-bottom: 4px;
    }

    .mesero-actual-nombre {
        display: block;

        color: #e3a66d;
        font-size: 18px;
        font-weight: 850;
    }

    .mesero-actual .campo-ayuda {
        margin-top: 6px;
    }

    /* =========================================================
       PLATOS
       ========================================================= */

    .platos-header {
        display: flex;
        justify-content: space-between;
        align-items: center;

        margin-bottom: 17px;
        gap: 15px;
    }

    .platos-header .seccion-titulo {
        flex: 1;
    }

    .btn-agregar-plato {
        border: 1px solid #9b4435;

        background-color: #7a2e24;
        color: white;

        padding: 11px 17px;
        border-radius: 9px;

        font-size: 14px;
        font-weight: 850;

        cursor: pointer;
        white-space: nowrap;

        box-shadow: 0 5px 12px rgba(122, 46, 36, 0.20);

        transition:
            background-color 0.2s ease,
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .btn-agregar-plato:hover {
        background-color: #963a2d;
        transform: translateY(-2px);
        box-shadow: 0 8px 17px rgba(122, 46, 36, 0.28);
    }

    .platos-container {
        display: flex;
        flex-direction: column;
        gap: 13px;
    }

    /* =========================================================
       FILA DE PLATO
       ========================================================= */

    .plato-row {
        display: grid;

        grid-template-columns:
            minmax(220px, 1fr)
            105px
            minmax(190px, 1fr)
            45px;

        gap: 12px;
        align-items: end;

        padding: 17px;

        background: #2a211e;
        border: 1px solid #4c3730;
        border-radius: 11px;

        transition:
            border-color 0.2s ease,
            background-color 0.2s ease;
    }

    .plato-row:hover {
        background: #302522;
        border-color: #65483e;
    }

    .plato-campo label {
        display: block;

        margin-bottom: 7px;

        font-size: 13px;
        font-weight: 800;
        color: #eaded7;
    }

    .plato-campo select,
    .plato-campo input {
        width: 100%;
        box-sizing: border-box;

        min-height: 42px;
        padding: 9px 11px;

        border: 1px solid #59423a;
        border-radius: 8px;

        background-color: #211a18;
        color: #f5ede8;

        font-size: 14px;
        font-weight: 600;

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }

    .plato-campo select:focus,
    .plato-campo input:focus {
        outline: none;

        border-color: #9b4435;

        box-shadow: 0 0 0 3px rgba(139, 58, 43, 0.16);
    }

    .plato-campo select option {
        background-color: #211a18;
        color: #f5ede8;
    }

    /* =========================================================
       BOTÓN ELIMINAR PLATO
       ========================================================= */

    .btn-eliminar-plato {
        width: 42px;
        height: 42px;

        border: 1px solid #874049;
        border-radius: 8px;

        background-color: #64252d;
        color: #ffd9dc;

        font-size: 22px;
        font-weight: 700;

        cursor: pointer;

        transition:
            background-color 0.2s ease,
            transform 0.2s ease;
    }

    .btn-eliminar-plato:hover {
        background-color: #842f38;
        transform: scale(1.04);
    }

    /* =========================================================
       SIN PLATOS
       ========================================================= */

    .sin-platos {
        text-align: center;

        padding: 30px 20px;

        border: 1px dashed #665049;
        border-radius: 10px;

        background: #28201d;

        color: #a99890;

        font-size: 14px;
        font-weight: 600;
        line-height: 1.7;
    }

    .sin-platos strong {
        color: #d69b45;
        font-weight: 850;
    }

    /* =========================================================
       ACCIONES
       ========================================================= */

    .acciones-form {
        display: flex;
        align-items: center;
        gap: 12px;

        margin-top: 30px;
        padding-top: 23px;

        border-top: 1px solid #49342e;
    }

    .btn-guardar {
        border: 1px solid #8f4134;

        background-color: #7a2e24;
        color: white;

        padding: 13px 25px;
        border-radius: 9px;

        font-size: 15px;
        font-weight: 850;

        cursor: pointer;

        box-shadow: 0 6px 14px rgba(122, 46, 36, 0.20);

        transition:
            background-color 0.2s ease,
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .btn-guardar:hover {
        background-color: #963a2d;

        transform: translateY(-2px);

        box-shadow: 0 9px 19px rgba(122, 46, 36, 0.28);
    }

    .btn-volver {
        background-color: #3a302c;
        color: #e8ddd7;

        border: 1px solid #594a43;

        text-decoration: none;

        padding: 13px 23px;
        border-radius: 9px;

        font-size: 15px;
        font-weight: 750;

        transition:
            background-color 0.2s ease,
            color 0.2s ease,
            transform 0.2s ease;
    }

    .btn-volver:hover {
        background-color: #4a3c36;
        color: white;
        transform: translateY(-2px);
    }

    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 850px) {

        .crear-pedido-container {
            padding: 20px;
        }

        .crear-pedido-card {
            padding: 24px;
        }

        .plato-row {
            grid-template-columns: 1fr 100px;
        }

        .plato-row .plato-campo:nth-child(3) {
            grid-column: 1 / -1;
        }

        .btn-eliminar-plato {
            width: 100%;
        }
    }

    @@media (max-width: 600px) {

        .crear-pedido-container {
            padding: 15px;
        }

        .crear-pedido-titulo {
            font-size: 27px;
        }

        .crear-pedido-card {
            padding: 18px;
            border-radius: 14px;
        }

        .platos-header {
            flex-direction: column;
            align-items: stretch;
        }

        .platos-header .seccion-titulo {
            width: 100%;
        }

        .btn-agregar-plato {
            width: 100%;
        }

        .plato-row {
            grid-template-columns: 1fr;
        }

        .plato-row .plato-campo:nth-child(3) {
            grid-column: auto;
        }

        .btn-eliminar-plato {
            width: 100%;
        }

        .acciones-form {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-guardar,
        .btn-volver {
            width: 100%;
            text-align: center;
            box-sizing: border-box;
        }
    }
</style>


<div class="crear-pedido-container">

    <!-- ==========================================
         ENCABEZADO
         ========================================== -->

    <div class="crear-pedido-header">

        <h1 class="crear-pedido-titulo">
            Crear nuevo pedido
        </h1>

        <p class="crear-pedido-subtitulo">
            Registra un nuevo pedido de manera rápida y sencilla
        </p>

    </div>


    <!-- ==========================================
         FORMULARIO
         ========================================== -->

    <div class="crear-pedido-card">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()


            <!-- ==========================================
                 ERRORES
                 ========================================== -->

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>


            <!-- ==========================================
                 INFORMACIÓN DEL PEDIDO
                 ========================================== -->

            <div class="seccion">

                <h2 class="seccion-titulo">
                    Información del pedido
                </h2>


                <!-- ==========================================
                     MESERO AUTOMÁTICO
                     ========================================== -->

                <div class="mesero-actual">

                    <span class="mesero-actual-label">
                        Mesero responsable
                    </span>

                    <span class="mesero-actual-nombre">
                        @(ViewData["NombreMesero"] ?? "Usuario actual")
                    </span>

                    <div class="campo-ayuda">
                        El mesero se asigna automáticamente según la cuenta que inició sesión.
                    </div>

                </div>


                <!-- ==========================================
                     TIPO DE PEDIDO
                     ========================================== -->

                <div class="campo">

                    <label asp-for="TipoPedido">
                        Tipo de pedido
                    </label>

                    <select asp-for="TipoPedido"
                            asp-items="Html.GetEnumSelectList<RestauranteSaborCasero.Models.TipoPedido>()">
                    </select>

                    <span class="campo-ayuda">
                        Selecciona si el pedido es para una mesa o para llevar.
                    </span>

                    <span asp-validation-for="TipoPedido"
                          class="campo-validation">
                    </span>

                </div>


                <!-- ==========================================
                     MESA
                     ========================================== -->

                <div class="campo">

                    <label asp-for="IdMesa">
                        Mesa
                    </label>

                    <select asp-for="IdMesa"
                            asp-items="ViewBag.IdMesa">

                        <option value="">
                            Sin mesa
                        </option>

                    </select>

                    <span class="campo-ayuda">
                        Si es un pedido para llevar, puedes dejarlo sin mesa.
                    </span>

                    <span asp-validation-for="IdMesa"
                          class="campo-validation">
                    </span>

                </div>

            </div>


            <!-- ==========================================
                 PLATOS
                 ========================================== -->

            <div class="seccion">

                <div class="platos-header">

                    <h2 class="seccion-titulo"
                        style="margin-bottom: 0; flex: 1;">

                        Platos del pedido

                    </h2>

                    <button type="button"
                            class="btn-agregar-plato"
                            onclick="agregarPlato()">

                        + Agregar plato

                    </button>

                </div>


                <div id="platos-container"
                     class="platos-container">

                    @if (Model?.Detalles != null &&
                         Model.Detalles.Count > 0)
                    {
                        var indice = 0;

                        foreach (var detalle in Model.Detalles)
                        {
                            <div class="plato-row">

                                <div class="plato-campo">

                                    <label>
                                        Plato
                                    </label>

                                    <select name="Detalles[@indice].IdPlato"
                                            required>

                                        <option value="">
                                            Seleccione un plato
                                        </option>

                                        @foreach (var plato in (IEnumerable<RestauranteSaborCasero.Models.Plato>)ViewBag.Platos)
                                        {
                                            if (plato.IdPlato == detalle.IdPlato)
                                            {
                                                <option value="@plato.IdPlato"
                                                        selected>

                                                    @plato.Nombre

                                                </option>
                                            }
                                            else
                                            {
                                                <option value="@plato.IdPlato">

                                                    @plato.Nombre

                                                </option>
                                            }
                                        }

                                    </select>

                                </div>


                                <div class="plato-campo">

                                    <label>
                                        Cantidad
                                    </label>

                                    <input type="number"
                                           name="Detalles[@indice].Cantidad"
                                           value="@detalle.Cantidad"
                                           min="1"
                                           max="1000"
                                           required />

                                </div>


                                <div class="plato-campo">

                                    <label>
                                        Indicaciones
                                    </label>

                                    <input type="text"
                                           name="Detalles[@indice].IndicacionesExtra"
                                           value="@detalle.IndicacionesExtra"
                                           maxlength="255"
                                           placeholder="Ej: Sin cebolla" />

                                </div>


                                <button type="button"
                                        class="btn-eliminar-plato"
                                        onclick="eliminarPlato(this)">

                                    ×

                                </button>

                            </div>

                            indice++;
                        }
                    }
                    else
                    {
                        <div class="sin-platos"
                             id="mensaje-sin-platos">

                            No has agregado ningún plato.

                            <br />

                            Presiona
                            <strong>+ Agregar plato</strong>
                            para comenzar.

                        </div>
                    }

                </div>

            </div>


            <!-- ==========================================
                 FECHA Y HORA
                 ========================================== -->

            <div class="seccion">

                <h2 class="seccion-titulo">
                    Fecha y hora
                </h2>


                <div class="campo">

                    <label>
                        Fecha
                    </label>

                    <input type="text"
                           value="@DateTime.Now.ToString("dd/MM/yyyy")"
                           readonly />

                    <span class="campo-ayuda">
                        La fecha se registra automáticamente.
                    </span>

                </div>


                <div class="campo">

                    <label>
                        Hora de inicio
                    </label>

                    <input type="text"
                           value="@DateTime.Now.ToString("HH:mm")"
                           readonly />

                    <span class="campo-ayuda">
                        La hora se registra automáticamente al guardar el pedido.
                    </span>

                </div>

            </div>


            <!-- ==========================================
                 BOTONES
                 ========================================== -->

            <div class="acciones-form">

                <button type="submit"
                        class="btn-guardar">

                    Guardar pedido

                </button>

                <a asp-action="Index"
                   class="btn-volver">

                    Volver a pedidos

                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        // ==========================================
        // CONTADOR DE PLATOS
        // ==========================================

        let indicePlato = @(Model?.Detalles?.Count ?? 0);


        // ==========================================
        // AGREGAR PLATO
        // ==========================================

        function agregarPlato() {

            const container =
                document.getElementById("platos-container");

            const mensaje =
                document.getElementById("mensaje-sin-platos");

            if (mensaje) {
                mensaje.remove();
            }


            const fila =
                document.createElement("div");

            fila.className = "plato-row";


            fila.innerHTML = `

                <div class="plato-campo">

                    <label>
                        Plato
                    </label>

                    <select name="Detalles[${indicePlato}].IdPlato"
                            required>

                        <option value="">
                            Seleccione un plato
                        </option>

                        @foreach (var plato in ViewBag.Platos as IEnumerable<RestauranteSaborCasero.Models.Plato>
                         ?? Enumerable.Empty<RestauranteSaborCasero.Models.Plato>())
                        {
                            <option value="@plato.IdPlato">
                                @plato.Nombre
                            </option>
                        }

                    </select>

                </div>


                <div class="plato-campo">

                    <label>
                        Cantidad
                    </label>

                    <input type="number"
                           name="Detalles[${indicePlato}].Cantidad"
                           value="1"
                           min="1"
                           max="1000"
                           required />

                </div>


                <div class="plato-campo">

                    <label>
                        Indicaciones
                    </label>

                    <input type="text"
                           name="Detalles[${indicePlato}].IndicacionesExtra"
                           maxlength="255"
                           placeholder="Ej: Sin cebolla" />

                </div>


                <button type="button"
                        class="btn-eliminar-plato"
                        onclick="eliminarPlato(this)">

                    ×

                </button>

            `;


            container.appendChild(fila);

            indicePlato++;
        }


        // ==========================================
        // ELIMINAR PLATO
        // ==========================================

        function eliminarPlato(boton) {

            const fila =
                boton.closest(".plato-row");

            if (fila) {
                fila.remove();
            }


            const filas =
                document.querySelectorAll(".plato-row");


            // Si ya no quedan platos,
            // mostramos el mensaje.

            if (filas.length === 0) {

                const container =
                    document.getElementById("platos-container");

                const mensaje =
                    document.createElement("div");

                mensaje.id = "mensaje-sin-platos";

                mensaje.className = "sin-platos";

                mensaje.innerHTML =
                    'No has agregado ningún plato.<br />' +
                    'Presiona <strong>+ Agregar plato</strong> para comenzar.';

                container.appendChild(mensaje);
            }
        }


        // ==========================================
        // MOSTRAR / OCULTAR MESA
        // ==========================================

        const tipoPedido =
            document.querySelector('[name="TipoPedido"]');

        const mesa =
            document.querySelector('[name="IdMesa"]');


        function actualizarMesa() {

            if (!tipoPedido || !mesa) {
                return;
            }

            if (tipoPedido.value === "0") {

                mesa.disabled = false;

            }
            else {

                mesa.value = "";
                mesa.disabled = true;

            }
        }


        if (tipoPedido) {

            tipoPedido.addEventListener(
                "change",
                actualizarMesa
            );

            actualizarMesa();
        }

    </script>
}