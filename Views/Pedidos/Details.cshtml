@model RestauranteSaborCasero.Models.Pedido

@{
    ViewData["Title"] = "Detalles del Pedido";
}

<h1>Detalles del Pedido</h1>

<div>

    <h4>Pedido #@Model.IdPedido</h4>

    <dl>

        <dt>
            Mesero
        </dt>

        <dd>
            @Model.Usuario.Nombre
        </dd>


        <dt>
            Mesa
        </dt>

        <dd>
            @(Model.Mesa != null
                ? Model.Mesa.NumeroMesa.ToString()
                : "Sin mesa")
        </dd>


        <dt>
            Tipo de pedido
        </dt>

        <dd>
            @Model.TipoPedido
        </dd>


        <dt>
            Fecha
        </dt>

        <dd>
            @Model.Fecha.ToString("dd/MM/yyyy")
        </dd>


        <dt>
            Hora de inicio
        </dt>

        <dd>
            @Model.HoraInicio
        </dd>


        <dt>
            Hora de finalización
        </dt>

        <dd>
            @(Model.HoraFin.HasValue
                ? Model.HoraFin.Value.ToString()
                : "No finalizado")
        </dd>


        <dt>
            Estado
        </dt>

        <dd>
            @Model.Estado
        </dd>

    </dl>

</div>


<h4>Detalles del pedido</h4>

@if (Model.Detalles != null && Model.Detalles.Any())
{
    <table>

        <thead>
            <tr>
                <th>Plato</th>
                <th>Cantidad</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var detalle in Model.Detalles)
            {
                <tr>

                    <td>
                        @detalle.Plato.Nombre
                    </td>

                    <td>
                        @detalle.Cantidad
                    </td>

                </tr>
            }

        </tbody>

    </table>
}
else
{
    <p>
        Este pedido no tiene detalles registrados.
    </p>
}


<div>

    <a asp-action="Edit"
       asp-route-id="@Model.IdPedido">
        Editar
    </a>

    <a asp-action="Index">
        Volver
    </a>

</div>