@model RestauranteSaborCasero.Models.Plato

@{
    ViewData["Title"] = "Editar Plato";
}

<style>
    /* =========================================================
           VARIABLES DE TEMA (Dashboard - Sabor Casero)
           ========================================================= */
    :root {
        --sc-primary: #8d3024;
        --sc-primary-dark: #7d2b21;
        --sc-primary-soft: #f9f2f0;
        --sc-dark: #3c2c27;
        --sc-gray: #756b65;
        --sc-border: #eee8e3;
        --sc-bg-panel: #ffffff;
        --sc-shadow: 0 8px 24px rgba(49, 31, 25, .07);
        --sc-danger-bg: #fdf3f2;
        --sc-danger-text: #c92a2a;
    }

    .sc-page-container {
        width: 100%;
        max-width: 1100px;
        padding-top: 12px;
        color: var(--sc-dark);
    }

    /* =========================================================
           ENCABEZADO
           ========================================================= */
    .sc-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 25px;
    }

    .sc-header-icon {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--sc-primary-soft);
        border-radius: 12px;
        color: var(--sc-primary);
    }

        .sc-header-icon svg {
            width: 24px;
            height: 24px;
            stroke: currentColor;
        }

    .sc-eyebrow {
        margin: 0 0 4px;
        color: var(--sc-primary);
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 1.2px;
        text-transform: uppercase;
    }

    .sc-title {
        margin: 0;
        color: var(--sc-dark);
        font-size: 2rem;
        font-weight: 900;
        letter-spacing: -0.5px;
        line-height: 1.1;
    }

    .sc-description {
        margin: 6px 0 0;
        color: var(--sc-gray);
        font-size: 0.85rem;
        font-weight: 600;
    }

    /* =========================================================
           LAYOUT GRID (FORMULARIO + ASIDE)
           ========================================================= */
    .sc-grid-layout {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 24px;
        align-items: start;
    }

    /* =========================================================
           TARJETA (PANEL)
           ========================================================= */
    .sc-panel {
        background: var(--sc-bg-panel);
        border: 1px solid var(--sc-border);
        border-radius: 16px;
        box-shadow: var(--sc-shadow);
        overflow: hidden;
        margin-bottom: 25px;
    }

    .sc-panel-header {
        padding: 20px 24px;
        background: #faf8f6;
        border-bottom: 1px solid var(--sc-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .sc-panel-title {
        margin: 0;
        color: var(--sc-dark);
        font-size: 1.15rem;
        font-weight: 900;
    }

    .sc-panel-subtitle {
        margin: 4px 0 0;
        color: var(--sc-gray);
        font-size: 0.75rem;
        font-weight: 600;
    }

    .sc-panel-body {
        padding: 24px;
    }

    /* =========================================================
           BANNER IDENTIFICADOR DEL REGISTRO
           ========================================================= */
    .sc-record-banner {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 24px;
        padding: 14px 18px;
        background: var(--sc-primary-soft);
        border: 1px solid var(--sc-border);
        border-radius: 12px;
        color: var(--sc-gray);
        font-size: 0.82rem;
        font-weight: 700;
    }

        .sc-record-banner svg {
            width: 18px;
            height: 18px;
            flex-shrink: 0;
            color: var(--sc-primary);
            stroke: currentColor;
        }

        .sc-record-banner strong {
            color: var(--sc-primary);
            font-size: 0.95rem;
        }

    /* =========================================================
           FORMULARIO Y CAMPOS
           ========================================================= */
    .sc-form-group {
        margin-bottom: 22px;
    }

    .sc-form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .sc-form-label {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 8px;
        color: var(--sc-dark);
        font-size: 0.85rem;
        font-weight: 800;
    }

    .sc-required {
        color: var(--sc-primary);
        font-size: 0.85rem;
    }

    .sc-input-wrapper {
        position: relative;
    }

    .sc-input-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        width: 18px;
        height: 18px;
        color: #a3968f;
        pointer-events: none;
    }

        .sc-input-icon svg {
            width: 100%;
            height: 100%;
            stroke: currentColor;
        }

    .sc-input {
        width: 100%;
        height: 48px;
        padding: 0 16px 0 42px;
        background: #ffffff;
        border: 1px solid #dcd2cc;
        border-radius: 10px;
        color: var(--sc-dark);
        font-size: 0.9rem;
        font-weight: 600;
        outline: none;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }

        .sc-input:hover {
            border-color: #c4b5ac;
        }

        .sc-input:focus {
            border-color: var(--sc-primary);
            box-shadow: 0 0 0 3px rgba(141, 48, 36, 0.1);
            background: #ffffff;
        }

        .sc-input::placeholder {
            color: #b5aba4;
        }

    .sc-help-text {
        display: block;
        margin-top: 6px;
        color: #8c8078;
        font-size: 0.75rem;
        font-weight: 600;
    }

    /* =========================================================
           VALIDACIÓN
           ========================================================= */
    .sc-validation {
        display: block;
        margin-top: 6px;
        color: var(--sc-danger-text);
        font-size: 0.75rem;
        font-weight: 700;
    }

    .sc-validation-summary {
        background-color: var(--sc-danger-bg);
        border: 1px solid #f5c2c2;
        color: var(--sc-danger-text);
        border-radius: 10px;
        padding: 14px 18px;
        margin-bottom: 24px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    /* =========================================================
           BOTONES Y ACCIONES
           ========================================================= */
    .sc-actions {
        display: flex;
        gap: 12px;
        align-items: center;
        padding-top: 24px;
        border-top: 1px solid var(--sc-border);
        margin-top: 10px;
    }

    .sc-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 44px;
        padding: 0 22px;
        border-radius: 10px;
        font-size: 0.85rem;
        font-weight: 800;
        text-decoration: none;
        transition: all 0.2s ease;
        border: 1px solid transparent;
        cursor: pointer;
    }

        .sc-btn svg {
            width: 18px;
            height: 18px;
            stroke: currentColor;
        }

    .sc-btn-primary {
        background-color: var(--sc-primary);
        color: #ffffff;
    }

        .sc-btn-primary:hover {
            background-color: var(--sc-primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(141, 48, 36, 0.2);
        }

    .sc-btn-secondary {
        background-color: #f3f0ed;
        color: #665d57;
        border-color: #e5ddd6;
    }

        .sc-btn-secondary:hover {
            background-color: #e9e3de;
            color: var(--sc-dark);
            transform: translateY(-2px);
        }

    /* =========================================================
           TARJETA LATERAL (ASIDE DE AYUDA)
           ========================================================= */
    .sc-aside-panel {
        background: var(--sc-bg-panel);
        border: 1px solid var(--sc-border);
        border-radius: 16px;
        box-shadow: var(--sc-shadow);
        overflow: hidden;
    }

    .sc-aside-top {
        padding: 24px 20px;
        background: linear-gradient(135deg, #2b1d19, #4a221b);
        color: #ffffff;
    }

    .sc-aside-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 14px;
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 11px;
    }

        .sc-aside-icon svg {
            width: 22px;
            height: 22px;
            stroke: currentColor;
        }

    .sc-aside-title {
        margin: 0;
        color: #ffffff;
        font-size: 1.05rem;
        font-weight: 900;
    }

    .sc-aside-text {
        margin: 6px 0 0;
        color: rgba(255, 255, 255, 0.75);
        font-size: 0.78rem;
        line-height: 1.5;
        font-weight: 500;
    }

    .sc-aside-body {
        padding: 20px;
    }

    .sc-aside-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .sc-aside-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .sc-aside-item-icon {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: var(--sc-primary-soft);
        border-radius: 8px;
        color: var(--sc-primary);
    }

        .sc-aside-item-icon svg {
            width: 16px;
            height: 16px;
            stroke: currentColor;
        }

    .sc-aside-item-title {
        margin: 0 0 2px;
        color: var(--sc-dark);
        font-size: 0.8rem;
        font-weight: 800;
    }

    .sc-aside-item-text {
        margin: 0;
        color: var(--sc-gray);
        font-size: 0.74rem;
        line-height: 1.4;
        font-weight: 500;
    }

    .sc-aside-footer {
        padding: 14px 20px;
        background: #faf8f6;
        border-top: 1px solid var(--sc-border);
        color: #8c827a;
        font-size: 0.72rem;
        font-weight: 600;
        line-height: 1.4;
    }

    @@media (max-width: 950px) {
        .sc-grid-layout {
            grid-template-columns: 1fr;
        }

        .sc-aside-panel {
            display: none;
        }
    }

    @@media (max-width: 600px) {
        .sc-form-row {
            grid-template-columns: 1fr;
            gap: 0;
        }
    }
</style>

<div class="sc-page-container">

    <!-- ENCABEZADO -->
    <div class="sc-header">
        <div class="sc-header-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 20h9" />
                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L8 18l-4 1 1-4Z" />
                <path d="m15 5 3 3" />
            </svg>
        </div>
        <div>
            <p class="sc-eyebrow">Gestión del Menú</p>
            <h1 class="sc-title">Editar plato</h1>
            <p class="sc-description">Modifica la información del plato seleccionado en el menú.</p>
        </div>
    </div>

    <!-- CONTENIDO EN DOS COLUMNAS -->
    <div class="sc-grid-layout">

        <!-- FORMULARIO -->
        <div class="sc-panel">

            <div class="sc-panel-header">
                <div>
                    <h2 class="sc-panel-title">Información del plato</h2>
                    <p class="sc-panel-subtitle">Actualiza los datos que necesites modificar</p>
                </div>
                <div style="background: var(--sc-primary-soft); color: var(--sc-primary); font-size: 0.72rem; padding: 6px 12px; border-radius: 8px; font-weight: 800;">
                    ID: <strong>@Model.IdPlato</strong>
                </div>
            </div>

            <div class="sc-panel-body">

                <form asp-action="Edit" method="post">

                    <input type="hidden" asp-for="IdPlato" />

                    <!-- IDENTIFICADOR VISUAL -->
                    <div class="sc-record-banner">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="16" rx="2" />
                            <path d="M8 8h8" />
                            <path d="M8 12h8" />
                            <path d="M8 16h4" />
                        </svg>
                        <span>Registro seleccionado: <strong>Plato #@Model.IdPlato</strong></span>
                    </div>

                    <!-- NOMBRE -->
                    <div class="sc-form-group">
                        <label asp-for="Nombre" class="sc-form-label">
                            Nombre del plato <span class="sc-required">*</span>
                        </label>
                        <div class="sc-input-wrapper">
                            <span class="sc-input-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="8" />
                                    <path d="M4 12h16" />
                                </svg>
                            </span>
                            <input asp-for="Nombre" class="sc-input" placeholder="Ej. Pollo a la plancha" />
                        </div>
                        <span asp-validation-for="Nombre" class="sc-validation"></span>
                    </div>

                    <!-- PRECIO Y TIEMPO ESTIMADO -->
                    <div class="sc-form-row">

                        <!-- PRECIO -->
                        <div class="sc-form-group">
                            <label asp-for="Precio" class="sc-form-label">
                                Precio <span class="sc-required">*</span>
                            </label>
                            <div class="sc-input-wrapper">
                                <span class="sc-input-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M12 3v18" />
                                        <path d="M17 7c0-2-2-3-5-3S7 5 7 7s2 3 5 3 5 1 5 3-2 3-5 3-5-1-5-3" />
                                    </svg>
                                </span>
                                <input asp-for="Precio" class="sc-input" type="number" step="0.01" min="0" placeholder="0.00" />
                            </div>
                            <span class="sc-help-text">Precio de venta en bolivianos.</span>
                            <span asp-validation-for="Precio" class="sc-validation"></span>
                        </div>

                        <!-- TIEMPO -->
                        <div class="sc-form-group">
                            <label asp-for="TiempoEstimado" class="sc-form-label">
                                Tiempo estimado <span class="sc-required">*</span>
                            </label>
                            <div class="sc-input-wrapper">
                                <span class="sc-input-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="9" />
                                        <path d="M12 7v5l3 2" />
                                    </svg>
                                </span>
                                <input asp-for="TiempoEstimado" class="sc-input" type="number" min="1" placeholder="Ej. 20" />
                            </div>
                            <span class="sc-help-text">Tiempo aproximado en minutos.</span>
                            <span asp-validation-for="TiempoEstimado" class="sc-validation"></span>
                        </div>

                    </div>

                    <!-- ESTADO -->
                    <div class="sc-form-group">
                        <label asp-for="Estado" class="sc-form-label">
                            Estado del plato <span class="sc-required">*</span>
                        </label>
                        <div class="sc-input-wrapper">
                            <span class="sc-input-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="9" />
                                    <path d="m8 12 2.5 2.5L16 9" />
                                </svg>
                            </span>
                            <input asp-for="Estado" class="sc-input" placeholder="Ej. Disponible" />
                        </div>
                        <span class="sc-help-text">Indica si el plato está disponible actualmente.</span>
                        <span asp-validation-for="Estado" class="sc-validation"></span>
                    </div>

                    <!-- BOTONES DE ACCIÓN -->
                    <div class="sc-actions">
                        <button type="submit" class="sc-btn sc-btn-primary">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M5 4h11l3 3v13H5z" />
                                <path d="M8 4v6h8V4" />
                                <path d="M8 17h8" />
                            </svg>
                            Guardar cambios
                        </button>

                        <a asp-action="Index" class="sc-btn sc-btn-secondary">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="19" y1="12" x2="5" y2="12" />
                                <polyline points="12 19 5 12 12 5" />
                            </svg>
                            Cancelar
                        </a>
                    </div>

                </form>

            </div>

        </div>

        <!-- INFORMACIÓN LATERAL -->
        <aside class="sc-aside-panel">

            <div class="sc-aside-top">
                <div class="sc-aside-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20h9" />
                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L8 18l-4 1 1-4Z" />
                        <path d="m15 5 3 3" />
                    </svg>
                </div>
                <h2 class="sc-aside-title">Editando información</h2>
                <p class="sc-aside-text">Los cambios realizados se aplicarán al registro del plato seleccionado.</p>
            </div>

            <div class="sc-aside-body">
                <ul class="sc-aside-list">

                    <li class="sc-aside-item">
                        <span class="sc-aside-item-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 3v18" />
                                <path d="M17 7c0-2-2-3-5-3S7 5 7 7s2 3 5 3 5 1 5 3-2 3-5 3-5-1-5-3" />
                            </svg>
                        </span>
                        <div>
                            <p class="sc-aside-item-title">Precio</p>
                            <p class="sc-aside-item-text">Puedes actualizar el precio de venta del plato en cualquier momento.</p>
                        </div>
                    </li>

                    <li class="sc-aside-item">
                        <span class="sc-aside-item-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="9" />
                                <path d="M12 7v5l3 2" />
                            </svg>
                        </span>
                        <div>
                            <p class="sc-aside-item-title">Tiempo estimado</p>
                            <p class="sc-aside-item-text">Ajusta el tiempo de cocina aproximado para organizar las comandas.</p>
                        </div>
                    </li>

                    <li class="sc-aside-item">
                        <span class="sc-aside-item-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="9" />
                                <path d="m8 12 2.5 2.5L16 9" />
                            </svg>
                        </span>
                        <div>
                            <p class="sc-aside-item-title">Disponibilidad</p>
                            <p class="sc-aside-item-text">Mantén al día el estado para que los meseros sepan si se puede ofrecer.</p>
                        </div>
                    </li>

                </ul>
            </div>

            <div class="sc-aside-footer">
                Los campos marcados con <strong style="color: var(--sc-primary);">*</strong> son obligatorios.
            </div>

        </aside>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}