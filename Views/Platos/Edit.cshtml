@model RestauranteSaborCasero.Models.Plato

@{
    ViewData["Title"] = "Editar Plato";
}

<style>
    /* =========================================================
           EDITAR PLATO - SABOR CASERO
           ========================================================= */

    .plato-edit-page {
        width: 100%;
        padding-top: 12px;
    }

    /* =========================================================
           ENCABEZADO
           ========================================================= */

    .plato-edit-header {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 25px;
    }

    .plato-edit-header-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f7eee9;
        border-radius: 12px;
        color: var(--sc-primary);
    }

        .plato-edit-header-icon svg {
            width: 25px;
            height: 25px;
            stroke: currentColor;
        }

    .plato-edit-eyebrow {
        margin: 0 0 4px;
        color: var(--sc-primary);
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 1.2px;
        text-transform: uppercase;
    }

    .plato-edit-title {
        margin: 0;
        color: var(--sc-dark);
        font-size: 1.9rem;
        font-weight: 800;
        letter-spacing: -0.7px;
        line-height: 1.1;
    }

    .plato-edit-description {
        margin: 6px 0 0;
        color: var(--sc-gray);
        font-size: 0.82rem;
    }

    /* =========================================================
           LAYOUT
           ========================================================= */

    .plato-edit-layout {
        display: grid;
        grid-template-columns: 1fr 310px;
        gap: 20px;
        align-items: start;
    }

    /* =========================================================
           TARJETA DEL FORMULARIO
           ========================================================= */

    .plato-edit-form-card {
        background: #ffffff;
        border: 1px solid var(--sc-border);
        border-radius: 15px;
        box-shadow: var(--sc-shadow);
        overflow: hidden;
    }

    .plato-edit-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 17px 21px;
        background: #ffffff;
        border-bottom: 1px solid var(--sc-border);
    }

    .plato-edit-card-title {
        margin: 0;
        color: var(--sc-dark);
        font-size: 0.92rem;
        font-weight: 800;
    }

    .plato-edit-card-subtitle {
        margin: 3px 0 0;
        color: var(--sc-gray);
        font-size: 0.72rem;
    }

    .plato-edit-id {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        background: #f5f1ed;
        border: 1px solid #e7dfd8;
        border-radius: 7px;
        color: #776c64;
        font-size: 0.66rem;
        font-weight: 800;
    }

        .plato-edit-id strong {
            margin-left: 4px;
            color: var(--sc-primary);
        }

    .plato-edit-form-body {
        padding: 24px;
    }

    /* =========================================================
           CAMPOS
           ========================================================= */

    .plato-edit-group {
        margin-bottom: 20px;
    }

    .plato-edit-label {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 7px;
        color: var(--sc-dark);
        font-size: 0.76rem;
        font-weight: 800;
    }

    .plato-edit-required {
        color: var(--sc-danger);
        font-size: 0.72rem;
    }

    .plato-edit-input-wrapper {
        position: relative;
    }

    .plato-edit-input-icon {
        position: absolute;
        left: 13px;
        top: 50%;
        width: 17px;
        height: 17px;
        color: #9a8d84;
        transform: translateY(-50%);
        pointer-events: none;
    }

        .plato-edit-input-icon svg {
            width: 100%;
            height: 100%;
            stroke: currentColor;
        }

    .plato-edit-input {
        width: 100%;
        height: 45px;
        padding: 0 13px 0 40px;
        background: #ffffff;
        border: 1px solid #ddd5cc;
        border-radius: 9px;
        color: var(--sc-dark);
        font-size: 0.8rem;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

        .plato-edit-input:hover {
            border-color: #cfc2b8;
        }

        .plato-edit-input:focus {
            border-color: var(--sc-primary);
            box-shadow: 0 0 0 3px rgba(139, 58, 43, 0.09);
        }

        .plato-edit-input::placeholder {
            color: #aaa19a;
        }

        .plato-edit-input[type="number"] {
            padding-right: 14px;
        }

    /* =========================================================
           CAMPOS DOBLES
           ========================================================= */

    .plato-edit-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    /* =========================================================
           AYUDA
           ========================================================= */

    .plato-edit-help {
        margin: 6px 0 0;
        color: #918780;
        font-size: 0.67rem;
        line-height: 1.4;
    }

    /* =========================================================
           VALIDACIÓN
           ========================================================= */

    .plato-edit-validation {
        display: block;
        margin-top: 6px;
        color: var(--sc-danger);
        font-size: 0.7rem;
        font-weight: 600;
    }

    /* =========================================================
           ACCIONES
           ========================================================= */

    .plato-edit-actions {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-top: 7px;
        padding-top: 20px;
        border-top: 1px solid var(--sc-border);
    }

    .plato-update-btn,
    .plato-cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        height: 40px;
        padding: 0 16px;
        border-radius: 9px;
        font-size: 0.76rem;
        font-weight: 800;
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    .plato-update-btn {
        background: var(--sc-primary);
        border: 1px solid var(--sc-primary);
        color: #ffffff;
    }

        .plato-update-btn:hover {
            background: var(--sc-primary-dark);
            border-color: var(--sc-primary-dark);
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 6px 14px rgba(139, 58, 43, 0.18);
        }

    .plato-cancel-btn {
        background: #f3f0ed;
        border: 1px solid #e5ddd6;
        color: #665d57;
    }

        .plato-cancel-btn:hover {
            background: #e9e3de;
            color: var(--sc-dark);
            transform: translateY(-1px);
        }

        .plato-update-btn svg,
        .plato-cancel-btn svg {
            width: 16px;
            height: 16px;
            stroke: currentColor;
        }

    /* =========================================================
           TARJETA LATERAL
           ========================================================= */

    .plato-edit-info-card {
        background: #ffffff;
        border: 1px solid var(--sc-border);
        border-radius: 15px;
        box-shadow: var(--sc-shadow);
        overflow: hidden;
    }

    .plato-edit-info-top {
        padding: 23px 21px;
        background: linear-gradient( 145deg, #8b3a2b 0%, #68291f 100% );
        color: #ffffff;
    }

    .plato-edit-info-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 11px;
    }

        .plato-edit-info-icon svg {
            width: 23px;
            height: 23px;
            stroke: currentColor;
        }

    .plato-edit-info-title {
        margin: 0;
        color: #ffffff;
        font-size: 1rem;
        font-weight: 800;
    }

    .plato-edit-info-text {
        margin: 7px 0 0;
        color: rgba(255, 255, 255, 0.72);
        font-size: 0.72rem;
        line-height: 1.5;
    }

    .plato-edit-info-body {
        padding: 19px 21px;
    }

    .plato-edit-info-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .plato-edit-info-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
    }

    .plato-edit-info-item-icon {
        width: 29px;
        height: 29px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: #f7f1ec;
        border-radius: 8px;
        color: var(--sc-primary);
    }

        .plato-edit-info-item-icon svg {
            width: 15px;
            height: 15px;
            stroke: currentColor;
        }

    .plato-edit-info-item-title {
        margin: 1px 0 2px;
        color: var(--sc-dark);
        font-size: 0.72rem;
        font-weight: 800;
    }

    .plato-edit-info-item-text {
        margin: 0;
        color: var(--sc-gray);
        font-size: 0.67rem;
        line-height: 1.4;
    }

    /* =========================================================
           FOOTER LATERAL
           ========================================================= */

    .plato-edit-info-footer {
        padding: 13px 21px;
        background: #faf8f6;
        border-top: 1px solid var(--sc-border);
        color: #8c827a;
        font-size: 0.65rem;
        line-height: 1.4;
    }

    /* =========================================================
           IDENTIFICADOR DEL REGISTRO
           ========================================================= */

    .plato-edit-record {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 20px;
        padding: 10px 12px;
        background: #faf8f6;
        border: 1px solid var(--sc-border);
        border-radius: 9px;
        color: #776d66;
        font-size: 0.69rem;
    }

        .plato-edit-record svg {
            width: 15px;
            height: 15px;
            flex-shrink: 0;
            color: var(--sc-primary);
            stroke: currentColor;
        }

        .plato-edit-record strong {
            color: var(--sc-dark);
        }
</style>


<div class="plato-edit-page">

    <!-- =====================================================
         ENCABEZADO
         ===================================================== -->

    <div class="plato-edit-header">

        <div class="plato-edit-header-icon">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <path d="M12 20h9" />
                <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z" />
                <path d="m15 5 3 3" />

            </svg>

        </div>

        <div>

            <p class="plato-edit-eyebrow">
                Gestión del menú
            </p>

            <h1 class="plato-edit-title">
                Editar plato
            </h1>

            <p class="plato-edit-description">
                Modifica la información del plato seleccionado.
            </p>

        </div>

    </div>


    <!-- =====================================================
         CONTENIDO
         ===================================================== -->

    <div class="plato-edit-layout">


        <!-- =================================================
             FORMULARIO
             ================================================= -->

        <div class="plato-edit-form-card">

            <div class="plato-edit-card-header">

                <div>

                    <h2 class="plato-edit-card-title">
                        Información del plato
                    </h2>

                    <p class="plato-edit-card-subtitle">
                        Actualiza los datos que necesites modificar.
                    </p>

                </div>

                <span class="plato-edit-id">
                    ID:
                    <strong>@Model.IdPlato</strong>
                </span>

            </div>


            <div class="plato-edit-form-body">

                <form asp-action="Edit"
                      method="post">

                    <input type="hidden"
                           asp-for="IdPlato" />


                    <!-- IDENTIFICADOR -->

                    <div class="plato-edit-record">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <rect x="3" y="4" width="18" height="16" rx="2" />
                            <path d="M8 8h8" />
                            <path d="M8 12h8" />
                            <path d="M8 16h4" />

                        </svg>

                        Registro seleccionado:

                        <strong>
                            Plato #@Model.IdPlato
                        </strong>

                    </div>


                    <!-- NOMBRE -->

                    <div class="plato-edit-group">

                        <label asp-for="Nombre"
                               class="plato-edit-label">

                            Nombre del plato

                            <span class="plato-edit-required">
                                *
                            </span>

                        </label>

                        <div class="plato-edit-input-wrapper">

                            <span class="plato-edit-input-icon">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <circle cx="12" cy="12" r="8" />
                                    <path d="M4 12h16" />

                                </svg>

                            </span>

                            <input asp-for="Nombre"
                                   class="plato-edit-input"
                                   placeholder="Ej. Pollo a la plancha" />

                        </div>

                        <span asp-validation-for="Nombre"
                              class="plato-edit-validation">
                        </span>

                    </div>


                    <!-- PRECIO + TIEMPO -->

                    <div class="plato-edit-row">


                        <!-- PRECIO -->

                        <div class="plato-edit-group">

                            <label asp-for="Precio"
                                   class="plato-edit-label">

                                Precio

                                <span class="plato-edit-required">
                                    *
                                </span>

                            </label>

                            <div class="plato-edit-input-wrapper">

                                <span class="plato-edit-input-icon">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">

                                        <path d="M12 3v18" />
                                        <path d="M17 7c0-2-2-3-5-3S7 5 7 7s2 3 5 3 5 1 5 3-2 3-5 3-5-1-5-3" />

                                    </svg>

                                </span>

                                <input asp-for="Precio"
                                       class="plato-edit-input"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       placeholder="0.00" />

                            </div>

                            <p class="plato-edit-help">
                                Precio de venta en bolivianos.
                            </p>

                            <span asp-validation-for="Precio"
                                  class="plato-edit-validation">
                            </span>

                        </div>


                        <!-- TIEMPO -->

                        <div class="plato-edit-group">

                            <label asp-for="TiempoEstimado"
                                   class="plato-edit-label">

                                Tiempo estimado

                                <span class="plato-edit-required">
                                    *
                                </span>

                            </label>

                            <div class="plato-edit-input-wrapper">

                                <span class="plato-edit-input-icon">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">

                                        <circle cx="12" cy="12" r="9" />
                                        <path d="M12 7v5l3 2" />

                                    </svg>

                                </span>

                                <input asp-for="TiempoEstimado"
                                       class="plato-edit-input"
                                       type="number"
                                       min="1"
                                       placeholder="Ej. 20" />

                            </div>

                            <p class="plato-edit-help">
                                Tiempo aproximado en minutos.
                            </p>

                            <span asp-validation-for="TiempoEstimado"
                                  class="plato-edit-validation">
                            </span>

                        </div>

                    </div>


                    <!-- ESTADO -->

                    <div class="plato-edit-group">

                        <label asp-for="Estado"
                               class="plato-edit-label">

                            Estado del plato

                            <span class="plato-edit-required">
                                *
                            </span>

                        </label>

                        <div class="plato-edit-input-wrapper">

                            <span class="plato-edit-input-icon">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <circle cx="12" cy="12" r="9" />
                                    <path d="m8 12 2.5 2.5L16 9" />

                                </svg>

                            </span>

                            <input asp-for="Estado"
                                   class="plato-edit-input"
                                   placeholder="Ej. Disponible" />

                        </div>

                        <p class="plato-edit-help">
                            Indica si el plato está disponible actualmente.
                        </p>

                        <span asp-validation-for="Estado"
                              class="plato-edit-validation">
                        </span>

                    </div>


                    <!-- ACCIONES -->

                    <div class="plato-edit-actions">

                        <button type="submit"
                                class="plato-update-btn">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.9"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <path d="M5 4h11l3 3v13H5z" />
                                <path d="M8 4v6h8V4" />
                                <path d="M8 17h8" />

                            </svg>

                            Guardar cambios

                        </button>


                        <a asp-action="Index"
                           class="plato-cancel-btn">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <path d="M18 6 6 18" />
                                <path d="m6 6 12 12" />

                            </svg>

                            Cancelar

                        </a>

                    </div>

                </form>

            </div>

        </div>


        <!-- =================================================
             INFORMACIÓN LATERAL
             ================================================= -->

        <aside class="plato-edit-info-card">


            <div class="plato-edit-info-top">

                <div class="plato-edit-info-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M12 20h9" />
                        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z" />
                        <path d="m15 5 3 3" />

                    </svg>

                </div>

                <h2 class="plato-edit-info-title">
                    Editando información
                </h2>

                <p class="plato-edit-info-text">
                    Los cambios realizados se aplicarán al
                    registro del plato seleccionado.
                </p>

            </div>


            <div class="plato-edit-info-body">

                <ul class="plato-edit-info-list">


                    <li class="plato-edit-info-item">

                        <span class="plato-edit-info-item-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <path d="M12 3v18" />
                                <path d="M17 7c0-2-2-3-5-3S7 5 7 7s2 3 5 3 5 1 5 3-2 3-5 3-5-1-5-3" />

                            </svg>

                        </span>

                        <div>

                            <p class="plato-edit-info-item-title">
                                Precio
                            </p>

                            <p class="plato-edit-info-item-text">
                                Puedes actualizar el precio de venta del plato.
                            </p>

                        </div>

                    </li>


                    <li class="plato-edit-info-item">

                        <span class="plato-edit-info-item-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <circle cx="12" cy="12" r="9" />
                                <path d="M12 7v5l3 2" />

                            </svg>

                        </span>

                        <div>

                            <p class="plato-edit-info-item-title">
                                Tiempo de preparación
                            </p>

                            <p class="plato-edit-info-item-text">
                                Ajusta el tiempo estimado cuando sea necesario.
                            </p>

                        </div>

                    </li>


                    <li class="plato-edit-info-item">

                        <span class="plato-edit-info-item-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <circle cx="12" cy="12" r="9" />
                                <path d="m8 12 2.5 2.5L16 9" />

                            </svg>

                        </span>

                        <div>

                            <p class="plato-edit-info-item-title">
                                Estado
                            </p>

                            <p class="plato-edit-info-item-text">
                                Mantén actualizado el estado de disponibilidad.
                            </p>

                        </div>

                    </li>


                    <li class="plato-edit-info-item">

                        <span class="plato-edit-info-item-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <path d="M5 12h14" />
                                <path d="m13 6 6 6-6 6" />

                            </svg>

                        </span>

                        <div>

                            <p class="plato-edit-info-item-title">
                                Guardar cambios
                            </p>

                            <p class="plato-edit-info-item-text">
                                Presiona el botón de guardar para actualizar el registro.
                            </p>

                        </div>

                    </li>

                </ul>

            </div>


            <div class="plato-edit-info-footer">
                Los campos marcados con <strong>*</strong> son obligatorios.
            </div>

        </aside>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
