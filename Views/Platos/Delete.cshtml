@model RestauranteSaborCasero.Models.Plato

@{
    ViewData["Title"] = "Eliminar Plato";
}

<style>
    /* =========================================================
           VARIABLES DE TEMA (Dashboard - Sabor Casero)
           ========================================================= */
    :root {
        --sc-primary: #8d3024;
        --sc-primary-dark: #7d2b21;
        --sc-primary-soft: #f9f2f0;
        --sc-dark: #3c2c27;
        --sc-gray: #756b65;
        --sc-border: #eee8e3;
        --sc-bg-panel: #ffffff;
        --sc-shadow: 0 8px 24px rgba(49, 31, 25, .07);
        --sc-danger: #dc3545;
        --sc-danger-dark: #c82333;
        --sc-danger-bg: #fdf3f2;
        --sc-danger-border: #f5c2c2;
        --sc-success: #198754;
        --sc-success-bg: #edf6f0;
    }

    .sc-page-container {
        width: 100%;
        max-width: 850px;
        padding-top: 12px;
        color: var(--sc-dark);
    }

    /* =========================================================
           ENCABEZADO
           ========================================================= */
    .sc-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 25px;
    }

    .sc-header-icon {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--sc-danger-bg);
        border-radius: 12px;
        color: var(--sc-danger);
    }

        .sc-header-icon svg {
            width: 24px;
            height: 24px;
            stroke: currentColor;
        }

    .sc-eyebrow {
        margin: 0 0 4px;
        color: var(--sc-danger);
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 1.2px;
        text-transform: uppercase;
    }

    .sc-title {
        margin: 0;
        color: var(--sc-dark);
        font-size: 2rem;
        font-weight: 900;
        letter-spacing: -0.5px;
        line-height: 1.1;
    }

    .sc-description {
        margin: 6px 0 0;
        color: var(--sc-gray);
        font-size: 0.85rem;
        font-weight: 600;
    }

    /* =========================================================
           TARJETA (PANEL)
           ========================================================= */
    .sc-panel {
        background: var(--sc-bg-panel);
        border: 1px solid var(--sc-border);
        border-radius: 16px;
        box-shadow: var(--sc-shadow);
        overflow: hidden;
        margin-bottom: 20px;
    }

    .sc-panel-header {
        padding: 20px 24px;
        background: #faf8f6;
        border-bottom: 1px solid var(--sc-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .sc-panel-title {
        margin: 0;
        color: var(--sc-dark);
        font-size: 1.15rem;
        font-weight: 900;
    }

    .sc-panel-subtitle {
        margin: 4px 0 0;
        color: var(--sc-gray);
        font-size: 0.75rem;
        font-weight: 600;
    }

    .sc-panel-body {
        padding: 24px;
    }

    /* =========================================================
           ALERTA DE PELIGRO
           ========================================================= */
    .sc-alert-danger {
        display: flex;
        gap: 14px;
        background-color: var(--sc-danger-bg);
        border: 1px solid var(--sc-danger-border);
        color: var(--sc-danger);
        border-radius: 12px;
        padding: 18px;
        margin-bottom: 24px;
    }

    .sc-alert-icon {
        flex-shrink: 0;
        width: 24px;
        height: 24px;
    }

    .sc-alert-content h4 {
        margin: 0 0 4px;
        font-size: 0.95rem;
        font-weight: 800;
    }

    .sc-alert-content p {
        margin: 0;
        font-size: 0.85rem;
        font-weight: 600;
        line-height: 1.5;
        opacity: 0.95;
    }

    /* =========================================================
           BANNER IDENTIFICADOR DEL REGISTRO
           ========================================================= */
    .sc-record-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        padding: 12px 18px;
        background: #faf8f6;
        border: 1px solid var(--sc-border);
        border-radius: 10px;
    }

    .sc-record-label {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--sc-gray);
        font-size: 0.8rem;
        font-weight: 700;
    }

        .sc-record-label svg {
            width: 16px;
            height: 16px;
            color: var(--sc-primary);
            stroke: currentColor;
        }

    .sc-record-value {
        color: var(--sc-primary);
        font-size: 0.85rem;
        font-weight: 800;
    }

    /* =========================================================
           GRID DE INFORMACIÓN DEL PLATO
           ========================================================= */
    .sc-info-grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr 1fr 1fr;
        gap: 12px;
        margin-bottom: 24px;
    }

    .sc-info-card {
        padding: 14px;
        background: #faf8f6;
        border: 1px solid #eee7e1;
        border-radius: 11px;
    }

    .sc-info-card-top {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
    }

    .sc-info-card-icon {
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f4ebe5;
        border-radius: 7px;
        color: var(--sc-primary);
    }

        .sc-info-card-icon svg {
            width: 16px;
            height: 16px;
            stroke: currentColor;
        }

    .sc-info-label {
        margin: 0;
        color: #887d75;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.4px;
        text-transform: uppercase;
    }

    .sc-info-value {
        margin: 0;
        color: var(--sc-dark);
        font-size: 0.92rem;
        font-weight: 800;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

        .sc-info-value.price {
            color: var(--sc-primary);
            font-size: 1.05rem;
        }

    /* =========================================================
           BADGE DE ESTADO
           ========================================================= */
    .sc-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--sc-success);
        font-size: 0.78rem;
        font-weight: 800;
    }

    .sc-status-dot {
        width: 7px;
        height: 7px;
        background: currentColor;
        border-radius: 50%;
    }

    .sc-badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* =========================================================
           BOTONES Y ACCIONES
           ========================================================= */
    .sc-actions {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
        padding-top: 20px;
        border-top: 1px solid var(--sc-border);
    }

    .sc-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 44px;
        padding: 0 22px;
        border-radius: 10px;
        font-size: 0.85rem;
        font-weight: 800;
        text-decoration: none;
        transition: all 0.2s ease;
        border: 1px solid transparent;
        cursor: pointer;
    }

        .sc-btn svg {
            width: 18px;
            height: 18px;
            stroke: currentColor;
        }

    .sc-btn-danger {
        background-color: var(--sc-danger);
        color: #ffffff;
    }

        .sc-btn-danger:hover {
            background-color: var(--sc-danger-dark);
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(220, 53, 69, 0.25);
        }

    .sc-btn-secondary {
        background-color: #ffffff;
        color: #665e58;
        border-color: #ddd5cc;
    }

        .sc-btn-secondary:hover {
            background-color: #f3efeb;
            color: var(--sc-dark);
            transform: translateY(-2px);
        }

    /* =========================================================
           FOOTER INFORMATIVO
           ========================================================= */
    .sc-footer-info {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #948981;
        font-size: 0.75rem;
        font-weight: 600;
        margin-top: 14px;
    }

        .sc-footer-info svg {
            width: 16px;
            height: 16px;
            color: #a49a93;
            stroke: currentColor;
            flex-shrink: 0;
        }

    @@media (max-width: 768px) {
        .sc-info-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 500px) {
        .sc-info-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="sc-page-container">

    <!-- ENCABEZADO -->
    <div class="sc-header">
        <div class="sc-header-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 6h18" />
                <path d="M8 6V4h8v2" />
                <path d="M19 6l-1 14H6L5 6" />
                <path d="M10 11v5" />
                <path d="M14 11v5" />
            </svg>
        </div>
        <div>
            <p class="sc-eyebrow">Gestión del menú</p>
            <h1 class="sc-title">Eliminar plato</h1>
            <p class="sc-description">Confirma la eliminación del registro seleccionado.</p>
        </div>
    </div>

    <!-- TARJETA -->
    <div class="sc-panel">

        <div class="sc-panel-header">
            <div>
                <h2 class="sc-panel-title">Confirmar baja de plato</h2>
                <p class="sc-panel-subtitle">Verifica los datos del registro antes de proceder</p>
            </div>
            <div class="sc-badge" style="background: var(--sc-danger-bg); color: var(--sc-danger);">
                Confirmación requerida
            </div>
        </div>

        <div class="sc-panel-body">

            <!-- ADVERTENCIA -->
            <div class="sc-alert-danger">
                <div class="sc-alert-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10.3 3.6 2.4 17a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.6a2 2 0 0 0-3.4 0Z" />
                        <path d="M12 9v4" />
                        <path d="M12 17h.01" />
                    </svg>
                </div>
                <div class="sc-alert-content">
                    <h4>Acción permanente</h4>
                    <p>Al confirmar, este plato será eliminado permanentemente del sistema. Se perderán sus referencias de preparación y comanda. Esta acción no se puede deshacer.</p>
                </div>
            </div>

            <!-- REGISTRO -->
            <div class="sc-record-banner">
                <span class="sc-record-label">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="16" rx="2" />
                        <path d="M8 8h8" />
                        <path d="M8 12h8" />
                        <path d="M8 16h4" />
                    </svg>
                    Identificador del registro
                </span>
                <span class="sc-record-value">
                    #@Model.IdPlato
                </span>
            </div>

            <!-- INFORMACIÓN -->
            <div class="sc-info-grid">

                <!-- NOMBRE -->
                <div class="sc-info-card">
                    <div class="sc-info-card-top">
                        <span class="sc-info-card-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 7h16" />
                                <path d="M6 7v10" />
                                <path d="M18 7v10" />
                                <path d="M8 17h8" />
                                <path d="M9 11h6" />
                            </svg>
                        </span>
                        <p class="sc-info-label">Nombre</p>
                    </div>
                    <p class="sc-info-value" title="@Model.Nombre">
                        @Model.Nombre
                    </p>
                </div>

                <!-- PRECIO -->
                <div class="sc-info-card">
                    <div class="sc-info-card-top">
                        <span class="sc-info-card-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 3v18" />
                                <path d="M17 7c0-2-2-3-5-3S7 5 7 7s2 3 5 3 5 1 5 3-2 3-5 3-5-1-5-3" />
                            </svg>
                        </span>
                        <p class="sc-info-label">Precio</p>
                    </div>
                    <p class="sc-info-value price">
                        Bs. @Model.Precio.ToString("0.00")
                    </p>
                </div>

                <!-- ESTADO -->
                <div class="sc-info-card">
                    <div class="sc-info-card-top">
                        <span class="sc-info-card-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="9" />
                                <path d="m8 12 2.5 2.5L16 9" />
                            </svg>
                        </span>
                        <p class="sc-info-label">Estado</p>
                    </div>
                    <p class="sc-status-badge">
                        <span class="sc-status-dot"></span>
                        @Model.Estado
                    </p>
                </div>

                <!-- TIEMPO -->
                <div class="sc-info-card">
                    <div class="sc-info-card-top">
                        <span class="sc-info-card-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="9" />
                                <path d="M12 7v5l3 2" />
                            </svg>
                        </span>
                        <p class="sc-info-label">Preparación</p>
                    </div>
                    <p class="sc-info-value">
                        @Model.TiempoEstimado min.
                    </p>
                </div>

            </div>

            <!-- FORMULARIO / ACCIONES -->
            <form asp-action="Delete" method="post">

                <input type="hidden" asp-for="IdPlato" />

                <div class="sc-actions">

                    <button type="submit" class="sc-btn sc-btn-danger">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 6h18" />
                            <path d="M8 6V4h8v2" />
                            <path d="M19 6l-1 14H6L5 6" />
                            <path d="M10 11v5" />
                            <path d="M14 11v5" />
                        </svg>
                        Sí, eliminar plato
                    </button>

                    <a asp-action="Index" class="sc-btn sc-btn-secondary">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 6 6 18" />
                            <path d="m6 6 12 12" />
                        </svg>
                        Cancelar
                    </a>

                </div>

            </form>

        </div>

    </div>

    <!-- PIE INFORMATIVO -->
    <div class="sc-footer-info">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v5" />
            <path d="M12 8h.01" />
        </svg>
        Si no deseas eliminar este plato, selecciona <strong>Cancelar</strong>.
    </div>

</div>