@model RestauranteSaborCasero.Models.Plato

@{
    ViewData["Title"] = "Eliminar Plato";
}

<style>
    /* =========================================================
           ELIMINAR PLATO - SABOR CASERO
           ========================================================= */

    .plato-delete-page {
        width: 100%;
        padding-top: 22px;
    }

    /* =========================================================
           CONTENEDOR PRINCIPAL
           ========================================================= */

    .plato-delete-wrapper {
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
    }

    /* =========================================================
           ENCABEZADO
           ========================================================= */

    .plato-delete-header {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 22px;
    }

    .plato-delete-header-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff1ef;
        border: 1px solid #f2d5d0;
        border-radius: 12px;
        color: var(--sc-danger);
    }

        .plato-delete-header-icon svg {
            width: 24px;
            height: 24px;
            stroke: currentColor;
        }

    .plato-delete-eyebrow {
        margin: 0 0 4px;
        color: var(--sc-danger);
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 1.2px;
        text-transform: uppercase;
    }

    .plato-delete-title {
        margin: 0;
        color: var(--sc-dark);
        font-size: 1.9rem;
        font-weight: 800;
        letter-spacing: -0.7px;
    }

    .plato-delete-subtitle {
        margin: 6px 0 0;
        color: var(--sc-gray);
        font-size: 0.82rem;
    }

    /* =========================================================
           TARJETA DE CONFIRMACIÓN
           ========================================================= */

    .plato-delete-card {
        background: #ffffff;
        border: 1px solid var(--sc-border);
        border-radius: 16px;
        box-shadow: var(--sc-shadow);
        overflow: hidden;
    }

    /* =========================================================
           ALERTA SUPERIOR
           ========================================================= */

    .plato-delete-warning {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        padding: 18px 21px;
        background: #fff8f6;
        border-bottom: 1px solid #f0ddd8;
    }

    .plato-delete-warning-icon {
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: #fde9e5;
        border-radius: 9px;
        color: var(--sc-danger);
    }

        .plato-delete-warning-icon svg {
            width: 18px;
            height: 18px;
            stroke: currentColor;
        }

    .plato-delete-warning-title {
        margin: 0 0 3px;
        color: #8f3535;
        font-size: 0.82rem;
        font-weight: 800;
    }

    .plato-delete-warning-text {
        margin: 0;
        color: #866b66;
        font-size: 0.7rem;
        line-height: 1.45;
    }

    /* =========================================================
           CUERPO
           ========================================================= */

    .plato-delete-body {
        padding: 24px;
    }

    .plato-delete-question {
        margin: 0 0 5px;
        color: var(--sc-dark);
        font-size: 1.05rem;
        font-weight: 800;
    }

    .plato-delete-question-text {
        margin: 0 0 20px;
        color: var(--sc-gray);
        font-size: 0.76rem;
    }

    /* =========================================================
           IDENTIFICADOR
           ========================================================= */

    .plato-delete-record {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
        padding: 11px 13px;
        background: #faf8f6;
        border: 1px solid var(--sc-border);
        border-radius: 9px;
    }

    .plato-delete-record-label {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #827870;
        font-size: 0.68rem;
        font-weight: 700;
    }

        .plato-delete-record-label svg {
            width: 15px;
            height: 15px;
            color: var(--sc-primary);
            stroke: currentColor;
        }

    .plato-delete-record-value {
        color: var(--sc-primary);
        font-size: 0.72rem;
        font-weight: 800;
    }

    /* =========================================================
           INFORMACIÓN DEL PLATO
           ========================================================= */

    .plato-delete-info {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr 1fr;
        gap: 12px;
        margin-bottom: 24px;
    }

    .plato-delete-info-item {
        min-height: 88px;
        padding: 14px;
        background: #faf8f6;
        border: 1px solid #eee7e1;
        border-radius: 11px;
    }

    .plato-delete-info-icon {
        width: 29px;
        height: 29px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 9px;
        background: #f4ebe5;
        border-radius: 7px;
        color: var(--sc-primary);
    }

        .plato-delete-info-icon svg {
            width: 15px;
            height: 15px;
            stroke: currentColor;
        }

    .plato-delete-info-label {
        margin: 0 0 3px;
        color: #887d75;
        font-size: 0.62rem;
        font-weight: 800;
        letter-spacing: 0.4px;
        text-transform: uppercase;
    }

    .plato-delete-info-value {
        margin: 0;
        color: var(--sc-dark);
        font-size: 0.82rem;
        font-weight: 800;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

        .plato-delete-info-value.price {
            color: var(--sc-primary);
            font-size: 0.95rem;
        }

    /* =========================================================
           ESTADO
           ========================================================= */

    .plato-delete-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--sc-success);
        font-size: 0.7rem;
        font-weight: 800;
    }

    .plato-delete-status-dot {
        width: 7px;
        height: 7px;
        background: currentColor;
        border-radius: 50%;
    }

    /* =========================================================
           CONFIRMACIÓN
           ========================================================= */

    .plato-delete-confirmation {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
        padding: 12px 14px;
        background: #fdf8ed;
        border: 1px solid #efdfbf;
        border-radius: 9px;
        color: #806b4b;
        font-size: 0.69rem;
        line-height: 1.4;
    }

        .plato-delete-confirmation svg {
            width: 16px;
            height: 16px;
            flex-shrink: 0;
            color: #a47a35;
            stroke: currentColor;
        }

    /* =========================================================
           ACCIONES
           ========================================================= */

    .plato-delete-actions {
        display: flex;
        align-items: center;
        gap: 9px;
        padding-top: 20px;
        border-top: 1px solid var(--sc-border);
    }

    .plato-delete-btn,
    .plato-delete-cancel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        height: 41px;
        padding: 0 17px;
        border-radius: 9px;
        font-size: 0.75rem;
        font-weight: 800;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    .plato-delete-btn {
        background: var(--sc-danger);
        border: 1px solid var(--sc-danger);
        color: #ffffff;
    }

        .plato-delete-btn:hover {
            background: #ad3d3d;
            border-color: #ad3d3d;
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 6px 14px rgba(201, 74, 74, 0.18);
        }

    .plato-delete-cancel {
        background: #ffffff;
        border: 1px solid #ddd5cc;
        color: #665e58;
        text-decoration: none;
    }

        .plato-delete-cancel:hover {
            background: #f3efeb;
            color: var(--sc-dark);
            transform: translateY(-1px);
        }

        .plato-delete-btn svg,
        .plato-delete-cancel svg {
            width: 16px;
            height: 16px;
            stroke: currentColor;
        }

    /* =========================================================
           INFORMACIÓN INFERIOR
           ========================================================= */

    .plato-delete-footer {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 14px;
        color: #948981;
        font-size: 0.65rem;
    }

        .plato-delete-footer svg {
            width: 14px;
            height: 14px;
            color: #a49a93;
            stroke: currentColor;
        }
</style>


<div class="plato-delete-page">

    <div class="plato-delete-wrapper">


        <!-- =================================================
             ENCABEZADO
             ================================================= -->

        <div class="plato-delete-header">

            <div class="plato-delete-header-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M3 6h18" />
                    <path d="M8 6V4h8v2" />
                    <path d="M19 6l-1 14H6L5 6" />
                    <path d="M10 11v5" />
                    <path d="M14 11v5" />

                </svg>

            </div>

            <div>

                <p class="plato-delete-eyebrow">
                    Gestión del menú
                </p>

                <h1 class="plato-delete-title">
                    Eliminar plato
                </h1>

                <p class="plato-delete-subtitle">
                    Confirma la eliminación del registro seleccionado.
                </p>

            </div>

        </div>


        <!-- =================================================
             TARJETA
             ================================================= -->

        <div class="plato-delete-card">


            <!-- ADVERTENCIA -->

            <div class="plato-delete-warning">

                <div class="plato-delete-warning-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.9"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M10.3 3.6 2.4 17a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.6a2 2 0 0 0-3.4 0Z" />
                        <path d="M12 9v4" />
                        <path d="M12 17h.01" />

                    </svg>

                </div>

                <div>

                    <p class="plato-delete-warning-title">
                        Acción permanente
                    </p>

                    <p class="plato-delete-warning-text">
                        Al confirmar, este plato será eliminado del sistema.
                        Verifica la información antes de continuar.
                    </p>

                </div>

            </div>


            <!-- CUERPO -->

            <div class="plato-delete-body">


                <h2 class="plato-delete-question">
                    ¿Está seguro de eliminar este plato?
                </h2>

                <p class="plato-delete-question-text">
                    Se eliminará el siguiente registro:
                </p>


                <!-- REGISTRO -->

                <div class="plato-delete-record">

                    <span class="plato-delete-record-label">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <rect x="3" y="4" width="18" height="16" rx="2" />
                            <path d="M8 8h8" />
                            <path d="M8 12h8" />
                            <path d="M8 16h4" />

                        </svg>

                        Identificador del registro

                    </span>

                    <span class="plato-delete-record-value">
                        #@Model.IdPlato
                    </span>

                </div>


                <!-- INFORMACIÓN -->

                <div class="plato-delete-info">


                    <!-- NOMBRE -->

                    <div class="plato-delete-info-item">

                        <div class="plato-delete-info-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <path d="M4 7h16" />
                                <path d="M6 7v10" />
                                <path d="M18 7v10" />
                                <path d="M8 17h8" />
                                <path d="M9 11h6" />

                            </svg>

                        </div>

                        <p class="plato-delete-info-label">
                            Nombre
                        </p>

                        <p class="plato-delete-info-value"
                           title="@Model.Nombre">
                            @Model.Nombre
                        </p>

                    </div>


                    <!-- PRECIO -->

                    <div class="plato-delete-info-item">

                        <div class="plato-delete-info-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <path d="M12 3v18" />
                                <path d="M17 7c0-2-2-3-5-3S7 5 7 7s2 3 5 3 5 1 5 3-2 3-5 3-5-1-5-3" />

                            </svg>

                        </div>

                        <p class="plato-delete-info-label">
                            Precio
                        </p>

                        <p class="plato-delete-info-value price">
                            Bs. @Model.Precio.ToString("0.00")
                        </p>

                    </div>


                    <!-- ESTADO -->

                    <div class="plato-delete-info-item">

                        <div class="plato-delete-info-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <circle cx="12" cy="12" r="9" />
                                <path d="m8 12 2.5 2.5L16 9" />

                            </svg>

                        </div>

                        <p class="plato-delete-info-label">
                            Estado
                        </p>

                        <p class="plato-delete-status">

                            <span class="plato-delete-status-dot"></span>

                            @Model.Estado

                        </p>

                    </div>


                    <!-- TIEMPO -->

                    <div class="plato-delete-info-item">

                        <div class="plato-delete-info-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <circle cx="12" cy="12" r="9" />
                                <path d="M12 7v5l3 2" />

                            </svg>

                        </div>

                        <p class="plato-delete-info-label">
                            Preparación
                        </p>

                        <p class="plato-delete-info-value">
                            @Model.TiempoEstimado min.
                        </p>

                    </div>

                </div>


                <!-- AVISO -->

                <div class="plato-delete-confirmation">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 8v4" />
                        <path d="M12 16h.01" />

                    </svg>

                    <span>
                        Revisa los datos anteriores. Esta acción no podrá
                        deshacerse desde esta pantalla.
                    </span>

                </div>


                <!-- FORMULARIO -->

                <form asp-action="Delete"
                      method="post">

                    <input type="hidden"
                           asp-for="IdPlato" />


                    <div class="plato-delete-actions">

                        <button type="submit"
                                class="plato-delete-btn">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.9"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <path d="M3 6h18" />
                                <path d="M8 6V4h8v2" />
                                <path d="M19 6l-1 14H6L5 6" />
                                <path d="M10 11v5" />
                                <path d="M14 11v5" />

                            </svg>

                            Sí, eliminar plato

                        </button>


                        <a asp-action="Index"
                           class="plato-delete-cancel">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <path d="M18 6 6 18" />
                                <path d="m6 6 12 12" />

                            </svg>

                            Cancelar

                        </a>

                    </div>

                </form>

            </div>

        </div>


        <!-- =================================================
             PIE
             ================================================= -->

        <div class="plato-delete-footer">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.7"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <circle cx="12" cy="12" r="9" />
                <path d="M12 11v5" />
                <path d="M12 8h.01" />

            </svg>

            Si no deseas eliminar este plato, selecciona
            <strong>Cancelar</strong>.

        </div>

    </div>

</div>
```
