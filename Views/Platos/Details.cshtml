@model RestauranteSaborCasero.Models.Plato

<h1>Detalle del Plato</h1>

<div>
    <dl class="row">

        <dt class="col-sm-2">
            Id
        </dt>

        <dd class="col-sm-10">
            @Model.IdPlato
        </dd>


        <dt class="col-sm-2">
            Nombre
        </dt>

        <dd class="col-sm-10">
            @Model.Nombre
        </dd>


        <dt class="col-sm-2">
            Precio
        </dt>

        <dd class="col-sm-10">
            @Model.Precio
        </dd>


        <dt class="col-sm-2">
            Estado
        </dt>

        <dd class="col-sm-10">
            @Model.Estado
        </dd>


        <dt class="col-sm-2">
            Tiempo estimado
        </dt>

        <dd class="col-sm-10">
            @Model.TiempoEstimado minutos
        </dd>

    </dl>
</div>

<a asp-action="Edit"
       asp-route-id="@Model.IdPlato"
       class="btn btn-primary">
    Editar
</a>

<a asp-action="Index"
       class="btn btn-secondary">
    Volver
</a>