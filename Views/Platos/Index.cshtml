@model IEnumerable<RestauranteSaborCasero.Models.Plato>

@{
    ViewData["Title"] = "Platos";

    var platos = Model?.ToList() ?? new List<RestauranteSaborCasero.Models.Plato>();

    var totalPlatos = platos.Count;

    var disponibles = platos.Count(p =>
        p.Estado.ToString().Trim().Equals("Disponible", StringComparison.OrdinalIgnoreCase));

    var agotados = platos.Count(p =>
        p.Estado.ToString().Trim().Equals("Agotado", StringComparison.OrdinalIgnoreCase));

    var precioPromedio = totalPlatos > 0
        ? platos.Average(p => p.Precio)
        : 0;
}

<style>
    /* =========================================================
       PLATOS - SABOR CASERO
       TEMA OSCURO / DARK RED
       ========================================================= */

    .platos-page {
        width: 100%;
        padding: 18px 0 35px;

        --platos-bg: #171312;
        --platos-card: #211a18;
        --platos-card-light: #29201d;
        --platos-card-hover: #302420;

        --platos-border: #3a2b27;
        --platos-border-soft: #332622;

        --platos-text: #f5eee9;
        --platos-text-soft: #c6b8b0;
        --platos-text-muted: #8f8078;

        --platos-red: #8f2f25;
        --platos-red-hover: #a63a2e;
        --platos-red-dark: #68221c;

        --platos-gold: #c59b58;
        --platos-gold-soft: #3a2e20;

        --platos-success: #63b582;
        --platos-success-bg: #1d3328;

        --platos-danger: #dc7373;
        --platos-danger-bg: #382122;

        --platos-info: #72a9d1;
        --platos-info-bg: #202f3c;

        --platos-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    }

    /* =========================================================
       ENCABEZADO
       ========================================================= */

    .platos-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
    }

    .platos-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
    }

    .platos-header-icon {
        width: 54px;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;

        background: linear-gradient(
            145deg,
            #321d19,
            #251916
        );

        color: #c85a49;
        border: 1px solid #5a3029;
        border-radius: 14px;

        box-shadow:
            inset 0 1px 0 rgba(255,255,255,0.03),
            0 6px 18px rgba(0,0,0,0.2);
    }

    .platos-header-icon svg {
        width: 27px;
        height: 27px;
        stroke: currentColor;
    }

    .platos-eyebrow {
        margin: 0 0 5px;

        color: #b34a3a;

        font-size: 0.67rem;
        font-weight: 850;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .platos-title {
        margin: 0;

        color: var(--platos-text);

        font-size: 1.95rem;
        font-weight: 850;
        letter-spacing: -0.7px;
        line-height: 1.1;
    }

    .platos-description {
        margin: 7px 0 0;

        color: var(--platos-text-muted);

        font-size: 0.79rem;
        font-weight: 500;
    }

    /* =========================================================
       BOTÓN NUEVO PLATO
       ========================================================= */

    .platos-create-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;

        min-height: 44px;
        padding: 0 18px;

        flex-shrink: 0;

        background: var(--platos-red);
        color: #ffffff !important;

        border: 1px solid #a33b30;
        border-radius: 10px;

        font-size: 0.76rem;
        font-weight: 850;

        text-decoration: none;

        box-shadow:
            0 7px 18px rgba(0,0,0,0.25),
            0 3px 10px rgba(104,34,28,0.2);

        transition:
            background 0.2s ease,
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .platos-create-btn:hover {
        background: var(--platos-red-hover);
        border-color: #bd493b;

        color: #ffffff !important;

        transform: translateY(-2px);

        box-shadow:
            0 10px 22px rgba(0,0,0,0.32),
            0 4px 14px rgba(143,47,37,0.25);
    }

    .platos-create-btn svg {
        width: 17px;
        height: 17px;
        stroke: currentColor;
    }

    /* =========================================================
       ESTADÍSTICAS
       ========================================================= */

    .platos-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;

        margin-bottom: 14px;
    }

    .platos-stat {
        position: relative;

        display: flex;
        align-items: center;
        gap: 12px;

        min-height: 76px;
        padding: 13px 16px;

        background: var(--platos-card);

        border: 1px solid var(--platos-border);
        border-radius: 13px;

        box-shadow: var(--platos-shadow);

        overflow: hidden;

        transition:
            transform 0.2s ease,
            border-color 0.2s ease,
            background 0.2s ease;
    }

    .platos-stat::after {
        content: "";

        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;

        width: 3px;

        background: var(--platos-red);
        opacity: 0.8;
    }

    .platos-stat:hover {
        transform: translateY(-2px);

        background: var(--platos-card-light);

        border-color: #4b332e;
    }

    .platos-stat-icon {
        width: 41px;
        height: 41px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 10px;
    }

    .platos-stat-icon svg {
        width: 19px;
        height: 19px;
        stroke: currentColor;
    }

    .platos-stat-icon.total {
        background: #34201d;
        color: #c85a49;
    }

    .platos-stat-icon.available {
        background: var(--platos-success-bg);
        color: var(--platos-success);
    }

    .platos-stat-icon.unavailable {
        background: var(--platos-danger-bg);
        color: var(--platos-danger);
    }

    .platos-stat-icon.average {
        background: var(--platos-gold-soft);
        color: var(--platos-gold);
    }

    .platos-stat-content {
        min-width: 0;
    }

    .platos-stat-label {
        margin: 0 0 4px;

        color: var(--platos-text-muted);

        font-size: 0.61rem;
        font-weight: 850;

        letter-spacing: 0.55px;
        text-transform: uppercase;
    }

    .platos-stat-value {
        margin: 0;

        color: var(--platos-text);

        font-size: 1.12rem;
        font-weight: 850;

        line-height: 1.1;
    }

    .platos-stat-value.primary {
        color: #c85a49;
    }

    /* =========================================================
       BARRA DE INFORMACIÓN
       ========================================================= */

    .platos-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;

        min-height: 50px;

        padding: 8px 15px;
        margin-bottom: 12px;

        background: #1d1715;

        border: 1px solid var(--platos-border);
        border-radius: 11px;

        box-shadow:
            0 5px 18px rgba(0,0,0,0.18);
    }

    .platos-toolbar-info {
        display: flex;
        align-items: center;
        gap: 9px;

        color: var(--platos-text-soft);

        font-size: 0.72rem;
        font-weight: 650;
    }

    .platos-toolbar-icon {
        width: 30px;
        height: 30px;

        display: flex;
        align-items: center;
        justify-content: center;

        background: #30201d;

        border: 1px solid #49302a;
        border-radius: 7px;

        color: #b84b3b;
    }

    .platos-toolbar-icon svg {
        width: 15px;
        height: 15px;
        stroke: currentColor;
    }

    .platos-count {
        color: var(--platos-text);
        font-weight: 850;
    }

    .platos-toolbar-label {
        color: var(--platos-text-muted);
    }

    .platos-toolbar-right {
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .platos-toolbar-dot {
        width: 7px;
        height: 7px;

        background: var(--platos-success);

        border-radius: 50%;

        box-shadow:
            0 0 0 3px rgba(99,181,130,0.08),
            0 0 8px rgba(99,181,130,0.25);
    }

    /* =========================================================
       TABLA
       ========================================================= */

    .platos-table-card {
        background: var(--platos-card);

        border: 1px solid var(--platos-border);
        border-radius: 15px;

        box-shadow: var(--platos-shadow);

        overflow: hidden;
    }

    .platos-table {
        width: 100%;
        margin: 0;

        border-collapse: separate;
        border-spacing: 0;

        background: var(--platos-card);

        vertical-align: middle;
    }

    /* =========================================================
       CABECERA
       ========================================================= */

    .platos-table thead th {
        height: 50px;

        padding: 0 18px;

        background: #181311;

        border-bottom: 1px solid #44312c;

        color: #a9968c;

        font-size: 0.65rem;
        font-weight: 850;

        letter-spacing: 0.75px;

        text-transform: uppercase;

        white-space: nowrap;

        vertical-align: middle;
    }

    .platos-table thead th:first-child {
        width: 75px;
        padding-left: 22px;
    }

    .platos-table thead th:nth-child(2) {
        width: 32%;
    }

    .platos-table thead th:nth-child(3) {
        width: 15%;
    }

    .platos-table thead th:nth-child(4) {
        width: 16%;
    }

    .platos-table thead th:nth-child(5) {
        width: 18%;
    }

    .platos-table thead th:last-child {
        width: 150px;

        padding-right: 22px;

        text-align: right;
    }

    /* =========================================================
       FILAS
       ========================================================= */

    .platos-table tbody tr {
        height: 74px;

        background: var(--platos-card);

        transition:
            background 0.16s ease;
    }

    .platos-table tbody tr:hover {
        background: #2a201d;
    }

    .platos-table tbody tr:not(:last-child) td {
        border-bottom: 1px solid var(--platos-border-soft);
    }

    .platos-table tbody td {
        padding: 0 18px;

        color: var(--platos-text);

        font-size: 0.78rem;

        vertical-align: middle;
    }

    .platos-table tbody td:first-child {
        padding-left: 22px;
    }

    .platos-table tbody td:last-child {
        padding-right: 22px;
    }

    /* =========================================================
       ID
       ========================================================= */

    .plato-id {
        display: inline-flex;

        align-items: center;
        justify-content: center;

        min-width: 37px;
        height: 28px;

        padding: 0 8px;

        background: #302622;

        border: 1px solid #49352f;
        border-radius: 7px;

        color: #a9978d;

        font-size: 0.65rem;
        font-weight: 850;
    }

    /* =========================================================
       NOMBRE DEL PLATO
       ========================================================= */

    .plato-name {
        display: flex;
        align-items: center;

        gap: 11px;

        min-width: 0;
    }

    .plato-avatar {
        width: 40px;
        height: 40px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        background: #34201d;

        border: 1px solid #54312a;
        border-radius: 10px;

        color: #c85a49;
    }

    .plato-avatar svg {
        width: 19px;
        height: 19px;
        stroke: currentColor;
    }

    .plato-name-content {
        min-width: 0;
    }

    .plato-name-text {
        display: block;

        overflow: hidden;

        color: #f2e9e4;

        font-size: 0.82rem;
        font-weight: 800;

        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .plato-name-subtitle {
        display: block;

        margin-top: 3px;

        color: #81736c;

        font-size: 0.61rem;
        font-weight: 550;
    }

    /* =========================================================
       PRECIO
       ========================================================= */

    .plato-price {
        color: #d05a48;

        font-size: 0.88rem;
        font-weight: 850;
    }

    .plato-currency {
        margin-right: 3px;

        color: #8d7d74;

        font-size: 0.62rem;
        font-weight: 750;
    }

    /* =========================================================
       ESTADO
       ========================================================= */

    .plato-status {
        display: inline-flex;

        align-items: center;
        gap: 7px;

        min-width: 96px;

        padding: 7px 10px;

        border-radius: 7px;

        font-size: 0.65rem;
        font-weight: 850;
    }

    .plato-status-dot {
        width: 6px;
        height: 6px;

        flex-shrink: 0;

        border-radius: 50%;
    }

    .plato-status.available {
        background: var(--platos-success-bg);
        color: var(--platos-success);
    }

    .plato-status.available .plato-status-dot {
        background: var(--platos-success);

        box-shadow:
            0 0 0 3px rgba(99,181,130,0.08),
            0 0 8px rgba(99,181,130,0.2);
    }

    .plato-status.unavailable {
        background: var(--platos-danger-bg);
        color: var(--platos-danger);
    }

    .plato-status.unavailable .plato-status-dot {
        background: var(--platos-danger);

        box-shadow:
            0 0 0 3px rgba(220,115,115,0.08);
    }

    .plato-status.other {
        background: #302a27;
        color: #9b8d85;
    }

    .plato-status.other .plato-status-dot {
        background: #8b7c74;
    }

    /* =========================================================
       TIEMPO
       ========================================================= */

    .plato-time {
        display: inline-flex;

        align-items: center;
        gap: 7px;

        color: #b5a69e;

        font-size: 0.73rem;
        font-weight: 700;

        white-space: nowrap;
    }

    .plato-time-icon {
        width: 29px;
        height: 29px;

        display: flex;
        align-items: center;
        justify-content: center;

        background: #30271f;

        border: 1px solid #46372b;
        border-radius: 7px;

        color: var(--platos-gold);
    }

    .plato-time-icon svg {
        width: 15px;
        height: 15px;
        stroke: currentColor;
    }

    /* =========================================================
       ACCIONES
       ========================================================= */

    .plato-actions {
        display: flex;

        align-items: center;
        justify-content: flex-end;

        gap: 7px;
    }

    .plato-action {
        position: relative;

        width: 35px;
        height: 35px;

        display: inline-flex;

        align-items: center;
        justify-content: center;

        border: 1px solid transparent;
        border-radius: 8px;

        text-decoration: none;

        transition:
            background 0.18s ease,
            border-color 0.18s ease,
            color 0.18s ease,
            transform 0.18s ease;
    }

    .plato-action:hover {
        transform: translateY(-1px);
    }

    .plato-action svg {
        width: 16px;
        height: 16px;
        stroke: currentColor;
    }

    /* VER */

    .plato-action.view {
        background: #2d2825;
        border-color: #443b36;

        color: #aaa099;
    }

    .plato-action.view:hover {
        background: #3a332f;
        border-color: #5a4d45;

        color: #f0e8e3;
    }

    /* EDITAR */

    .plato-action.edit {
        background: #352b20;
        border-color: #4a3b29;

        color: #c7a05e;
    }

    .plato-action.edit:hover {
        background: #463720;
        border-color: #66502e;

        color: #e0ba70;
    }

    /* ELIMINAR */

    .plato-action.delete {
        background: #382122;
        border-color: #513033;

        color: #d77474;
    }

    .plato-action.delete:hover {
        background: #4a292a;
        border-color: #6a393b;

        color: #ed8989;
    }

    /* =========================================================
       TOOLTIP
       ========================================================= */

    .plato-action::after {
        content: attr(title);

        position: absolute;

        left: 50%;
        bottom: calc(100% + 7px);

        z-index: 20;

        transform: translateX(-50%) translateY(3px);

        padding: 5px 8px;

        background: #100e0d;

        color: #ffffff;

        border: 1px solid #41332e;
        border-radius: 6px;

        font-size: 0.59rem;
        font-weight: 700;

        white-space: nowrap;

        opacity: 0;
        visibility: hidden;

        pointer-events: none;

        transition:
            opacity 0.15s ease,
            transform 0.15s ease;
    }

    .plato-action:hover::after {
        opacity: 1;
        visibility: visible;

        transform: translateX(-50%) translateY(0);
    }

    /* =========================================================
       ESTADO VACÍO
       ========================================================= */

    .platos-empty {
        display: flex;

        align-items: center;
        flex-direction: column;

        padding: 75px 20px;

        background: var(--platos-card);
    }

    .platos-empty-icon {
        width: 66px;
        height: 66px;

        display: flex;
        align-items: center;
        justify-content: center;

        margin-bottom: 16px;

        background: #34201d;

        border: 1px solid #54312a;
        border-radius: 15px;

        color: #c85a49;

        box-shadow:
            0 8px 20px rgba(0,0,0,0.22);
    }

    .platos-empty-icon svg {
        width: 29px;
        height: 29px;
        stroke: currentColor;
    }

    .platos-empty-title {
        margin: 0 0 7px;

        color: #f1e8e3;

        font-size: 1rem;
        font-weight: 850;
    }

    .platos-empty-text {
        margin: 0 0 20px;

        color: #8f8179;

        font-size: 0.76rem;
        font-weight: 550;

        text-align: center;
    }

    .platos-empty-btn {
        display: inline-flex;

        align-items: center;
        justify-content: center;

        gap: 7px;

        min-height: 39px;

        padding: 0 15px;

        background: var(--platos-red);

        border: 1px solid #a33b30;
        border-radius: 8px;

        color: #ffffff !important;

        font-size: 0.7rem;
        font-weight: 850;

        text-decoration: none;

        transition:
            background 0.18s ease,
            transform 0.18s ease;
    }

    .platos-empty-btn:hover {
        background: var(--platos-red-hover);

        color: #ffffff !important;

        transform: translateY(-1px);
    }

    .platos-empty-btn svg {
        width: 15px;
        height: 15px;
        stroke: currentColor;
    }
</style>


<div class="platos-page">

    <!-- =====================================================
         ENCABEZADO
         ===================================================== -->

    <div class="platos-header">

        <div class="platos-header-left">

            <div class="platos-header-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <circle cx="12" cy="12" r="8" />
                    <path d="M4 12h16" />
                    <path d="M12 4c2.5 2 3.5 4.5 3.5 8s-1 6-3.5 8" />

                </svg>

            </div>

            <div>

                <p class="platos-eyebrow">
                    Gestión del menú
                </p>

                <h1 class="platos-title">
                    Platos
                </h1>

                <p class="platos-description">
                    Administra los platos, precios, disponibilidad y tiempos de preparación.
                </p>

            </div>

        </div>


        <a asp-action="Create"
           class="platos-create-btn">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <path d="M12 5v14" />
                <path d="M5 12h14" />

            </svg>

            Nuevo plato

        </a>

    </div>


    <!-- =====================================================
         ESTADÍSTICAS
         ===================================================== -->

    <div class="platos-stats">

        <!-- TOTAL -->

        <div class="platos-stat">

            <div class="platos-stat-icon total">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M4 5h16v14H4z" />
                    <path d="M8 9h8" />
                    <path d="M8 13h5" />

                </svg>

            </div>

            <div class="platos-stat-content">

                <p class="platos-stat-label">
                    Total platos
                </p>

                <p class="platos-stat-value">
                    @totalPlatos
                </p>

            </div>

        </div>


        <!-- DISPONIBLES -->

        <div class="platos-stat">

            <div class="platos-stat-icon available">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <circle cx="12" cy="12" r="9" />
                    <path d="m8 12 2.5 2.5L16 9" />

                </svg>

            </div>

            <div class="platos-stat-content">

                <p class="platos-stat-label">
                    Disponibles
                </p>

                <p class="platos-stat-value">
                    @disponibles
                </p>

            </div>

        </div>


        <!-- AGOTADOS -->

        <div class="platos-stat">

            <div class="platos-stat-icon unavailable">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <circle cx="12" cy="12" r="9" />
                    <path d="M8 8l8 8" />
                    <path d="m16 8-8 8" />

                </svg>

            </div>

            <div class="platos-stat-content">

                <p class="platos-stat-label">
                    No disponibles
                </p>

                <p class="platos-stat-value">
                    @agotados
                </p>

            </div>

        </div>


        <!-- PRECIO PROMEDIO -->

        <div class="platos-stat">

            <div class="platos-stat-icon average">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M12 3v18" />
                    <path d="M17 7c0-2-2-3-5-3S7 5 7 7s2 3 5 3 5 1 5 3-2 3-5 3-5-1-5-3" />

                </svg>

            </div>

            <div class="platos-stat-content">

                <p class="platos-stat-label">
                    Precio promedio
                </p>

                <p class="platos-stat-value primary">
                    Bs @precioPromedio.ToString("0.00")
                </p>

            </div>

        </div>

    </div>


    <!-- =====================================================
         BARRA DE INFORMACIÓN
         ===================================================== -->

    <div class="platos-toolbar">

        <div class="platos-toolbar-info">

            <span class="platos-toolbar-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M8 6h13" />
                    <path d="M8 12h13" />
                    <path d="M8 18h13" />
                    <path d="M3 6h.01" />
                    <path d="M3 12h.01" />
                    <path d="M3 18h.01" />

                </svg>

            </span>

            <span>

                <span class="platos-count">
                    @totalPlatos
                </span>

                <span class="platos-toolbar-label">
                    platos registrados
                </span>

            </span>

        </div>


        <div class="platos-toolbar-right">

            <span class="platos-toolbar-dot"></span>

            <span class="platos-toolbar-label">
                Catálogo del restaurante
            </span>

        </div>

    </div>


    <!-- =====================================================
         TABLA
         ===================================================== -->

    <div class="platos-table-card">

        @if (platos.Any())
        {
            <table class="platos-table">

                <thead>

                    <tr>

                        <th>
                            ID
                        </th>

                        <th>
                            Plato
                        </th>

                        <th>
                            Precio
                        </th>

                        <th>
                            Estado
                        </th>

                        <th>
                            Tiempo estimado
                        </th>

                        <th>
                            Acciones
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var plato in platos)
                    {
                        var estadoTexto = plato.Estado
                            .ToString()
                            .Trim();

                        var estado = estadoTexto.ToLowerInvariant();

                        var estadoClase =
                            estado == "disponible"
                                ? "available"
                                : estado == "agotado" ||
                                  estado == "no disponible" ||
                                  estado == "inactivo"
                                    ? "unavailable"
                                    : "other";

                        <tr>

                            <!-- ID -->

                            <td>

                                <span class="plato-id">
                                    #@plato.IdPlato
                                </span>

                            </td>


                            <!-- PLATO -->

                            <td>

                                <div class="plato-name">

                                    <span class="plato-avatar">

                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8"
                                             stroke-linecap="round"
                                             stroke-linejoin="round">

                                            <circle cx="12" cy="12" r="8" />
                                            <path d="M4 12h16" />
                                            <path d="M12 4c2.5 2 3.5 4.5 3.5 8s-1 6-3.5 8" />

                                        </svg>

                                    </span>

                                    <span class="plato-name-content">

                                        <span class="plato-name-text"
                                              title="@plato.Nombre">

                                            @plato.Nombre

                                        </span>

                                        <span class="plato-name-subtitle">
                                            Plato del menú
                                        </span>

                                    </span>

                                </div>

                            </td>


                            <!-- PRECIO -->

                            <td>

                                <span class="plato-price">

                                    <span class="plato-currency">
                                        Bs
                                    </span>

                                    @plato.Precio.ToString("0.00")

                                </span>

                            </td>


                            <!-- ESTADO -->

                            <td>

                                <span class="plato-status @estadoClase">

                                    <span class="plato-status-dot"></span>

                                    @estadoTexto

                                </span>

                            </td>


                            <!-- TIEMPO -->

                            <td>

                                <span class="plato-time">

                                    <span class="plato-time-icon">

                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8"
                                             stroke-linecap="round"
                                             stroke-linejoin="round">

                                            <circle cx="12" cy="12" r="9" />
                                            <path d="M12 7v5l3 2" />

                                        </svg>

                                    </span>

                                    @plato.TiempoEstimado min

                                </span>

                            </td>


                            <!-- ACCIONES -->

                            <td>

                                <div class="plato-actions">

                                    <!-- VER -->

                                    <a asp-action="Details"
                                       asp-route-id="@plato.IdPlato"
                                       class="plato-action view"
                                       title="Ver detalles"
                                       aria-label="Ver detalles">

                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8"
                                             stroke-linecap="round"
                                             stroke-linejoin="round">

                                            <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" />
                                            <circle cx="12" cy="12" r="2.5" />

                                        </svg>

                                    </a>


                                    <!-- EDITAR -->

                                    <a asp-action="Edit"
                                       asp-route-id="@plato.IdPlato"
                                       class="plato-action edit"
                                       title="Editar plato"
                                       aria-label="Editar plato">

                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8"
                                             stroke-linecap="round"
                                             stroke-linejoin="round">

                                            <path d="M12 20h9" />
                                            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z" />

                                        </svg>

                                    </a>


                                    <!-- ELIMINAR -->

                                    <a asp-action="Delete"
                                       asp-route-id="@plato.IdPlato"
                                       class="plato-action delete"
                                       title="Eliminar plato"
                                       aria-label="Eliminar plato">

                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8"
                                             stroke-linecap="round"
                                             stroke-linejoin="round">

                                            <path d="M4 7h16" />
                                            <path d="M10 11v6" />
                                            <path d="M14 11v6" />
                                            <path d="M6 7l1 14h10l1-14" />
                                            <path d="M9 7V4h6v3" />

                                        </svg>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }
        else
        {
            <div class="platos-empty">

                <div class="platos-empty-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <circle cx="12" cy="12" r="8" />
                        <path d="M4 12h16" />
                        <path d="M12 4c2.5 2 3.5 4.5 3.5 8s-1 6-3.5 8" />

                    </svg>

                </div>

                <h3 class="platos-empty-title">
                    No hay platos registrados
                </h3>

                <p class="platos-empty-text">
                    Comienza agregando el primer plato al menú del restaurante.
                </p>

                <a asp-action="Create"
                   class="platos-empty-btn">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M12 5v14" />
                        <path d="M5 12h14" />

                    </svg>

                    Agregar primer plato

                </a>

            </div>
        }

    </div>

</div>
