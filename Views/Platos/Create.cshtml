@model RestauranteSaborCasero.Models.Plato

@using RestauranteSaborCasero.Models

@{
    ViewData["Title"] = "Nuevo Plato";
}

<style>
    /* =========================================================
       CREAR PLATO - SABOR CASERO
       ESTILO OSCURO / DARK RED
       ========================================================= */

    .plato-create-page {
        width: 100%;
        padding-top: 12px;
        color: #f1e9e3;
    }

    /* =========================================================
       ENCABEZADO
       ========================================================= */

    .plato-create-header {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 25px;
    }

    .plato-create-header-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #321b18;
        border: 1px solid #623027;
        border-radius: 12px;
        color: #c99b58;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
    }

    .plato-create-header-icon svg {
        width: 27px;
        height: 27px;
        stroke: currentColor;
    }

    .plato-create-eyebrow {
        margin: 0 0 4px;
        color: #c99b58;
        font-size: 0.7rem;
        font-weight: 900;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .plato-create-title {
        margin: 0;
        color: #f6eee8;
        font-size: 2rem;
        font-weight: 900;
        letter-spacing: -0.8px;
        line-height: 1.1;
    }

    .plato-create-description {
        margin: 7px 0 0;
        color: #9f9087;
        font-size: 0.82rem;
        font-weight: 500;
    }

    /* =========================================================
       CONTENEDOR PRINCIPAL
       ========================================================= */

    .plato-create-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 310px;
        gap: 20px;
        align-items: start;
    }

    /* =========================================================
       FORMULARIO
       ========================================================= */

    .plato-form-card {
        background: #211917;
        border: 1px solid #392824;
        border-radius: 15px;
        box-shadow: 0 14px 35px rgba(0, 0, 0, 0.28);
        overflow: hidden;
    }

    .plato-form-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 22px;
        background: #271c1a;
        border-bottom: 1px solid #3b2925;
    }

    .plato-form-card-title {
        margin: 0;
        color: #f2e9e3;
        font-size: 0.98rem;
        font-weight: 900;
    }

    .plato-form-card-subtitle {
        margin: 4px 0 0;
        color: #95867e;
        font-size: 0.72rem;
    }

    .plato-form-badge {
        padding: 7px 11px;
        background: #381e1b;
        border: 1px solid #663127;
        border-radius: 7px;
        color: #d0a15b;
        font-size: 0.65rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .plato-form-body {
        padding: 25px;
    }

    /* =========================================================
       CAMPOS
       ========================================================= */

    .plato-form-group {
        margin-bottom: 20px;
    }

    .plato-form-label {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 8px;
        color: #eee4dd;
        font-size: 0.77rem;
        font-weight: 900;
    }

    .plato-form-required {
        color: #d35d55;
        font-size: 0.72rem;
    }

    .plato-form-input-wrapper {
        position: relative;
    }

    .plato-form-input-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        width: 17px;
        height: 17px;
        color: #8f7168;
        transform: translateY(-50%);
        pointer-events: none;
        z-index: 2;
    }

    .plato-form-input-icon svg {
        width: 100%;
        height: 100%;
        stroke: currentColor;
    }

    .plato-form-input {
        width: 100%;
        height: 46px;
        padding: 0 14px 0 42px;
        background: #171211;
        border: 1px solid #44312b;
        border-radius: 9px;
        color: #f2e9e3;
        font-size: 0.81rem;
        font-weight: 600;
        outline: none;
        transition: border-color 0.2s ease,
                    box-shadow 0.2s ease,
                    background 0.2s ease;
        box-sizing: border-box;
    }

    .plato-form-input:hover {
        background: #1b1513;
        border-color: #614139;
    }

    .plato-form-input:focus {
        background: #1b1513;
        border-color: #96382c;
        box-shadow: 0 0 0 3px rgba(150, 56, 44, 0.14);
    }

    .plato-form-input::placeholder {
        color: #756861;
    }

    .plato-form-input[type="number"] {
        padding-right: 14px;
    }

    /* =========================================================
       SELECT
       ========================================================= */

    .plato-form-select {
        width: 100%;
        height: 46px;
        padding: 0 38px 0 42px;
        background: #171211;
        border: 1px solid #44312b;
        border-radius: 9px;
        color: #f2e9e3;
        font-size: 0.81rem;
        font-weight: 600;
        outline: none;
        cursor: pointer;
        appearance: auto;
        transition: border-color 0.2s ease,
                    box-shadow 0.2s ease,
                    background 0.2s ease;
        box-sizing: border-box;
    }

    .plato-form-select:hover {
        background: #1b1513;
        border-color: #614139;
    }

    .plato-form-select:focus {
        border-color: #96382c;
        box-shadow: 0 0 0 3px rgba(150, 56, 44, 0.14);
    }

    .plato-form-select option {
        color: #f2e9e3;
        background: #211917;
    }

    /* =========================================================
       DOS COLUMNAS
       ========================================================= */

    .plato-form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    /* =========================================================
       AYUDA
       ========================================================= */

    .plato-form-help {
        margin: 6px 0 0;
        color: #81736c;
        font-size: 0.67rem;
        line-height: 1.45;
    }

    /* =========================================================
       VALIDACIÓN
       ========================================================= */

    .plato-validation {
        display: block;
        margin-top: 6px;
        color: #d7655d;
        font-size: 0.7rem;
        font-weight: 700;
    }

    /* =========================================================
       SECCIÓN RECETA
       ========================================================= */

    .plato-receta-section {
        margin-top: 30px;
        padding-top: 23px;
        border-top: 1px solid #3b2925;
    }

    .plato-receta-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 8px;
    }

    .plato-receta-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin: 0;
        color: #eee4dd;
        font-size: 1rem;
        font-weight: 900;
    }

    .plato-receta-title-icon {
        width: 31px;
        height: 31px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #321b18;
        border: 1px solid #5e3028;
        border-radius: 8px;
        color: #c99b58;
        flex-shrink: 0;
    }

    .plato-receta-title-icon svg {
        width: 16px;
        height: 16px;
        stroke: currentColor;
    }

    .plato-add-ingredient-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        height: 37px;
        padding: 0 13px;
        background: #7f2d24;
        border: 1px solid #9a3b30;
        border-radius: 8px;
        color: #ffffff;
        font-size: 0.72rem;
        font-weight: 900;
        cursor: pointer;
        box-shadow: 0 6px 14px rgba(95, 29, 22, 0.25);
        transition: background 0.2s ease,
                    border-color 0.2s ease,
                    transform 0.2s ease,
                    box-shadow 0.2s ease;
    }

    .plato-add-ingredient-btn:hover {
        background: #98362a;
        border-color: #b5483a;
        transform: translateY(-1px);
        box-shadow: 0 8px 18px rgba(110, 31, 24, 0.32);
    }

    .plato-add-ingredient-btn svg {
        width: 15px;
        height: 15px;
        stroke: currentColor;
    }

    .plato-receta-description {
        margin: 0 0 15px;
        color: #82746d;
        font-size: 0.68rem;
        line-height: 1.5;
    }

    .plato-ingredientes-container {
        padding: 13px;
        background: #181311;
        border: 1px solid #352621;
        border-radius: 10px;
        min-height: 20px;
    }

    /* =========================================================
       FILAS DE INGREDIENTES CREADAS POR JAVASCRIPT
       ========================================================= */

    .plato-ingrediente-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
    }

    .plato-ingrediente-row:last-child {
        margin-bottom: 0;
    }

    .plato-ingrediente-row .plato-form-select {
        flex: 2;
        padding-left: 14px;
    }

    .plato-ingrediente-row .plato-form-input {
        flex: 1;
        padding-left: 14px;
    }

    .plato-remove-ingredient-btn {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: #421e1d;
        border: 1px solid #71302d;
        border-radius: 8px;
        color: #e28b85;
        cursor: pointer;
        font-size: 0;
        transition: background 0.2s ease,
                    border-color 0.2s ease,
                    color 0.2s ease,
                    transform 0.2s ease;
    }

    .plato-remove-ingredient-btn:hover {
        background: #632322;
        border-color: #963832;
        color: #ffffff;
        transform: translateY(-1px);
    }

    .plato-remove-ingredient-btn svg {
        width: 17px;
        height: 17px;
        stroke: currentColor;
    }

    .plato-receta-empty {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 58px;
        color: #70625c;
        font-size: 0.7rem;
        font-weight: 600;
        text-align: center;
    }

    .plato-receta-empty svg {
        width: 17px;
        height: 17px;
        stroke: currentColor;
    }

    /* =========================================================
       BOTONES
       ========================================================= */

    .plato-form-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 8px;
        padding-top: 21px;
        border-top: 1px solid #3b2925;
    }

    .plato-save-btn,
    .plato-cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 43px;
        padding: 0 18px;
        border-radius: 9px;
        font-size: 0.77rem;
        font-weight: 900;
        text-decoration: none;
        cursor: pointer;
        transition: transform 0.2s ease,
                    box-shadow 0.2s ease,
                    background 0.2s ease,
                    border-color 0.2s ease;
    }

    .plato-save-btn {
        background: #842f25;
        border: 1px solid #9c3b30;
        color: #ffffff;
        box-shadow: 0 7px 17px rgba(90, 27, 20, 0.25);
    }

    .plato-save-btn:hover {
        background: #9b392d;
        border-color: #b24739;
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 9px 20px rgba(105, 30, 22, 0.34);
    }

    .plato-cancel-btn {
        background: #29201d;
        border: 1px solid #46342e;
        color: #b9aaa1;
    }

    .plato-cancel-btn:hover {
        background: #342724;
        border-color: #5b4038;
        color: #f0e7e1;
        transform: translateY(-1px);
    }

    .plato-save-btn svg,
    .plato-cancel-btn svg {
        width: 16px;
        height: 16px;
        stroke: currentColor;
    }

    /* =========================================================
       TARJETA LATERAL
       ========================================================= */

    .plato-info-card {
        background: #211917;
        border: 1px solid #392824;
        border-radius: 15px;
        box-shadow: 0 14px 35px rgba(0, 0, 0, 0.28);
        overflow: hidden;
    }

    .plato-info-top {
        padding: 23px 21px;
        background: linear-gradient(145deg, #67271f 0%, #3a1b18 100%);
        border-bottom: 1px solid #5a2922;
        color: #ffffff;
    }

    .plato-info-icon {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
        background: rgba(0, 0, 0, 0.18);
        border: 1px solid rgba(255, 255, 255, 0.13);
        border-radius: 11px;
        color: #e0b66d;
    }

    .plato-info-icon svg {
        width: 24px;
        height: 24px;
        stroke: currentColor;
    }

    .plato-info-title {
        margin: 0;
        color: #ffffff;
        font-size: 1rem;
        font-weight: 900;
    }

    .plato-info-text {
        margin: 7px 0 0;
        color: rgba(255, 255, 255, 0.68);
        font-size: 0.72rem;
        line-height: 1.55;
    }

    .plato-info-body {
        padding: 20px 21px;
        background: #211917;
    }

    .plato-info-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .plato-info-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
    }

    .plato-info-item-icon {
        width: 31px;
        height: 31px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: #2c201d;
        border: 1px solid #47312b;
        border-radius: 8px;
        color: #c99b58;
    }

    .plato-info-item-icon svg {
        width: 15px;
        height: 15px;
        stroke: currentColor;
    }

    .plato-info-item-title {
        margin: 1px 0 3px;
        color: #e9dfd8;
        font-size: 0.73rem;
        font-weight: 900;
    }

    .plato-info-item-text {
        margin: 0;
        color: #8b7c74;
        font-size: 0.67rem;
        line-height: 1.45;
    }

    /* =========================================================
       FOOTER LATERAL
       ========================================================= */

    .plato-info-footer {
        padding: 14px 21px;
        background: #191412;
        border-top: 1px solid #372621;
        color: #796b64;
        font-size: 0.65rem;
        line-height: 1.45;
    }

    .plato-info-footer strong {
        color: #c55b51;
    }
</style>

<div class="plato-create-page">

    <!-- =====================================================
         ENCABEZADO
         ===================================================== -->

    <div class="plato-create-header">

        <div class="plato-create-header-icon">
            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <circle cx="12" cy="12" r="8" />
                <path d="M4 12h16" />
                <path d="M12 4c2.5 2 3.5 4.5 3.5 8s-1 6-3.5 8" />

            </svg>
        </div>

        <div>

            <p class="plato-create-eyebrow">
                Gestión del menú
            </p>

            <h1 class="plato-create-title">
                Nuevo plato
            </h1>

            <p class="plato-create-description">
                Registra un nuevo plato en el menú de Sabor Casero.
            </p>

        </div>

    </div>


    <!-- =====================================================
         CONTENIDO
         ===================================================== -->

    <div class="plato-create-layout">

        <!-- =================================================
             FORMULARIO
             ================================================= -->

        <div class="plato-form-card">

            <div class="plato-form-card-header">

                <div>

                    <h2 class="plato-form-card-title">
                        Información del plato
                    </h2>

                    <p class="plato-form-card-subtitle">
                        Completa los datos principales del producto.
                    </p>

                </div>

                <span class="plato-form-badge">
                    Nuevo registro
                </span>

            </div>


            <div class="plato-form-body">

                <form asp-action="Create" method="post">

                    <!-- =================================================
                         NOMBRE
                         ================================================= -->

                    <div class="plato-form-group">

                        <label asp-for="Nombre"
                               class="plato-form-label">

                            Nombre del plato

                            <span class="plato-form-required">
                                *
                            </span>

                        </label>

                        <div class="plato-form-input-wrapper">

                            <span class="plato-form-input-icon">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <circle cx="12" cy="12" r="8" />
                                    <path d="M4 12h16" />

                                </svg>

                            </span>

                            <input asp-for="Nombre"
                                   class="plato-form-input"
                                   placeholder="Ej. Pollo a la plancha" />

                        </div>

                        <span asp-validation-for="Nombre"
                              class="plato-validation">
                        </span>

                    </div>


                    <!-- =================================================
                         PRECIO + TIEMPO
                         ================================================= -->

                    <div class="plato-form-row">

                        <!-- PRECIO -->

                        <div class="plato-form-group">

                            <label asp-for="Precio"
                                   class="plato-form-label">

                                Precio

                                <span class="plato-form-required">
                                    *
                                </span>

                            </label>

                            <div class="plato-form-input-wrapper">

                                <span class="plato-form-input-icon">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">

                                        <path d="M12 3v18" />
                                        <path d="M17 7c0-2-2-3-5-3S7 5 7 7s2 3 5 3 5 1 5 3-2 3-5 3-5-1-5-3" />

                                    </svg>

                                </span>

                                <input asp-for="Precio"
                                       class="plato-form-input"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       placeholder="0.00" />

                            </div>

                            <p class="plato-form-help">
                                Precio de venta expresado en bolivianos.
                            </p>

                            <span asp-validation-for="Precio"
                                  class="plato-validation">
                            </span>

                        </div>


                        <!-- TIEMPO -->

                        <div class="plato-form-group">

                            <label asp-for="TiempoEstimado"
                                   class="plato-form-label">

                                Tiempo estimado

                                <span class="plato-form-required">
                                    *
                                </span>

                            </label>

                            <div class="plato-form-input-wrapper">

                                <span class="plato-form-input-icon">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">

                                        <circle cx="12" cy="12" r="9" />
                                        <path d="M12 7v5l3 2" />

                                    </svg>

                                </span>

                                <input asp-for="TiempoEstimado"
                                       class="plato-form-input"
                                       type="number"
                                       min="1"
                                       placeholder="Ej. 20" />

                            </div>

                            <p class="plato-form-help">
                                Tiempo aproximado de preparación en minutos.
                            </p>

                            <span asp-validation-for="TiempoEstimado"
                                  class="plato-validation">
                            </span>

                        </div>

                    </div>


                    <!-- =================================================
                         ESTADO
                         ================================================= -->

                    <div class="plato-form-group">

                        <label asp-for="Estado"
                               class="plato-form-label">

                            Estado del plato

                            <span class="plato-form-required">
                                *
                            </span>

                        </label>

                        <div class="plato-form-input-wrapper">

                            <span class="plato-form-input-icon">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <circle cx="12" cy="12" r="9" />
                                    <path d="m8 12 2.5 2.5L16 9" />

                                </svg>

                            </span>

                            <select asp-for="Estado"
                                    class="plato-form-select">

                                <option value="@EstadoPlato.Disponible">
                                    Disponible
                                </option>

                                <option value="@EstadoPlato.Agotado">
                                    Agotado
                                </option>

                            </select>

                        </div>

                        <p class="plato-form-help">
                            Selecciona si el plato está disponible o agotado.
                        </p>

                        <span asp-validation-for="Estado"
                              class="plato-validation">
                        </span>

                    </div>


                    <!-- =================================================
                         RECETA
                         ================================================= -->

                    <div class="plato-receta-section">

                        <div class="plato-receta-header">

                            <h3 class="plato-receta-title">

                                <span class="plato-receta-title-icon">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">

                                        <path d="M4 7h16" />
                                        <path d="M4 12h16" />
                                        <path d="M4 17h10" />
                                        <path d="M17 15v5" />
                                        <path d="M14.5 17.5h5" />

                                    </svg>

                                </span>

                                Receta e ingredientes

                            </h3>


                            <button type="button"
                                    id="btnAgregarIngrediente"
                                    class="plato-add-ingredient-btn">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <path d="M12 5v14" />
                                    <path d="M5 12h14" />

                                </svg>

                                Agregar ingrediente

                            </button>

                        </div>


                        <p class="plato-receta-description">
                            Define los ingredientes y la cantidad exacta que se
                            descontará del inventario por cada plato vendido.
                        </p>


                        <div id="contenedorIngredientes"
                             class="plato-ingredientes-container">

                            <div id="recetaVacia"
                                 class="plato-receta-empty">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.7"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <circle cx="12" cy="12" r="9" />
                                    <path d="M12 8v4" />
