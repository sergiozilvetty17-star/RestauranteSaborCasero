<!-- =========================================================
     SCRIPT PARA AGREGAR INGREDIENTES
     ========================================================= -->

<script>

    document.getElementById('btnAgregarIngrediente').addEventListener('click', function () {

        var container = document.getElementById('contenedorIngredientes');

        var recetaVacia = document.getElementById('recetaVacia');

        if (recetaVacia) {
            recetaVacia.remove();
        }

        var fila = document.createElement('div');

        fila.className = 'plato-ingrediente-row';

        var htmlSelect = `
            <select name="IdsIngredientes"
                    class="plato-form-select"
                    required>

                <option value="">
                    Seleccione un ingrediente...
                </option>

                @if (ViewBag.Ingredientes != null)
                {
                    foreach (var ing in ViewBag.Ingredientes)
                    {
                        <option value="@ing.Value">
                            @ing.Text
                        </option>
                    }
                }

            </select>
        `;

        var htmlCantidad = `
            <input type="number"
                   name="CantidadesNecesarias"
                   class="plato-form-input"
                   step="0.01"
                   min="0.01"
                   placeholder="Cantidad (Ej: 0.2)"
                   required />
        `;

        var btnEliminar = `
            <button type="button"
                    class="plato-remove-ingredient-btn"
                    title="Eliminar ingrediente"
                    onclick="this.parentElement.remove();">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M6 6l12 12" />
                    <path d="M18 6L6 18" />

                </svg>

            </button>
        `;

        fila.innerHTML =
            htmlSelect +
            htmlCantidad +
            btnEliminar;

        container.appendChild(fila);

    });

</script>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

