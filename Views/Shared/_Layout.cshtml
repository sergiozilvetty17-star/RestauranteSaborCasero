<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Sabor Casero</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* =========================================================
           VARIABLES
           ========================================================= */

        :root {
            --sc-primary: #7a1f2b;
            --sc-primary-dark: #54131d;
            --sc-primary-light: #9b2d3a;
            --sc-primary-soft: #32191e;

            --sc-secondary: #b88945;
            --sc-secondary-light: #d1a866;

            --sc-bg: #151312;
            --sc-bg-secondary: #1b1817;
            --sc-card: #211e1c;
            --sc-card-header: #282422;

            --sc-border: #3a3430;
            --sc-border-soft: #302b28;

            --sc-text: #f1ebe5;
            --sc-text-secondary: #d3cbc4;
            --sc-text-muted: #aaa19a;
            --sc-text-dark: #827a74;

            --sc-success: #3d8b65;
            --sc-danger: #a6403a;
            --sc-warning: #b88945;
            --sc-info: #527d91;

            --sc-radius: 12px;
            --sc-radius-sm: 8px;

            --sc-shadow:
                0 12px 30px rgba(0, 0, 0, 0.28);

            --sc-shadow-soft:
                0 6px 18px rgba(0, 0, 0, 0.22);
        }


        /* =========================================================
           GENERAL
           ========================================================= */

        html {
            font-size: 14px;
            min-height: 100%;
        }

        body {
            margin: 0;
            min-height: 100vh;

            background:
                radial-gradient(
                    circle at top right,
                    rgba(122, 31, 43, 0.08),
                    transparent 32%
                ),
                var(--sc-bg);

            color: var(--sc-text);

            font-family:
                "Segoe UI",
                Arial,
                Helvetica,
                sans-serif;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        a:hover {
            color: inherit;
        }


        /* =========================================================
           NAVBAR
           ========================================================= */

        header {
            position: relative;
            z-index: 100;
        }

        .navbar {
            min-height: 76px;

            padding: 0 28px;

            background:
                linear-gradient(
                    180deg,
                    #211c1a 0%,
                    #1b1817 100%
                ) !important;

            border-bottom: 1px solid var(--sc-border);

            box-shadow:
                0 8px 24px rgba(0, 0, 0, 0.28);
        }


        /* =========================================================
           BRAND
           ========================================================= */

        .navbar-brand {
            display: flex;
            align-items: center;

            gap: 12px;

            color: var(--sc-text) !important;

            font-size: 1.08rem;
            font-weight: 800;

            letter-spacing: 0.2px;

            margin-right: 28px;
        }

        .navbar-brand:hover {
            color: #ffffff !important;
        }

        .navbar-brand-logo {
            width: 48px;
            height: 48px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 12px;

            background:
                linear-gradient(
                    145deg,
                    #2c211e,
                    #171312
                );

            border: 1px solid #49352e;

            box-shadow:
                0 5px 16px rgba(0, 0, 0, 0.35);

            overflow: hidden;
        }

        .navbar-brand-logo svg {
            width: 40px;
            height: 40px;
        }

        .navbar-brand-text {
            display: flex;
            flex-direction: column;
            line-height: 1.05;
        }

        .navbar-brand-title {
            color: #f5eee8;

            font-size: 1rem;
            font-weight: 800;
        }

        .navbar-brand-subtitle {
            margin-top: 4px;

            color: var(--sc-secondary);

            font-size: 0.62rem;
            font-weight: 700;

            letter-spacing: 1.3px;
            text-transform: uppercase;
        }


        /* =========================================================
           NAVIGATION LINKS
           ========================================================= */

        .navbar-nav {
            display: flex;
            align-items: center;

            gap: 5px;
        }

        .navbar-nav .nav-link {
            position: relative;

            display: flex;
            align-items: center;

            min-height: 42px;

            padding: 9px 13px !important;

            border-radius: var(--sc-radius-sm);

            color: var(--sc-text-muted) !important;

            font-size: 0.84rem;
            font-weight: 700;

            transition:
                background 0.2s ease,
                color 0.2s ease,
                transform 0.2s ease;
        }

        .navbar-nav .nav-link:hover {
            color: #ffffff !important;

            background: #302a27;

            transform: translateY(-1px);
        }

        .navbar-nav .nav-link.active {
            color: #ffffff !important;

            background:
                linear-gradient(
                    135deg,
                    rgba(122, 31, 43, 0.9),
                    rgba(84, 19, 29, 0.9)
                );

            box-shadow:
                inset 0 0 0 1px rgba(155, 45, 58, 0.35),
                0 5px 14px rgba(0, 0, 0, 0.18);
        }


        /* =========================================================
           PAGE WRAPPER
           ========================================================= */

        .sc-page-wrapper {
            min-height: calc(100vh - 76px - 64px);

            padding: 28px 30px 40px;
        }

        main {
            width: 100%;
        }


        /* =========================================================
           CARDS
           ========================================================= */

        .card {
            background: var(--sc-card);

            color: var(--sc-text);

            border: 1px solid var(--sc-border);

            border-radius: var(--sc-radius);

            box-shadow: var(--sc-shadow-soft);
        }

        .card-header {
            background: var(--sc-card-header);

            color: var(--sc-text);

            border-bottom: 1px solid var(--sc-border);
        }

        .card-body {
            color: var(--sc-text-secondary);
        }


        /* =========================================================
           BUTTONS
           ========================================================= */

        .btn {
            border-radius: var(--sc-radius-sm);

            font-weight: 700;

            transition:
                transform 0.18s ease,
                box-shadow 0.18s ease,
                background 0.18s ease;
        }

        .btn:hover {
            transform: translateY(-1px);
        }

        .btn-primary {
            background: var(--sc-primary);

            border-color: var(--sc-primary);

            color: #ffffff;
        }

        .btn-primary:hover {
            background: var(--sc-primary-light);

            border-color: var(--sc-primary-light);

            color: #ffffff;

            box-shadow:
                0 6px 18px rgba(122, 31, 43, 0.28);
        }

        .btn-secondary {
            background: #282422;

            border-color: var(--sc-border);

            color: var(--sc-text-secondary);
        }

        .btn-secondary:hover {
            background: #332d2a;

            border-color: #4a403a;

            color: #ffffff;
        }

        .btn-warning {
            background: #382d1d;

            border-color: #6e552e;

            color: #d7b46e;
        }

        .btn-warning:hover {
            background: #4a3923;

            color: #e7c989;
        }

        .btn-danger {
            background: #421f1d;

            border-color: #71312d;

            color: #d97970;
        }

        .btn-danger:hover {
            background: #552622;

            color: #ef8b81;
        }


        /* =========================================================
           FORMS
           ========================================================= */

        .form-control,
        .form-select {
            min-height: 42px;

            background: #181514 !important;

            color: var(--sc-text) !important;

            border: 1px solid var(--sc-border) !important;

            border-radius: var(--sc-radius-sm);
        }

        .form-control::placeholder {
            color: #766d67;
        }

        .form-control:focus,
        .form-select:focus {
            background: #1d1918 !important;

            color: #ffffff !important;

            border-color: var(--sc-primary-light) !important;

            box-shadow:
                0 0 0 3px rgba(122, 31, 43, 0.18) !important;
        }

        .form-label {
            color: var(--sc-text-secondary);

            font-weight: 700;
        }

        .form-text {
            color: var(--sc-text-muted);
        }

        .form-select option {
            background: #1b1817;

            color: #ffffff;
        }


        /* =========================================================
           TABLES
           ========================================================= */

        .table {
            margin-bottom: 0;

            color: var(--sc-text-secondary);

            --bs-table-bg: transparent;
            --bs-table-color: var(--sc-text-secondary);
            --bs-table-border-color: var(--sc-border);
        }

        .table thead th {
            background: #282422;

            color: #eee5de;

            border-bottom: 1px solid var(--sc-border);

            font-size: 0.78rem;

            font-weight: 800;

            letter-spacing: 0.4px;

            text-transform: uppercase;
        }

        .table tbody td {
            background: #211e1c;

            color: var(--sc-text-secondary);

            border-color: var(--sc-border-soft);

            vertical-align: middle;
        }

        .table tbody tr {
            transition:
                background 0.18s ease;
        }

        .table tbody tr:hover td {
            background: #292421;
        }


        /* =========================================================
           BADGES
           ========================================================= */

        .badge {
            padding: 6px 9px;

            border-radius: 7px;

            font-size: 0.7rem;

            font-weight: 800;
        }

        .bg-success {
            background: #183126 !important;

            color: #69b58d !important;
        }

        .bg-danger {
            background: #421f1d !important;

            color: #d97970 !important;
        }

        .bg-warning {
            background: #382d1d !important;

            color: #d0a85f !important;
        }

        .bg-primary {
            background: #321b18 !important;

            color: #d28a80 !important;
        }

        .bg-secondary {
            background: #302a27 !important;

            color: #c2b8b0 !important;
        }


        /* =========================================================
           ALERTS
           ========================================================= */

        .alert {
            border-radius: var(--sc-radius-sm);

            border-width: 1px;
        }

        .alert-success {
            background: #183126;

            color: #83c8a5;

            border-color: #28553f;
        }

        .alert-danger {
            background: #3b211f;

            color: #df8a82;

            border-color: #63332e;
        }

        .alert-warning {
            background: #382d1d;

            color: #d5b46e;

            border-color: #68532f;
        }

        .alert-info {
            background: #1e2d34;

            color: #8bb7c9;

            border-color: #304b58;
        }


        /* =========================================================
           VALIDATION
           ========================================================= */

        .field-validation-error,
        .validation-summary-errors {
            color: #df8178 !important;

            font-size: 0.78rem;

            font-weight: 600;
        }

        .input-validation-error {
            border-color: #8c3933 !important;

            box-shadow:
                0 0 0 2px rgba(140, 57, 51, 0.12) !important;
        }


        /* =========================================================
           USUARIO ACTUAL
           ========================================================= */

        .navbar-user {
            display: flex;
            align-items: center;

            gap: 11px;

            margin-left: auto;
            margin-right: 14px;

            padding: 7px 12px;

            background: #1b1817;

            border: 1px solid var(--sc-border);

            border-radius: var(--sc-radius-sm);

            box-shadow:
                0 4px 14px rgba(0, 0, 0, 0.16);
        }

        .navbar-user-icon {
            width: 34px;
            height: 34px;

            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 9px;

            background:
                linear-gradient(
                    145deg,
                    var(--sc-primary-light),
                    var(--sc-primary-dark)
                );

            color: #ffffff;

            box-shadow:
                0 4px 12px rgba(122, 31, 43, 0.25);
        }

        .navbar-user-icon svg {
            width: 18px;
            height: 18px;

            stroke: currentColor;
        }

        .navbar-user-info {
            display: flex;
            flex-direction: column;

            line-height: 1.15;
        }

        .navbar-user-name {
            color: #eee7e1;

            font-size: 0.84rem;

            font-weight: 700;

            white-space: nowrap;
        }

        .navbar-user-role {
            margin-top: 4px;

            color: var(--sc-secondary);

            font-size: 0.68rem;

            font-weight: 800;

            letter-spacing: 0.7px;

            text-transform: uppercase;
        }


        /* =========================================================
           LOGOUT
           ========================================================= */

        .navbar-logout-form {
            display: flex;
            align-items: center;

            margin: 0;
        }

        .navbar-logout-btn {
            display: flex;
            align-items: center;

            gap: 8px;

            min-height: 40px;

            padding: 8px 13px;

            background: #281f1d;

            border: 1px solid #49302c;

            border-radius: var(--sc-radius-sm);

            color: #d8c9c2;

            font-size: 0.78rem;

            font-weight: 700;

            cursor: pointer;

            transition:
                background 0.18s ease,
                color 0.18s ease,
                border-color 0.18s ease,
                transform 0.18s ease;
        }

        .navbar-logout-btn:hover {
            background: #3b211f;

            border-color: #69342f;

            color: #f0a39b;

            transform: translateY(-1px);
        }

        .logout-icon {
            width: 18px;
            height: 18px;

            display: flex;
            align-items: center;
            justify-content: center;
        }

        .logout-icon svg {
            width: 17px;
            height: 17px;

            stroke: currentColor;
        }


        /* =========================================================
           FOOTER
           ========================================================= */

        .footer {
            min-height: 64px;

            display: flex;
            align-items: center;

            padding: 16px 30px;

            background: #1b1817;

            border-top: 1px solid var(--sc-border);

            color: var(--sc-text-muted);

            font-size: 0.78rem;
        }

        .footer strong {
            color: var(--sc-text-secondary);
        }

        .footer-accent {
            color: var(--sc-secondary);
        }


        /* =========================================================
           DROPDOWNS
           ========================================================= */

        .dropdown-menu {
            background: #211e1c;

            border: 1px solid var(--sc-border);

            border-radius: var(--sc-radius-sm);

            box-shadow: var(--sc-shadow);
        }

        .dropdown-item {
            color: var(--sc-text-secondary);
        }

        .dropdown-item:hover {
            background: #302a27;

            color: #ffffff;
        }


        /* =========================================================
           MODALS
           ========================================================= */

        .modal-content {
            background: var(--sc-card);

            color: var(--sc-text);

            border: 1px solid var(--sc-border);

            border-radius: var(--sc-radius);

            box-shadow: var(--sc-shadow);
        }

        .modal-header,
        .modal-footer {
            border-color: var(--sc-border);
        }

        .modal-title {
            color: #ffffff;

            font-weight: 800;
        }

        .btn-close {
            filter: invert(1) grayscale(1);

            opacity: 0.75;
        }


        /* =========================================================
           SCROLLBAR
           ========================================================= */

        ::-webkit-scrollbar {
            width: 9px;
            height: 9px;
        }

        ::-webkit-scrollbar-track {
            background: #151312;
        }

        ::-webkit-scrollbar-thumb {
            background: #493b35;

            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #604d45;
        }
    </style>
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-light">

            <!-- =====================================================
                 LOGO / MARCA
                 ===================================================== -->

            <a class="navbar-brand"
               asp-area=""
               asp-controller="Home"
               asp-action="Index">

                <span class="navbar-brand-logo">

                    <svg width="40"
                         height="40"
                         viewBox="0 0 280 280"
                         xmlns="http://www.w3.org/2000/svg"
                         aria-hidden="true">

                        <circle
                            cx="140"
                            cy="140"
                            r="132"
                            fill="#1B1714" />

                        <circle
                            cx="140"
                            cy="140"
                            r="124"
                            fill="none"
                            stroke="#842F25"
                            stroke-width="8" />

                        <circle
                            cx="140"
                            cy="140"
                            r="104"
                            fill="none"
                            stroke="#C99B58"
                            stroke-width="3"
                            opacity="0.9" />

                        <path
                            d="M92 102
                               C92 82 108 68 128 68
                               H152
                               C172 68 188 82 188 102
                               V146
                               C188 170 168 190 140 190
                               C112 190 92 170 92 146 Z"
                            fill="#842F25" />

                        <path
                            d="M108 105
                               C108 91 118 82 132 82
                               H148
                               C162 82 172 91 172 105
                               V143
                               C172 158 158 171 140 171
                               C122 171 108 158 108 143 Z"
                            fill="#C99B58"
                            opacity="0.95" />

                        <path
                            d="M121 112
                               C128 118 135 120 140 120
                               C145 120 152 118 159 112"
                            fill="none"
                            stroke="#1B1714"
                            stroke-width="6"
                            stroke-linecap="round" />

                        <circle
                            cx="126"
                            cy="136"
                            r="4"
                            fill="#1B1714" />

                        <circle
                            cx="154"
                            cy="136"
                            r="4"
                            fill="#1B1714" />

                        <path
                            d="M126 151
                               C134 157 146 157 154 151"
                            fill="none"
                            stroke="#1B1714"
                            stroke-width="4"
                            stroke-linecap="round" />

                    </svg>

                </span>

                <span class="navbar-brand-text">
                    <span class="navbar-brand-title">
                        Sabor Casero
                    </span>

                    <span class="navbar-brand-subtitle">
                        Restaurante
                    </span>
                </span>

            </a>


            <!-- =====================================================
                 BOTÓN MOBILE DE BOOTSTRAP
                 ===================================================== -->

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Mostrar navegación">

                <span class="navbar-toggler-icon"></span>

            </button>


            <!-- =====================================================
                 NAVEGACIÓN
                 ===================================================== -->

            <div class="collapse navbar-collapse"
                 id="mainNavbar">

                <ul class="navbar-nav">

                    <!-- Dashboard -->

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Dashboard"
                               asp-action="Index">

                                Dashboard

                            </a>

                        </li>
                    }


                    <!-- Platos -->

                    @if (User.IsInRole("Administrador") ||
                         User.IsInRole("Cocinero"))
                    {
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Platos"
                               asp-action="Index">

                                Platos

                            </a>

                        </li>
                    }


                    <!-- Mesas -->

                    @if (User.IsInRole("Administrador") ||
                         User.IsInRole("Mesero"))
                    {
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Mesas"
                               asp-action="Index">

                                Mesas

                            </a>

                        </li>
                    }


                    <!-- Ingredientes -->

                    @if (User.IsInRole("Administrador") ||
                         User.IsInRole("Cocinero"))
                    {
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Ingredientes"
                               asp-action="Index">

                                Ingredientes

                            </a>

                        </li>
                    }


                    <!-- Pedidos -->

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Pedidos"
                               asp-action="Index">

                                Pedidos

                            </a>

                        </li>
                    }


                    <!-- Compras -->

                    @if (User.IsInRole("Administrador"))
                    {
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Compras"
                               asp-action="Index">

                                Compras

                            </a>

                        </li>
                    }


                    <!-- Usuarios -->

                    @if (User.IsInRole("Administrador"))
                    {
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Usuarios"
                               asp-action="Index">

                                Usuarios

                            </a>

                        </li>
                    }

                </ul>


                <!-- =================================================
                     USUARIO ACTUAL + ROL + LOGOUT
                     ================================================= -->

                @if (User.Identity?.IsAuthenticated == true)
                {
                    var nombreUsuario =
                        User.Identity.Name ?? "Usuario";

                    var rolUsuario =
                        User.IsInRole("Administrador")
                            ? "Administrador"
                            : User.IsInRole("Cocinero")
                                ? "Cocinero"
                                : User.IsInRole("Mesero")
                                    ? "Mesero"
                                    : "Usuario";


                    <!-- Usuario -->

                    <div class="navbar-user">

                        <span class="navbar-user-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">

                                <circle
                                    cx="12"
                                    cy="8"
                                    r="3" />

                                <path
                                    d="M5 21
                                       C5 17.5 7.8 15 12 15
                                       S19 17.5 19 21" />

                            </svg>

                        </span>


                        <span class="navbar-user-info">

                            <span class="navbar-user-name">
                                @nombreUsuario
                            </span>

                            <span class="navbar-user-role">
                                @rolUsuario
                            </span>

                        </span>

                    </div>


                    <!-- Cerrar sesión -->

                    <form class="navbar-logout-form"
                          asp-area=""
                          asp-controller="Login"
                          asp-action="Logout"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="navbar-logout-btn">

                            <span class="logout-icon">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">

                                    <path
                                        d="M9 21H5
                                           C3.9 21 3 20.1 3 19V5
                                           C3 3.9 3.9 3 5 3H9" />

                                    <path
                                        d="M16 17L21 12L16 7" />

                                    <path
                                        d="M21 12H9" />

                                </svg>

                            </span>

                            Cerrar sesión

                        </button>

                    </form>
                }

            </div>

        </nav>
    </header>


    <!-- =============================================================
         CONTENIDO PRINCIPAL
         ============================================================= -->

    <div class="sc-page-wrapper">

        <main role="main">

            @RenderBody()

        </main>

    </div>


    <!-- =============================================================
         FOOTER
         ============================================================= -->

    <footer class="footer">

        <div>

            <strong>
                Sabor Casero
            </strong>

            <span>
                &nbsp;•&nbsp;
            </span>

            <span>
                Sistema de gestión de restaurante
            </span>

            <span>
                &nbsp;•&nbsp;
            </span>

            <span class="footer-accent">
