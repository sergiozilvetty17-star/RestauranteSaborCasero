<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Sabor Casero</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- CSS principal -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            /* =========================================================
                       SABOR CASERO - SISTEMA VISUAL
                       Diseño optimizado para escritorio
                       ========================================================= */

            :root {
                --sc-primary: #8b3a2b;
                --sc-primary-dark: #68291f;
                --sc-primary-soft: #f7eee9;
                --sc-secondary: #d69b45;
                --sc-secondary-dark: #b77c2f;
                --sc-secondary-soft: #fbf3e6;
                --sc-background: #f6f3ef;
                --sc-surface: #ffffff;
                --sc-dark: #292522;
                --sc-dark-soft: #49433e;
                --sc-gray: #746f6a;
                --sc-gray-light: #9b948d;
                --sc-border: #e8e0d8;
                --sc-border-light: #f0ebe6;
                --sc-success: #3d8b5f;
                --sc-success-soft: #eaf6ee;
                --sc-danger: #c94a4a;
                --sc-danger-soft: #fbecec;
                --sc-info: #527da8;
                --sc-info-soft: #edf4fa;
                --sc-warning: #c98b32;
                --sc-warning-soft: #fff5e5;
                --sc-radius-sm: 8px;
                --sc-radius-md: 12px;
                --sc-radius-lg: 16px;
                --sc-shadow-sm: 0 2px 8px rgba(70, 45, 30, 0.05);
                --sc-shadow: 0 8px 25px rgba(70, 45, 30, 0.07);
                --sc-shadow-lg: 0 15px 40px rgba(70, 45, 30, 0.11);
                --sc-transition: 0.2s ease;
            }

            /* =========================================================
                       BASE
                       ========================================================= */

            html {
                font-size: 14px;
                min-height: 100%;
            }

            body {
                margin: 0;
                min-height: 100vh;
                background: var(--sc-background);
                color: var(--sc-dark);
                font-family: "Segoe UI", Arial, Helvetica, sans-serif;
                -webkit-font-smoothing: antialiased;
                text-rendering: optimizeLegibility;
            }

            ::selection {
                background: var(--sc-primary);
                color: #ffffff;
            }

            a {
                color: var(--sc-primary);
                transition: color var(--sc-transition);
            }

                a:hover {
                    color: var(--sc-primary-dark);
                }

            /* =========================================================
                       NAVBAR
                       ========================================================= */

            .navbar {
                min-height: 76px;
                padding: 0 32px;
                margin: 0 !important;
                background: var(--sc-surface) !important;
                border: none !important;
                border-bottom: 1px solid var(--sc-border) !important;
                box-shadow: 0 3px 18px rgba(45, 30, 20, 0.055);
                position: relative;
                z-index: 1000;
            }

                .navbar .container-fluid {
                    width: 100%;
                    max-width: 1480px;
                    padding: 0;
                }

            /* =========================================================
                       LOGO
                       ========================================================= */

            .navbar-brand {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-right: 38px;
                color: var(--sc-primary) !important;
                font-size: 1.35rem;
                font-weight: 800;
                letter-spacing: -0.45px;
                text-decoration: none;
                transition: transform var(--sc-transition), color var(--sc-transition);
            }

                .navbar-brand:hover {
                    color: var(--sc-primary-dark) !important;
                    transform: translateY(-1px);
                }

            .brand-icon {
                width: 43px;
                height: 43px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background: var(--sc-primary);
                color: #ffffff;
                border-radius: 12px;
                box-shadow: 0 6px 16px rgba(139, 58, 43, 0.20);
            }

                .brand-icon svg {
                    width: 23px;
                    height: 23px;
                    stroke: currentColor;
                }

            .brand-text {
                display: flex;
                flex-direction: column;
                line-height: 1.05;
            }

            .brand-name {
                font-size: 1.35rem;
                font-weight: 800;
            }

            .brand-subtitle {
                margin-top: 4px;
                color: var(--sc-gray-light);
                font-size: 0.68rem;
                font-weight: 600;
                letter-spacing: 1.2px;
                text-transform: uppercase;
            }

            /* =========================================================
                       NAVIGATION
                       ========================================================= */

            .navbar-collapse {
                display: flex !important;
                align-items: center;
            }

            .navbar-nav {
                display: flex;
                align-items: center;
                gap: 3px;
            }

                .navbar-nav .nav-item {
                    margin: 0;
                }

                .navbar-nav .nav-link {
                    position: relative;
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    padding: 10px 13px !important;
                    border-radius: var(--sc-radius-sm);
                    color: var(--sc-gray) !important;
                    font-size: 0.88rem;
                    font-weight: 600;
                    text-decoration: none;
                    transition: background var(--sc-transition), color var(--sc-transition), transform var(--sc-transition);
                }

                    .navbar-nav .nav-link:hover {
                        background: var(--sc-primary-soft);
                        color: var(--sc-primary) !important;
                        transform: translateY(-1px);
                    }

                    .navbar-nav .nav-link.active {
                        background: var(--sc-primary);
                        color: #ffffff !important;
                        box-shadow: 0 5px 14px rgba(139, 58, 43, 0.16);
                    }

                        .navbar-nav .nav-link.active:hover {
                            background: var(--sc-primary-dark);
                            color: #ffffff !important;
                        }

            .nav-icon {
                width: 17px;
                height: 17px;
                flex-shrink: 0;
            }

                .nav-icon svg {
                    width: 100%;
                    height: 100%;
                    stroke: currentColor;
                }

            /* =========================================================
                       CONTENIDO
                       ========================================================= */

            .sc-page-wrapper {
                width: 100%;
                max-width: 1480px;
                margin: 0 auto;
                padding: 30px 32px 40px;
            }

            main {
                min-height: calc(100vh - 160px);
            }

            /* =========================================================
                       CARDS
                       ========================================================= */

            .card {
                background: var(--sc-surface);
                border: 1px solid var(--sc-border);
                border-radius: var(--sc-radius-lg);
                box-shadow: var(--sc-shadow);
                overflow: hidden;
                transition: box-shadow var(--sc-transition), transform var(--sc-transition);
            }

                .card:hover {
                    box-shadow: var(--sc-shadow-lg);
                }

            .card-header {
                padding: 17px 21px;
                background: var(--sc-surface);
                border-bottom: 1px solid var(--sc-border);
                color: var(--sc-primary);
                font-weight: 700;
            }

            .card-body {
                padding: 23px;
                background: var(--sc-surface);
            }

            .card-footer {
                padding: 15px 21px;
                background: #fcfaf8;
                border-top: 1px solid var(--sc-border);
            }

            /* =========================================================
                       BOTONES
                       ========================================================= */

            .btn {
                min-height: 40px;
                padding: 8px 16px;
                border-radius: var(--sc-radius-sm);
                font-size: 0.88rem;
                font-weight: 600;
                transition: background var(--sc-transition), border-color var(--sc-transition), box-shadow var(--sc-transition), transform var(--sc-transition);
            }

                .btn:hover {
                    transform: translateY(-1px);
                }

                .btn:active {
                    transform: translateY(0);
                }

            .btn-primary {
                background: var(--sc-primary);
                border-color: var(--sc-primary);
                color: #ffffff;
            }

                .btn-primary:hover,
                .btn-primary:focus {
                    background: var(--sc-primary-dark);
                    border-color: var(--sc-primary-dark);
                    color: #ffffff;
                    box-shadow: 0 6px 15px rgba(139, 58, 43, 0.20);
                }

            .btn-warning {
                background: var(--sc-secondary);
                border-color: var(--sc-secondary);
                color: #ffffff;
            }

                .btn-warning:hover,
                .btn-warning:focus {
                    background: var(--sc-secondary-dark);
                    border-color: var(--sc-secondary-dark);
                    color: #ffffff;
                    box-shadow: 0 6px 15px rgba(214, 155, 69, 0.20);
                }

            .btn-success {
                background: var(--sc-success);
                border-color: var(--sc-success);
                color: #ffffff;
            }

                .btn-success:hover,
                .btn-success:focus {
                    background: #32734e;
                    border-color: #32734e;
                    color: #ffffff;
                    box-shadow: 0 6px 15px rgba(61, 139, 95, 0.18);
                }

            .btn-danger {
                background: var(--sc-danger);
                border-color: var(--sc-danger);
                color: #ffffff;
            }

                .btn-danger:hover,
                .btn-danger:focus {
                    background: #aa3e3e;
                    border-color: #aa3e3e;
                    color: #ffffff;
                    box-shadow: 0 6px 15px rgba(201, 74, 74, 0.18);
                }

            .btn-secondary {
                background: #eee9e4;
                border-color: #eee9e4;
                color: var(--sc-dark-soft);
            }

                .btn-secondary:hover,
                .btn-secondary:focus {
                    background: #e2dbd4;
                    border-color: #e2dbd4;
                    color: var(--sc-dark);
                }

            /* =========================================================
                       FORMULARIOS
                       ========================================================= */

            .form-label {
                margin-bottom: 7px;
                color: var(--sc-dark);
                font-size: 0.87rem;
                font-weight: 700;
            }

            .form-control,
            .form-select {
                min-height: 42px;
                padding: 9px 13px;
                background: #ffffff;
                border: 1px solid #ddd5cc;
                border-radius: var(--sc-radius-sm);
                color: var(--sc-dark);
                font-size: 0.9rem;
                transition: border-color var(--sc-transition), box-shadow var(--sc-transition);
            }

                .form-control::placeholder {
                    color: #aaa39d;
                }

                .form-control:hover,
                .form-select:hover {
                    border-color: #cfc4ba;
                }

                .form-control:focus,
                .form-select:focus {
                    background: #ffffff;
                    border-color: var(--sc-primary);
                    box-shadow: 0 0 0 3px rgba(139, 58, 43, 0.10);
                    color: var(--sc-dark);
                    outline: none;
                }

            textarea.form-control {
                min-height: 100px;
                resize: vertical;
            }

            /* =========================================================
                       TABLAS
                       ========================================================= */

            .table {
                margin-bottom: 0;
                background: #ffffff;
                border-color: var(--sc-border);
                vertical-align: middle;
            }

                .table thead th {
                    padding: 13px 15px;
                    background: #f5eee8;
                    border-bottom: 2px solid var(--sc-border);
                    color: var(--sc-primary);
                    font-size: 0.79rem;
                    font-weight: 800;
                    letter-spacing: 0.35px;
                    text-transform: uppercase;
                    white-space: nowrap;
                }

                .table tbody td {
                    padding: 13px 15px;
                    border-color: var(--sc-border-light);
                    color: var(--sc-dark-soft);
                    font-size: 0.88rem;
                }

                .table tbody tr {
                    transition: background var(--sc-transition);
                }

                    .table tbody tr:hover {
                        background: #fcf8f4;
                    }

                .table > :not(caption) > * > * {
                    box-shadow: none;
                }

            /* =========================================================
                       BADGES
                       ========================================================= */

            .badge {
                display: inline-flex;
                align-items: center;
                min-height: 27px;
                padding: 5px 10px;
                border-radius: 7px;
                font-size: 0.74rem;
                font-weight: 700;
                letter-spacing: 0.15px;
            }

                .badge.bg-success {
                    background: var(--sc-success-soft) !important;
                    color: var(--sc-success) !important;
                }

                .badge.bg-danger {
                    background: var(--sc-danger-soft) !important;
                    color: var(--sc-danger) !important;
                }

                .badge.bg-warning {
                    background: var(--sc-warning-soft) !important;
                    color: var(--sc-warning) !important;
                }

                .badge.bg-info {
                    background: var(--sc-info-soft) !important;
                    color: var(--sc-info) !important;
                }

            /* =========================================================
                       ALERTAS
                       ========================================================= */

            .alert {
                padding: 13px 16px;
                border: 1px solid transparent;
                border-radius: var(--sc-radius-md);
                box-shadow: var(--sc-shadow-sm);
                font-size: 0.88rem;
            }

            /* =========================================================
                       FOOTER
                       ========================================================= */

            footer.footer {
                margin-top: 0 !important;
                padding: 20px 32px;
                background: var(--sc-surface);
                border-top: 1px solid var(--sc-border) !important;
                color: var(--sc-gray);
            }

            footer .container {
                max-width: 1480px;
                color: var(--sc-gray-light);
                font-size: 0.82rem;
            }

            footer a {
                color: var(--sc-primary);
                font-weight: 600;
                text-decoration: none;
            }

                footer a:hover {
                    color: var(--sc-primary-dark);
                    text-decoration: underline;
                }

            /* =========================================================
                       SCROLLBAR
                       ========================================================= */

            ::-webkit-scrollbar {
                width: 9px;
                height: 9px;
            }

            ::-webkit-scrollbar-track {
                background: #eee9e4;
            }

            ::-webkit-scrollbar-thumb {
                background: #c7beb6;
                border-radius: 10px;
            }

                ::-webkit-scrollbar-thumb:hover {
                    background: #a99f96;
                }
    </style>
</head>

