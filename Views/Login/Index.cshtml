@{
    ViewData["Title"] = "Iniciar sesión";
}

<style>
    .login-page {
        min-height: 75vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px;
    }

    .login-card {
        width: 420px;
        background-color: white;
        border: 1px solid #e5e5e5;
        border-radius: 12px;
        padding: 35px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    }

    .login-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .login-logo {
        width: 65px;
        height: 65px;
        margin: 0 auto 15px;
        border-radius: 50%;
        background-color: #68291f;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
        font-weight: 700;
    }

    .login-title {
        margin: 0;
        font-size: 28px;
        font-weight: 700;
        color: #2c2c2c;
    }

    .login-subtitle {
        margin: 7px 0 0;
        color: #777;
        font-size: 14px;
    }

    .login-welcome {
        text-align: center;
        color: #555;
        font-size: 14px;
        margin-bottom: 25px;
    }

    .campo {
        margin-bottom: 20px;
    }

        .campo label {
            display: block;
            margin-bottom: 7px;
            font-size: 14px;
            font-weight: 600;
            color: #333;
        }

        .campo input {
            width: 100%;
            box-sizing: border-box;
            padding: 12px 13px;
            border: 1px solid #ced4da;
            border-radius: 7px;
            font-size: 15px;
            color: #333;
            background-color: white;
        }

            .campo input:focus {
                outline: none;
                border-color: #68291f;
                box-shadow: 0 0 0 2px rgba(104, 41, 31, 0.12);
            }

            .campo input::placeholder {
                color: #aaa;
            }

    .validation-summary {
        background-color: #f8d7da;
        border: 1px solid #f1aeb5;
        color: #842029;
        border-radius: 7px;
        padding: 12px 15px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .btn-login {
        width: 100%;
        border: none;
        background-color: #68291f;
        color: white;
        padding: 13px;
        border-radius: 7px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 5px;
    }

        .btn-login:hover {
            background-color: #f7eee9;
        }

    .login-footer {
        text-align: center;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #eeeeee;
        color: #999;
        font-size: 12px;
    }
</style>


<div class="login-page">

    <div class="login-card">

        <!-- ENCABEZADO -->
        <div class="login-header">

            <div class="login-logo">
                <svg
    viewBox="0 0 160 160"
    width="160"
    height="160"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
    role="img"
    aria-labelledby="loginTitle loginDesc">

    <title id="loginTitle">Acceso a Sabor Casero</title>
    <desc id="loginDesc">
        Icono minimalista y elegante de acceso de usuario para restaurante
    </desc>

    <!-- Marco exterior -->
    <circle
        cx="80"
        cy="80"
        r="70"
        stroke-width="1"
        opacity="0.35"
    />

    <!-- Acento superior -->
    <path
        d="M69 20
           C72 17.5 76 16 80 16
           C84 16 88 17.5 91 20"
        stroke-width="1.2"
    />

    <!-- Pequeño ornamento -->
    <path
        d="M76 20H84"
        stroke-width="1"
    />

    <!-- CABEZA / USUARIO -->
    <circle
        cx="80"
        cy="56"
        r="13"
        stroke-width="1.5"
    />

    <!-- Detalle interior del rostro -->
    <path
        d="M75 58
           C76.5 60
           78 61
           80 61
           C82 61
           83.5 60
           85 58"
        stroke-width="0.8"
        opacity="0.5"
    />

    <!-- HOMBROS / PERFIL DEL USUARIO -->
    <path
        d="M51 103
           C53 87
           64 78
           80 78
           C96 78
           107 87
           109 103"
        stroke-width="1.6"
    />

    <!-- Línea interior elegante -->
    <path
        d="M59 99
           C64 91
           71 87
           80 87
           C89 87
           96 91
           101 99"
        stroke-width="0.8"
        opacity="0.45"
    />

    <!-- PLATO detrás del usuario -->
    <path
        d="M45 108
           C52 114
           65 117
           80 117
           C95 117
           108 114
           115 108"
        stroke-width="1.4"
    />

    <path
        d="M50 112
           C57 120
           67 124
           80 124
           C93 124
           103 120
           110 112"
        stroke-width="1"
        opacity="0.65"
    />

    <!-- TENEDOR DECORATIVO -->
    <path
        d="M38 51V78"
        stroke-width="1.1"
    />

    <path
        d="M34 51V64
           C34 67
           36 69
           38 69
           C40 69
           42 67
           42 64V51"
        stroke-width="1.1"
    />

    <path
        d="M38 69V92"
        stroke-width="1.1"
    />

    <!-- CUCHILLO DECORATIVO -->
    <path
        d="M122 51V92"
        stroke-width="1.1"
    />

    <path
        d="M122 51
           C128 55
           131 61
           131 68
           V70
           H122"
        stroke-width="1.1"
    />

    <!-- Separador inferior -->
    <path
        d="M59 133H101"
        stroke-width="1"
        opacity="0.5"
    />

    <!-- Detalle central -->
    <circle
        cx="80"
        cy="133"
        r="1.8"
        fill="currentColor"
        stroke="none"
    />

</svg>
            </div>

            <h1 class="login-title">
                Sabor Casero
            </h1>

            <p class="login-subtitle">
                Sistema de gestión del restaurante
            </p>

        </div>


        <p class="login-welcome">
            Ingresa tus datos para acceder al sistema.
        </p>


        <!-- FORMULARIO -->
        <form asp-controller="Login"
              asp-action="Index"
              method="post">

            @Html.AntiForgeryToken()


            <!-- MENSAJES DE ERROR -->
            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>


            <!-- CORREO -->
            <div class="campo">

                <label for="correo">
                    Correo electrónico
                </label>

                <input type="email"
                       id="correo"
                       name="correo"
                       placeholder="correo@ejemplo.com"
                       autocomplete="email"
                       required />

            </div>


            <!-- CONTRASEÑA -->
            <div class="campo">

                <label for="contrasena">
                    Contraseña
                </label>

                <input type="password"
                       id="contrasena"
                       name="contrasena"
                       placeholder="Ingrese su contraseña"
                       autocomplete="current-password"
                       required />

            </div>


            <!-- BOTÓN -->
            <button type="submit"
                    class="btn-login">
                Iniciar sesión
            </button>

        </form>


        <div class="login-footer">
            Sistema de gestión · Sabor Casero
        </div>

    </div>

</div>
