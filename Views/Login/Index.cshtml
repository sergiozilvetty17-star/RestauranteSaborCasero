@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">

        <div class="card shadow">

            <div class="card-body p-4">

                <div class="text-center mb-4">
                    <h2 class="fw-bold">Sabor Casero</h2>
                    <p class="text-muted">
                        Iniciar sesión
                    </p>
                </div>

                <form asp-controller="Login"
                      asp-action="Index"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <div class="mb-3">
                        <label for="correo"
                               class="form-label">
                            Correo
                        </label>

                        <input type="email"
                               id="correo"
                               name="correo"
                               class="form-control"
                               placeholder="correo@ejemplo.com"
                               autocomplete="email"
                               required />
                    </div>

                    <div class="mb-4">
                        <label for="contrasena"
                               class="form-label">
                            Contraseña
                        </label>

                        <input type="password"
                               id="contrasena"
                               name="contrasena"
                               class="form-control"
                               placeholder="Ingrese su contraseña"
                               autocomplete="current-password"
                               required />
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Iniciar sesión
                    </button>

                </form>

            </div>

        </div>

    </div>
</div>