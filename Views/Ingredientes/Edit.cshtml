@model RestauranteSaborCasero.Models.Ingrediente

@{
    ViewData["Title"] = "Editar Ingrediente";
}

<style>
    /* =========================================================
           VARIABLES DE TEMA (Basado en el Dashboard)
           ========================================================= */
    :root {
        --sc-primary: #8d3024;
        --sc-primary-dark: #7d2b21;
        --sc-primary-soft: #f9f2f0;
        --sc-dark: #3c2c27;
        --sc-gray: #756b65;
        --sc-border: #eee8e3;
        --sc-bg-panel: #ffffff;
        --sc-shadow: 0 8px 24px rgba(49, 31, 25, .07);
        --sc-danger-bg: #fdf3f2;
        --sc-danger-text: #c92a2a;
    }

    .sc-page-container {
        width: 100%;
        max-width: 650px;
        padding-top: 12px;
        color: var(--sc-dark);
    }

    /* =========================================================
           ENCABEZADO
           ========================================================= */
    .sc-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 25px;
    }

    .sc-header-icon {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--sc-primary-soft);
        border-radius: 12px;
        color: var(--sc-primary);
    }

        .sc-header-icon svg {
            width: 24px;
            height: 24px;
            stroke: currentColor;
        }

    .sc-eyebrow {
        margin: 0 0 4px;
        color: var(--sc-primary);
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 1.2px;
        text-transform: uppercase;
    }

    .sc-title {
        margin: 0;
        color: var(--sc-dark);
        font-size: 2rem;
        font-weight: 900;
        letter-spacing: -0.5px;
        line-height: 1.1;
    }

    .sc-description {
        margin: 6px 0 0;
        color: var(--sc-gray);
        font-size: 0.85rem;
        font-weight: 600;
    }

    /* =========================================================
           TARJETA (PANEL)
           ========================================================= */
    .sc-panel {
        background: var(--sc-bg-panel);
        border: 1px solid var(--sc-border);
        border-radius: 16px;
        box-shadow: var(--sc-shadow);
        overflow: hidden;
        margin-bottom: 25px;
    }

    .sc-panel-header {
        padding: 20px 24px;
        background: #faf8f6;
        border-bottom: 1px solid var(--sc-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .sc-panel-title {
        margin: 0;
        color: var(--sc-dark);
        font-size: 1.1rem;
        font-weight: 900;
    }

    .sc-panel-subtitle {
        margin: 4px 0 0;
        color: var(--sc-gray);
        font-size: 0.75rem;
        font-weight: 600;
    }

    .sc-panel-body {
        padding: 24px;
    }

    /* =========================================================
           FORMULARIO Y CAMPOS
           ========================================================= */
    .sc-form-group {
        margin-bottom: 22px;
    }

    .sc-form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .sc-form-label {
        display: block;
        margin-bottom: 8px;
        color: var(--sc-dark);
        font-size: 0.85rem;
        font-weight: 800;
    }

    .sc-input-wrapper {
        position: relative;
    }

    .sc-input-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        width: 18px;
        height: 18px;
        color: #a3968f;
        pointer-events: none;
    }

        .sc-input-icon svg {
            width: 100%;
            height: 100%;
            stroke: currentColor;
        }

    .sc-input {
        width: 100%;
        height: 48px;
        padding: 0 16px 0 42px;
        background: #ffffff;
        border: 1px solid #dcd2cc;
        border-radius: 10px;
        color: var(--sc-dark);
        font-size: 0.9rem;
        font-weight: 600;
        outline: none;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }

        .sc-input:hover {
            border-color: #c4b5ac;
        }

        .sc-input:focus {
            border-color: var(--sc-primary);
            box-shadow: 0 0 0 3px rgba(141, 48, 36, 0.1);
            background: #ffffff;
        }

        .sc-input::placeholder {
            color: #b5aba4;
        }

    .sc-help-text {
        display: block;
        margin-top: 6px;
        color: #8c8078;
        font-size: 0.75rem;
        font-weight: 600;
    }

    /* =========================================================
           VALIDACIÓN
           ========================================================= */
    .sc-validation {
        display: block;
        margin-top: 6px;
        color: var(--sc-danger-text);
        font-size: 0.75rem;
        font-weight: 700;
    }

    .sc-validation-summary {
        background-color: var(--sc-danger-bg);
        border: 1px solid #f5c2c2;
        color: var(--sc-danger-text);
        border-radius: 10px;
        padding: 14px 18px;
        margin-bottom: 24px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    /* =========================================================
           BOTONES Y ACCIONES
           ========================================================= */
    .sc-actions {
        display: flex;
        gap: 12px;
        align-items: center;
        padding-top: 24px;
        border-top: 1px solid var(--sc-border);
        margin-top: 10px;
    }

    .sc-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 44px;
        padding: 0 22px;
        border-radius: 10px;
        font-size: 0.85rem;
        font-weight: 800;
        text-decoration: none;
        transition: all 0.2s ease;
        border: 1px solid transparent;
        cursor: pointer;
    }

        .sc-btn svg {
            width: 18px;
            height: 18px;
            stroke: currentColor;
        }

    .sc-btn-primary {
        background-color: var(--sc-primary);
        color: #ffffff;
    }

        .sc-btn-primary:hover {
            background-color: var(--sc-primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(141, 48, 36, 0.2);
        }

    .sc-btn-secondary {
        background-color: #f3f0ed;
        color: #665d57;
        border-color: #e5ddd6;
    }

        .sc-btn-secondary:hover {
            background-color: #e9e3de;
            color: var(--sc-dark);
            transform: translateY(-2px);
        }

    @@media (max-width: 600px) {
        .sc-form-row {
            grid-template-columns: 1fr;
            gap: 0;
        }
    }
</style>

<div class="sc-page-container">

    <!-- ENCABEZADO -->
    <div class="sc-header">
        <div class="sc-header-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 8l6-3 6 3v8l-6 3-6-3V8" />
                <path d="M12 11v7" />
                <path d="M6 11l6 3 6-3" />
            </svg>
        </div>
        <div>
            <p class="sc-eyebrow">Control de Inventario</p>
            <h1 class="sc-title">Editar ingrediente</h1>
            <p class="sc-description">Modifica los detalles, niveles de stock y medidas del insumo.</p>
        </div>
    </div>

    <!-- TARJETA FORMULARIO -->
    <div class="sc-panel">

        <div class="sc-panel-header">
            <div>
                <h2 class="sc-panel-title">@Model.Nombre</h2>
                <p class="sc-panel-subtitle">Edición de ficha de insumo</p>
            </div>
            <div style="background: var(--sc-primary-soft); color: var(--sc-primary); font-size: 0.7rem; padding: 6px 10px; border-radius: 8px; font-weight: 800; text-transform: uppercase;">
                Modo Edición
            </div>
        </div>

        <div class="sc-panel-body">

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="IdIngrediente" />

                <!-- VALIDACIONES -->
                <div asp-validation-summary="ModelOnly" class="sc-validation-summary"></div>

                <!-- NOMBRE -->
                <div class="sc-form-group">
                    <label asp-for="Nombre" class="sc-form-label">
                        Nombre del ingrediente
                    </label>
                    <div class="sc-input-wrapper">
                        <span class="sc-input-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" />
                                <line x1="7" y1="7" x2="7.01" y2="7" />
                            </svg>
                        </span>
                        <input asp-for="Nombre" type="text" class="sc-input" placeholder="Ejemplo: Tomate" />
                    </div>
                    <span asp-validation-for="Nombre" class="sc-validation"></span>
                </div>

                <!-- STOCK ACTUAL Y STOCK MÍNIMO -->
                <div class="sc-form-row">

                    <!-- CANTIDAD DISPONIBLE -->
                    <div class="sc-form-group">
                        <label asp-for="CantidadDisponible" class="sc-form-label">
                            Cantidad disponible
                        </label>
                        <div class="sc-input-wrapper">
                            <span class="sc-input-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                                </svg>
                            </span>
                            <input asp-for="CantidadDisponible" type="number" step="0.01" min="0" class="sc-input" />
                        </div>
                        <span class="sc-help-text">Cantidad actual en inventario.</span>
                        <span asp-validation-for="CantidadDisponible" class="sc-validation"></span>
                    </div>

                    <!-- CANTIDAD MÍNIMA -->
                    <div class="sc-form-group">
                        <label asp-for="CantidadMinima" class="sc-form-label">
                            Cantidad mínima
                        </label>
                        <div class="sc-input-wrapper">
                            <span class="sc-input-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 2L2 18h20L12 2M12 10v4M12 16h0.01" />
                                </svg>
                            </span>
                            <input asp-for="CantidadMinima" type="number" step="0.01" min="0" class="sc-input" />
                        </div>
                        <span class="sc-help-text">Límite para generar alerta.</span>
                        <span asp-validation-for="CantidadMinima" class="sc-validation"></span>
                    </div>

                </div>

                <!-- UNIDAD DE MEDIDA -->
                <div class="sc-form-group">
                    <label asp-for="UnidadMedida" class="sc-form-label">
                        Unidad de medida
                    </label>
                    <div class="sc-input-wrapper">
                        <span class="sc-input-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="4" y1="21" x2="4" y2="14" />
                                <line x1="4" y1="10" x2="4" y2="3" />
                                <line x1="12" y1="21" x2="12" y2="12" />
                                <line x1="12" y1="8" x2="12" y2="3" />
                                <line x1="20" y1="21" x2="20" y2="16" />
                                <line x1="20" y1="12" x2="20" y2="3" />
                                <line x1="1" y1="14" x2="7" y2="14" />
                                <line x1="9" y1="8" x2="15" y2="8" />
                                <line x1="17" y1="16" x2="23" y2="16" />
                            </svg>
                        </span>
                        <input asp-for="UnidadMedida" type="text" class="sc-input" placeholder="Ejemplo: Kg, Litros, Unidades" />
                    </div>
                    <span asp-validation-for="UnidadMedida" class="sc-validation"></span>
                </div>

                <!-- ESTADO -->
                <div class="sc-form-group">
                    <label asp-for="Estado" class="sc-form-label">
                        Estado
                    </label>
                    <div class="sc-input-wrapper">
                        <span class="sc-input-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10" />
                                <polyline points="12 6 12 12 16 14" />
                            </svg>
                        </span>
                        <input asp-for="Estado" type="text" class="sc-input" placeholder="Ejemplo: Disponible" />
                    </div>
                    <span class="sc-help-text">Estado actual o disponibilidad del insumo.</span>
                    <span asp-validation-for="Estado" class="sc-validation"></span>
                </div>

                <!-- ACCIONES -->
                <div class="sc-actions">
                    <button type="submit" class="sc-btn sc-btn-primary">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
                            <polyline points="17 21 17 13 7 13 7 21" />
                            <polyline points="7 3 7 8 15 8" />
                        </svg>
                        Guardar cambios
                    </button>

                    <a asp-action="Index" class="sc-btn sc-btn-secondary">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="19" y1="12" x2="5" y2="12" />
                            <polyline points="12 19 5 12 12 5" />
                        </svg>
                        Volver al inventario
                    </a>
                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}