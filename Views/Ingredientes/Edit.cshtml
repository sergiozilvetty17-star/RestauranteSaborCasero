@model RestauranteSaborCasero.Models.Ingrediente

@{
    ViewData["Title"] = "Editar Ingrediente";
}

<style>
    .editar-ingrediente-container {
        padding: 30px;
    }

    .editar-ingrediente-header {
        margin-bottom: 25px;
    }

    .editar-ingrediente-titulo {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
        color: #2c2c2c;
    }

    .editar-ingrediente-subtitulo {
        margin: 6px 0 0;
        color: #777;
        font-size: 15px;
    }

    .editar-ingrediente-card {
        width: 600px;
        background-color: white;
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        padding: 30px;
    }

    .ingrediente-identificacion {
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 25px;
        color: #343a40;
    }

        .ingrediente-identificacion strong {
            font-size: 18px;
        }

    .campo {
        margin-bottom: 20px;
    }

        .campo label {
            display: block;
            margin-bottom: 7px;
            font-size: 14px;
            font-weight: 600;
            color: #333;
        }

        .campo input {
            width: 100%;
            box-sizing: border-box;
            padding: 12px;
            border: 1px solid #ced4da;
            border-radius: 7px;
            background-color: white;
            color: #333;
            font-size: 15px;
        }

            .campo input:focus {
                outline: none;
                border-color: #198754;
                box-shadow: 0 0 0 2px rgba(25, 135, 84, 0.12);
            }

    .ayuda {
        display: block;
        margin-top: 6px;
        color: #888;
        font-size: 12px;
    }

    .validation {
        display: block;
        margin-top: 5px;
        color: #dc3545;
        font-size: 13px;
    }

    .validation-summary {
        background-color: #f8d7da;
        border: 1px solid #f1aeb5;
        color: #842029;
        border-radius: 7px;
        padding: 12px 15px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .acciones {
        display: flex;
        gap: 10px;
        align-items: center;
        padding-top: 20px;
        border-top: 1px solid #eeeeee;
        margin-top: 25px;
    }

    .btn-guardar {
        border: none;
        background-color: #198754;
        color: white;
        padding: 12px 22px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-guardar:hover {
            background-color: #157347;
        }

    .btn-volver {
        background-color: #6c757d;
        color: white;
        text-decoration: none;
        padding: 12px 22px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
    }

        .btn-volver:hover {
            background-color: #5c636a;
            color: white;
        }
</style>


<div class="editar-ingrediente-container">

    <!-- ENCABEZADO -->
    <div class="editar-ingrediente-header">

        <h1 class="editar-ingrediente-titulo">
            Editar ingrediente
        </h1>

        <p class="editar-ingrediente-subtitulo">
            Modifica la información del ingrediente
        </p>

    </div>


    <!-- TARJETA -->
    <div class="editar-ingrediente-card">

        <div class="ingrediente-identificacion">

            Ingrediente:
            <strong>
                @Model.Nombre
            </strong>

        </div>


        <form asp-action="Edit"
              method="post">

            <input type="hidden"
                   asp-for="IdIngrediente" />


            <!-- VALIDACIONES -->
            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>


            <!-- NOMBRE -->
            <div class="campo">

                <label asp-for="Nombre">
                    Nombre del ingrediente
                </label>

                <input asp-for="Nombre"
                       type="text"
                       placeholder="Ejemplo: Tomate" />

                <span asp-validation-for="Nombre"
                      class="validation">
                </span>

            </div>


            <!-- CANTIDAD DISPONIBLE -->
            <div class="campo">

                <label asp-for="CantidadDisponible">
                    Cantidad disponible
                </label>

                <input asp-for="CantidadDisponible"
                       type="number"
                       step="0.01"
                       min="0" />

                <span class="ayuda">
                    Cantidad que tienes actualmente en inventario.
                </span>

                <span asp-validation-for="CantidadDisponible"
                      class="validation">
                </span>

            </div>


            <!-- CANTIDAD MÍNIMA -->
            <div class="campo">

                <label asp-for="CantidadMinima">
                    Cantidad mínima
                </label>

                <input asp-for="CantidadMinima"
                       type="number"
                       step="0.01"
                       min="0" />

                <span class="ayuda">
                    Nivel mínimo para generar una alerta de inventario.
                </span>

                <span asp-validation-for="CantidadMinima"
                      class="validation">
                </span>

            </div>


            <!-- UNIDAD -->
            <div class="campo">

                <label asp-for="UnidadMedida">
                    Unidad de medida
                </label>

                <input asp-for="UnidadMedida"
                       type="text"
                       placeholder="Ejemplo: Kg, Litros, Unidades" />

                <span asp-validation-for="UnidadMedida"
                      class="validation">
                </span>

            </div>


            <!-- ESTADO -->
            <div class="campo">

                <label asp-for="Estado">
                    Estado
                </label>

                <input asp-for="Estado"
                       type="text"
                       placeholder="Ejemplo: Disponible" />

                <span class="ayuda">
                    Estado actual del ingrediente.
                </span>

                <span asp-validation-for="Estado"
                      class="validation">
                </span>

            </div>


            <!-- ACCIONES -->
            <div class="acciones">

                <button type="submit"
                        class="btn-guardar">
                    Guardar cambios
                </button>

                <a asp-action="Index"
                   class="btn-volver">
                    Volver al inventario
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

