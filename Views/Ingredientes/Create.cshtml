@model RestauranteSaborCasero.Models.Ingrediente

<h1>Crear Ingrediente</h1>

<form asp-action="Create">
    <div>
        <label asp-for="Nombre">Nombre:</label>
        <input asp-for="Nombre" type="text" />
    </div>

    <div>
        <label asp-for="CantidadDisponible">Cantidad Disponible:</label>
        <input asp-for="CantidadDisponible" type="number" step="0.01" />
    </div>

    <div>
        <label asp-for="CantidadMinima">Cantidad Mínima (Alerta):</label>
        <input asp-for="CantidadMinima" type="number" step="0.01" />
    </div>

    <div>
        <label asp-for="UnidadMedida">Unidad de Medida (Ej: Kg, Litros, Unidades):</label>
        <input asp-for="UnidadMedida" type="text" />
    </div>

    <div>
        <label asp-for="Estado">Estado:</label>
        <input asp-for="Estado" type="text" value="Disponible" />
    </div>

    <div>
        <input type="submit" value="Guardar Ingrediente" />
    </div>
</form>

<div>
    <a asp-action="Index">Volver a la lista</a>
</div>