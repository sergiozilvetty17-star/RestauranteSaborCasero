@model RestauranteSaborCasero.Models.Ingrediente

@{
    ViewData["Title"] = "Crear Ingrediente";
}

<style>
    .ingrediente-container {
        padding: 30px;
    }

    .ingrediente-header {
        margin-bottom: 25px;
    }

    .ingrediente-titulo {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
        color: #2c2c2c;
    }

    .ingrediente-subtitulo {
        margin: 6px 0 0;
        color: #777;
        font-size: 15px;
    }

    .ingrediente-card {
        width: 600px;
        background-color: white;
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        padding: 30px;
    }

    .seccion-titulo {
        margin: 0 0 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid #eeeeee;
        font-size: 18px;
        font-weight: 700;
        color: #343a40;
    }

    .campo {
        margin-bottom: 20px;
    }

        .campo label {
            display: block;
            margin-bottom: 7px;
            font-size: 14px;
            font-weight: 600;
            color: #333;
        }

        .campo input {
            width: 100%;
            box-sizing: border-box;
            padding: 12px;
            border: 1px solid #ced4da;
            border-radius: 7px;
            background-color: white;
            color: #333;
            font-size: 15px;
        }

            .campo input:focus {
                outline: none;
                border-color: #198754;
                box-shadow: 0 0 0 2px rgba(25, 135, 84, 0.12);
            }

    .ayuda {
        display: block;
        margin-top: 6px;
        color: #888;
        font-size: 12px;
    }

    .acciones {
        display: flex;
        gap: 10px;
        align-items: center;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #eeeeee;
    }

    .btn-guardar {
        border: none;
        background-color: #198754;
        color: white;
        padding: 12px 22px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-guardar:hover {
            background-color: #157347;
        }

    .btn-volver {
        background-color: #6c757d;
        color: white;
        text-decoration: none;
        padding: 12px 22px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
    }

        .btn-volver:hover {
            background-color: #5c636a;
            color: white;
        }
</style>


<div class="ingrediente-container">

    <!-- ENCABEZADO -->
    <div class="ingrediente-header">

        <h1 class="ingrediente-titulo">
            Crear ingrediente
        </h1>

        <p class="ingrediente-subtitulo">
            Registra un nuevo ingrediente para el inventario
        </p>

    </div>


    <!-- FORMULARIO -->
    <div class="ingrediente-card">

        <h2 class="seccion-titulo">
            Información del ingrediente
        </h2>


        <form asp-action="Create"
              method="post">


            <!-- NOMBRE -->
            <div class="campo">

                <label asp-for="Nombre">
                    Nombre del ingrediente
                </label>

                <input asp-for="Nombre"
                       type="text"
                       placeholder="Ejemplo: Tomate" />

            </div>


            <!-- CANTIDAD DISPONIBLE -->
            <div class="campo">

                <label asp-for="CantidadDisponible">
                    Cantidad disponible
                </label>

                <input asp-for="CantidadDisponible"
                       type="number"
                       step="0.01"
                       min="0"
                       placeholder="Ejemplo: 25" />

                <span class="ayuda">
                    Cantidad que actualmente tienes en inventario.
                </span>

            </div>


            <!-- CANTIDAD MÍNIMA -->
            <div class="campo">

                <label asp-for="CantidadMinima">
                    Cantidad mínima
                </label>

                <input asp-for="CantidadMinima"
                       type="number"
                       step="0.01"
                       min="0"
                       placeholder="Ejemplo: 5" />

                <span class="ayuda">
                    Cuando el inventario llegue a este nivel se considera bajo.
                </span>

            </div>


            <!-- UNIDAD -->
            <div class="campo">

                <label asp-for="UnidadMedida">
                    Unidad de medida
                </label>

                <input asp-for="UnidadMedida"
                       type="text"
                       placeholder="Ejemplo: Kg, Litros, Unidades" />

                <span class="ayuda">
                    Indica cómo se mide el ingrediente.
                </span>

            </div>


            <!-- ESTADO -->
            <div class="campo">

                <label asp-for="Estado">
                    Estado
                </label>

                <input asp-for="Estado"
                       type="text"
                       value="Disponible"
                       placeholder="Disponible" />

                <span class="ayuda">
                    Estado actual del ingrediente.
                </span>

            </div>


            <!-- BOTONES -->
            <div class="acciones">

                <button type="submit"
                        class="btn-guardar">
                    Guardar ingrediente
                </button>

                <a asp-action="Index"
                   class="btn-volver">
                    Volver al inventario
                </a>

            </div>

        </form>

    </div>

</div>

