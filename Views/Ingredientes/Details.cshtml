@model RestauranteSaborCasero.Models.Ingrediente

<h1>Detalles del Ingrediente</h1>

<div>
    <p><strong>Nombre:</strong> @Model.Nombre</p>
    <p><strong>Cantidad Disponible:</strong> @Model.CantidadDisponible @Model.UnidadMedida</p>
    <p><strong>Cantidad Mínima (Alerta):</strong> @Model.CantidadMinima @Model.UnidadMedida</p>
    <p><strong>Estado:</strong> @Model.Estado</p>
</div>

<br />
<div>
    <a asp-action="Edit" asp-route-id="@Model.IdIngrediente">Editar</a> |
    <a asp-action="Index">Volver a la lista</a>
</div>