```cshtml
@model IEnumerable<RestauranteSaborCasero.Models.Ingrediente>

@{
    ViewData["Title"] = "Ingredientes";
}

<style>
    .ingredientes-container {
        padding: 30px;
    }

    .ingredientes-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .ingredientes-titulo {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
        color: #2c2c2c;
    }

    .ingredientes-subtitulo {
        margin: 6px 0 0;
        color: #777;
        font-size: 15px;
    }

    .btn-nuevo {
        display: inline-block;
        background-color: #198754;
        color: white;
        text-decoration: none;
        padding: 12px 20px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
    }

        .btn-nuevo:hover {
            background-color: #157347;
            color: white;
        }

    .ingredientes-card {
        width: 1100px;
        background-color: white;
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        overflow: hidden;
    }

    .tabla-ingredientes {
        width: 100%;
        border-collapse: collapse;
    }

        .tabla-ingredientes thead {
            background-color: #343a40;
            color: white;
        }

        .tabla-ingredientes th {
            padding: 15px 16px;
            text-align: left;
            font-size: 13px;
            font-weight: 600;
        }

        .tabla-ingredientes td {
            padding: 14px 16px;
            border-bottom: 1px solid #eeeeee;
            color: #444;
            font-size: 14px;
            vertical-align: middle;
        }

        .tabla-ingredientes tbody tr:hover {
            background-color: #f8f9fa;
        }

    .nombre-ingrediente {
        font-size: 15px;
        font-weight: 700;
        color: #343a40;
    }

    .cantidad {
        font-weight: 700;
    }

    .cantidad-normal {
        color: #198754;
    }

    .cantidad-baja {
        color: #dc3545;
    }

    .alerta-stock {
        display: inline-block;
        margin-left: 7px;
        padding: 4px 8px;
        border-radius: 12px;
        background-color: #f8d7da;
        color: #842029;
        font-size: 11px;
        font-weight: 700;
    }

    .unidad {
        color: #777;
    }

    .estado {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 20px;
        background-color: #d1e7dd;
        color: #0f5132;
        font-size: 12px;
        font-weight: 600;
    }

    .acciones {
        display: flex;
        gap: 6px;
        white-space: nowrap;
    }

    .btn-accion {
        display: inline-block;
        text-decoration: none;
        padding: 7px 10px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
    }

    .btn-editar {
        background-color: #ffc107;
        color: #212529;
    }

        .btn-editar:hover {
            background-color: #ffca2c;
            color: #212529;
        }

    .btn-detalles {
        background-color: #0d6efd;
        color: white;
    }

        .btn-detalles:hover {
            background-color: #0b5ed7;
            color: white;
        }

    .btn-eliminar {
        background-color: #dc3545;
        color: white;
    }

        .btn-eliminar:hover {
            background-color: #bb2d3b;
            color: white;
        }

    .tabla-vacia {
        text-align: center;
        padding: 45px;
        color: #777;
        font-size: 15px;
    }
</style>


<div class="ingredientes-container">

    <!-- ENCABEZADO -->
    <div class="ingredientes-header">

        <div>

            <h1 class="ingredientes-titulo">
                Ingredientes
            </h1>

            <p class="ingredientes-subtitulo">
                Control y administración del inventario de ingredientes
            </p>

        </div>


        <a asp-action="Create"
           class="btn-nuevo">
            + Crear nuevo ingrediente
        </a>

    </div>


    <!-- TABLA -->
    <div class="ingredientes-card">

        <table class="tabla-ingredientes">

            <thead>

                <tr>

                    <th>
                        Ingrediente
                    </th>

                    <th>
                        Disponible
                    </th>

                    <th>
                        Mínimo
                    </th>

                    <th>
                        Unidad
                    </th>

                    <th>
                        Estado
                    </th>

                    <th>
                        Acciones
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var stockBajo = item.CantidadDisponible <= item.CantidadMinima;

                        <tr>

                            <!-- NOMBRE -->
                            <td>

                                <span class="nombre-ingrediente">
                                    @item.Nombre
                                </span>

                            </td>


                            <!-- DISPONIBLE -->
                            <td>

                                @if (stockBajo)
                                {
                                    <span class="cantidad cantidad-baja">
                                        @item.CantidadDisponible
                                    </span>

                                    <span class="alerta-stock">
                                        STOCK BAJO
                                    </span>
                                }
                                else
                                {
                                    <span class="cantidad cantidad-normal">
                                        @item.CantidadDisponible
                                    </span>
                                }

                            </td>


                            <!-- MÍNIMO -->
                            <td>

                                <span class="cantidad">
                                    @item.CantidadMinima
                                </span>

                            </td>


                            <!-- UNIDAD -->
                            <td>

                                <span class="unidad">
                                    @item.UnidadMedida
                                </span>

                            </td>


                            <!-- ESTADO -->
                            <td>

                                <span class="estado">
                                    @item.Estado
                                </span>

                            </td>


                            <!-- ACCIONES -->
                            <td>

                                <div class="acciones">

                                    <a asp-action="Details"
                                       asp-route-id="@item.IdIngrediente"
                                       class="btn-accion btn-detalles">
                                        Ver
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.IdIngrediente"
                                       class="btn-accion btn-editar">
                                        Editar
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.IdIngrediente"
                                       class="btn-accion btn-eliminar">
                                        Eliminar
                                    </a>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="6"
                            class="tabla-vacia">

                            No hay ingredientes registrados.

                            <br />

                            Utiliza
                            <strong>“Crear nuevo ingrediente”</strong>
                            para agregar el primero.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
```
